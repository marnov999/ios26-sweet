+/* ---- the Titan blocks up and down ----------------------------------------------------------------- */
+
+static bool
+titan_up(void)
+{
+	if (csid == 0) {
+		csid = cam_map(CSID_PHYS, 0x1000);
+		ife = cam_map(IFE_PHYS, 0x4000);
+	}
+	if (csiphys[hw->csiphy] == 0) {
+		csiphys[hw->csiphy] = cam_map(CSIPHY_PHYS(hw->csiphy), 0x2000);
+	}
+	csiphy = csiphys[hw->csiphy];
+	if (!arcs(true) || !gdsc_on()) {
+		return false;
+	}
+	return pll0_up() && clocks_up();
+}
+
+static void
+titan_down(void)
+{
+	paths_down();
+	smmu_down();
+	clocks_down();
+	pll0_down();
+	(void)arcs(false);
+}
+
+/* ---- frames' memory ---------------------------------------------------------------------------------- */
+
+static bool
+frames_alloc(uint64_t bytes)
+{
+	frames_bytes = round_page(bytes);
+	if (kmem_alloc(kernel_map, &frames, frames_bytes, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		say("no memory for frames (%llu KB)\n", frames_bytes >> 10);
+		frames = 0;
+		return false;
+	}
+	for (vm_offset_t l = frames; l < frames + frames_bytes; l += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (l));
+	}
+	__asm__ volatile ("dsb sy");
+	return true;
+}
+
+static void
+frames_free(void)
+{
+	if (frames != 0) {
+		kmem_free(kernel_map, frames, frames_bytes);
+		frames = 0;
+		frames_bytes = 0;
+	}
+}
+
+static void
+first_bytes(vm_offset_t at, const char *what)
+{
+	const uint8_t *p = (const uint8_t *)at;
+
+	for (vm_offset_t l = at & ~63ul; l < at + 256; l += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (l));
+	}
+	__asm__ volatile ("dsb sy");
+	say("%s: first bytes %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n", what, p[0], p[1], p[2], p[3], p[4], p[5], p[6],
+	    p[7], p[8], p[9]);
+}
+
+/* sweetcam=3: CSID-lite's colour bars -> RDI 0 -> IFE-lite 0 -> SMMU -> memory; no sensor. */
+static void
+capture_tpg(void)
+{
+	const uint32_t width = 1600, height = 1200, stride = RAW10_STRIDE(width);
+	bool done = false;
+
+	if (!frames_alloc((uint64_t)stride * height) || !titan_up() || !smmu_up() || !csid_reset() ||
+	    !csid_config(-1, 4, 0x3210, TPG_VC, width, height) || !ife_config(FRAME_ADDRESSES, 0)) {
+		titan_down();
+		frames_free();
+		return;
+	}
+	show_paths("configured");
+	if (tpg_start()) {
+		for (unsigned ms = 0; ms < 2000 && !done; ms += 50) {
+			wait_ms(50);
+			done = (rd(ife + BUS_IRQ_STATUS1) & WM0_DONE) != 0;
+		}
+		say("test pattern: %s\n", done ? "write master 0 finished a frame" : "NO FRAME in 2 s");
+	}
+	show_paths("after");
+	smmu_faults();
+	titan_down();
+	first_bytes(frames, "test pattern frame");
+	frames_free();
+}
+
+/* ---- the lens motors (wide, tele) ------------------------------------------------------------------- */
+
+/*
+ * The wide and the tele lenses move on voice coils driven by a Dongwoon DW9763 each, on their sensor's own
+ * I2C (the module files' actuatorDriver: "davinci_imx582_dw9763_*" at 8-bit 0x18, "davinci_ov8856_dw9763_*"
+ * at 0x1c), powered by VAF: a fixed 2.8 V regulator that PM6150L GPIO 11 switches (both motors'). The
+ * modules' initialisation, as it is: 0x02 = 0x01 (power down), 0x02 = 0x00 and 1 ms, 0x02 = 0x02 (ring
+ * control), 0x06 = 0x60 (SAC mode), 0x07 = 0x02 (its timing); the position is ten bits, 0x03 (the high two)
+ * and 0x04 written together (registerParam). As HackiOS's DW9800 (redwood_camera.c): at the end the lens is
+ * let down in steps, the chip powered down and VAF switched off. A motor that does not answer leaves the
+ * camera fixed-focus for the session -- never the camera given up.
+ */
+#define AF_CONTROL              0x02
+#define AF_POSITION             0x03
+#define AF_MODE                 0x06
+#define AF_TIMING               0x07
+#define AF_VAF_PGPIO            11
+#define AF_FIRST_POSITION       180             /* the modules' first figure after their settings */
+
+static uint32_t af_position = SWEET_CAMERA_NO_FOCUS;
+static bool af_vaf_on;
+
+static bool
+af_write(uint8_t reg, uint16_t value)
+{
+	uint8_t out[3] = { reg, (uint8_t)value, 0 };
+
+	if (hw->af_address == 0) {
+		return false;
+	}
+	if (reg == AF_POSITION) {
+		out[1] = (uint8_t)(value >> 8 & 3);
+		out[2] = (uint8_t)value;
+	}
+	return i2c_transfer(&cci_bus, hw->af_address, out, reg == AF_POSITION ? 3 : 2, NULL, 0);
+}
+
+/* VAF on through GPIO 11 -- only if it is ours to write (a refusal is no reason to give the camera up) */
+static bool
+af_vaf(bool on)
+{
+	unsigned owner = 7, apid;
+
+	if (!on) {
+		if (af_vaf_on) {
+			(void)pgpio_drive(AF_VAF_PGPIO, false);
+			pgpio_restore(AF_VAF_PGPIO);
+			af_vaf_on = false;
+		}
+		return true;
+	}
+	if (!spmi_up()) {
+		return false;
+	}
+	lck_mtx_lock(&spmi_lock);
+	apid = spmi_apid(SID_PM6150L, PGPIO_PERIPH(AF_VAF_PGPIO), &owner);
+	lck_mtx_unlock(&spmi_lock);
+	if (apid == 0xffff || owner != 0) {
+		say("the lens motors' VAF (PM6150L GPIO %u): APID %#x owner EE %u, not ours: fixed focus\n", AF_VAF_PGPIO, apid, owner);
+		return false;
+	}
+	af_vaf_on = pgpio_drive(AF_VAF_PGPIO, true);
+	return af_vaf_on;
+}
+
+static void
+af_up(void)
+{
+	af_position = SWEET_CAMERA_NO_FOCUS;
+	if (hw->af_address == 0 || broken) {
+		return;
+	}
+	if (!af_vaf(true) || broken) {
+		return;
+	}
+	wait_ms(2);
+	if (!af_write(AF_CONTROL, 0x01) || !af_write(AF_CONTROL, 0x00)) {
+		say("the %s lens motor (DW9763 at %#x) does not answer: fixed focus this session\n", hw->name, hw->af_address);
+		(void)af_vaf(false);
+		return;
+	}
+	wait_ms(1);
+	if (!af_write(AF_CONTROL, 0x02) || !af_write(AF_MODE, 0x60) || !af_write(AF_TIMING, 0x02) ||
+	    !af_write(AF_POSITION, AF_FIRST_POSITION)) {
+		say("the %s lens motor stopped answering during its initialisation: fixed focus this session\n", hw->name);
+		(void)af_vaf(false);
+		return;
+	}
+	af_position = AF_FIRST_POSITION;
+	say("the %s lens motor (DW9763 at %#x) is up, the lens at %u\n", hw->name, hw->af_address, af_position);
+}
+
+static void
+af_move(uint32_t position)
+{
+	if (af_position == SWEET_CAMERA_NO_FOCUS) {
+		return;
+	}
+	position = position > 1023 ? 1023 : position;
+	if (position != af_position && af_write(AF_POSITION, (uint16_t)position)) {
+		af_position = position;
+	}
+}
+
+static void
+af_down(void)
+{
+	if (af_position != SWEET_CAMERA_NO_FOCUS) {
+		/* down in steps, not to knock the lens against its stop */
+		while (af_position > 0) {
+			uint32_t was = af_position;
+
+			af_move(af_position > 48 ? af_position - 48 : 0);
+			if (af_position == was) {
+				break;
+			}
+			wait_ms(10);
+		}
+		(void)af_write(AF_CONTROL, 0x01);
+		af_position = SWEET_CAMERA_NO_FOCUS;
+	}
+	(void)af_vaf(false);
+}
+
+/* ---- exposure ------------------------------------------------------------------------------------------ */
+
+#define EXPOSURE_MARGIN         40
+#define FRAME_LINES_MAX         0xfff0
+
+static const struct ctab_mode *ios_mode;
+
+static bool
+exposure_write(uint32_t lines, uint32_t gain, uint32_t frame_lines)
+{
+	bool ok;
+
+	switch (hw->regs) {
+	case REGS_SMIA:
+		ok = sensor_table("holdon") && sensor_write(0x0340, (uint16_t)frame_lines, true) && sensor_write(0x0202, (uint16_t)lines, true) &&
+		    sensor_write(0x0204, (uint16_t)gain, true) && sensor_table("holdoff");
+		break;
+	case REGS_SONY: {
+		/* linear gain (256 = 1x) to Sony's code: 1024 - 1024 / gain */
+		uint32_t code = 1024 - (1024u * hw->gain_unity) / (gain ? gain : hw->gain_unity);
+
+		ok = sensor_table("holdon") && sensor_write(0x0340, (uint16_t)(frame_lines >> 8), false) &&
+		    sensor_write(0x0341, (uint16_t)(frame_lines & 0xff), false) && sensor_write(0x0202, (uint16_t)(lines >> 8), false) &&
+		    sensor_write(0x0203, (uint16_t)(lines & 0xff), false) && sensor_write(0x0204, (uint16_t)(code >> 8 & 3), false) &&
+		    sensor_write(0x0205, (uint16_t)(code & 0xff), false) && sensor_table("holdoff");
+		break;
+	}
+	default: {
+		uint32_t e = lines << 4;        /* OV8856: in 1/16 lines */
+
+		ok = sensor_table("holdon") && sensor_write(0x380e, (uint16_t)(frame_lines >> 8), false) &&
+		    sensor_write(0x380f, (uint16_t)(frame_lines & 0xff), false) && sensor_write(0x3500, (uint16_t)(e >> 16 & 0xf), false) &&
+		    sensor_write(0x3501, (uint16_t)(e >> 8 & 0xff), false) && sensor_write(0x3502, (uint16_t)(e & 0xff), false) &&
+		    sensor_write(0x3508, (uint16_t)(gain >> 8 & 0x1f), false) && sensor_write(0x3509, (uint16_t)(gain & 0xff), false) &&
+		    sensor_table("holdoff");
+		break;
+	}
+	}
+	if (!ok) {
+		give_up("a sensor write nobody acknowledged");
+	}
+	return ok;
+}
+
+static void
+exposure_limits(uint32_t *lines, uint32_t *gain, uint32_t *frame_lines)
+{
+	uint32_t shortest = ios_mode->frame_length;
+
+	*gain = *gain < hw->gain_unity ? hw->gain_unity : *gain > hw->gain_max ? hw->gain_max : *gain;
+	*lines = *lines < 4 ? 4 : *lines > FRAME_LINES_MAX - EXPOSURE_MARGIN ? FRAME_LINES_MAX - EXPOSURE_MARGIN : *lines;
+	if (*frame_lines == 0) {
+		*frame_lines = *lines + EXPOSURE_MARGIN > shortest ? *lines + EXPOSURE_MARGIN : shortest;
+	}
+	*frame_lines = *frame_lines < shortest ? shortest : *frame_lines > FRAME_LINES_MAX ? FRAME_LINES_MAX : *frame_lines;
+	if (*lines > *frame_lines - EXPOSURE_MARGIN) {
+		*lines = *frame_lines - EXPOSURE_MARGIN;
+	}
+}
+
+/* ---- sensor bring-up shared by sweetcam=4 and =5 --------------------------------------------------- */
+
+static vm_offset_t kept_frame;          /* its allocation stays for the rest of the boot */
+static uint32_t kept_frame_bytes;
+
+static int
+camframe_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	if (kept_frame == 0) {
+		return ENOENT;
+	}
+	for (vm_offset_t l = kept_frame & ~63ul; l < kept_frame + kept_frame_bytes; l += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (l));
+	}
+	__asm__ volatile ("dsb sy");
+	return SYSCTL_OUT(req, (const void *)kept_frame, kept_frame_bytes);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_camframe, CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0,
+    camframe_sysctl, "A", "sweetcam=4's last frame, RAW10 as the IFE wrote it");
+
+static uint32_t ios_mode_n;
+
+/* The mode: sweetcam_mode, else the 4:3-ish one with the fewest pixels at >= 24 fps (the ultra's 2104x1560@60). */
+/*
+ * Which of the footprint's two tables (the wide: IMX586 or IMX582) is the one fitted, before a mode is picked
+ * and frames are sized from it: power up, read the chip ID (read_chip_id() loads the other table if it is
+ * that one), power down. Once known, later sessions load it straight away.
+ */
+static const char *resolved_tab[SENSORS];
+
+static bool
+ctab_load_resolved(void)
+{
+	unsigned index = (unsigned)(hw - sensors);
+
+	if (resolved_tab[index] != NULL) {
+		return ctab_load(resolved_tab[index]);
+	}
+	if (!ctab_load(hw->tab)) {
+		return false;
+	}
+	if (hw->tab_alt == NULL || fake) {
+		return true;
+	}
+	bool ok = power_up() && read_chip_id();
+	power_down();
+	if (ok && !broken) {
+		resolved_tab[index] = ctab_loaded;
+	}
+	return ok && !broken;
+}
+
+static bool
+pick_mode(uint32_t asked)
+{
+	if (asked >= ctab->modes) {
+		uint64_t best = ~0ull;
+
+		asked = 0;
+		for (uint32_t m = 0; m < ctab->modes; m++) {
+			const struct ctab_mode *o = &ctab_modes[m];
+			uint64_t pixels = (uint64_t)o->width * o->height;
+
+			if (o->fps_milli >= 24000 && o->width * 3 <= o->height * 4 + o->width / 8 && pixels < best) {
+				best = pixels;
+				asked = m;
+			}
+		}
+	}
+	ios_mode_n = asked;
+	ios_mode = &ctab_modes[asked];
+	if (ios_mode->lanes < 1 || ios_mode->lanes > 4 || ios_mode->cphy != 0 || ios_mode->data_type != RAW10_DT ||
+	    ios_mode->width % 4 != 0 || ios_mode->fps_milli == 0 || ios_mode->frame_length == 0) {
+		say("mode %u is not what this is written for\n", asked);
+		return false;
+	}
+	return true;
+}
+
+static unsigned
+settle_count(void)
+{
+	uint32_t settle = 0;
+
+	if (!PE_parse_boot_argn("sweetcam_settle", &settle, sizeof(settle)) || settle == 0) {
+		settle = ios_mode->settle;      /* the module's (IMX586/OV8856 14, S5K3L6/S5K3T2 19): see the plan's risks */
+	}
+	return settle;
+}
+
+static bool
+sensor_stream_setup(uint64_t first_address)
+{
+	char res[8];
+
+	snprintf(res, sizeof(res), "res%u", ios_mode_n);
+	return power_up() && read_chip_id() && sensor_table("init") && sensor_table(res) && titan_up() && smmu_up() && csid_reset() &&
+	       csid_config((int)hw->csiphy, ios_mode->lanes, ctab->lane_assign & ((1u << (4 * ios_mode->lanes)) - 1), 0, ios_mode->width,
+	    ios_mode->height) && ife_config(first_address, 0) && csiphy_up(ios_mode->lanes, ctab->lane_assign, settle_count());
+}
+
+/* sweetcam=4: N frames of the sensor into two places, then everything down. */
+static void
+capture_sensor(void)
+{
+	uint32_t mode = ~0u, wanted = 8, stride, frame;
+	unsigned done = 0;
+
+	(void)PE_parse_boot_argn("sweetcam_mode", &mode, sizeof(mode));
+	(void)PE_parse_boot_argn("sweetcam_frames", &wanted, sizeof(wanted));
+	wanted = wanted < 1 ? 1 : wanted > 300 ? 300 : wanted;
+	if (!ctab_load_resolved() || !pick_mode(mode)) {
+		return;
+	}
+	stride = RAW10_STRIDE(ios_mode->width);
+	frame = (uint32_t)round_page((uint64_t)stride * ios_mode->height + (256u << 10));
+	if (!frames_alloc(2ull * frame)) {
+		return;
+	}
+	if (!sensor_stream_setup(FRAME_ADDRESSES)) {
+		csiphy_down();
+		titan_down();
+		power_down();
+		frames_free();
+		return;
+	}
+	show_paths("configured");
+	if (sensor_table("on")) {
+		uint32_t lines = ios_mode->frame_length - EXPOSURE_MARGIN, gain = 8 * hw->gain_unity, fl = 0;
+
+		exposure_limits(&lines, &gain, &fl);
+		(void)exposure_write(lines, gain, fl);
+		for (unsigned ms = 0; ms < 5000 && done < wanted && !broken; ms += 2) {
+			sensor_delay(2000);
+			if (!(rd(ife + BUS_IRQ_STATUS1) & WM0_DONE)) {
+				continue;
+			}
+			done++;
+			if (done <= 3 || done == wanted) {
+				say("frame %u written, %u ms after stream on\n", done, ms + 2);
+			}
+			blk_put(ife, "IFE", BUS_IRQ_CLEAR1, WM0_DONE, false);
+			blk_put(ife, "IFE", BUS_IRQ_GLOBAL_CLEAR, 1, false);
+			blk_put(ife, "IFE", WM0_IMAGE_ADDR, (uint32_t)(FRAME_ADDRESSES + (uint64_t)(done & 1) * frame), false);
+			blk_put(ife, "IFE", IFE_REG_UPDATE, 0x2, false);
+		}
+		show_paths("after the frames");
+		show_csiphy("after the frames");
+		(void)sensor_table("off");
+	}
+	smmu_faults();
+	csiphy_down();
+	titan_down();
+	power_down();
+	if (done != 0) {
+		first_bytes(frames + (uint64_t)((done - 1) & 1) * frame, "last frame");
+		/* kept for sysctl kern.sweet_camframe (the camera is off and the SMMU mapping is gone) */
+		kept_frame = frames + (uint64_t)((done - 1) & 1) * frame;
+		kept_frame_bytes = stride * ios_mode->height;
+		frames = 0;
+		frames_bytes = 0;
+		say("last frame kept: %ux%u RAW10, stride %u, %u bytes (sysctl kern.sweet_camframe)\n", ios_mode->width,
+		    ios_mode->height, stride, kept_frame_bytes);
+	}
+	frames_free();
+}
+
+/* ---- sweetcam=5: /dev/sweet-camera (HackiOS redwood_camera.c:3233-4107, renamed, davinci sensors) ---- */
+
+#define RING                    3
+#define PLACE_SPARE             (256u << 10)
+#define IDLE_MS                 1000
+#define FRAME_TIMEOUT_MS        1500
+
+enum { PLACE_FREE, PLACE_WRITING, PLACE_READY, PLACE_READING };
+enum { SOURCE_SENSOR, SOURCE_SENSOR_PATTERN, SOURCE_CSID_TPG };
+
+static LCK_MTX_DECLARE(ios_lock, &cam_lck_grp);
+static struct {
+	uint8_t         state;
+	uint64_t        sequence, time;
+	uint32_t        exposure_lines, gain, frame_lines;
+} place[RING];
+static uint64_t ring_place_bytes;
+static uint32_t ring_frame_bytes, ios_line_ns;
+static volatile bool ios_open, ios_streaming, ios_wanted;
+static uint64_t ios_last_read, ios_given, ios_frames_done, ios_writes_late;
+static struct { uint32_t lines, gain, frame_lines; bool pending; uint32_t focus; bool focus_pending; } ios_ask;
+static struct { uint32_t lines, gain, frame_lines; uint64_t from; } ios_now, ios_next;
+static int ios_source = SOURCE_SENSOR;
+static volatile unsigned ios_switch_to;
+static uint32_t ios_switch_mode;
+
+static uint64_t
+ios_ms(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+static bool
+ring_alloc(void)
+{
+	ring_frame_bytes = RAW10_STRIDE(ios_mode->width) * ios_mode->height;
+	ring_place_bytes = round_page(ring_frame_bytes) + PLACE_SPARE;
+	return frames_alloc(RING * ring_place_bytes);
+}
+
+static void
+ios_stop(const char *why)
+{
+	lck_mtx_lock(&ios_lock);
+	ios_streaming = false;
+	for (int i = 0; i < RING; i++) {
+		place[i].state = PLACE_FREE;
+	}
+	lck_mtx_unlock(&ios_lock);
+	wakeup(&ios_frames_done);
+	if (!broken && ios_source != SOURCE_CSID_TPG && ctab != NULL) {
+		af_down();
+		(void)sensor_table("off");
+	}
+	(void)af_vaf(false);
+	if (csid_running || ife_running) {
+		show_paths("at the end");
+	}
+	smmu_faults();
+	csiphy_down();
+	titan_down();
+	power_down();
+	frames_free();
+	say("frames for iOS stopped (%s): %llu done, %llu given, %llu written over\n", why, ios_frames_done, ios_given, ios_writes_late);
+}
+
+static bool
+ios_start(void)
+{
+	uint32_t lines, gain, frame_lines;
+
+	ios_frames_done = ios_given = ios_writes_late = 0;
+	if (!ring_alloc()) {
+		return false;
+	}
+	if (ios_source == SOURCE_CSID_TPG) {
+		if (!titan_up() || !smmu_up() || !csid_reset() || !csid_config(-1, 4, 0x3210, TPG_VC, ios_mode->width, ios_mode->height) ||
+		    !ife_config(FRAME_ADDRESSES, 0) || !tpg_start()) {
+			return false;
+		}
+	} else if (!sensor_stream_setup(FRAME_ADDRESSES) || (ios_source == SOURCE_SENSOR_PATTERN && !sensor_table("tpgon"))) {
+		return false;
+	}
+	lck_mtx_lock(&ios_lock);
+	for (int i = 0; i < RING; i++) {
+		place[i].state = PLACE_FREE;
+	}
+	place[0].state = PLACE_WRITING;
+	lines = ios_ask.lines;
+	gain = ios_ask.gain;
+	frame_lines = ios_ask.frame_lines;
+	ios_ask.pending = false;
+	lck_mtx_unlock(&ios_lock);
+	exposure_limits(&lines, &gain, &frame_lines);
+	if (ios_source != SOURCE_CSID_TPG && (!sensor_table("on") || !exposure_write(lines, gain, frame_lines))) {
+		return false;
+	}
+	ios_now.lines = ios_next.lines = lines;
+	ios_now.gain = ios_next.gain = gain;
+	ios_now.frame_lines = ios_next.frame_lines = frame_lines;
+	ios_next.from = 0;
+	ios_ask.focus_pending = false;
+	if (ios_source != SOURCE_CSID_TPG) {
+		af_up();
+	}
+	say("frames for iOS: %s mode %u %ux%u; exposure %u lines, gain %#x, frame %u lines\n", hw->name, ios_mode_n, ios_mode->width,
+	    ios_mode->height, lines, gain, frame_lines);
+	return true;
+}
+
+/* At each RDI0 SOF the address of the place after it goes to WM0 (latched at the next SOF). */
+static void
+ios_session(void)
+{
+	int writing = 0, next = 0;
+	uint64_t last_frame;
+
+	if (!ios_start()) {
+		give_up("the camera did not start");
+		ios_stop("it did not start");
+		return;
+	}
+	last_frame = ios_ms();
+	blk_put(ife, "IFE", IFE_IRQ_CLEAR0, 0xffffffff, false);
+	blk_put(ife, "IFE", IFE_IRQ_GLOBAL_CLEAR, 1, false);
+	lck_mtx_lock(&ios_lock);
+	ios_streaming = true;
+	ios_last_read = ios_ms();
+	lck_mtx_unlock(&ios_lock);
+	while (!broken && ios_open && ios_switch_to == 0) {
+		uint32_t top, bus;
+		uint64_t now;
+
+		wait_ms(1);
+		now = ios_ms();
+		top = rd(ife + IFE_IRQ_STATUS0);
+		bus = rd(ife + BUS_IRQ_STATUS1);
+		if (!(top & RDI0_SOF) && !(bus & WM0_DONE)) {
+			if (now - last_frame > FRAME_TIMEOUT_MS) {
+				show_paths("no frame");
+				give_up("no frame for 1.5 s");
+				break;
+			}
+			if (now - ios_last_read > IDLE_MS) {
+				break;
+			}
+			continue;
+		}
+		blk_put(ife, "IFE", IFE_IRQ_CLEAR0, top & RDI0_SOF, false);
+		blk_put(ife, "IFE", IFE_IRQ_GLOBAL_CLEAR, 1, false);
+		blk_put(ife, "IFE", BUS_IRQ_CLEAR1, bus & WM0_DONE, false);
+		blk_put(ife, "IFE", BUS_IRQ_GLOBAL_CLEAR, 1, false);
+		lck_mtx_lock(&ios_lock);
+		if (bus & WM0_DONE) {
+			last_frame = now;
+			ios_frames_done++;
+			if (ios_frames_done >= ios_next.from && ios_next.from != 0) {
+				ios_now = ios_next;
+				ios_next.from = 0;
+			}
+			place[writing].state = PLACE_READY;
+			place[writing].sequence = ios_frames_done;
+			place[writing].time = mach_absolute_time();
+			place[writing].exposure_lines = ios_now.lines;
+			place[writing].gain = ios_now.gain;
+			place[writing].frame_lines = ios_now.frame_lines;
+		}
+		if (top & RDI0_SOF) {
+			if (next >= 0) {
+				writing = next;
+				next = -1;
+			} else {
+				ios_writes_late++;
+			}
+			place[writing].state = PLACE_WRITING;
+			for (int i = 0; i < RING; i++) {
+				int c = (writing + 1 + i) % RING;
+
+				if (c != writing && place[c].state != PLACE_READING && (next < 0 || place[c].sequence < place[next].sequence)) {
+					next = c;
+				}
+			}
+			if (next >= 0) {
+				blk_put(ife, "IFE", WM0_IMAGE_ADDR, (uint32_t)(FRAME_ADDRESSES + (uint64_t)next * ring_place_bytes), false);
+				blk_put(ife, "IFE", IFE_REG_UPDATE, 0x2, false);
+			}
+		}
+		bool ask = (bus & WM0_DONE) && ios_ask.pending, focus = (bus & WM0_DONE) && ios_ask.focus_pending;
+		uint32_t lines = ios_ask.lines, gain = ios_ask.gain, frame_lines = ios_ask.frame_lines, position = ios_ask.focus;
+
+		ios_ask.pending = ios_ask.pending && !ask;
+		ios_ask.focus_pending = ios_ask.focus_pending && !focus;
+		lck_mtx_unlock(&ios_lock);
+		if (focus) {
+			af_move(position);
+		}
+		if (bus & WM0_DONE) {
+			wakeup(&ios_frames_done);
+		}
+		if (ask && ios_source != SOURCE_CSID_TPG) {
+			exposure_limits(&lines, &gain, &frame_lines);
+			if (lines != ios_now.lines || gain != ios_now.gain || frame_lines != ios_now.frame_lines) {
+				if (!exposure_write(lines, gain, frame_lines)) {
+					break;
+				}
+				ios_next.lines = lines;
+				ios_next.gain = gain;
+				ios_next.frame_lines = frame_lines;
+				ios_next.from = ios_frames_done + 2;
+			}
+		}
+		if ((bus & WM0_DONE) && ios_frames_done % 30 == 0) {
+			if (rd(smmu_context + SMMU_CB_FSR) & SMMU_FSR_ALL) {
+				smmu_faults();
+				give_up("the SMMU refused the IFE");
+				break;
+			}
+			if (ios_frames_done == 30 || ios_frames_done % 900 == 0) {
+				show_paths("streaming");
+			}
+		}
+	}
+	ios_stop(broken ? "a fault" : !ios_open ? "closed" : ios_switch_to != 0 ? "another sensor" : "nobody reads");
+}
+
+/* sweetcam_fake=1: synthetic RAW10 colour bars in the sensor's order (HackiOS fake_session), no hardware. */
+static void
+fake_session(void)
+{
+	uint32_t width = ios_mode->width, height = ios_mode->height, stride = RAW10_STRIDE(width);
+
+	ios_frames_done = ios_given = 0;
+	if (!ring_alloc()) {
+		return;
+	}
+	for (int p = 0; p < RING; p++) {
+		uint8_t *at = (uint8_t *)(frames + (uint64_t)p * ring_place_bytes);
+
+		for (uint32_t y = 0; y < height; y++) {
+			for (uint32_t x = 0; x < width; x += 4) {
+				uint8_t level = (uint8_t)(16 + ((x * 8 / width) * 28) + ((y & 1) ? 0 : 8));
+
+				memset(at + (uint64_t)y * stride + x / 4 * 5, level, 4);
+				at[(uint64_t)y * stride + x / 4 * 5 + 4] = 0;
+			}
+		}
+	}
+	lck_mtx_lock(&ios_lock);
+	ios_streaming = true;
+	ios_last_read = ios_ms();
+	lck_mtx_unlock(&ios_lock);
+	while (ios_open && ios_switch_to == 0) {
+		int p = -1;
+
+		wait_ms(100);
+		lck_mtx_lock(&ios_lock);
+		if (ios_ms() - ios_last_read > IDLE_MS) {
+			lck_mtx_unlock(&ios_lock);
+			break;
+		}
+		for (int i = 0; i < RING; i++) {
+			if (place[i].state != PLACE_READING && (p < 0 || place[i].sequence < place[p].sequence)) {
+				p = i;
+			}
+		}
+		if (p >= 0) {
+			place[p].state = PLACE_READY;
+			place[p].sequence = ++ios_frames_done;
+			place[p].time = mach_absolute_time();
+			place[p].exposure_lines = ios_now.lines;
+			place[p].gain = ios_now.gain;
+			place[p].frame_lines = ios_now.frame_lines;
+		}
+		lck_mtx_unlock(&ios_lock);
+		wakeup(&ios_frames_done);
+	}
+	lck_mtx_lock(&ios_lock);
+	ios_streaming = false;
+	for (int i = 0; i < RING; i++) {
+		place[i].state = PLACE_FREE;
+	}
+	lck_mtx_unlock(&ios_lock);
+	wakeup(&ios_frames_done);
+	frames_free();
+}
+
+static int
+camdev_open(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	if (broken) {
+		return EIO;
+	}
+	ios_open = true;
+	return 0;
+}
+
+static int
+camdev_close(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	ios_open = false;
+	ios_wanted = false;
+	wakeup(__DEVOLATILE(void *, &ios_open));
+	return 0;
+}
+
+static int
+camdev_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	struct sweet_camera_frame f;
+	uint64_t since = ios_ms();
+	int b, error = 0;
+
+	lck_mtx_lock(&ios_lock);
+	ios_last_read = ios_ms();
+	for (;;) {
+		if (broken) {
+			lck_mtx_unlock(&ios_lock);
+			return EIO;
+		}
+		b = -1;
+		for (int i = 0; i < RING; i++) {
+			if (place[i].state == PLACE_READY && place[i].sequence > ios_given && (b < 0 || place[i].sequence > place[b].sequence)) {
+				b = i;
+			}
+		}
+		if (b >= 0) {
+			break;
+		}
+		if (ios_ms() - since > (ios_streaming ? 3000u : 15000u)) {
+			lck_mtx_unlock(&ios_lock);
+			return EAGAIN;
+		}
+		if (!ios_streaming && !ios_wanted) {
+			ios_wanted = true;
+			wakeup(__DEVOLATILE(void *, &ios_open));
+		}
+		struct timespec ts = { 0, 100 * NSEC_PER_MSEC };
+		error = msleep(&ios_frames_done, &ios_lock, PZERO | PCATCH, "sweet-camera", &ts);
+		if (error != 0 && error != EWOULDBLOCK) {
+			lck_mtx_unlock(&ios_lock);
+			return error;
+		}
+		ios_last_read = ios_ms();
+	}
+	place[b].state = PLACE_READING;
+	ios_given = place[b].sequence;
+	bzero(&f, sizeof(f));
+	memcpy(f.magic, SWEET_CAMERA_MAGIC, 8);
+	f.header_bytes = sizeof(f);
+	f.width = ios_mode->width;
+	f.height = ios_mode->height;
+	f.stride = RAW10_STRIDE(ios_mode->width);
+	f.format = 1;
+	f.bayer = ios_source == SOURCE_CSID_TPG ? 0 : hw->bayer;
+	f.black = 64;
+	f.sequence = place[b].sequence;
+	f.time = place[b].time;
+	f.exposure_lines = place[b].exposure_lines;
+	f.line_ns = ios_line_ns;
+	f.gain = place[b].gain;
+	f.gain_unity = hw->gain_unity;
+	f.gain_max = hw->gain_max;
+	f.frame_lines = place[b].frame_lines;
+	f.frame_lines_min = ios_mode->frame_length;
+	f.frame_lines_max = FRAME_LINES_MAX;
+	f.margin = EXPOSURE_MARGIN;
+	f.sensor = hw_index;
+	f.focus = af_position;                  /* SWEET_CAMERA_NO_FOCUS: fixed focus (ultra, front) or no motor */
+	lck_mtx_unlock(&ios_lock);
+
+	error = uiomove((caddr_t)&f, (int)MIN(sizeof(f), (size_t)uio_resid(uio)), uio);
+	if (error == 0 && uio_resid(uio) > 0) {
+		vm_offset_t at = frames + (uint64_t)b * ring_place_bytes;
+		uint32_t n = (uint32_t)MIN((uint64_t)ring_frame_bytes, (uint64_t)uio_resid(uio));
+
+		for (vm_offset_t l = at & ~63ul; l < at + n; l += 64) {
+			__asm__ volatile ("dc civac, %0" : : "r" (l));          /* the IFE wrote past the caches */
+		}
+		__asm__ volatile ("dsb sy");
+		error = uiomove((caddr_t)at, (int)n, uio);
+	}
+	lck_mtx_lock(&ios_lock);
+	if (place[b].state == PLACE_READING) {
+		place[b].state = PLACE_READY;
+	}
+	ios_last_read = ios_ms();
+	lck_mtx_unlock(&ios_lock);
+	return error;
+}
+
+static int
+camdev_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	struct sweet_camera_command c;
+
+	if (uio_resid(uio) < (user_ssize_t)sizeof(c) || uiomove((caddr_t)&c, sizeof(c), uio) != 0) {
+		return EINVAL;
+	}
+	if (c.command == SWEET_CAMERA_EXPOSURE) {
+		lck_mtx_lock(&ios_lock);
+		ios_ask.lines = c.a;
+		ios_ask.gain = c.b;
+		ios_ask.frame_lines = c.c;
+		ios_ask.pending = true;
+		lck_mtx_unlock(&ios_lock);
+		return 0;
+	}
+	if (c.command == SWEET_CAMERA_FOCUS) {
+		lck_mtx_lock(&ios_lock);
+		ios_ask.focus = c.a;
+		ios_ask.focus_pending = true;
+		lck_mtx_unlock(&ios_lock);
+		return 0;
+	}
+	if (c.command == SWEET_CAMERA_SENSOR) {
+		if (c.a >= SENSORS) {
+			return EINVAL;
+		}
+		lck_mtx_lock(&ios_lock);
+		ios_switch_mode = c.b;
+		ios_switch_to = c.a + 1;
+		lck_mtx_unlock(&ios_lock);
+		wakeup(__DEVOLATILE(void *, &ios_open));
+		return 0;
+	}
+	return EINVAL;
+}
+
+static const struct cdevsw camdev_cdevsw = {
+	.d_open = camdev_open, .d_close = camdev_close, .d_read = camdev_read, .d_write = camdev_write,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+static bool camdev_made;
+
+/* Made as the thread starts, before mediaserverd (its capture stack looks for cameras once). */
+static void
+camdev_make(void)
+{
+	int major = cdevsw_add(-1, &camdev_cdevsw);
+
+	camdev_made = major >= 0 && devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "sweet-camera") != NULL;
+}
+
+static bool
+ios_select(unsigned index, uint32_t mode)
+{
+	uint32_t pattern = 0, count = 0;
+	const struct ctab_entry *tpgon;
+
+	select_sensor(index);
+	if (!fake) {
+		find_pins();
+	}
+	if (!ctab_load_resolved() || !pick_mode(mode)) {
+		return false;
+	}
+	ios_line_ns = (uint32_t)(1000000000000ull / ((uint64_t)ios_mode->fps_milli * ios_mode->frame_length));
+	(void)PE_parse_boot_argn("sweetcam_pattern", &pattern, sizeof(pattern));
+	tpgon = ctab_find("tpgon", &count);
+	ios_source = pattern == 0 ? SOURCE_SENSOR : pattern == 1 && tpgon != NULL && count > 0 ? SOURCE_SENSOR_PATTERN : SOURCE_CSID_TPG;
+	ios_ask.lines = ios_mode->frame_length - EXPOSURE_MARGIN;
+	ios_ask.gain = 8 * hw->gain_unity;
+	ios_ask.frame_lines = 0;
+	ios_now.lines = ios_ask.lines;
+	ios_now.gain = ios_ask.gain;
+	ios_now.frame_lines = ios_mode->frame_length;
+	say("/dev/sweet-camera: the %s camera (%s), mode %u %ux%u %u.%03u fps, on demand\n", hw->name, hw->chip, ios_mode_n,
+	    ios_mode->width, ios_mode->height, ios_mode->fps_milli / 1000, ios_mode->fps_milli % 1000);
+	return true;
+}
+
+static void
+serve_ios(void)
+{
+	uint32_t mode = ~0u;
+
+	if (!camdev_made) {
+		say("/dev/sweet-camera cannot be made\n");
+		return;
+	}
+	(void)PE_parse_boot_argn("sweetcam_mode", &mode, sizeof(mode));
+	if (!ios_select(hw_index, mode)) {
+		say("/dev/sweet-camera: the %s sensor's table or mode cannot be used: no frames in this boot\n", hw->name);
+		return;
+	}
+	while (!broken) {
+		unsigned to;
+
+		lck_mtx_lock(&ios_lock);
+		while (!broken && !(ios_open && ios_wanted) && ios_switch_to == 0) {
+			(void)msleep(__DEVOLATILE(void *, &ios_open), &ios_lock, PZERO, "sweet-camera-idle", NULL);
+		}
+		to = ios_switch_to;
+		ios_switch_to = 0;
+		ios_wanted = false;
+		lck_mtx_unlock(&ios_lock);
+		if (broken) {
+			break;
+		}
+		if (to != 0) {
+			if (!ios_select(to - 1, ios_switch_mode)) {
+				give_up("a sensor that cannot be used");
+				break;
+			}
+			continue;
+		}
+		if (fake) {
+			fake_session();
+		} else {
+			ios_session();
+		}
+	}
+	say("/dev/sweet-camera: no more frames in this boot\n");
+}
+
+/* ---- the look (sweetcam=1: reads only), the thread ------------------------------------------------------ */
+
+/*
+ * sweetcam=1 writes nothing and votes nothing. What it reads, and when:
+ *   GCC, TLMM, the SPMI arbiter's core/cnfg tables, the apps SMMU's global registers: always (these
+ *   blocks are on and clocked for the system itself: GCC/TLMM by every driver here, the arbiter by
+ *   sweet_spmi.c at each boot, the SMMU translates the panel's traffic and Linux reads the same
+ *   registers at probe);
+ *   camcc: only if GCC's camera AHB branch is running (CBCR bit 31 clear) -- a gated block aborts;
+ *   a Titan block's own registers (CPAS, CCI, CSID-lite, IFE-lite, CSIPHY): only if, in addition, the
+ *   titan_top GDSC reports PWR_ON and cpas_ahb plus the block's core clock are running;
+ *   PMIC regulator status: never at level 1 by default -- an SPMI observer read is an MMIO command
+ *   write to the arbiter (no PMIC state changes, but a write); boot-arg sweetcam_pmic=1 allows it.
+ */
+static const char *
+onoff(uint32_t cbcr)
+{
+	return (cbcr & CBCR_OFF) ? "off" : "on";
+}
+
+static void
+show_regulator(const char *name, unsigned sid, uint16_t base)
+{
+	uint8_t status = 0, enable = 0, vlo = 0, vhi = 0;
+	bool ok = spmi_read(sid, base + 0x08, &status) && spmi_read(sid, base + 0x46, &enable) && spmi_read(sid, base + 0x40, &vlo) &&
+	    spmi_read(sid, base + 0x41, &vhi);
+
+	say("rail %s (sid %u %#x): %s status %#04x enable %#04x set %u mV\n", name, sid, base, ok ? "read" : "NOT READABLE", status,
+	    enable, (unsigned)vhi << 8 | vlo);
+}
+
+static void
+show_apid(const char *name, unsigned sid, unsigned periph)
+{
+	unsigned owner = 7, apid = spmi_apid(sid, periph, &owner);
+
+	if (apid == 0xffff) {
+		say("SPMI %s (sid %u periph %#x): no APID\n", name, sid, periph);
+	} else {
+		say("SPMI %s (sid %u periph %#x): APID %u owner EE %u%s\n", name, sid, periph, apid, owner,
+		    owner == 0 ? " (apps: writable by us)" : " (NOT ours to write)");
+	}
+}
+
+/* A Titan block's version registers, only with everything it needs running. */
+static void
+titan_read(const char *name, vm_offset_t pa, uint32_t clock_cbcr, uint32_t off0, uint32_t off1, bool titan_ok, const char *why)
+{
+	vm_offset_t va;
+	uint32_t clk;
+
+	if (!titan_ok) {
+		say("titan: %s not read: %s\n", name, why);
+		return;
+	}
+	clk = rd(camcc + clock_cbcr);
+	if (clk & CBCR_OFF) {
+		say("titan: %s not read: its clock (camcc %#x = %#x) is off\n", name, clock_cbcr, clk);
+		return;
+	}
+	va = cam_map(pa, 0x4000);
+	if (va == 0) {
+		return;
+	}
+	say("titan: %s @%#lx: [%#x] %#x [%#x] %#x\n", name, (unsigned long)pa, off0, rd(va + off0), off1, rd(va + off1));
+}
+
+static void
+look_readonly(void)
+{
+	uint32_t ahb = rd(gcc + GCC_CAMERA_AHB_CBCR);
+
+	say("sweetcam=%u: the %s camera (%s); read-only look first (no writes, no votes)\n", level, hw->name, hw->chip);
+	say("GCC: camera_ahb %#x (%s) camera_xo %#x (%s) hf_axi %#x (%s) sf_axi %#x (%s)\n", ahb, onoff(ahb),
+	    rd(gcc + GCC_CAMERA_XO_CBCR), onoff(rd(gcc + GCC_CAMERA_XO_CBCR)), rd(gcc + GCC_CAMERA_HF_AXI_CBCR),
+	    onoff(rd(gcc + GCC_CAMERA_HF_AXI_CBCR)), rd(gcc + GCC_CAMERA_SF_AXI_CBCR), onoff(rd(gcc + GCC_CAMERA_SF_AXI_CBCR)));
+
+	/* camcc and the Titan blocks */
+	if (ahb & CBCR_OFF) {
+		say("camcc: not read: GCC camera_ahb is off (camcc aborts while it is gated; level 2 switches it on)\n");
+		say("titan: CPAS, CCI0/1, CSID-lite, IFE-lite, CSIPHY0-3 not read: camcc not readable\n");
+	} else {
+		uint32_t gdsc = rd(camcc + TITAN_TOP_GDSCR), cpas = rd(camcc + 0xc124);
+		bool titan_ok = (gdsc & GDSC_ON) && !(gdsc & GDSC_COLLAPSE) && !(cpas & CBCR_OFF);
+		const char *why = !(gdsc & GDSC_ON) || (gdsc & GDSC_COLLAPSE) ? "titan_top GDSC off" : "cpas_ahb off";
+
+		say("camcc: titan_top GDSC %#x (%s) gdsc_clk %#x (%s) cpas_ahb %#x (%s) camnoc_axi %#x (%s)\n", gdsc,
+		    (gdsc & GDSC_ON) ? "powered" : "collapsed", rd(camcc + CAMCC_GDSC_CBCR), onoff(rd(camcc + CAMCC_GDSC_CBCR)), cpas,
+		    onoff(cpas), rd(camcc + 0xc148), onoff(rd(camcc + 0xc148)));
+		say("camcc: PLL0 mode %#x L %#x user %#x opmode %#x (%s)\n", rd(camcc + PLL_MODE), rd(camcc + PLL_L_VAL),
+		    rd(camcc + PLL_USER_CTL), rd(camcc + PLL_OPMODE), (rd(camcc + PLL_MODE) & (1u << 31)) ? "locked" : "not locked");
+		for (unsigned i = 0; i < SENSORS; i++) {
+			const struct sensor_hw *s = &sensors[i];
+
+			say("camcc: %s: MCLK RCG %#x cfg %#x branch %#x (%s); CSIPHY%u %#x (%s) timer cfg %#x branch %#x (%s)\n", s->name,
+			    rd(camcc + s->mclk_cmd), rd(camcc + s->mclk_cmd + 4), rd(camcc + s->mclk_cbcr), onoff(rd(camcc + s->mclk_cbcr)),
+			    s->csiphy, rd(camcc + s->phy_cbcr), onoff(rd(camcc + s->phy_cbcr)), rd(camcc + s->timer_cmd + 4),
+			    rd(camcc + s->timer_cbcr), onoff(rd(camcc + s->timer_cbcr)));
+		}
+		say("camcc: ife_lite %#x (%s) ife_lite_csid %#x (%s) ife_lite_cphy_rx %#x (%s) cci0 %#x (%s) cci1 %#x (%s)\n",
+		    rd(camcc + 0xc01c), onoff(rd(camcc + 0xc01c)), rd(camcc + 0xc038), onoff(rd(camcc + 0xc038)), rd(camcc + 0xc040),
+		    onoff(rd(camcc + 0xc040)), rd(camcc + 0xc0dc), onoff(rd(camcc + 0xc0dc)), rd(camcc + 0xc0f8), onoff(rd(camcc + 0xc0f8)));
+		/* CPAS top: its own AHB is cpas_ahb (checked above) */
+		titan_read("CPAS top (hw version, titan version)", 0x0ac40000, 0xc124, 0x0, 0x4, titan_ok, why);
+		titan_read("CCI0 (hw version)", 0x0ac4a000, 0xc0dc, 0x0, 0x4, titan_ok, why);
+		titan_read("CCI1 (hw version)", 0x0ac4b000, 0xc0f8, 0x0, 0x4, titan_ok, why);
+		titan_read("CSID-lite 0 (hw version, rx cfg0)", CSID_PHYS, 0xc038, CSID_HW_VERSION, CSID_CSI2_RX_CFG0, titan_ok, why);
+		titan_read("IFE-lite 0 (hw version, bus version)", IFE_PHYS, 0xc01c, IFE_HW_VERSION, BUS_HW_VERSION, titan_ok, why);
+		for (unsigned n = 0; n < 4; n++) {
+			static const uint32_t phy_cbcr[4] = { 0x6020, 0x6044, 0x6068, 0x608c };
+			char name[48];
+
+			snprintf(name, sizeof(name), "CSIPHY%u (lane enable, ctrl)", n);
+			titan_read(name, CSIPHY_PHYS(n), phy_cbcr[n], 0x814, 0x800, titan_ok, why);
+		}
+	}
+
+	/* pins (TLMM is always readable) */
+	for (unsigned i = 0; i < SENSORS; i++) {
+		const struct sensor_hw *s = &sensors[i];
+		char what[32];
+
+		snprintf(what, sizeof(what), "%s MCLK", s->name);
+		show_pin(s->mclk_pin, what);
+		snprintf(what, sizeof(what), "%s CCI SDA", s->name);
+		show_pin(s->sda, what);
+		snprintf(what, sizeof(what), "%s CCI SCL", s->name);
+		show_pin(s->scl, what);
+		snprintf(what, sizeof(what), "%s reset", s->name);
+		show_pin(s->reset, what);
+		if (s->vdig_kind == VDIG_TLMM) {
+			snprintf(what, sizeof(what), "%s VDIG enable", s->name);
+			show_pin(s->vdig_gpio, what);
+		}
+	}
+
+	/* rails: who owns the PMIC peripherals (arbiter tables: reads); their state only with sweetcam_pmic=1 */
+	if (spmi_up()) {
+		say("SPMI: arbiter %#x, %u APIDs\n", rd(spmi_core), spmi_count);
+		show_apid("PM6150 L16 (VIO)", SID_PM6150, 0x4f);
+		show_apid("PM6150L L9 (CUSTOM)", SID_PM6150L, 0x48);
+		show_apid("PM6150L S8 (VDIG in)", SID_PM6150L, 0x29);
+		show_apid("PM6150L BOB (VANA)", SID_PM6150L, 0xa0);
+		show_apid("PM6150L GPIO3 (wide VDIG enable)", SID_PM6150L, PGPIO_PERIPH(3));
+		show_apid("PM6150L GPIO8 (tele VDIG enable)", SID_PM6150L, PGPIO_PERIPH(8));
+		if (pmic_reads) {
+			show_regulator("L16A (VIO)", SID_PM6150, 0x4f00);
+			show_regulator("L9C (CUSTOM)", SID_PM6150L, 0x4800);
+			show_regulator("S8C (VDIG in)", SID_PM6150L, 0x2900);
+			show_regulator("BOB (VANA)", SID_PM6150L, 0xa000);
+		} else {
+			say("rails: PMIC status not read (an SPMI observer read is a command write to the arbiter); sweetcam_pmic=1 reads it\n");
+		}
+	}
+
+	/* the sensor tables (a file read) */
+	for (unsigned i = 0; i < SENSORS; i++) {
+		if (ctab_load(sensors[i].tab)) {
+			ctab_free();
+		}
+	}
+	if (ctab_load("camera-imx582.tab")) {
+		ctab_free();
+	}
+
+	/* the apps SMMU, last: if a read here faulted, everything above is already in the log */
+	if (smmu == 0) {
+		smmu = cam_map(SMMU_PHYS, 0x1000);
+	}
+	if (smmu != 0) {
+		uint32_t idr0, idr1, smrs, used = 0, overlaps = 0;
+
+		say("SMMU: reading the global registers (a missing next line means the read faulted)\n");
+		idr0 = rd(smmu + SMMU_IDR0);
+		idr1 = rd(smmu + SMMU_IDR1);
+		smrs = idr0 & 0xff;
+		say("SMMU: SCR0 %#x IDR0 %#x IDR1 %#x: %u SMRs, %u contexts, %s pages\n", rd(smmu), idr0, idr1, smrs, idr1 & 0xff,
+		    idr1 >> 31 ? "64K" : "4K");
+		for (uint32_t n = 0; n < smrs && SMMU_SMR(n) < 0xc00; n++) {
+			uint32_t smr = rd(smmu + SMMU_SMR(n)), s2cr;
+
+			if (!(smr >> 31)) {
+				continue;
+			}
+			used++;
+			s2cr = rd(smmu + SMMU_S2CR(n));
+			say("SMMU: SMR %u stream %#x mask %#x -> S2CR %#x (type %u, context %u)\n", n, smr & 0x7fff, smr >> 16 & 0x7fff, s2cr,
+			    s2cr >> 16 & 3, s2cr & 0xff);
+			for (int g = 0; g < IFE_SMRS; g++) {
+				if ((((smr & 0x7fff) ^ ife_streams[g].stream) & ~((smr >> 16 & 0x7fff) | ife_streams[g].mask)) == 0) {
+					overlaps++;
+				}
+			}
+		}
+		say("SMMU: %u SMRs in use, %u free; %u overlap the IFE stream groups 0x900/0x460 0x880/0x460 0x820/0x440\n", used,
+		    smrs - used, overlaps);
+	}
+	say("look done: nothing was written\n");
+}
+
+static void
+camera_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	uint32_t secs = 20;
+	char which[16] = "";
+
+	(void)PE_parse_boot_argn("sweetcam_after", &secs, sizeof(secs));
+	if (level == 5) {
+		camdev_make();
+	}
+	if (PE_parse_boot_arg_str("sweetcam_sensor", which, sizeof(which))) {
+		static const char *const names[SENSORS] = { "wide", "tele", "front", "ultra" };
+
+		for (unsigned i = 0; i < SENSORS; i++) {
+			if (strcmp(which, names[i]) == 0) {
+				hw_index = i;
+			}
+		}
+	}
+	select_sensor(hw_index);
+	if (fake) {
+		say("sweetcam=5 sweetcam_fake=1: synthetic frames, nothing of the phone touched\n");
+		wait_ms(secs * 1000);   /* the sensor tables are files on the root file system: not there yet at boot */
+		serve_ios();
+		(void)thread_terminate(current_thread());
+		thread_block(THREAD_CONTINUE_NULL);
+		return;
+	}
+	wait_ms(secs * 1000);           /* the system up first */
+	gcc = cam_map(GCC_PHYS, 0x1f0000);
+	camcc = cam_map(CAMCC_PHYS, CAMCC_SIZE);
+	if (gcc == 0 || camcc == 0) {
+		say("cannot map GCC/camcc\n");
+	} else {
+		look_readonly();
+	}
+	/* sweetpopup=2: only the motor, up, 2 s, down; no camera power (to tell the motor from the sensor) */
+	if (popup_enabled && popup_probe_wanted && !broken) {
+		popup_probe();
+	}
+	if (popup_test && !broken) {
+		say("pop-up test: up\n");
+		(void)popup_move(true);
+		wait_ms(2000);
+		say("pop-up test: down\n");
+		(void)popup_move(false);
+		say("pop-up test: done\n");
+	}
+	/* level 1 stops here; everything below writes */
+	if (level >= 2 && !popup_test && gcc != 0 && camcc != 0 && !broken && gcc_camera_ahb()) {
+		find_pins();
+		if (level == 2) {
+			if (ctab_load(hw->tab) && power_up()) {
+				(void)read_chip_id();
+			}
+			power_down();
+		} else if (level == 3) {
+			capture_tpg();
+			power_down();           /* (the GDSC titan_up switched on) */
+		} else if (level == 4) {
+			capture_sensor();
+		} else if (level == 5) {
+			serve_ios();
+			power_down();
+		}
+	}
+	say("done\n");
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_camera_init(void)
+{
+	thread_t thread;
+	uint32_t v = 0;
+
+	if (!PE_parse_boot_argn("sweetcam", &level, sizeof(level)) || level == 0) {
+		return;
+	}
+	level = level > 5 ? 5 : level;
+	fake = level == 5 && PE_parse_boot_argn("sweetcam_fake", &v, sizeof(v)) && v != 0;
+	v = 1;
+	(void)PE_parse_boot_argn("sweetcam_rails", &v, sizeof(v));
+	use_rails = v != 0;
+	v = 0;
+	swap_i2c = PE_parse_boot_argn("sweetcam_swapi2c", &v, sizeof(v)) && v != 0;
+	v = 0;
+	pmic_reads = PE_parse_boot_argn("sweetcam_pmic", &v, sizeof(v)) && v != 0;
+	v = 0;
+	popup_enabled = level >= 2 && PE_parse_boot_argn("sweetpopup", &v, sizeof(v)) && v != 0;
+	popup_test = popup_enabled && v == 2;
+	popup_probe_wanted = popup_enabled && v == 3;
+	(void)PE_parse_boot_argn("sweetpopup_stop", &popup_stop, sizeof(popup_stop));
+	if (kernel_thread_start(camera_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/* Halt / restart / panic: whatever was switched on, off (call from sweet_halt_restart()). */
+void
+sweet_camera_quiesce(void)
+{
+	if (level < 2 || camcc == 0) {
+		return;                 /* (sweetcam=1 wrote nothing; nothing to put back) */
+	}
+	leaving = true;
+	broken = false;
+	use_rails = false;              /* no RPMh transactions on the way out (TCS state unknown at panic) */
+	csiphy_down();
+	paths_down();
+	smmu_down();
+	clocks_down();
+	pll0_down();
+	power_down();
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_dpu.c b/bsd/dev/sweet_dpu.c
new file mode 100644
index 0000000..9c5c803
--- /dev/null
+++ b/bsd/dev/sweet_dpu.c
@@ -0,0 +1,83 @@
+/*
+ * The display engine (MDSS MDP / "DPU", dt qcom,mdss_mdp@ae00000), step 1 of scanning iOS's frames
+ * out directly instead of copying them into the boot loader's framebuffer: what the boot loader
+ * left programmed, read and printed. Reads only.
+ *
+ * Block offsets from davinci's dt (qcom,sde-*-off); register layout from the vendor's SDE driver
+ * (drivers/gpu/drm/msm/sde: sde_hw_sspp.c, sde_hw_ctl.c, sde_hw_lm.c, sde_hw_pingpong.c,
+ * sde_hw_intf.c). Every block is printed as its non-zero words, so what is live stands out: the
+ * pipe that fetches the framebuffer (its address, stride, format, sizes), the mixer and control
+ * path it goes through, the pingpong's tear check and autorefresh (a command-mode panel), and the
+ * DSI interface. And VIG0's pixel extension and scaler (QSEED3 lite at +0xa00), which
+ * SweetFramebuffer.cpp's scalerOn sets up to fetch 1125x2436 and give the panel 1080x2340.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <machine/machine_routines.h>
+#include <mach/memory_object_types.h>
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, uint32_t);
+#ifndef VM_WIMG_IO
+#define VM_WIMG_IO 0x7u
+#endif
+
+void sweet_dpu_survey(void);
+
+#define MDP_PA    0x0ae00000u
+#define MDP_SIZE  0x90000u
+
+static const struct {
+	const char *name;
+	uint32_t off, len;
+} dpu_blocks[] = {
+	{ "top", 0x1000u, 0x460u },
+	{ "ctl0", 0x2000u, 0x100u }, { "ctl1", 0x2200u, 0x100u }, { "ctl2", 0x2400u, 0x100u },
+	{ "ctl3", 0x2600u, 0x100u }, { "ctl4", 0x2800u, 0x100u }, { "ctl5", 0x2a00u, 0x100u },
+	{ "vig0", 0x5000u, 0x80u }, { "vig0 pe", 0x5100u, 0x30u }, { "vig0 qseed", 0x5a00u, 0xa0u },
+	{ "vig1", 0x7000u, 0x80u },
+	{ "dma0", 0x25000u, 0x80u }, { "dma1", 0x27000u, 0x80u }, { "dma2", 0x29000u, 0x80u },
+	{ "lm0", 0x45000u, 0x60u }, { "lm1", 0x46000u, 0x60u }, { "lm2", 0x47000u, 0x60u }, { "lm3", 0x48000u, 0x60u },
+	{ "intf1(dsi)", 0x6b800u, 0x2c0u }, { "intf2(dsi)", 0x6c000u, 0x2c0u },
+	{ "pp0", 0x71000u, 0x40u }, { "pp1", 0x71800u, 0x40u }, { "pp2", 0x72000u, 0x40u }, { "pp3", 0x72800u, 0x40u },
+};
+
+void
+sweet_dpu_survey(void)
+{
+	static bool done;
+	vm_offset_t mdp;
+	unsigned b;
+	if (done) {
+		return;
+	}
+	done = true;
+	mdp = ml_io_map_unmappable(MDP_PA, MDP_SIZE, VM_WIMG_IO);
+	if (!mdp) {
+		printf("SWEET DPU: cannot map the MDP\n");
+		return;
+	}
+	printf("SWEET DPU: [1] the display engine as the boot loader left it (non-zero words; reads only)\n");
+	for (b = 0; b < sizeof(dpu_blocks) / sizeof(dpu_blocks[0]); b++) {
+		char line[320];
+		int at = 0;
+		unsigned nz = 0;
+		for (uint32_t o = 0; o < dpu_blocks[b].len; o += 4u) {
+			uint32_t v = *(volatile uint32_t *)(mdp + dpu_blocks[b].off + o);
+			if (v == 0) {
+				continue;
+			}
+			nz++;
+			if (at > (int)sizeof(line) - 24) {
+				printf("SWEET DPU: %s:%s\n", dpu_blocks[b].name, line);
+				at = 0;
+			}
+			at += snprintf(line + at, sizeof(line) - (size_t)at, " %03x=%x", o, v);
+		}
+		if (nz) {
+			printf("SWEET DPU: %s:%s\n", dpu_blocks[b].name, line);
+		}
+	}
+	printf("SWEET DPU: [1] done\n");
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
new file mode 100644
index 0000000..ecdbefe
--- /dev/null
+++ b/bsd/dev/sweet_gpu.c
@@ -0,0 +1,10126 @@
+/*
+ * SWEET Adreno 618 (davinci / SM7150 / sdmmagpie) bring-up - Phase 0 / 0.5.
+ * Call once after the scheduler is running; all work runs on one thread.
+ *
+ * LESSON (first boot, sweetgpu=1): a pure read of GPUCC/CX-misc HARD-FAULTS
+ * (external abort -> panic -> reset), because those blocks are clock-gated by
+ * gcc_gpu_cfg_ahb_clk which ABL leaves OFF under XNU - a gated register block
+ * aborts, it does not return 0xffffffff. So Phase 0 must first enable the GPU
+ * AHB/config clocks via GCC (always-accessible, clocks every live peripheral)
+ * BEFORE touching the GPU clock-controller window.
+ *
+ * Phase 0 (sweetgpu=1): read GCC GPU clock status (safe), enable the GPU
+ * config/AHB/NoC clocks, then read GPUCC offset 0 to prove MMIO reach. Does
+ * NOT touch the GPU CORE (0x5000000, GX domain, GMU-gated), votes no GX rail,
+ * loads no firmware. The QFPROM fuse block is NOT read (access-controlled).
+ *
+ * Phase 0.5 (sweetgpu=2): additionally one read-only TrustZone query,
+ * PAS_IS_SUPPORTED(pas-id 13) - "does TZ expose the GPU zap PAS service".
+ * No memory setup / image load / reset. An unrecognised SMC returns SMCCC
+ * NOT_SUPPORTED (x0=-1), it does not hang. See trustzone-pas-feasibility.md.
+ *
+ * Addresses from davinci-p-oss (gcc-sdmmagpie.c, sdmmagpie-gpu.dtsi):
+ *   GCC base 0x100000; gpu branches (offset within GCC): cfg_ahb 0x71004,
+ *   memnoc_gfx 0x7100c, snoc_dvm_gfx 0x71018, ddrss_gpu_axi 0x4452c (BIT0);
+ *   GPUCC 0x5090000/0x9000, chipid 0x06010800 (a618).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <kern/locks.h>
+#include <sys/vnode.h>
+#include <sys/uio.h>
+extern vnode_t rootvnode;
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <mach/memory_object_types.h>   /* MAP_MEM_WCOMB, memory_object_size_t/offset_t */
+#include <mach/vm_prot.h>
+#include <mach/vm_inherit.h>
+#include <mach/vm_statistics.h>         /* VM_FLAGS_ANYWHERE */
+#include <mach/vm_types.h>
+#include <sys/conf.h>
+#include <miscfs/devfs/devfs.h>
+#include "a618_gmu_fw.h"
+#include "a615_zap_fw.h"
+#include "a630_sqe_fw.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t, vm_size_t);   /* write-combine (framebuffer) */
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, uint32_t);
+/*
+ * Every mapping of this file goes into kernel_map, not io_submap. io_submap is 8 MB in all and
+ * what ml_io_map() puts there is KMA_PERMANENT: the GPU's 256 KB core window three times, the ring,
+ * render targets, SPMI windows at each reboot request, a 16 KB page more for every four page tables
+ * the GPU's address space grows (gpu_pt_table), the 2 MB shared memory area of the Wi-Fi survey --
+ * and when it was full, an unlock that grew the GPU's tables panicked in io_map:
+ * "kmem_alloc(io_submap, 16384, 0x100021 = PERMANENT|PAGEABLE|NOFAIL): failed with 3 (NO_SPACE)".
+ * ml_io_map_unmappable() is the same mapping (same memory type) from kernel_map, as HackiOS maps
+ * its shared memory (redwood_wifi.c smem_peek).
+ */
+#ifndef VM_WIMG_IO
+#define VM_WIMG_IO                0x7u   /* arm/memory_types.h: COHERENT | NOT_CACHEABLE | GUARDED */
+#endif
+#ifndef VM_WIMG_WCOMB
+#define VM_WIMG_WCOMB             0x6u   /* NOT_CACHEABLE | COHERENT */
+#endif
+#define ml_io_map(pa, size)       ml_io_map_unmappable((vm_offset_t)(pa), (vm_size_t)(size), VM_WIMG_IO)
+#define ml_io_map_wcomb(pa, size) ml_io_map_unmappable((vm_offset_t)(pa), (vm_size_t)(size), VM_WIMG_WCOMB)
+extern kern_return_t thread_terminate(thread_t);
+void sweet_gpu_init(void);
+
+#define GPU_GCC_PA       0x00100000u
+#define GPU_GCC_SIZE     0x001f0000u   /* qcom_cc_map max_register ~0x1820b0 */
+#define GPU_GPUCC_PA     0x05090000u
+#define GPU_GPUCC_SIZE   0x9000u
+
+/* GCC GPU clock branch registers (offset within the GCC window). Enable = set
+ * BIT(0); the low bit of halt status (readback) reads 0 when the branch runs. */
+#define GCC_GPU_CFG_AHB_CLK    0x71004u
+#define GCC_GPU_MEMNOC_GFX_CLK 0x7100cu
+#define GCC_GPU_SNOC_DVM_CLK   0x71018u
+#define GCC_DDRSS_GPU_AXI_CLK  0x4452cu
+#define GCC_BRANCH_ENABLE      0x1u
+
+/* Registers WITHIN the GPUCC window (base 0x5090000), from gpucc-sdmmagpie.c:
+ * gpu_gx_gdsc 0x509100c, gpu_cx_gdsc 0x509106c, cx_gmu_clk 0x1098, cxo 0x109c.
+ * GDSCR bit 31 = PWR_ON. */
+#define GPUCC_GX_GDSCR   0x100cu
+#define GPUCC_CX_GDSCR   0x106cu
+#define GPUCC_CX_GMU_CLK 0x1098u
+#define GPUCC_CXO_CLK    0x109cu
+
+#define GPU_DT_CHIPID    0x06010800u
+
+/* Qualcomm SCM PAS: id = ARM_SMCCC_CALL_VAL(FAST,SMC64,SIP=2,fnid(svc2,cmd7)). */
+#define QCOM_SCM_PAS_IS_SUPPORTED_FNID  0xC2000207ull
+#define QCOM_GPU_PAS_ID                 13u
+/* TZ-mediated MMIO access (SVC_IO 0x05): EL3 performs the store, sitting above
+ * the XPU that blocks our EL1 write to the SPMI arbiter chnls region. Fast SMC64,
+ * SIP. io_writel(addr,val): x1=2,x2=addr,x3=val; io_readl(addr): x1=1,x2=addr,
+ * value in out[1]. (mainline qcom_scm_io_writel/readl.) */
+#define QCOM_SCM_IO_WRITE_FNID          0xC2000502ull
+#define QCOM_SCM_IO_READ_FNID           0xC2000501ull
+
+/* Dev-loop helper: reboot straight back to fastboot. davinci qcom,msm-imem is
+ * at 0x146aa000; restart_reason is at +0x65c; ABL enters fastboot when it reads
+ * FASTBOOT_MODE (0x77665500) there. Then PSCI SYSTEM_RESET (0x84000009). */
+#define IMEM_PA                 0x146aa000u
+#define IMEM_SIZE               0x1000u
+#define IMEM_RESTART_REASON_OFF 0x65cu
+#define RESTART_REASON_FASTBOOT 0x77665500u
+#define PSCI_SYSTEM_RESET       0x84000009ull
+/* qcom,pshold: writing 0 drops the PS_HOLD line -> HW reset that PRESERVES IMEM
+ * (PSCI SYSTEM_RESET cleared it, so the cookie was lost). From sdmmagpie.dtsi. */
+#define PSHOLD_PA               0x0c264000u
+
+/* GPUCC extras for the GMU power step: ahb branch + GDSC bits. */
+#define GPUCC_AHB_CLK      0x1078u
+#define GDSC_SW_COLLAPSE   0x1u          /* bit0: 1 = collapsed/off */
+#define GDSC_PWR_ON        0x80000000u   /* bit31: 1 = powered on */
+
+/* GMU register window (0x506a000). a6xx GMU regs are dword INDICES; byte offset
+ * within this window = (index<<2) - 0x6a000 (a6xx_regs.h / a6xx_gmu.h). The GMU
+ * is in the CX domain, so these are reachable once the CX GDSC + GMU clocks are
+ * on (gmu step 1). CM3_FW_INIT_RESULT == 0xBABEFACE only AFTER fw boots. */
+#define A6XX_GMU_PA            0x0506a000u
+#define A6XX_GMU_SIZE          0x31000u
+#define GMU_BOFF(idx)         ((uint32_t)(((idx) << 2) - 0x6a000u))
+#define GMU_CM3_SYSRESET       0x1F800u
+#define GMU_CX_GMU_WFI_CONFIG  0x1F802u
+#define GMU_CM3_FW_INIT_RESULT 0x1F81Cu
+#define GMU_HFI_CTRL_STATUS    0x1F980u
+#define GMU_GENERAL_0          0x1F9C5u
+
+static vm_offset_t gpu_gcc, gpu_gpucc;
+static bool gpu_started;
+static int gpu_level;
+
+static uint32_t
+gpu_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+gpu_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dmb oshst" ::: "memory");
+}
+
+/* One SMC64 to the resident TZ; mirrors sweet_psci_cpu_on's conduit (0065). */
+static void
+gpu_smc(uint64_t a0, uint64_t a1, uint64_t a2, uint64_t a3,
+    uint64_t a4, uint64_t a5, uint64_t a6, uint64_t out[4])
+{
+	register uint64_t x0 __asm__("x0") = a0;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = a3;
+	register uint64_t x4 __asm__("x4") = a4;
+	register uint64_t x5 __asm__("x5") = a5;
+	register uint64_t x6 __asm__("x6") = a6;
+	__asm__ volatile("smc #0"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3)
+	    : "r"(x4), "r"(x5), "r"(x6)
+	    : "memory", "x7", "x8", "x9", "x10", "x11", "x12",
+	      "x13", "x14", "x15", "x16", "x17");
+	out[0] = x0;
+	out[1] = x1;
+	out[2] = x2;
+	out[3] = x3;
+}
+
+static void
+gpu_tz_probe(void)
+{
+	uint64_t r[4] = {0, 0, 0, 0};
+	gpu_smc(QCOM_SCM_PAS_IS_SUPPORTED_FNID, 1u, QCOM_GPU_PAS_ID, 0, 0, 0, 0, r);
+	printf("SWEET GPU: PAS_IS_SUPPORTED(13) -> x0=%#llx x1=%#llx\n", r[0], r[1]);
+	if (r[0] == 0 && r[1] == 1) {
+		printf("SWEET GPU: TrustZone PAS ALIVE + GPU zap supported (blocker #2 tractable).\n");
+	} else if (r[0] == 0xffffffffull) {
+		printf("SWEET GPU: SMC not recognised; resident TZ exposes no SIP PAS to XNU.\n");
+	} else {
+		printf("SWEET GPU: PAS query status %#llx (check SCM arg convention).\n", r[0]);
+	}
+}
+
+/* GMU bring-up step 1 (sweetgpu>=4): power on the CX GDSC and start the GMU
+ * clocks. All ops are inside the reachable GPUCC window (no GMU-window access
+ * yet). The cold-state probe showed CX GDSC off + GMU clocks halted; this is
+ * the prerequisite for loading GMU firmware. If PWR_ON never asserts, the CX
+ * rail likely needs an RPMh vote (sweet_rpmh.c) as the next step. */
+static void
+gpu_gmu_step1(void)
+{
+	uint32_t v = gpu_rd(gpu_gpucc, GPUCC_CX_GDSCR);
+	gpu_wr(gpu_gpucc, GPUCC_CX_GDSCR, v & ~GDSC_SW_COLLAPSE); /* de-collapse */
+	unsigned i;
+	for (i = 0; i < 2000u; i++) {
+		if (gpu_rd(gpu_gpucc, GPUCC_CX_GDSCR) & GDSC_PWR_ON) {
+			break;
+		}
+		delay_for_interval(10, NSEC_PER_USEC);
+	}
+	uint32_t cx = gpu_rd(gpu_gpucc, GPUCC_CX_GDSCR);
+	printf("SWEET GPU: CX GDSC enable -> %#x pwr_on=%d (polls=%u)\n",
+	    cx, (cx >> 31) & 1u, i);
+	gpu_wr(gpu_gpucc, GPUCC_CX_GMU_CLK,
+	    gpu_rd(gpu_gpucc, GPUCC_CX_GMU_CLK) | GCC_BRANCH_ENABLE);
+	gpu_wr(gpu_gpucc, GPUCC_CXO_CLK,
+	    gpu_rd(gpu_gpucc, GPUCC_CXO_CLK) | GCC_BRANCH_ENABLE);
+	gpu_wr(gpu_gpucc, GPUCC_AHB_CLK,
+	    gpu_rd(gpu_gpucc, GPUCC_AHB_CLK) | GCC_BRANCH_ENABLE);
+	delay_for_interval(100, NSEC_PER_USEC);
+	printf("SWEET GPU: GMU clks -> cx_gmu=%#x cxo=%#x ahb=%#x\n",
+	    gpu_rd(gpu_gpucc, GPUCC_CX_GMU_CLK), gpu_rd(gpu_gpucc, GPUCC_CXO_CLK),
+	    gpu_rd(gpu_gpucc, GPUCC_AHB_CLK));
+}
+
+/* GMU bring-up step 2 (sweetgpu>=5): now that the CX domain is powered and the
+ * GMU clocks run, map the GMU register window and read its core/AO registers.
+ * Reads only - proves the GMU window is reachable and shows the pre-boot state
+ * (CM3 held in reset, FW_INIT_RESULT not yet 0xBABEFACE) before we load fw. */
+static vm_offset_t gpu_gmu;
+static void
+gpu_gmu_step2(void)
+{
+	gpu_gmu = ml_io_map(A6XX_GMU_PA, A6XX_GMU_SIZE);
+	if (!gpu_gmu) {
+		printf("SWEET GPU: GMU window map failed\n");
+		return;
+	}
+	uint32_t sysreset = gpu_rd(gpu_gmu, GMU_BOFF(GMU_CM3_SYSRESET));
+	uint32_t fwinit = gpu_rd(gpu_gmu, GMU_BOFF(GMU_CM3_FW_INIT_RESULT));
+	uint32_t hfi = gpu_rd(gpu_gmu, GMU_BOFF(GMU_HFI_CTRL_STATUS));
+	uint32_t gen0 = gpu_rd(gpu_gmu, GMU_BOFF(GMU_GENERAL_0));
+	uint32_t wfi = gpu_rd(gpu_gmu, GMU_BOFF(GMU_CX_GMU_WFI_CONFIG));
+	printf("SWEET GPU: GMU window reachable: cm3_sysreset=%#x fw_init=%#x "
+	    "hfi_ctrl=%#x general0=%#x wfi_cfg=%#x\n",
+	    sysreset, fwinit, hfi, gen0, wfi);
+	if (fwinit == 0xBABEFACEu) {
+		printf("SWEET GPU: GMU fw already booted?! (0xBABEFACE)\n");
+	}
+}
+
+/* ======================================================================== *
+ *  STANDALONE COMPILE HARNESS - compiled out when pasted into sweet_gpu.c.
+ *  Define GMU_BOOT_STANDALONE_TEST only for the gcc-aarch64 syntax check.
+ * ======================================================================== */
+#ifdef GMU_BOOT_STANDALONE_TEST
+#include <stdint.h>
+typedef unsigned long vm_offset_t;
+typedef unsigned long vm_size_t;
+typedef unsigned long vm_map_t;
+typedef unsigned long pmap_t;
+typedef unsigned long long addr64_t;
+typedef unsigned int ppnum_t;
+typedef int kern_return_t;
+#define KERN_SUCCESS 0
+#define PAGE_MASK 0x3fffUL           /* 16 KiB pages on arm64 XNU */
+#define PAGE_SIZE 0x4000UL
+#define KMA_DATA 0
+#define KMA_ZERO 0
+#define KMA_PERMANENT 0
+#define VM_KERN_MEMORY_IOKIT 0
+#define NSEC_PER_USEC 1000ULL
+static vm_offset_t gpu_gmu, gpu_gpucc;
+static unsigned char a618_gmu_fw[32768];
+#define A618_GMU_FW_LEN 32768u
+extern int printf(const char *, ...);
+static vm_map_t kernel_map; static pmap_t kernel_pmap;
+static uint32_t gpu_rd(vm_offset_t b, uint32_t o){ return *(volatile uint32_t*)(b+o); }
+static void gpu_wr(vm_offset_t b, uint32_t o, uint32_t v){ *(volatile uint32_t*)(b+o)=v; }
+#define GMU_BOFF(idx) ((uint32_t)(((idx)<<2) - 0x6a000u))
+static vm_offset_t ml_io_map(vm_offset_t p, vm_size_t s){ (void)s; return (vm_offset_t)p; }
+static void delay_for_interval(unsigned i, unsigned long long s){ (void)i; (void)s; }
+static kern_return_t kmem_alloc_contig(vm_map_t m, vm_offset_t *a, vm_size_t sz,
+    vm_offset_t mask, ppnum_t maxp, ppnum_t pmask, int flags, int tag)
+{ (void)m;(void)sz;(void)mask;(void)maxp;(void)pmask;(void)flags;(void)tag; *a=0x1000; return KERN_SUCCESS; }
+static ppnum_t pmap_find_phys(pmap_t pm, addr64_t va){ (void)pm; return (ppnum_t)(va>>14); }
+static uint64_t ptoa_64(ppnum_t p){ return (uint64_t)p << 14; }
+#else
+/* In sweet_gpu.c: pmap_find_phys is extern'd as in sweet_ufs.c; kmem_alloc_contig,
+ * kernel_map, kernel_pmap, ptoa_64, KMA_*, VM_KERN_MEMORY_IOKIT, PAGE_MASK come
+ * from the XNU build headers already pulled in by the sweet drivers. */
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+#endif
+
+/* ============================== constants ============================== */
+/* GMU/RSCC register indices (via GMU_BOFF) [a6xx_regs.h / davinci a6xx_reg.h] */
+#define GMUB_CM3_ITCM_START       0x1B400u
+#define GMUB_ICACHE_CONFIG        0x1F400u
+#define GMUB_DCACHE_CONFIG        0x1F401u
+#define GMUB_CM3_SYSRESET         0x1F800u
