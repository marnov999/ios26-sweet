+/* GENERATED from davinci-ios/battery/port by "make kernel-files" - edit the port, not this */
+/*
+ * qg_softfloat.h - integer-only IEEE-754 binary32/binary64 arithmetic with the
+ * exact semantics of AArch64 (FPCR = 0: round-to-nearest-even, no flush-to-zero,
+ * no default-NaN mode) plus a bit-exact port of bionic libm exp() (Android 11
+ * arm64, ARM optimized-routines, EXP_TABLE_BITS = 7, FMA-contracted).
+ *
+ * Purpose: the MIUI QG daemon (hvdcp_opti) computes its battery model in float.
+ * The XNU kernel may not use FP/SIMD (-mkernel), so qg_algo.c performs every
+ * daemon FP operation through these functions, in the daemon's own operation
+ * order, which reproduces its results bit for bit.
+ *
+ * Values are carried as raw bit patterns (uint32_t / uint64_t).
+ */
+#ifndef QG_SOFTFLOAT_H
+#define QG_SOFTFLOAT_H
+
+#include <stdint.h>
+
+typedef uint32_t f32;
+typedef uint64_t f64;
+
+/* binary64 */
+f64 f64_add(f64 a, f64 b);
+f64 f64_sub(f64 a, f64 b);
+f64 f64_mul(f64 a, f64 b);
+f64 f64_div(f64 a, f64 b);
+f64 f64_fma(f64 a, f64 b, f64 c);      /* a*b + c, single rounding (FMADD d,a,b,c) */
+f64 f64_rinta(f64 a);                  /* FRINTA: round to integral, ties away */
+int64_t f64_to_i64_rna(f64 a);         /* FCVTAS x, d */
+f64 f64_from_i32(int32_t v);           /* SCVTF d, w (exact) */
+
+/* binary32 (each is a single correctly rounded operation, like FADD s etc.) */
+f32 f32_add(f32 a, f32 b);
+f32 f32_sub(f32 a, f32 b);
+f32 f32_mul(f32 a, f32 b);
+f32 f32_div(f32 a, f32 b);
+f32 f32_min(f32 a, f32 b);             /* FMIN s */
+f32 f32_max(f32 a, f32 b);             /* FMAX s */
+f32 f32_from_i32(int32_t v);           /* SCVTF s, w */
+int32_t f32_to_i32_rz(f32 a);          /* FCVTZS w, s (saturating, NaN -> 0) */
+
+f64 f32_to_f64(f32 a);                 /* FCVT d, s (exact) */
+f32 f64_to_f32(f64 a);                 /* FCVT s, d (RNE) */
+
+/* FCMP result as AArch64 NZCV, and the condition codes the daemon uses */
+#define SF_N 8
+#define SF_Z 4
+#define SF_C 2
+#define SF_V 1
+unsigned f32_cmp(f32 a, f32 b);        /* FCMP s, s  (or s, #0.0 with b = 0) */
+unsigned f64_cmp(f64 a, f64 b);        /* FCMP d, d */
+static inline int sf_mi(unsigned f) { return (f & SF_N) != 0; }
+static inline int sf_pl(unsigned f) { return (f & SF_N) == 0; }
+static inline int sf_gt(unsigned f) { return !(f & SF_Z) && (!!(f & SF_N) == !!(f & SF_V)); }
+static inline int sf_le(unsigned f) { return (f & SF_Z) || (!!(f & SF_N) != !!(f & SF_V)); }
+static inline int sf_ge(unsigned f) { return !!(f & SF_N) == !!(f & SF_V); }
+static inline int sf_lt(unsigned f) { return !!(f & SF_N) != !!(f & SF_V); }
+static inline int sf_eq(unsigned f) { return (f & SF_Z) != 0; }
+
+/* bionic libm exp() (arm64, Android 11), bit exact */
+f64 sf_exp(f64 x);
+
+/* constants used by the daemon (bit patterns) */
+#define F32_0      0x00000000u
+#define F32_1      0x3f800000u
+#define F32_2      0x40000000u
+#define F32_M10    0xc1200000u
+#define F32_100    0x42c80000u
+#define F32_200    0x43480000u
+#define F32_1000   0x447a0000u
+#define F32_M1000  0xc47a0000u
+#define F32_3600   0x45610000u
+#define F32_10000  0x461c4000u
+#define F32_M10000 0xc61c4000u
+#define F32_20000  0x469c4000u
+#define F32_1E6    0x49742400u
+#define F32_0_35   0x3eb33333u
+#define F32_10     0x41200000u
+#define F64_1      0x3ff0000000000000ull
+#define F64_M0_005 0xbf747ae147ae147bull
+#define F64_0_005  0x3f747ae147ae147bull
+
+#endif
