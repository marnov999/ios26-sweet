+/*
+ * Back from a powered-off panel, dsi_panel_power_on and dsi_panel_enable's order: the supply (L18A)
+ * on, the reset sequence (qcom,mdss-dsi-reset-sequence <0 1 1 10> on PM6150L GPIO 9), the on
+ * commands with their waits (sleep out, the panel's set-up, display on), then the display engine's
+ * refresh as it was (panel_dcs_cmd 0x29 with refresh back).
+ */
+static int
+panel_power_up(void)
+{
+	int bad = 0, sent = 0;
+	printf("SWEET PANEL: vdda (L18A) vote on -> %d\n", sweet_rpmh_vreg_vote("ldoa18", 3000, true));
+	gmub_udelay(10000);
+	/* qcom,mdss-dsi-reset-sequence <0 1 1 10>: low 1 ms, high, 10 ms */
+	panel_reset_line(false);
+	gmub_udelay(1000);
+	panel_reset_line(true);
+	gmub_udelay(10000);
+	for (unsigned j = 0; j + 7 <= sizeof(panel_on_commands);) {
+		const uint8_t *c = &panel_on_commands[j];
+		unsigned n = ((unsigned)c[5] << 8) | c[6];
+		if (j + 7 + n > sizeof(panel_on_commands)) {
+			break;
+		}
+		if (panel_dsi_packet(c[0], c + 7, n, true) != 0) {
+			bad++;
+		}
+		sent++;
+		if (c[4]) {
+			gmub_udelay((uint32_t)c[4] * 1000u);
+		}
+		j += 7 + n;
+	}
+	int on = panel_dcs_cmd(0x29, true);          /* display on; the refresh comes back with the first frame */
+	printf("SWEET PANEL: on-commands %d sent, %d failed; display on %d\n", sent, bad, on);
+	return bad ? -bad : on;
+}
+
+static int
+panel_dcs_brightness(uint32_t level)
+{
+	static vm_offset_t dsi;
+	static bool told;
+	uint32_t ctrl, reg, i, done = 0;
+	if (!dsi && !(dsi = ml_io_map(DSI0_PA, 0x400u))) {
+		return -1;
+	}
+	if (level > 0x7FFu) {
+		level = 0x7FFu;
+	}
+	ctrl = gpu_rd(dsi, DSI_CTRL_R);
+	if (!told) {
+		told = true;
+		printf("SWEET PANEL: DSI0 ctrl %#x status %#x cmd_dma_ctrl %#x int_ctrl %#x\n", ctrl, gpu_rd(dsi, DSI_STATUS_R),
+		    gpu_rd(dsi, DSI_CMD_DMA_CTRL_R), gpu_rd(dsi, DSI_INT_CTRL_R));
+	}
+	if (!(ctrl & 1u)) {
+		return -2;                              /* the controller is off */
+	}
+	/*
+	 * Not while the display engine streams a frame: it refreshes the panel by itself at every TE
+	 * (INTF1 tear check, autorefresh), and a command put in between -- the busy bit was clear, the
+	 * next frame began -- never finished ("NO DMA DONE") and left the link wedged: no frame reached
+	 * the panel again, every flip waited out its timeout, the screen stood still. As the vendor's
+	 * driver does: autorefresh off, the frame in flight finished, the command, autorefresh as it was.
+	 */
+	static vm_offset_t intf;
+	uint32_t autorefresh = 0;
+	if (!intf) {
+		intf = ml_io_map(0x0ae6b000u, 0x1000u);
+	}
+	if (intf) {
+		autorefresh = gpu_rd(intf, 0x800u + 0x2B4u);          /* INTF1 INTF_TEAR_AUTOREFRESH_CONFIG */
+		if (autorefresh & (1u << 31)) {
+			gpu_wr(intf, 0x800u + 0x2B4u, 0u);
+			__asm__ volatile("dsb sy" ::: "memory");
+		}
+	}
+	for (i = 0; i < 40000u && (gpu_rd(dsi, DSI_STATUS_R) & (1u << 2)); i++) {   /* CMD_MODE_MDP_BUSY: up to 40 ms */
+		gmub_udelay(1);
+	}
+	uint32_t idle_us = i;
+	gpu_wr(dsi, DSI_TPG_CTRL_R, (1u << 1) | (1u << 2) | (3u << 16));   /* CMD_DMA_TPG_EN, FIFO mode, custom pattern */
+	/* the packet as dsi_ctrl_copy_and_pad_cmd makes it: header {wc lo, wc hi, type, flags}, payload padded with 0xff;
+	 * DCS long write (0x39), 3 bytes; flags: last command (bit 7), long packet (bit 6) */
+	gpu_wr(dsi, DSI_TPG_DMA_INIT_R, 0x03u | 0x00u << 8 | 0x39u << 16 | 0xC0u << 24);
+	gpu_wr(dsi, DSI_TPG_DMA_INIT_R, 0x51u | (level >> 8) << 8 | (level & 0xFFu) << 16 | 0xFFu << 24);
+	reg = gpu_rd(dsi, DSI_CMD_DMA_CTRL_R);
+	reg &= ~((1u << 31) | (1u << 30));            /* not broadcast, not a master of two */
+	reg |= 1u << 28;                              /* embedded mode */
+	gpu_wr(dsi, DSI_CMD_DMA_CTRL_R, reg);
+	gpu_wr(dsi, DSI_DMA_CMD_LENGTH_R, 8u);
+	__asm__ volatile("dsb sy" ::: "memory");
+	gpu_wr(dsi, DSI_DMA_SW_TRIGGER_R, 1u);
+	for (i = 0; i < 20000u; i++) {                /* CMD_MODE_DMA_DONE: status bit 0 of INT_CTRL */
+		if ((done = gpu_rd(dsi, DSI_INT_CTRL_R)) & 1u) {
+			break;
+		}
+		gmub_udelay(1);
+	}
+	if (done & 1u) {
+		gpu_wr(dsi, DSI_INT_CTRL_R, done);       /* (status bits are cleared by writing them) */
+	}
+	gpu_wr(dsi, DSI_TPG_CTRL_R, 0u);
+	gpu_wr(dsi, DSI_TPG_FIFO_RESET_R, 1u);
+	gmub_udelay(1);
+	gpu_wr(dsi, DSI_TPG_FIFO_RESET_R, 0u);
+	if (intf && (autorefresh & (1u << 31))) {
+		__asm__ volatile("dsb sy" ::: "memory");
+		gpu_wr(intf, 0x800u + 0x2B4u, autorefresh);          /* autorefresh again, from the next TE */
+	}
+	printf("SWEET PANEL: brightness %u: %s (mdp idle after %u us)\n", level, (done & 1u) ? "sent" : "NO DMA DONE", idle_us);
+	return (done & 1u) ? 0 : -3;
+}
+
+/*
+ * One DCS short write without parameter (display off/on, sleep in/out), the way panel_dcs_brightness()
+ * sends its long write: refresh paused, the frame in flight finished, the packet through the test
+ * pattern FIFO. refresh_stays_off: the INTF1 autorefresh is left off (kept in g_panel_refresh) -- the
+ * panel sleeps; otherwise the one kept before is put back.
+ */
+static int
+panel_dcs_cmd(uint8_t cmd, bool refresh_stays_off)
+{
+	static vm_offset_t dsi, intf;
+	uint32_t reg, i, done = 0, ar;
+	if (!dsi && !(dsi = ml_io_map(DSI0_PA, 0x400u))) {
+		return -1;
+	}
+	if (!intf && !(intf = ml_io_map(0x0ae6b000u, 0x1000u))) {
+		return -1;
+	}
+	if (!(gpu_rd(dsi, DSI_CTRL_R) & 1u)) {
+		return -2;                              /* the controller is off */
+	}
+	ar = gpu_rd(intf, 0x800u + 0x2B4u);             /* INTF1 INTF_TEAR_AUTOREFRESH_CONFIG */
+	if (ar & (1u << 31)) {
+		if (g_panel_refresh == ~0u) {
+			g_panel_refresh = ar;
+		}
+		gpu_wr(intf, 0x800u + 0x2B4u, 0u);
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	for (i = 0; i < 40000u && (gpu_rd(dsi, DSI_STATUS_R) & (1u << 2)); i++) {   /* CMD_MODE_MDP_BUSY */
+		gmub_udelay(1);
+	}
+	gpu_wr(dsi, DSI_TPG_CTRL_R, (1u << 1) | (1u << 2) | (3u << 16));
+	/* header {data 0 = the command, data 1 = 0, type 0x05 DCS short write, flags: last command} */
+	gpu_wr(dsi, DSI_TPG_DMA_INIT_R, (uint32_t)cmd | 0x05u << 16 | 0x80u << 24);
+	reg = gpu_rd(dsi, DSI_CMD_DMA_CTRL_R);
+	reg &= ~((1u << 31) | (1u << 30));
+	reg |= 1u << 28;
+	gpu_wr(dsi, DSI_CMD_DMA_CTRL_R, reg);
+	gpu_wr(dsi, DSI_DMA_CMD_LENGTH_R, 4u);
+	__asm__ volatile("dsb sy" ::: "memory");
+	gpu_wr(dsi, DSI_DMA_SW_TRIGGER_R, 1u);
+	for (i = 0; i < 20000u; i++) {
+		if ((done = gpu_rd(dsi, DSI_INT_CTRL_R)) & 1u) {
+			break;
+		}
+		gmub_udelay(1);
+	}
+	if (done & 1u) {
+		gpu_wr(dsi, DSI_INT_CTRL_R, done);
+	}
+	gpu_wr(dsi, DSI_TPG_CTRL_R, 0u);
+	gpu_wr(dsi, DSI_TPG_FIFO_RESET_R, 1u);
+	gmub_udelay(1);
+	gpu_wr(dsi, DSI_TPG_FIFO_RESET_R, 0u);
+	if (!refresh_stays_off && g_panel_refresh != ~0u) {
+		__asm__ volatile("dsb sy" ::: "memory");
+		gpu_wr(intf, 0x800u + 0x2B4u, g_panel_refresh);
+		g_panel_refresh = ~0u;
+	}
+	return (done & 1u) ? 0 : -3;
+}
+static void
+thermal_report(void)
+{
+	static vm_offset_t t0, t1;
+	static const char *const name0[15] = { "aoss0", "cpu0", "cpu1", "cpu2", "cpu3", "cpu4", "cpu5", "cpuss0", "cpuss1",
+		"big0", "big1", "big2", "big3", "gpu0", "gpu1" };
+	static const char *const name1[10] = { "aoss1", "wlan", "audio", "ddr", "hvx", "camera", "mdm", "mdmdsp", "npu", "video" };
+	char line[400];
+	int at = 0, d, little = -1000, big = -1000;
+	unsigned i;
+	if (!t0) {
+		t0 = ml_io_map(0x0c263000u, 0x1000u);
+		t1 = ml_io_map(0x0c265000u, 0x1000u);
+		if (!t0 || !t1) {
+			return;
+		}
+	}
+	for (i = 1; i <= 6u; i++) {
+		if (tsens_read(t0, i, &d) == 0 && d > little) little = d;
+	}
+	for (i = 9; i <= 12u; i++) {
+		if (tsens_read(t0, i, &d) == 0 && d > big) big = d;
+	}
+	at += snprintf(line + at, sizeof(line) - (size_t)at, "little %d.%d big %d.%d", little / 10, little % 10, big / 10, big % 10);
+	for (i = 13; i <= 14u; i++) {
+		if (tsens_read(t0, i, &d) == 0) {
+			at += snprintf(line + at, sizeof(line) - (size_t)at, " %s %d.%d", name0[i], d / 10, (d < 0 ? -d : d) % 10);
+		}
+	}
+	for (i = 0; i < 10u && at < (int)sizeof(line) - 24; i++) {
+		if ((i == 3u || i == 6u || i == 0u) && tsens_read(t1, i, &d) == 0) {
+			at += snprintf(line + at, sizeof(line) - (size_t)at, " %s %d.%d", name1[i], d / 10, (d < 0 ? -d : d) % 10);
+		}
+	}
+	(void)name0;
+	printf("SWEET THERMAL: %s (C)\n", line);
+}
+
+/* redwood gpu_times: add up what the core spent on the submissions done since the last look. */
+static void
+gpu_times(void)
+{
+	volatile uint64_t *times = (volatile uint64_t *)(g_res_nc + GPU_TIMES_OFF);
+	uint32_t done = *(volatile uint32_t *)(g_res_nc + GPU_FENCE_OFF);
+	if (done - g_timed > GPU_TIMES) {
+		g_timed = done - GPU_TIMES;                     /* (the older ones were written over) */
+	}
+	while (g_timed != done) {
+		uint32_t slot = ++g_timed % GPU_TIMES;
+		if (g_timed != 0 && times[2 * slot + 1] > times[2 * slot]) {
+			g_gpu_ticks += times[2 * slot + 1] - times[2 * slot];
+			g_gpu_busy_ticks += times[2 * slot + 1] - times[2 * slot];
+			g_gpu_timed++;
+		}
+	}
+}
+
+/* redwood_gpu_report: a submission does not come back -- what the core and its SMMU context say. */
+static void
+gpu_report(const char *why)
+{
+	if (g_reports >= 8u) {
+		return;
+	}
+	g_reports++;
+	printf("SWEET DRM: GPU %s: submission %u is the last, the core has done %u; ring read up to %u, "
+	    "written up to %u; rbbm %#x; ib1 %#x_%08x rem %#x; ib2 rem %#x; protect %#x; smmu fsr %#x far %#x_%08x "
+	    "fsynr0 %#x\n",
+	    why, g_fence, *(volatile uint32_t *)(g_res_nc + GPU_FENCE_OFF),
+	    gpu_rd(g_core, 0x806u << 2), g_wptr, gpu_rd(g_core, 0x210u << 2),
+	    gpu_rd(g_core, 0x929u << 2), gpu_rd(g_core, 0x928u << 2),
+	    gpu_rd(g_core, 0x92Au << 2), gpu_rd(g_core, 0x92Du << 2), gpu_rd(g_core, 0x8CAu << 2),
+	    g_smmu_base ? gpu_rd(g_smmu_base, 0x8000u + 0x058u) : 0,
+	    g_smmu_base ? gpu_rd(g_smmu_base, 0x8000u + 0x064u) : 0,   /* FAR high: the GPU's VAs are past 4 GiB */
+	    g_smmu_base ? gpu_rd(g_smmu_base, 0x8000u + 0x060u) : 0,
+	    g_smmu_base ? gpu_rd(g_smmu_base, 0x8000u + 0x068u) : 0);  /* FSYNR0: read/write, which stream */
+}
+
+/* RedwoodGPU gpuWait: wait for the core to be done with `fence`; with the lock held, which is
+ * let go of while waiting. A wait of a second or more that comes to nothing is reported. */
+static uint32_t g_waits;
+static uint64_t g_waiting;
+static bool
+gpu_wait(uint32_t fence, uint64_t milliseconds)
+{
+	uint64_t began = mach_absolute_time(), patience;
+	bool waited = false;
+	nanoseconds_to_absolutetime(milliseconds * NSEC_PER_MSEC, &patience);
+	for (;; waited = true) {
+		if (gpu_done(fence)) {
+			if (waited) {
+				g_waits++;
+				g_waiting += mach_absolute_time() - began;
+			}
+			return true;
+		}
+		if (mach_absolute_time() - began >= patience) {
+			break;
+		}
+		gpu_unlock();
+		gmub_udelay(GPU_ASK_AGAIN_US);
+		gpu_lock();
+	}
+	if (milliseconds >= 1000u) {
+		gpu_report("no answer");
+	}
+	return false;
+}
+
+/* redwood_gpu_submit: command buffers for the core to run, in order, as Linux's a6xx_submit
+ * puts them in the ring. Returns the submission's number; 0: the ring stayed full (the core is
+ * not reading it). With the lock held throughout, as redwood does. */
+static uint32_t
+gpu_submit(const uint64_t *ibva, const uint32_t *ibdw, unsigned n)
+{
+	uint32_t wanted = 8u + 4u + 4u * n + 2u + 5u, room = 0, fence;
+	unsigned i, tries;
+	if (!g_kgsl_ready || n == 0) {
+		return 0;
+	}
+	for (tries = 0; tries < 10000u; tries++) {           /* 2 s */
+		uint32_t rptr = gpu_rd(g_core, 0x806u << 2) % KGSL_RING_DWORDS;   /* CP_RB_RPTR */
+		room = (rptr + KGSL_RING_DWORDS - g_wptr - 1u) % KGSL_RING_DWORDS;
+		if (room >= wanted) {
+			break;
+		}
+		gmub_udelay(GPU_ASK_AGAIN_US);
+	}
+	if (room < wanted) {
+		gpu_report("the ring is full");
+		return 0;
+	}
+	if (++g_fence == 0) {
+		g_fence = 1;
+	}
+	fence = g_fence;
+	{       /* the time at the beginning (redwood ring_time(fence, 0)) */
+		uint64_t at = g_res_pa + GPU_TIMES_OFF + 16u * (fence % GPU_TIMES);
+		ring_put(cp_type7(0x3Eu, 3u));                   /* CP_REG_TO_MEM */
+		ring_put(A6XX_CP_ALWAYS_ON_COUNTER | 2u << 18 | 1u << 30);
+		ring_put((uint32_t)at);
+		ring_put((uint32_t)(at >> 32));
+	}
+	/* Per-submit cache-invalidate preamble: stale depth/colour cache state from the previous
+	 * draw must not corrupt this one. */
+	ring_put(cp_type7(0x46u, 1u));                       /* CP_EVENT_WRITE */
+	ring_put(0x00000018u);                               /* EVENT_INVALIDATE_DEPTH */
+	ring_put(cp_type7(0x46u, 1u));                       /* CP_EVENT_WRITE */
+	ring_put(0x00000019u);                               /* EVENT_INVALIDATE_COLOR */
+	for (i = 0; i < n; i++) {
+		ring_put(cp_type7(0x3Fu, 3u));                   /* CP_INDIRECT_BUFFER */
+		ring_put((uint32_t)ibva[i]);
+		ring_put((uint32_t)(ibva[i] >> 32));
+		ring_put(ibdw[i]);
+	}
+	{       /* the time at the end (redwood ring_time(fence, 1)) */
+		uint64_t at = g_res_pa + GPU_TIMES_OFF + 16u * (fence % GPU_TIMES) + 8u;
+		ring_put(cp_type7(0x3Eu, 3u));                   /* CP_REG_TO_MEM */
+		ring_put(A6XX_CP_ALWAYS_ON_COUNTER | 2u << 18 | 1u << 30);
+		ring_put((uint32_t)at);
+		ring_put((uint32_t)(at >> 32));
+	}
+	ring_put(cp_type4(A6XX_CP_SCRATCH_REG2, 1u));        /* the fence, for a hang's post-mortem */
+	ring_put(fence);
+	ring_put(cp_type7(0x46u, 4u));                       /* CP_EVENT_WRITE CACHE_FLUSH_TS */
+	ring_put(0x00000004u);
+	ring_put((uint32_t)(g_res_pa + GPU_FENCE_OFF));      /* phys, identity-mapped */
+	ring_put((uint32_t)((g_res_pa + GPU_FENCE_OFF) >> 32));
+	ring_put(fence);
+	__asm__ volatile("dsb sy" ::: "memory");             /* the ring is NC: the words are in memory */
+	gpu_wr(g_core, 0x807u << 2, g_wptr);                 /* CP_RB_WPTR doorbell */
+	__asm__ volatile("dsb sy" ::: "memory");
+	return fence;
+}
+
+/* The KGSL front-end (turnip) and the in-kernel self-tests submit synchronously: submit, then
+ * wait for that one fence. With the lock held. */
+static int
+kgsl_submit_ibs(const uint64_t *ibva, const uint32_t *ibdw, unsigned n)
+{
+	uint32_t fence = gpu_submit(ibva, ibdw, n);
+	if (fence == 0) {
+		return -2;
+	}
+	return gpu_wait(fence, 2000u) ? 0 : -2;
+}
+
+/* ===================== buffers given back =====================
+ * Ported from HackiOS RedwoodGPU.cpp (freeBuffer, reap, keep, dropKept, gemNew).
+ *
+ * A buffer given back while the GPU is still at it keeps its memory and its addresses until
+ * its submission is done ("left"), and nobody waits for that. A buffer of a program's own,
+ * given back and done with, is kept -- memory and addresses -- for the next one of the same
+ * size and kind from the same program ("kept"; CoreAnimation makes a texture per frame of an
+ * animation and gives them back a score at a time: each made afresh costs memory got, cleared,
+ * and entered page by page into the GPU's address space). At most GPU_KEPT_BYTES are kept, none
+ * for longer than GPU_KEPT_SECONDS. A buffer is never freed under a GPU that may still use it.
+ */
+struct gpu_left {
+	vm_offset_t cva; uint64_t gpuaddr; vm_size_t mmapsize; uint32_t flags; int pid;
+	void *surf; uint32_t surf_id; uint32_t fence;
+};
+#define GPU_LEFT 256u
+static struct gpu_left g_left[GPU_LEFT];
+static uint32_t g_left_count;
+
+struct gpu_kept {
+	vm_offset_t cva;    /* 0: this place is free */
+	uint64_t gpuaddr, pa, since; vm_size_t mmapsize; uint32_t flags; int pid;
+};
+#define GPU_KEPT          48u
+#define GPU_KEPT_BYTES    (160ull << 20)
+#define GPU_KEPT_SECONDS  60u
+#define GPU_KEEP_FROM     (256u << 10)      /* bytes: smaller ones are not worth it */
+static struct gpu_kept g_kept[GPU_KEPT];
+static uint64_t g_kept_bytes;
+static uint32_t g_bo_count;
+static uint64_t g_bo_bytes;
+
+/* What the last seconds' work was, for one log line every five (RedwoodGPU gGPUStat). */
+static struct {
+	uint64_t since, flushed, flushed_whole;    /* (whole: first use, or memory without page bits) */
+	uint32_t submissions, commands, buffers, surfaces, made, given_again, closed, left_now;
+} g_stat;
+
+/* A buffer's memory and addresses given up for good: the GPU is done with it. */
+#define SWEET_IMPORT_PAD_BYTES (128u * 0x1000u)   /* drm_do_ios_import's scratch pages after an import */
+static void
+gpu_bo_destroy(vm_offset_t cva, uint64_t gpuaddr, vm_size_t mmapsize, void *surf)
+{
+	/* an imported surface's addresses run on into its scratch pages (drm_do_ios_import) */
+	vm_size_t vsize = surf ? mmapsize + SWEET_IMPORT_PAD_BYTES : mmapsize;
+	gpu_unmap(gpuaddr, vsize);
+	gpu_address_free(gpuaddr, vsize);
+	if (cva) {
+		kmem_free(kernel_map, cva, mmapsize);
+	}
+	if (surf) {
+		sweet_surface_gpu_unref(surf);
+	}
+}
+
+static void
+gpu_drop_kept(struct gpu_kept *k)
+{
+	if (k->cva == 0) {
+		return;
+	}
+	gpu_bo_destroy(k->cva, k->gpuaddr, k->mmapsize, NULL);
+	g_kept_bytes -= k->mmapsize;
+	k->cva = 0;
+}
+
+/* RedwoodGPU keep: the GPU done with a buffer of a program's own -- kept if it is worth it
+ * (those kept longest make way). */
+static bool
+gpu_keep(vm_offset_t cva, uint64_t gpuaddr, uint64_t pa, vm_size_t mmapsize, uint32_t flags, int pid)
+{
+	struct gpu_kept *place;
+	unsigned i;
+	if (cva == 0 || mmapsize < GPU_KEEP_FROM || mmapsize > GPU_KEPT_BYTES / 4u) {
+		return false;
+	}
+	for (;;) {
+		struct gpu_kept *oldest = NULL;
+		place = NULL;
+		for (i = 0; i < GPU_KEPT; i++) {
+			if (g_kept[i].cva == 0) {
+				place = place ? place : &g_kept[i];
+			} else if (oldest == NULL || g_kept[i].since < oldest->since) {
+				oldest = &g_kept[i];
+			}
+		}
+		if (place != NULL && g_kept_bytes + mmapsize <= GPU_KEPT_BYTES) {
+			break;
+		}
+		gpu_drop_kept(oldest);
+	}
+	place->cva = cva;
+	place->gpuaddr = gpuaddr;
+	place->pa = pa;
+	place->mmapsize = mmapsize;
+	place->flags = flags;
+	place->pid = pid;
+	place->since = mach_absolute_time();
+	g_kept_bytes += mmapsize;
+	return true;
+}
+
+/* RedwoodGPU freeBuffer: a handle given back. With the lock held. If the GPU is not done
+ * with the buffer it goes on the left list; if that is full, it is waited for; and if the
+ * GPU never answers, the memory stays the GPU's for good (it may yet be written). */
+static void
+gpu_bo_release(struct kgsl_bo_ent *b)
+{
+	bool busy;
+	if (!b || b->used != 1) {
+		return;
+	}
+	b->used = 2;                                   /* nobody finds it while it is given back */
+	busy = b->fence != 0 && !gpu_done(b->fence);
+	if (busy && g_left_count == GPU_LEFT) {
+		busy = !gpu_wait(b->fence, 1000u);         /* nowhere to keep it: this one is waited for */
+	}
+	if (busy && g_left_count < GPU_LEFT) {
+		struct gpu_left *l = &g_left[g_left_count++];
+		l->cva = b->cva;
+		l->gpuaddr = b->gpuaddr;
+		l->mmapsize = b->mmapsize;
+		l->flags = b->flags;
+		l->pid = b->pid;
+		l->surf = b->surf;
+		l->surf_id = b->surf_id;
+		l->fence = b->fence;
+	} else if (busy) {
+		static uint32_t said;
+		if (said++ < 8u) {
+			printf("SWEET DRM: the GPU is not done with what it was given: a buffer of %lu bytes stays its own\n",
+			    (unsigned long)b->mmapsize);
+		}
+	} else if (!(b->surf == NULL && gpu_keep(b->cva, b->gpuaddr, b->pa, b->mmapsize, b->flags, b->pid))) {
+		gpu_bo_destroy(b->cva, b->gpuaddr, b->mmapsize, b->surf);
+	}
+	g_bo_count--;
+	g_bo_bytes -= b->mmapsize;
+	g_stat.closed++;
+	kgsl_bo_unhash(b);
+	bzero(b, sizeof(*b));
+}
+
+static void gpu_import_expire(void);
+static void gpu_import_drop(struct kgsl_bo_ent *b);
+/* RedwoodGPU reap: buffers given back early that the GPU is done with now. With the lock held. */
+static void
+gpu_reap(void)
+{
+	uint32_t i;
+	gpu_import_expire();
+	for (i = 0; i < g_left_count;) {
+		struct gpu_left *l = &g_left[i];
+		if (!gpu_done(l->fence)) {
+			i++;
+			continue;
+		}
+		if (!(l->surf == NULL &&
+		    gpu_keep(l->cva, l->gpuaddr, ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)l->cva)),
+		    l->mmapsize, l->flags, l->pid))) {
+			gpu_bo_destroy(l->cva, l->gpuaddr, l->mmapsize, l->surf);
+		}
+		*l = g_left[--g_left_count];
+	}
+}
+
+/* Reclaim contexts/BOs whose owning process has exited (pid no longer resolves), at most once
+ * a second: leaked GPU state of dead processes (a SIGKILLed backboardd) is given back the
+ * same way a close gives it back -- never under a GPU that may still use it. With the lock held. */
+static uint64_t g_reaped_last;      /* (0: whenever asked) */
+#define last g_reaped_last
+static void
+kgsl_reap_dead(void)
+{
+	uint64_t now = mach_absolute_time(), second;
+	unsigned i, nctx = 0, nbo = 0;
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &second);
+	if (last != 0 && now - last < second) {
+		return;
+	}
+	last = now;
+	for (i = 0; i < KGSL_MAX_CTX; i++) {
+		if (g_ctx[i].used && g_ctx[i].pid > 0) {
+			struct proc *p = proc_find(g_ctx[i].pid);
+			if (p) { proc_rele(p); } else { g_ctx[i].used = 0; nctx++; }
+		}
+	}
+	for (i = 0; i < KGSL_MAX_BO; i++) {
+		if ((g_bo[i].used == 1 || g_bo[i].used == 3) && g_bo[i].pid > 0) {
+			struct proc *p = proc_find(g_bo[i].pid);
+			if (p) { proc_rele(p); } else if (g_bo[i].used == 3) { gpu_import_drop(&g_bo[i]); nbo++; } else { gpu_bo_release(&g_bo[i]); nbo++; }
+		}
+	}
+	for (i = 0; i < GPU_KEPT; i++) {
+		if (g_kept[i].cva != 0 && g_kept[i].pid > 0) {
+			struct proc *p = proc_find(g_kept[i].pid);
+			if (p) { proc_rele(p); } else { gpu_drop_kept(&g_kept[i]); }
+		}
+	}
+	gpu_reap();
+	if (nctx || nbo) { printf("SWEET DRM: reaped %u dead ctx, %u dead bo\n", nctx, nbo); }
+}
+#undef last
+
+/*
+ * SweetSurface.cpp, when the display pool is empty: a window server started again makes its
+ * full-screen surfaces while the buffers of the one that died still hold its own (the reaping
+ * above comes at the next allocation, too late) -- and then every other frame is copied, not
+ * scanned out. Those buffers given back now.
+ */
+void sweet_gpu_reap_dead_now(void);
+void
+sweet_gpu_reap_dead_now(void)
+{
+	if (g_gpu_mtx == NULL || !g_kgsl_ready) {
+		return;
+	}
+	gpu_lock();
+	g_reaped_last = 0;
+	kgsl_reap_dead();
+	gpu_unlock();
+}
+
+static int
+kgsl_do_drawctxt_create(uint32_t flags, uint32_t *out_id)
+{
+	unsigned i;
+	(void)flags;
+	kgsl_reap_dead();
+	for (i = 0; i < KGSL_MAX_CTX; i++) {
+		if (!g_ctx[i].used) {
+			g_ctx[i].used = 1;
+			g_ctx[i].id = g_ctx_next++;
+			g_ctx[i].ts_issued = 0;
+			g_ctx[i].ts_retired = 0;
+			g_ctx[i].pid = proc_selfpid();
+			*out_id = g_ctx[i].id;
+			return 0;
+		}
+	}
+	return -1;
+}
+static int
+kgsl_do_drawctxt_destroy(uint32_t id)
+{
+	struct kgsl_ctx_ent *c = kgsl_ctx_find(id);
+	if (!c) { return -1; }
+	c->used = 0;
+	return 0;
+}
+
+/*
+ * An IOSurface's buffer given back is kept a while (used 3) -- its GPU mapping, its handle, what
+ * of it has been pushed out of the cache -- and is the buffer again if the same program asks for
+ * that surface again: CoreAnimation makes a texture of a surface, lets it go, and makes one again
+ * a frame later, and every time was a new mapping of all its pages, a new buffer in Mesa, and the
+ * whole of it pushed out of the cache (11 MB for a full-screen one: glFlush taking 2-9 ms while an
+ * application opened). Given back for good after GPU_KEEP_IMPORT_MS, when its slot is wanted, or
+ * when its program is gone. With the lock held.
+ */
+#define GPU_KEEP_IMPORT_MS 2000u
+static void gpu_bo_release(struct kgsl_bo_ent *b);
+static void
+gpu_import_drop(struct kgsl_bo_ent *b)
+{
+	if (b->used != 3) {
+		return;
+	}
+	b->used = 1;                    /* (as it was: gpu_bo_release counts it out again) */
+	b->kept_at = 0;
+	g_bo_count++;
+	g_bo_bytes += b->mmapsize;
+	gpu_bo_release(b);
+}
+
+static void
+gpu_import_expire(void)
+{
+	static uint64_t last;
+	uint64_t now = mach_absolute_time(), limit, every;
+	nanoseconds_to_absolutetime((uint64_t)GPU_KEEP_IMPORT_MS * NSEC_PER_MSEC, &limit);
+	nanoseconds_to_absolutetime(250ull * NSEC_PER_MSEC, &every);
+	if (now - last < every) {
+		return;
+	}
+	last = now;
+	for (unsigned i = 0; i < KGSL_MAX_BO; i++) {
+		if (g_bo[i].used == 3 && now - g_bo[i].kept_at > limit) {
+			gpu_import_drop(&g_bo[i]);
+		}
+	}
+}
+
+/* A free slot of the BO table; NULL: none. */
+static struct kgsl_bo_ent *
+kgsl_bo_slot(void)
+{
+	static unsigned next;
+	unsigned n;
+	struct kgsl_bo_ent *oldest = NULL;
+	for (n = 0; n < KGSL_MAX_BO; n++) {
+		unsigned i = (next + n) % KGSL_MAX_BO;      /* one given back is not the next given */
+		if (g_bo[i].used == 0) {
+			next = i + 1u;
+			return &g_bo[i];
+		}
+		if (g_bo[i].used == 3 && (oldest == NULL || g_bo[i].kept_at < oldest->kept_at)) {
+			oldest = &g_bo[i];
+		}
+	}
+	if (oldest != NULL) {           /* (no free slot: the import kept longest goes) */
+		gpu_import_drop(oldest);
+		if (oldest->used == 0) {
+			return oldest;
+		}
+	}
+	return NULL;
+}
+
+/* GEM_NEW / GPUMEM_ALLOC (RedwoodGPU gemNew): one kept of this size and kind of this program's,
+ * if there is one (the one kept last), else made. With the lock held. */
+static int
+kgsl_do_gpumem_alloc(vm_size_t size, uint32_t flags, struct kgsl_bo_ent **out)
+{
+	struct kgsl_bo_ent *b;
+	struct gpu_kept *found = NULL;
+	uint64_t gpuaddr = 0, pa = 0, now = mach_absolute_time(), old;
+	vm_offset_t nc = 0, cva = 0;
+	vm_size_t asize = (size + (vm_size_t)PAGE_SIZE - 1) & ~((vm_size_t)PAGE_SIZE - 1);
+	uint32_t kflags = flags & ~(KGSL_MEMFLAGS_USE_CPU_MAP | KGSL_MEMFLAGS_IOCOHERENT);
+	int pid = proc_selfpid();
+	unsigned i;
+	if (asize == 0 || asize > (256u << 20)) {
+		return -1;
+	}
+	kgsl_reap_dead();
+	if ((b = kgsl_bo_slot()) == NULL) {
+		printf("SWEET DRM: no handles left for a buffer of %lu bytes (%u buffers, %llu MB)\n",
+		    (unsigned long)asize, g_bo_count, g_bo_bytes >> 20);
+		return -1;
+	}
+	nanoseconds_to_absolutetime((uint64_t)GPU_KEPT_SECONDS * NSEC_PER_SEC, &old);
+	for (i = 0; i < GPU_KEPT; i++) {
+		struct gpu_kept *k = &g_kept[i];
+		if (k->cva != 0 && now - k->since > old) {
+			gpu_drop_kept(k);
+		}
+		if (k->cva != 0 && k->mmapsize == asize && k->flags == kflags && k->pid == pid &&
+		    (found == NULL || k->since > found->since)) {
+			found = k;
+		}
+	}
+	if (found != NULL) {
+		cva = found->cva;
+		nc = found->cva;
+		gpuaddr = found->gpuaddr;
+		pa = found->pa;
+		g_kept_bytes -= found->mmapsize;
+		found->cva = 0;
+		g_stat.given_again++;
+	} else if (gpu_gpumem_alloc(asize, &gpuaddr, &nc, &pa, &cva) != 0) {
+		printf("SWEET DRM: no memory for a buffer of %lu bytes (%u buffers, %llu MB; va %llu MB used, %u refused)\n",
+		    (unsigned long)asize, g_bo_count, g_bo_bytes >> 20, gpu_va_used >> 20, gpu_va_refused);
+		return -1;
+	} else {
+		g_stat.made++;
+	}
+	kgsl_bo_unhash(b);
+	bzero(b, sizeof(*b));
+	b->used = 1;
+	b->id = g_mmap_page_next;                    /* id = 4K-page offset base (16K aligned) */
+	g_mmap_page_next += (uint32_t)(asize / 0x1000u);
+	b->gpuaddr = gpuaddr;
+	b->pa = pa;
+	b->cpu_nc = nc;
+	b->cva = cva;                                /* cacheable kernel VA for BO CPU-map */
+	b->size = size;
+	b->mmapsize = asize;
+	/* we honour only WRITECOMBINE (cachemode bits[27:26]=0); drop capability bits we
+	 * don't implement so turnip's (flags & requested)==requested probe degrades */
+	b->flags = kflags;
+	b->pid = pid;
+	g_bo_count++;
+	g_bo_bytes += asize;
+	kgsl_bo_hint(b);
+	*out = b;
+	return 0;
+}
+static int
+kgsl_do_gpumem_free(uint32_t id)
+{
+	struct kgsl_bo_ent *b = kgsl_bo_find(id);
+	if (!b) { return -1; }
+	if (b->surf != NULL) {          /* an IOSurface's: kept a while (gpu_import_drop) */
+		b->used = 3;
+		b->kept_at = mach_absolute_time();
+		g_bo_count--;
+		g_bo_bytes -= b->mmapsize;
+		g_stat.closed++;
+		gpu_import_expire();
+		return 0;
+	}
+	gpu_bo_release(b);
+	gpu_reap();
+	return 0;
+}
+
+/* GPU_COMMAND: copyin the IB list, submit the KGSL_CMDLIST_IB entries, assign the
+ * per-context timestamp (synchronous -> retired == issued on return). */
+static int
+kgsl_do_gpu_command(struct kgsl_gpu_command *gc, uint32_t *out_ts)
+{
+	struct kgsl_ctx_ent *c = kgsl_ctx_find(gc->context_id);
+	struct kgsl_command_object obj;
+	uint64_t ibva[16];
+	uint32_t ibdw[16];
+	unsigned n = 0, i;
+	int rc;
+	if (!c || gc->numcmds == 0 || gc->numcmds > 16u || gc->cmdsize < sizeof(obj)) {
+		return -1;
+	}
+	for (i = 0; i < gc->numcmds; i++) {
+		user_addr_t ea = (user_addr_t)(gc->cmdlist + (uint64_t)i * gc->cmdsize);
+		if (copyin(ea, &obj, sizeof(obj)) != 0) { return -1; }
+		if (obj.flags & KGSL_CMDLIST_IB) {
+			ibva[n] = obj.gpuaddr + obj.offset;
+			ibdw[n] = (uint32_t)(obj.size / 4u);
+			n++;
+		}
+	}
+	if (n == 0) { return -1; }
+	rc = kgsl_submit_ibs(ibva, ibdw, n);
+	if (rc != 0) { return rc; }
+	c->ts_issued++;
+	c->ts_retired = c->ts_issued;
+	*out_ts = c->ts_issued;
+	return 0;
+}
+
+static void
+kgsl_fill_devinfo(struct kgsl_devinfo *di)
+{
+	bzero(di, sizeof(*di));
+	di->device_id = 1;
+	di->chip_id = 0x06010800u;         /* Adreno a618 - the field turnip derives gpu_id 618 from */
+	di->mmu_enabled = 1;               /* stage-1 pagetables are up */
+	di->gpu_id = 618;
+	di->gmem_sizebytes = 0x80000u;     /* a618 GMEM = 512 KB (Linux adreno_device.c SZ_512K) */
+}
+
+/*
+ * The device nodes are there from the start (gpu_nodes_register), and an open waits until the
+ * GPU's bring-up is over: whoever opens one -- backboardd's GLES context for CoreAnimation --
+ * gets the GPU, or ENXIO if the bring-up failed, never "no such file" because it was early.
+ * (HackiOS's system does not go on starting until the GPU is up; here the bring-up runs in its
+ * own thread, and it was a race: the window server sometimes started before the GPU was there
+ * and drew in software for the rest of the run.)
+ */
+static volatile int g_gpu_boot_done;   /* the bring-up thread is through (g_kgsl_ready says how) */
+static int
+kgsl_open(__unused dev_t dev, __unused int f, __unused int dt, __unused struct proc *p)
+{
+	unsigned waited;
+	for (waited = 0; !g_gpu_boot_done && waited < 1200u; waited++) {   /* 120 s at most */
+		uint64_t deadline;
+		clock_interval_to_deadline(100, NSEC_PER_MSEC, &deadline);
+		assert_wait_deadline((event_t)&g_gpu_boot_done, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+	if (waited != 0) {
+		printf("SWEET GPU: an open waited %u ms for the bring-up: %s\n", waited * 100u,
+		    g_kgsl_ready ? "the GPU is there" : "NO GPU");
+	}
+	return g_kgsl_ready ? 0 : ENXIO;
+}
+static int kgsl_close(__unused dev_t dev, __unused int f, __unused int dt, __unused struct proc *p) { return 0; }
+static int kgsl_norw(__unused dev_t dev, __unused struct uio *uio, __unused int ioflag) { return ENODEV; }
+
+/* copy a kernel scalar out to the getproperty.value user ptr */
+static int
+kgsl_prop_out(struct kgsl_device_getproperty *gp, const void *src, vm_size_t len)
+{
+	if (!gp->value || gp->sizebytes < len) { return EINVAL; }
+	return copyout(src, (user_addr_t)(uintptr_t)gp->value, len);
+}
+
+static int drm_do_gem_mmap(struct kgsl_bo_ent *bo, uint64_t *out_uaddr);
+/* With the lock held (kgsl_ioctl). */
+static int
+kgsl_ioctl_locked(unsigned nr, caddr_t data)
+{
+	switch (nr) {
+	case KGSL_IOC_GETPROPERTY: {
+		struct kgsl_device_getproperty *gp = (struct kgsl_device_getproperty *)data;
+		switch (gp->type) {
+		case KGSL_PROP_DEVICE_INFO: {
+			struct kgsl_devinfo di; kgsl_fill_devinfo(&di);
+			return kgsl_prop_out(gp, &di, sizeof(di));
+		}
+		case KGSL_PROP_UCHE_GMEM_VADDR: { uint64_t v = 0x100000000ull; return kgsl_prop_out(gp, &v, 8); }
+		case KGSL_PROP_HIGHEST_BANK_BIT:{ uint32_t v = 14u; return kgsl_prop_out(gp, &v, 4); }   /* a618 (VERIFY) */
+		case KGSL_PROP_UBWC_MODE:       { uint32_t v = 1u;  return kgsl_prop_out(gp, &v, 4); }   /* UBWC enabled (VERIFY) */
+		case KGSL_PROP_UCHE_TRAP_BASE:  { uint64_t v = 0x1fffffffff000ull; return kgsl_prop_out(gp, &v, 8); }
+		case KGSL_PROP_GPU_VA64_SIZE:   { uint64_t v = (1ull << 48); return kgsl_prop_out(gp, &v, 8); }
+		case KGSL_PROP_IS_RAYTRACING:   { uint32_t v = 0u; return kgsl_prop_out(gp, &v, 4); }
+		case KGSL_PROP_GPU_RESET_STAT:  { uint32_t v = 0u; return kgsl_prop_out(gp, &v, 4); }  /* NO_ERROR: never report a GPU reset (synchronous submits) -> turnip check_status passes */
+		default:
+			return EINVAL;   /* turnip falls back / treats unknown props as unsupported */
+		}
+	}
+	case KGSL_IOC_DRAWCTXT_CREATE: {
+		struct kgsl_drawctxt_create *dc = (struct kgsl_drawctxt_create *)data;
+		uint32_t id = 0;
+		if (kgsl_do_drawctxt_create(dc->flags, &id) != 0) { return ENOMEM; }
+		dc->drawctxt_id = id;
+		return 0;
+	}
+	case KGSL_IOC_DRAWCTXT_DESTROY: {
+		struct kgsl_drawctxt_destroy *dd = (struct kgsl_drawctxt_destroy *)data;
+		return kgsl_do_drawctxt_destroy(dd->drawctxt_id) == 0 ? 0 : EINVAL;
+	}
+	case KGSL_IOC_GPUMEM_ALLOC_ID: {
+		struct kgsl_gpumem_alloc_id *ga = (struct kgsl_gpumem_alloc_id *)data;
+		struct kgsl_bo_ent *bo = NULL;
+		if (kgsl_do_gpumem_alloc((vm_size_t)ga->size, ga->flags, &bo) != 0) { return ENOMEM; }
+		ga->id = bo->id;
+		ga->flags = bo->flags;          /* echo honoured flags (capability probe) */
+		ga->size = bo->size;
+		ga->mmapsize = bo->mmapsize;
+		ga->gpuaddr = bo->gpuaddr;
+		return 0;
+	}
+	case KGSL_IOC_GPUMEM_FREE_ID: {
+		struct kgsl_gpumem_free_id *gf = (struct kgsl_gpumem_free_id *)data;
+		return kgsl_do_gpumem_free(gf->id) == 0 ? 0 : EINVAL;
+	}
+	case KGSL_IOC_GPU_COMMAND: {
+		struct kgsl_gpu_command *gc = (struct kgsl_gpu_command *)data;
+		uint32_t ts = 0;
+		int rc = kgsl_do_gpu_command(gc, &ts);
+		if (rc != 0) { return (rc == -1) ? EINVAL : EIO; }
+		gc->timestamp = ts;
+		return 0;
+	}
+	case KGSL_IOC_READTIMESTAMP_CID: {
+		struct kgsl_cmdstream_readtimestamp_ctxtid *rt =
+		    (struct kgsl_cmdstream_readtimestamp_ctxtid *)data;
+		struct kgsl_ctx_ent *c = kgsl_ctx_find(rt->context_id);
+		if (!c) { return EINVAL; }
+		rt->timestamp = c->ts_retired;   /* synchronous submit: retired == latest */
+		return 0;
+	}
+	case KGSL_IOC_WAITTIMESTAMP_CID: {
+		/* NOTE: pure _IOW -> under Linux ioccom XNU won't copyin (see banner); the
+		 * Mesa build must use XNU ioccom for this nr. Synchronous submit means the
+		 * target is already retired, so success is immediate when the ctx exists. */
+		struct kgsl_device_waittimestamp_ctxtid *wt =
+		    (struct kgsl_device_waittimestamp_ctxtid *)data;
+		struct kgsl_ctx_ent *c = kgsl_ctx_find(wt->context_id);
+		if (!c) { return EINVAL; }
+		return 0;
+	}
+	case 0x60: {   /* IOCTL_KGSL_SWEET_BO_MAP: map a BO into the caller, return uaddr.
+	                * XNU won't route mmap() to d_mmap, so turnip calls this instead. */
+		struct sweet_bo_map { uint32_t id; uint32_t pad; uint64_t uaddr; };
+		struct sweet_bo_map *mp = (struct sweet_bo_map *)data;
+		struct kgsl_bo_ent *bo = kgsl_bo_find(mp->id);
+		uint64_t ua = 0;
+		if (!bo) { return EINVAL; }
+		if (drm_do_gem_mmap(bo, &ua) != 0) { return ENOMEM; }
+		mp->uaddr = ua;
+		return 0;
+	}
+	default:
+		return 0;   /* accepted (Tier-2/3 stub) */
+	}
+}
+
+static int
+kgsl_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag, __unused struct proc *p)
+{
+	unsigned nr  = (unsigned)(cmd & 0xffu);
+	unsigned grp = (unsigned)((cmd >> 8) & 0xffu);
+	int e;
+	if (grp != KGSL_IOC_TYPE) {
+		return ENOTTY;
+	}
+	gpu_lock();
+	e = kgsl_ioctl_locked(nr, data);
+	gpu_unlock();
+	return e;
+}
+
+/* mmap() of a GPU object: userland (turnip on /dev/kgsl, freedreno on the DRM node)
+ * maps a BO at file offset (bo->id << 12; MSM_INFO_GET_OFFSET also returns that).
+ * Each BO owns a disjoint offset range [id<<12, id<<12+mmapsize) and is physically
+ * contiguous from bo->pa, so return the 16K page frame for the faulting page.
+ * The device_pager calls this per page with off advancing by PAGE_SIZE. */
+static int
+kgsl_mmap(__unused dev_t dev, off_t off, __unused int prot)
+{
+	unsigned i;
+	uint64_t o = (uint64_t)off;
+	for (i = 0; i < KGSL_MAX_BO; i++) {
+		uint64_t base;
+		if (!g_bo[i].used) { continue; }
+		base = (uint64_t)g_bo[i].id << 12;
+		if (o >= base && o < base + (uint64_t)g_bo[i].mmapsize) {
+			uint64_t pa = g_bo[i].pa + (o - base);
+			return (int)(ppnum_t)(pa >> 14);   /* 16K page frame number */
+		}
+	}
+	printf("SWEET KGSL: mmap miss off=%#llx\n", (unsigned long long)off);
+	return -1;
+}
+
+static const struct cdevsw kgsl_cdevsw = {
+	.d_open       = kgsl_open,
+	.d_close      = kgsl_close,
+	.d_read       = kgsl_norw,
+	.d_write      = kgsl_norw,
+	.d_ioctl      = kgsl_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = kgsl_mmap,   /* map GPUOBJ BOs to userland (turnip BO map) */
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = 0,
+};
+
+/* In-kernel self-test of the UAPI core: create a context, alloc two BOs via the
+ * GPUMEM_ALLOC handler, build a CP_MEM_WRITE IB in one that stores a magic to the
+ * other's GPU VA, submit it via the submit path, assign the timestamp, and verify
+ * the store landed. Runs in the boot/probe thread (same as gpu_stage_s), so it is
+ * as safe as the existing stages and needs no userland client. */
+static void
+gpu_stage_u(void)
+{
+	uint32_t cid = 0, got;
+	struct kgsl_bo_ent *ib = NULL, *dst = NULL;
+	struct kgsl_ctx_ent *c;
+	uint64_t ibva;
+	uint32_t ibdw;
+	int rc;
+	if (!g_kgsl_ready) {
+		printf("SWEET KGSL: [U] selftest skipped (submit path not published)\n");
+		return;
+	}
+	if (kgsl_do_drawctxt_create(0x13u, &cid) != 0) {
+		printf("SWEET KGSL: [U] drawctxt_create FAIL\n"); return;
+	}
+	gpu_lock();
+	if (kgsl_do_gpumem_alloc(PAGE_SIZE, 0, &ib) != 0 ||
+	    kgsl_do_gpumem_alloc(PAGE_SIZE, 0, &dst) != 0) {
+		gpu_unlock();
+		printf("SWEET KGSL: [U] gpumem_alloc FAIL\n"); return;
+	}
+	gpu_unlock();
+	*(volatile uint32_t *)dst->cpu_nc = 0;
+	((volatile uint32_t *)ib->cpu_nc)[0] = cp_type7(0x3Du, 3u);     /* CP_MEM_WRITE -> dst gpuaddr */
+	((volatile uint32_t *)ib->cpu_nc)[1] = (uint32_t)dst->gpuaddr;
+	((volatile uint32_t *)ib->cpu_nc)[2] = (uint32_t)(dst->gpuaddr >> 32);
+	((volatile uint32_t *)ib->cpu_nc)[3] = 0x5AFE600Du;
+	gpu_dcache_clean(ib->cpu_nc, PAGE_SIZE);    /* cacheable cva: flush IB + cleared dst to DRAM */
+	gpu_dcache_clean(dst->cpu_nc, PAGE_SIZE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	ibva = ib->gpuaddr;
+	ibdw = 4u;
+	gpu_lock();
+	rc = kgsl_submit_ibs(&ibva, &ibdw, 1);
+	gpu_unlock();
+	c = kgsl_ctx_find(cid);
+	if (c && rc == 0) { c->ts_issued++; c->ts_retired = c->ts_issued; }
+	gpu_dcache_clean(dst->cpu_nc, PAGE_SIZE);   /* invalidate: CPU re-reads GPU-written DRAM */
+	got = *(volatile uint32_t *)dst->cpu_nc;
+	printf("SWEET KGSL: [U] UAPI SELFTEST ctx=%u ib_id=%u(va=%#llx) dst_id=%u(va=%#llx) "
+	    "submit_rc=%d ts=%u readback=%#x(exp 5afe600d) -> %s\n",
+	    cid, ib->id, (unsigned long long)ib->gpuaddr, dst->id, (unsigned long long)dst->gpuaddr,
+	    rc, c ? c->ts_retired : 0, got,
+	    (rc == 0 && got == 0x5AFE600Du) ?
+	    "KGSL UAPI SUBMIT OK (create+alloc+submit+ts via ioctl handlers)" : "FAIL");
+	gmub_flush();
+}
+
+static int g_kgsl_major = -1;
+static void
+gpu_kgsl_init(void)
+{
+	struct kgsl_devinfo di;
+	if (g_kgsl_major < 0) {
+		return;                 /* not registered (gpu_nodes_register) */
+	}
+	kgsl_fill_devinfo(&di);     /* in-kernel self-test of the DEVICE_INFO reply */
+	printf("SWEET KGSL: /dev/kgsl-3d0 registered (major=%d); devinfo chip_id=%#x gpu_id=%u -> %s\n",
+	    g_kgsl_major, di.chip_id, di.gpu_id,
+	    (di.chip_id == 0x06010800u) ? "DEVINFO OK (a618) = cdev ready for userland freedreno"
+	    : "BAD chip_id");
+	gpu_stage_u();              /* exercise create+alloc+submit+timestamp through the handlers */
+}
+
+/* ===================== /dev/dri/renderD128 MSM-DRM UAPI =====================
+ * Second GPU front-end: the upstream-Linux MSM DRM render-node ioctls that Mesa's
+ * gallium **freedreno** OpenGL-ES driver speaks (contract in gpu/userland/mesa/
+ * MSM-DRM-IOCTL-SURFACE.md). This is the collaborator's path (gallium-freedreno
+ * GLES injected into backboardd; no zink/turnip/Metal). It wraps the SAME proven
+ * ring/iova/submit core (kgsl_submit_ibs + gpu_gpumem_alloc + the g_bo table) as
+ * the KGSL front-end; only the ioctl envelope differs: BOs are GEM handles, iova
+ * comes from GEM_INFO(GET_IOVA), and the retire token is a per-queue fence seqno.
+ * DRM ioctls use type 'd'=0x64. All structs arm64/LP64. An in-kernel self-test
+ * (gpu_stage_v) exercises GEM_NEW->submit->fence through the shared core.
+ *
+ * NOTE (same _IOC gotcha as KGSL): Mesa talks through a libdrm shim we control
+ * (mesa/ios-libdrm-shim/xf86drm.h). _IOWR ioctls (VERSION/GET_PARAM/GEM_NEW/
+ * GEM_INFO/GEM_SUBMIT) copyin+out fine under XNU; the pure-_IOW ones (GEM_CLOSE,
+ * GEM_CPU_PREP, WAIT_FENCE, SUBMITQUEUE_CLOSE) are XNU-IOC_OUT-only, so the shim
+ * must encode those with IOC_IN for the kernel to receive their input. */
+#define DRM_IOC_TYPE 0x64u       /* 'd' */
+/* core DRM nrs */
+#define DRM_NR_VERSION      0x00u
+#define DRM_NR_GET_CAP      0x0cu
+#define DRM_NR_GEM_CLOSE    0x09u
+/* MSM nrs (0x40 + index) */
+#define DRM_NR_MSM_GET_PARAM       0x40u
+#define DRM_NR_MSM_GEM_NEW         0x42u
+#define DRM_NR_MSM_GEM_INFO        0x43u
+#define DRM_NR_MSM_GEM_CPU_PREP    0x44u
+#define DRM_NR_MSM_GEM_SUBMIT      0x46u
+#define DRM_NR_MSM_WAIT_FENCE      0x47u
+#define DRM_NR_MSM_GEM_MADVISE     0x48u
+#define DRM_NR_MSM_SUBMITQUEUE_NEW 0x4Au
+#define DRM_NR_MSM_SUBMITQUEUE_CLOSE 0x4Bu
+#define DRM_NR_MSM_SUBMITQUEUE_QUERY 0x4Cu
+/* MSM_PARAM_* */
+#define MSM_PARAM_GPU_ID    0x01u
+#define MSM_PARAM_GMEM_SIZE 0x02u
+#define MSM_PARAM_CHIP_ID   0x03u
+#define MSM_PARAM_MAX_FREQ  0x04u
+#define MSM_PARAM_TIMESTAMP 0x05u
+#define MSM_PARAM_GMEM_BASE 0x06u
+#define MSM_PARAM_PRIORITIES 0x07u
+#define MSM_PARAM_VA_START  0x0eu
+#define MSM_PARAM_VA_SIZE   0x0fu
+/* MSM_INFO_* */
+#define MSM_INFO_GET_OFFSET 0x00u
+#define MSM_INFO_GET_IOVA   0x01u
+#define MSM_SUBMIT_CMD_BUF  0x01u
+
+struct drm_version {                  /* size 64 */
+	int           version_major;
+	int           version_minor;
+	int           version_patchlevel;
+	unsigned long name_len;           /* @16 */
+	char         *name;               /* @24 */
+	unsigned long date_len;
+	char         *date;
+	unsigned long desc_len;
+	char         *desc;
+};
+struct drm_get_cap   { uint64_t capability; uint64_t value; };          /* 16 */
+struct drm_gem_close { uint32_t handle; uint32_t pad; };                /* 8  */
+struct drm_msm_param { uint32_t pipe; uint32_t param; uint64_t value; uint32_t len; uint32_t pad; }; /* 24 */
+struct drm_msm_gem_new  { uint64_t size; uint32_t flags; uint32_t handle; };  /* 16 */
+struct drm_msm_gem_info { uint32_t handle; uint32_t info; uint64_t value; uint32_t len; uint32_t pad; }; /* 24 */
+struct drm_msm_timespec { int64_t tv_sec; int64_t tv_nsec; };           /* 16 */
+struct drm_msm_gem_cpu_prep { uint32_t handle; uint32_t op; struct drm_msm_timespec timeout; }; /* 24 */
+struct drm_msm_gem_submit {           /* size 72 */
+	uint32_t flags; uint32_t fence; uint32_t nr_bos; uint32_t nr_cmds;
+	uint64_t bos; uint64_t cmds; int32_t fence_fd; uint32_t queueid;
+	uint64_t in_syncobjs; uint64_t out_syncobjs;
+	uint32_t nr_in_syncobjs; uint32_t nr_out_syncobjs; uint32_t syncobj_stride; uint32_t pad;
+};
+struct drm_msm_gem_submit_bo  { uint32_t flags; uint32_t handle; uint64_t presumed; };  /* 16 */
+struct drm_msm_gem_submit_cmd { uint32_t type; uint32_t submit_idx; uint32_t submit_offset;
+	uint32_t size; uint32_t pad; uint32_t nr_relocs; uint64_t relocs; };                /* 40 */
+struct drm_msm_wait_fence { uint32_t fence; uint32_t flags; struct drm_msm_timespec timeout;
+	uint32_t queueid; uint32_t pad; };                                                  /* 32 */
+struct drm_msm_submitqueue { uint32_t flags; uint32_t prio; uint32_t id; };             /* 12 */
+struct drm_msm_gem_madvise  { uint32_t handle; uint32_t madv; uint32_t retained; };     /* 12 */
+
+static uint32_t g_sq_next = 1;      /* submitqueue id counter */
+
+static int
+drm_do_get_param(uint32_t param, uint64_t *out)
+{
+	switch (param) {
+	case MSM_PARAM_CHIP_ID:   *out = 0x06010800ull; return 0;  /* the field freedreno derives gen from */
+	case MSM_PARAM_GPU_ID:    *out = 618u;          return 0;
+	case MSM_PARAM_GMEM_SIZE: *out = 0x80000u;      return 0;  /* a618: 512 KB (Linux adreno_device.c SZ_512K); 1 MB made Mesa's bins overlap */
+	case MSM_PARAM_GMEM_BASE: *out = 0x100000u;     return 0;
+	case MSM_PARAM_MAX_FREQ:  *out = 500000000u;    return 0;
+	case MSM_PARAM_TIMESTAMP: *out = mach_absolute_time(); return 0;
+	case MSM_PARAM_PRIORITIES:*out = 1;             return 0;
+	case MSM_PARAM_VA_START:  *out = (uint64_t)GPU_VA_L1_FIRST << 30; return 0;  /* where buffers are put (the kernel puts them) */
+	case MSM_PARAM_VA_SIZE:   *out = GPU_VA_END - ((uint64_t)GPU_VA_L1_FIRST << 30); return 0;
+	default: return EINVAL;    /* freedreno treats most params as optional */
+	}
+}
+
+/* GEM_SUBMIT (port of HackiOS RedwoodGPU::submit). With the lock held.
+ *  - each CMD_BUF resolved to its BO's address, checked to lie inside the BO;
+ *  - every IOSurface the submission names looked at when its seed says it has changed, and in
+ *    any case once in GPU_PUSH_AGAIN_MS (not everybody who draws into a surface says so), and
+ *    the pages a processor wrote pushed out of its cache (all of it the first time, or when
+ *    its pages say nothing): the GPU reads memory, uncached;
+ *  - the submission put in the ring, not waited for;
+ *  - every BO it names given its fence: a BO given back before that fence is done keeps its
+ *    memory and addresses until it is (gpu_bo_release), and the display waits for a surface's
+ *    fence before it shows it (sweet_gpu_surface_wait). */
+static int
+drm_do_gem_submit(struct drm_msm_gem_submit *s, uint32_t *out_fence)
+{
+	uint64_t ibva[GPU_SUBMIT_CMDS];
+	uint32_t ibdw[GPU_SUBMIT_CMDS];
+	struct drm_msm_gem_submit_bo chunk[32];
+	uint64_t began = mach_absolute_time(), again, nanos;
+	unsigned n = 0, i, j;
+	uint32_t fence;
+	if (s->nr_cmds == 0 || s->nr_cmds > GPU_SUBMIT_CMDS || s->nr_bos == 0 || s->nr_bos > GPU_SUBMIT_BOS) {
+		printf("SWEET DRM: a submission of %u command buffers in %u buffers: not taken\n", s->nr_cmds, s->nr_bos);
+		return EINVAL;
+	}
+	for (i = 0; i < s->nr_cmds; i++) {
+		struct drm_msm_gem_submit_cmd c;
+		struct drm_msm_gem_submit_bo  b;
+		struct kgsl_bo_ent *bo;
+		if (copyin((user_addr_t)(s->cmds + (uint64_t)i * sizeof(c)), &c, sizeof(c)) != 0) { return EFAULT; }
+		if (c.type != MSM_SUBMIT_CMD_BUF) { continue; }   /* the other kinds are for a GPU shared between address spaces */
+		if (c.submit_idx >= s->nr_bos) { return EINVAL; }
+		if (copyin((user_addr_t)(s->bos + (uint64_t)c.submit_idx * sizeof(b)), &b, sizeof(b)) != 0) { return EFAULT; }
+		bo = kgsl_bo_find(b.handle);
+		if (!bo || c.nr_relocs != 0 || (c.size & 3u) || (c.submit_offset & 3u) ||
+		    (uint64_t)c.submit_offset + c.size > bo->mmapsize) {
+			printf("SWEET DRM: command buffer %u of a submission: buffer %u, offset %u, %u bytes, %u relocations: not taken\n",
+			    i, b.handle, c.submit_offset, c.size, c.nr_relocs);
+			return EINVAL;
+		}
+		ibva[n] = bo->gpuaddr + c.submit_offset;
+		ibdw[n] = c.size / 4u;
+		n++;
+	}
+	if (n == 0) { return EINVAL; }
+	nanoseconds_to_absolutetime((uint64_t)GPU_PUSH_AGAIN_MS * NSEC_PER_MSEC, &again);
+	for (i = 0; i < s->nr_bos; i += j) {
+		unsigned m = s->nr_bos - i < 32u ? s->nr_bos - i : 32u;
+		if (copyin((user_addr_t)(s->bos + (uint64_t)i * sizeof(chunk[0])), chunk, m * sizeof(chunk[0])) != 0) { return EFAULT; }
+		for (j = 0; j < m; j++) {
+			struct kgsl_bo_ent *b = kgsl_bo_find(chunk[j].handle);
+			uint32_t seed;
+			int64_t written;
+			if (b == NULL || b->surf == NULL) { continue; }
+			seed = sweet_surface_gpu_seed(b->surf);
+			if (seed == b->seed && began - b->pushed < again) { continue; }
+			written = b->pushed != 0 ? sweet_surface_gpu_push_written(b->surf) : -1;
+			b->seed = seed;
+			b->pushed = began;
+			if (written < 0) {
+				sweet_surface_gpu_flush(b->surf);
+				written = (int64_t)b->mmapsize;
+				g_stat.flushed_whole += b->mmapsize;
+			}
+			g_stat.flushed += (uint64_t)written;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");             /* and what was written last is in memory */
+	sweet_dvfs_kick();
+	fence = gpu_submit(ibva, ibdw, n);
+	if (fence == 0) {
+		return EIO;                                      /* the ring stayed full: the core is not reading it */
+	}
+	for (i = 0; i < s->nr_bos; i += j) {
+		unsigned m = s->nr_bos - i < 32u ? s->nr_bos - i : 32u;
+		if (copyin((user_addr_t)(s->bos + (uint64_t)i * sizeof(chunk[0])), chunk, m * sizeof(chunk[0])) != 0) { break; }
+		for (j = 0; j < m; j++) {
+			struct kgsl_bo_ent *b = kgsl_bo_find(chunk[j].handle);
+			if (b != NULL) { b->fence = fence; }
+		}
+	}
+	gpu_reap();
+	/* every five seconds in which something was submitted: how much, and what it cost (RedwoodGPU) */
+	g_stat.submissions++;
+	g_stat.commands += n;
+	g_stat.buffers += s->nr_bos;
+	if (g_stat.since == 0) { g_stat.since = began; }
+	absolutetime_to_nanoseconds(mach_absolute_time() - g_stat.since, &nanos);
+	if (nanos >= 5ull * NSEC_PER_SEC) {
+		uint64_t waiting;
+		absolutetime_to_nanoseconds(g_waiting, &waiting);
+		gpu_times();
+		thermal_report();
+		{
+			static unsigned every;
+			if (every++ % 6u == 0) {
+				battery_report();
+			}
+		}
+		{
+			volatile uint64_t *tm = (volatile uint64_t *)(g_res_nc + GPU_TIMES_OFF);
+			uint32_t last = *(volatile uint32_t *)(g_res_nc + GPU_FENCE_OFF) % GPU_TIMES;
+			uint64_t mhz = g_gpu_nlevels ? g_gpu_mhz[g_gpu_level < g_gpu_nlevels ? g_gpu_level : g_gpu_nlevels - 1u] : 180u;
+			printf("SWEET DRM: the GPU worked %llu us on each of %u submissions (%llu ms in all, %llu Mcycles), level %u "
+			    "(%llu MHz); last slot %u begin %#llx end %#llx\n",
+			    g_gpu_timed ? g_gpu_ticks / mhz / g_gpu_timed : 0, g_gpu_timed, g_gpu_ticks / mhz / 1000,
+			    g_gpu_ticks / 1000000u, g_gpu_level, mhz, last, tm[2 * last], tm[2 * last + 1]);
+		}
+		g_gpu_ticks = 0;
+		g_gpu_timed = 0;
+		printf("SWEET DRM: %u submissions in %llu ms (%u IBs, %u buffers named, %llu KB of surfaces out of the cache, %llu KB of it whole); "
+		    "fence %u done %u; buffers: %u made, %u kept ones given again, %u given back, %u left, %llu MB kept; "
+		    "%u buffers %llu MB; %u waits of %llu us; va %llu MB in %u, %u holes (%u most), %llu KB lost, %u refused\n",
+		    g_stat.submissions, nanos / NSEC_PER_MSEC, g_stat.commands, g_stat.buffers, g_stat.flushed >> 10, g_stat.flushed_whole >> 10,
+		    g_fence, *(volatile uint32_t *)(g_res_nc + GPU_FENCE_OFF),
+		    g_stat.made, g_stat.given_again, g_stat.closed, g_left_count, g_kept_bytes >> 20,
+		    g_bo_count, g_bo_bytes >> 20, g_waits, g_waits ? waiting / NSEC_PER_USEC / g_waits : 0,
+		    gpu_va_used >> 20, gpu_va_live, gpu_free_count, gpu_va_holes, gpu_va_lost >> 10, gpu_va_refused);
+		bzero(&g_stat, sizeof(g_stat));
+		g_waits = 0;
+		g_waiting = 0;
+	}
+	*out_fence = fence;
+	return 0;
+}
+
+/* How long from now an msm time is, in milliseconds (0: now or past), at most GPU_PATIENCE_MS.
+ * msm's clock goes on while the machine sleeps (CLOCK_MONOTONIC on Darwin), as RedwoodGPU has it. */
+static uint64_t
+drm_ms_until(const struct drm_msm_timespec *when)
+{
+	uint64_t now;
+	int64_t left;
+	absolutetime_to_nanoseconds(mach_continuous_time(), &now);
+	left = when->tv_sec * (int64_t)NSEC_PER_SEC + when->tv_nsec - (int64_t)now;
+	if (left <= 0) {
+		return 0;
+	}
+	return (uint64_t)left / NSEC_PER_MSEC > GPU_PATIENCE_MS ? GPU_PATIENCE_MS : (uint64_t)left / NSEC_PER_MSEC;
+}
+
+/* ---- BO CPU-map (Route B): iOS has no cdev mmap() path, so instead of
+ * mmap(fd, offset) we expose a private GEM_INFO op (MSM_INFO_IOS_MMAP) that maps
+ * the BO's physically-contiguous pages into the calling (Mesa) task as write-
+ * combine (Normal-NC) and returns the user VA. WC matches the GPU's stage-1
+ * Normal-NC view, so CPU<->GPU stay coherent with only the submit path's dsb sy.
+ * See gpu/userland/mesa/BO-MMAP-DESIGN.md. Our patched msm_bo.c calls this. ---- */
+#define MSM_INFO_IOS_MMAP 0x80u    /* private, outside the real 0x00..0x07 range */
+extern vm_map_t      current_map(void);
+extern kern_return_t mach_make_memory_entry_64(vm_map_t target_map,
+                         memory_object_size_t *size, memory_object_offset_t offset,
+                         vm_prot_t permission, ipc_port_t *object_handle,
+                         ipc_port_t parent_handle);
+extern kern_return_t mach_vm_map_external(vm_map_t target_map,
+                         mach_vm_offset_t *address, mach_vm_size_t initial_size,
+                         mach_vm_offset_t mask, int flags, ipc_port_t port,
+                         vm_object_offset_t offset, boolean_t copy,
+                         vm_prot_t cur_protection, vm_prot_t max_protection,
+                         vm_inherit_t inheritance);
+extern void          mach_memory_entry_port_release(ipc_port_t port);
+
+static int
+drm_do_gem_mmap(struct kgsl_bo_ent *bo, uint64_t *out_uaddr)
+{
+	kern_return_t        kr;
+	ipc_port_t           entry      = IPC_PORT_NULL;
+	memory_object_size_t entry_size = (memory_object_size_t)bo->mmapsize;
+	mach_vm_offset_t     uaddr      = 0;
+	vm_prot_t            perm;
+
+	if (!bo->cva || bo->mmapsize == 0) {
+		return EINVAL;
+	}
+	/* named entry over the BO's object-backed cacheable kernel range, forcing WC
+	 * (cache mode = bits[31:24] of permission; MAP_MEM_WCOMB<<24, outside the flag mask) */
+	perm = VM_PROT_READ | VM_PROT_WRITE | ((vm_prot_t)MAP_MEM_WCOMB << 24);
+	kr = mach_make_memory_entry_64(kernel_map, &entry_size,
+	        (memory_object_offset_t)bo->cva, perm, &entry, IPC_PORT_NULL);
+	if (kr != KERN_SUCCESS || entry == IPC_PORT_NULL) {
+		printf("SWEET DRM: gem_mmap mem_entry id=%u kr=%d\n", bo->id, kr);
+		return ENOMEM;
+	}
+	kr = mach_vm_map_external(current_map(), &uaddr,
+	        (mach_vm_size_t)entry_size, 0, VM_FLAGS_ANYWHERE, entry,
+	        0, FALSE, VM_PROT_READ | VM_PROT_WRITE, VM_PROT_READ | VM_PROT_WRITE,
+	        VM_INHERIT_SHARE);
+	mach_memory_entry_port_release(entry);
+	if (kr != KERN_SUCCESS) {
+		printf("SWEET DRM: gem_mmap vm_map id=%u kr=%d\n", bo->id, kr);
+		return ENOMEM;
+	}
+	{
+		static uint32_t told;
+		if (told++ < 16u) {
+			printf("SWEET DRM: gem_mmap id=%u iova=%#llx -> uva=%#llx size=%#lx (WC)\n",
+			    bo->id, (unsigned long long)bo->gpuaddr, (unsigned long long)uaddr,
+			    (unsigned long)bo->mmapsize);
+		}
+	}
+	*out_uaddr = (uint64_t)uaddr;
+	return 0;
+}
+
+/* ---- Zero-copy IOSurface import (MSM_INFO_IOS_IMPORT) ---------------------
+ * Port of HackiOS RedwoodGPUUserClient::surfaceBuffer: the memory of an IOSurface as a GEM
+ * buffer, which freedreno samples or draws into DIRECTLY (eglCreateImageKHR dma-buf path,
+ * fd==handle) instead of a glTexImage2D copy per frame. The surface is held for as long as the
+ * buffer is there (a surface freed under a GPU mapping would be memory the GPU still writes).
+ * A surface that is a buffer already is that buffer again, as with Linux's handles. Mapped
+ * uncached; its CPU-written pixels are pushed out of the cache by the submissions naming it. */
+#define MSM_INFO_IOS_IMPORT 0x85u
+extern int sweet_surface_gpu_pages(uint32_t id, uint64_t *pa, unsigned maxpages,
+    unsigned *npages, uint32_t *allocSize, uint32_t *width, uint32_t *height,
+    uint32_t *bytesPerRow, uint32_t *pixelFormat);
+#define SWEET_IMPORT_MAX_PAGES 4096u    /* 16 MB: covers a full-screen BGRA surface */
+/* Every import is followed in the GPU's address space by this many pages that all alias one
+ * scratch page: a GMEM resolve writes whole bins, and of a 2436x1125 surface (1125 rows, not a
+ * multiple of the bin height) that ran 1 KB past the surface's last page -- an SMMU write fault
+ * that stalled the core for the rest of the boot. What lands past the end now lands in scratch. */
+#define SWEET_IMPORT_PAD_PAGES 128u
+static uint64_t g_import_pa[SWEET_IMPORT_MAX_PAGES + SWEET_IMPORT_PAD_PAGES];
+static uint64_t g_import_scratch_pa;
+static int
+drm_do_ios_import(uint32_t surf_id, uint32_t *out_handle)
+{
+	unsigned i, npages = 0;
+	uint32_t allocSize = 0, w = 0, h = 0, bpr = 0, fmt = 0;
+	uint64_t gpuaddr = 0;
+	struct kgsl_bo_ent *b;
+	void *surf;
+	if (surf_id == 0u) { return EINVAL; }
+	/* a surface that is a buffer of this process already is that buffer. Of THIS process: a handle
+	 * has no count of its own, so a buffer shared with another importer (the window server
+	 * compositing an application's IOSurface) was taken out of the GPU's address space when that
+	 * process closed it -- under the application still drawing into it (SMMU write fault, core
+	 * stalled). Each process has its own mapping of the same pages. */
+	for (i = 0; i < KGSL_MAX_BO; i++) {
+		if (g_bo[i].used == 1 && g_bo[i].surf_id == surf_id && g_bo[i].pid == proc_selfpid()) {
+			*out_handle = g_bo[i].id;
+			return 0;
+		}
+	}
+	for (i = 0; i < KGSL_MAX_BO; i++) {   /* one given back and kept: again, as it was */
+		if (g_bo[i].used == 3 && g_bo[i].surf_id == surf_id && g_bo[i].pid == proc_selfpid()) {
+			g_bo[i].used = 1;
+			g_bo[i].kept_at = 0;
+			g_bo_count++;
+			g_bo_bytes += g_bo[i].mmapsize;
+			kgsl_bo_hint(&g_bo[i]);
+			g_stat.given_again++;
+			*out_handle = g_bo[i].id;
+			return 0;
+		}
+	}
+	if ((b = kgsl_bo_slot()) == NULL) { return ENOMEM; }
+	if ((surf = sweet_surface_gpu_ref(surf_id)) == NULL) { return ENOENT; }
+	if (sweet_surface_gpu_pages(surf_id, g_import_pa, SWEET_IMPORT_MAX_PAGES, &npages,
+	        &allocSize, &w, &h, &bpr, &fmt) != 0 || npages == 0u) {
+		sweet_surface_gpu_unref(surf);
+		printf("SWEET DRM: ios_import surf %u FAILED (pages)\n", surf_id);
+		return EINVAL;
+	}
+	if (g_import_scratch_pa == 0) {
+		vm_offset_t scva = 0;
+		uint64_t spa = 0;
+		if (gmub_alloc_phys(&scva, &spa, PAGE_SIZE) != 0 || spa == 0) {
+			sweet_surface_gpu_unref(surf);
+			printf("SWEET DRM: ios_import surf %u FAILED (no scratch page)\n", surf_id);
+			return ENOMEM;
+		}
+		g_import_scratch_pa = spa;
+	}
+	for (i = 0; i < SWEET_IMPORT_PAD_PAGES; i++) {
+		g_import_pa[npages + i] = g_import_scratch_pa;
+	}
+	if (gpu_gpumem_map_phys(g_import_pa, npages + SWEET_IMPORT_PAD_PAGES, &gpuaddr) != 0) {
+		sweet_surface_gpu_unref(surf);
+		printf("SWEET DRM: ios_import surf %u FAILED (map %u pages)\n", surf_id, npages);
+		return ENOMEM;
+	}
+	kgsl_bo_unhash(b);
+	bzero(b, sizeof(*b));
+	b->used = 1;
+	b->id = g_mmap_page_next;
+	g_mmap_page_next += npages;
+	b->gpuaddr = gpuaddr;
+	b->pa = g_import_pa[0];
+	b->cpu_nc = 0;
+	b->cva = 0;                 /* the surface's memory: never kmem_free'd here */
+	b->size = allocSize;
+	b->mmapsize = (vm_size_t)npages * 0x1000u;
+	b->flags = 0;
+	b->pid = proc_selfpid();
+	b->surf_id = surf_id;
+	b->surf = surf;
+	b->seed = sweet_surface_gpu_seed(surf) - 1u;   /* pushed out of the cache before its first use */
+	b->pushed = 0;                                 /* (all of it) */
+	g_bo_count++;
+	g_bo_bytes += b->mmapsize;
+	kgsl_bo_hint(b);
+	g_stat.surfaces++;
+	*out_handle = b->id;
+	{
+		static uint32_t told;
+		if (told++ < 16u) {
+			printf("SWEET DRM: ios_import surf %u -> handle %u gpuaddr %#llx %ux%u fmt %#x (%u pages, zero-copy)\n",
+			    surf_id, b->id, (unsigned long long)gpuaddr, w, h, fmt, npages);
+		}
+	}
+	return 0;
+}
+
+/* For the display (SweetSurface.cpp AppleCLCD::swap, as HackiOS MiniIOSurfaceDrawn): wait,
+ * at most `ms`, for the GPU to be done with the last submission that named surface `surf_id`.
+ * 1: done (or the GPU never had it); 0: not done in time -- shown as it is. */
+int
+sweet_gpu_surface_wait(uint32_t surf_id, uint32_t ms)
+{
+	uint32_t fence = 0;
+	unsigned i;
+	int done = 1;
+	if (g_gpu_mtx == NULL || !g_kgsl_ready || surf_id == 0u) {
+		return 1;
+	}
+	gpu_lock();
+	for (i = 0; i < KGSL_MAX_BO; i++) {
+		if ((g_bo[i].used == 1 || g_bo[i].used == 3) && g_bo[i].surf_id == surf_id && g_bo[i].fence != 0 &&
+		    (fence == 0 || (int32_t)(g_bo[i].fence - fence) > 0)) {
+			fence = g_bo[i].fence;
+		}
+	}
+	for (i = 0; i < g_left_count; i++) {      /* given back already, the GPU still at it */
+		if (g_left[i].surf_id == surf_id && (fence == 0 || (int32_t)(g_left[i].fence - fence) > 0)) {
+			fence = g_left[i].fence;
+		}
+	}
+	if (fence != 0 && !gpu_wait(fence, ms)) {
+		/* (which fence, and where from: a present that waits its whole time, 100 ms a frame, came and went
+		 * with Settings in some boots -- the GPU busy a third of the time, its submissions 2.4 ms each) */
+		static uint32_t told;
+		done = 0;
+		if (told++ < 12u) {
+			unsigned bos = 0, lefts = 0, used = 0;
+			for (i = 0; i < KGSL_MAX_BO; i++) {
+				if ((g_bo[i].used == 1 || g_bo[i].used == 3) && g_bo[i].surf_id == surf_id && g_bo[i].fence != 0) {
+					bos++;
+					used |= 1u << g_bo[i].used;
+				}
+			}
+			for (i = 0; i < g_left_count; i++) {
+				lefts += g_left[i].surf_id == surf_id;
+			}
+			printf("SWEET DRM: surface %u: waited %u ms for fence %u, the core has done %u, the last submitted is %u; "
+			    "%u buffers of it (kinds %#x), %u given back\n", surf_id, ms, fence,
+			    *(volatile uint32_t *)(g_res_nc + GPU_FENCE_OFF), g_fence, bos, used, lefts);
+		}
+	}
+	gpu_unlock();
+	return done;
+}
+
+/* ---- On-screen present (Stage P1) ----------------------------------------
+ * Copy a rendered BO to the live scanout at FB_PHYS (= boot_args.Video.v_baseAddr,
+ * loader.c). The display controller is ALREADY scanning this region out (the shim
+ * console + XNU panic UI draw here), so no DSI/DPU bringup is needed to light the
+ * panel. The BO is expected to hold FB_W x FB_H pixels in GL_RGBA8 (glReadPixels
+ * byte order R,G,B,A), bottom-up (GL origin = lower-left). We flip vertically and
+ * swizzle R<->B into the panel's a8r8g8b8. This CPU blit is the first step toward
+ * a zero-copy GPU scanout (P2: wrap FB_PHYS as a BO and let freedreno render into
+ * it directly). ------------------------------------------------------------- */
+#define SWEET_FB_PHYS        0x9c000000ull
+#define SWEET_FB_W           1080u
+#define SWEET_FB_H           2340u
+#define SWEET_FB_STRIDE      (SWEET_FB_W * 4u)
+#define SWEET_FB_SIZE        ((vm_size_t)SWEET_FB_H * SWEET_FB_STRIDE)
+#define MSM_INFO_IOS_PRESENT     0x81u   /* private GEM_INFO op: fill scanout w/ colour word */
+#define MSM_INFO_IOS_PRESENT_IMG 0x82u   /* private GEM_INFO op: upscale small image to scanout */
+
+/* The kernel fbcon already maps the scanout (write-combine) at this global and
+ * draws boot/panic text to it. We reuse that exact mapping: a fresh ml_io_map of
+ * the 10MB framebuffer panics with kmem_alloc KERN_NO_SPACE (no second 10MB VA
+ * window in the constrained IO map). de-static'd in 0003-sweet-framebuffer-*. */
+extern volatile uint32_t *fbcon_base;
+extern uint32_t fbcon_width, fbcon_height, fbcon_stride;
+
+/* Present a SOLID colour to the whole scanout. The app passes the GPU-produced
+ * pixel as a GL_RGBA8 word (byte order R,G,B,A, i.e. u32 = A<<24|B<<16|G<<8|R);
+ * we swizzle R<->B into the panel's a8r8g8b8 and fill every pixel via the fbcon
+ * mapping. No userland buffer / copyin / new mapping. Proves GPU-render -> colour
+ * -> scanout -> glass; full-frame content comes with the zero-copy P2 path. */
+static int
+drm_do_present(uint32_t gl_rgba)
+{
+	volatile uint32_t *dst = fbcon_base;
+	uint32_t panel, i, n;
+	if (!dst || !fbcon_stride || !fbcon_height) {
+		printf("SWEET DRM: present no fbcon mapping (base=%p stride=%u h=%u)\n",
+		    (void *)dst, fbcon_stride, fbcon_height);
+		return ENXIO;
+	}
+	/* (A<<24|B<<16|G<<8|R) -> (A<<24|R<<16|G<<8|B) */
+	panel = (gl_rgba & 0xFF00FF00u) | ((gl_rgba & 0x000000FFu) << 16) | ((gl_rgba & 0x00FF0000u) >> 16);
+	n = (fbcon_stride / 4u) * fbcon_height;   /* words in the real fbcon mapping */
+	for (i = 0; i < n; i++) { dst[i] = panel; }
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("SWEET DRM: present gl=%#x -> panel=%#x filled %u px (%ux%u)\n",
+	    gl_rgba, panel, n, fbcon_width, fbcon_height);
+	return 0;
+}
+
+/* Present a SMALL GPU-rendered image (w x h, GL_RGBA8) by nearest-neighbour
+ * upscaling it across the whole scanout. The app renders a real fragment shader
+ * into a small FBO and reads it back (small => safe: avoids the big-readback
+ * overrun and the ~1.6MB userland heap ceiling on this port), then hands us the
+ * w*h*4 pixels. We copyin once, build per-axis nearest maps (cached per w/h),
+ * and fill the panel. Stepping stone to zero-copy full-res. */
+#define PIMG_MAXW 128u
+#define PIMG_MAXH 256u
+static uint32_t g_pimg[PIMG_MAXW * PIMG_MAXH];   /* small source bounce (<=128KB) */
+static uint16_t g_xmap[1080];                    /* nearest-x map (built per src w) */
+static uint16_t g_ymap[2340];                    /* nearest-y map (built per src h) */
+static uint32_t g_pw, g_ph;
+
+static int
+drm_do_present_img(user_addr_t usrc, uint32_t w, uint32_t h)
+{
+	volatile uint32_t *dst = fbcon_base;
+	uint32_t X, Y;
+	if (!dst || !fbcon_stride || !fbcon_height) { return ENXIO; }
+	if (w == 0u || h == 0u || w > PIMG_MAXW || h > PIMG_MAXH) {
+		printf("SWEET DRM: present_img bad dims %ux%u\n", w, h);
+		return EINVAL;
+	}
+	if (fbcon_width > 1080u || fbcon_height > 2340u) { return EINVAL; }
+	if (copyin(usrc, (void *)g_pimg, (user_size_t)w * h * 4u) != 0) {
+		printf("SWEET DRM: present_img copyin fault\n");
+		return EFAULT;
+	}
+	if (w != g_pw) {
+		for (X = 0; X < fbcon_width; X++) { g_xmap[X] = (uint16_t)((uint64_t)X * w / fbcon_width); }
+		g_pw = w;
+	}
+	if (h != g_ph) {
+		for (Y = 0; Y < fbcon_height; Y++) { g_ymap[Y] = (uint16_t)((uint64_t)Y * h / fbcon_height); }
+		g_ph = h;
+	}
+	for (Y = 0; Y < fbcon_height; Y++) {
+		volatile uint32_t *drow = dst + (uint32_t)Y * (fbcon_stride / 4u);
+		const uint32_t *srow = g_pimg + (uint32_t)g_ymap[Y] * w;
+		for (X = 0; X < fbcon_width; X++) {
+			uint32_t g = srow[g_xmap[X]];     /* GL RGBA, LE: A<<24|B<<16|G<<8|R */
+			drow[X] = (g & 0xFF00FF00u) | ((g & 0x000000FFu) << 16) | ((g & 0x00FF0000u) >> 16);
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	return 0;
+}
+
+/* Present a GPU-RENDERED BO (freedreno rendered straight into it via the Mesa
+ * GEM-import path) by nearest-upscaling it to the scanout. The BO is one of our
+ * GEM BOs (kmem-backed, kernel-readable via cva); we invalidate the cacheable
+ * view (the GPU wrote it NC), then upscale + swizzle to the panel. No readback,
+ * no userland copy -- the GPU produced the final pixels. src = ABGR8888 linear
+ * (GL byte order R,G,B,A); stride is the BO row pitch (align(w*4,64)). */
+#define MSM_INFO_IOS_PRESENT_BO 0x83u
+static int
+drm_do_present_bo(uint32_t handle, uint32_t w, uint32_t h, uint32_t stride)
+{
+	struct kgsl_bo_ent *bo = kgsl_bo_find(handle);
+	volatile uint32_t *dst = fbcon_base;
+	uint32_t X, Y;
+	if (!dst || !fbcon_stride || !fbcon_height) { return ENXIO; }
+	if (!bo || !bo->cva) { printf("SWEET DRM: present_bo bad handle %u\n", handle); return EINVAL; }
+	if (w == 0u || h == 0u || w > 4096u || h > 8192u || stride < w * 4u) { return EINVAL; }
+	if (fbcon_width > 1080u || fbcon_height > 2340u) { return EINVAL; }
+	if (bo->mmapsize < (vm_size_t)stride * h) {
+		printf("SWEET DRM: present_bo id=%u too small %#lx < %u*%u\n",
+		    handle, (unsigned long)bo->mmapsize, stride, h);
+		return EINVAL;
+	}
+	gpu_dcache_clean(bo->cva, (vm_size_t)stride * h);   /* GPU wrote NC; drop stale cache lines */
+	__asm__ volatile("dsb sy" ::: "memory");
+	if (w != g_pw) {
+		for (X = 0; X < fbcon_width; X++) { g_xmap[X] = (uint16_t)((uint64_t)X * w / fbcon_width); }
+		g_pw = w;
+	}
+	if (h != g_ph) {
+		for (Y = 0; Y < fbcon_height; Y++) { g_ymap[Y] = (uint16_t)((uint64_t)Y * h / fbcon_height); }
+		g_ph = h;
+	}
+	for (Y = 0; Y < fbcon_height; Y++) {
+		volatile uint32_t *drow = dst + (uint32_t)Y * (fbcon_stride / 4u);
+		const uint32_t *srow = (const uint32_t *)((const uint8_t *)bo->cva + (uint32_t)g_ymap[Y] * stride);
+		for (X = 0; X < fbcon_width; X++) {
+			uint32_t g = srow[g_xmap[X]];     /* ABGR8888 LE: A<<24|B<<16|G<<8|R */
+			drow[X] = (g & 0xFF00FF00u) | ((g & 0x000000FFu) << 16) | ((g & 0x00FF0000u) >> 16);
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	return 0;
+}
+
+/* Read back the live scanout as a small thumbnail so a host tool can SEE what is
+ * actually on the panel (debug visibility). User passes value=buffer, handle=gw,
+ * len=gh; we point-sample the fbcon (a8r8g8b8) into gw*gh u32 and copyout. */
+#define MSM_INFO_IOS_READ_PANEL 0x84u
+static uint32_t g_panel_thumb[32 * 48];
+static int
+drm_do_read_panel(user_addr_t ubuf, uint32_t gw, uint32_t gh)
+{
+	volatile uint32_t *src = fbcon_base;
+	uint32_t x, y;
+	if (!src || !fbcon_stride || !fbcon_height || !fbcon_width) { return ENXIO; }
+	if (gw == 0u || gh == 0u || gw > 32u || gh > 48u || !ubuf) { return EINVAL; }
+	for (y = 0; y < gh; y++) {
+		uint32_t sy = y * fbcon_height / gh;
+		volatile uint32_t *srow = src + (uint32_t)sy * (fbcon_stride / 4u);
+		for (x = 0; x < gw; x++) {
+			uint32_t sx = x * fbcon_width / gw;
+			g_panel_thumb[y * gw + x] = srow[sx];
+		}
+	}
+	return copyout(g_panel_thumb, ubuf, (vm_size_t)gw * gh * 4u);
+}
+
+#define MSM_PREP_NOSYNC 0x04u
+#define MSM_INFO_IOS_GPU_LEVEL 0x87u   /* private: value = GPU perf level 0 (825 MHz) .. 7 (180 MHz); out: DCVS return */
+static int gpu_set_level(uint32_t level, uint64_t *out);
+static int g_level_quiet;       /* (the clock governor's changes: no measuring, no line) */
+#define MSM_INFO_IOS_REBOOT 0x86u      /* private: value 0 = set the PMIC reboot reason "bootloader" and
+                                         * report; 1 = set it and reset (-> fastboot) */
+static int sweet_reboot_fastboot(uint32_t mode);
+/* With the lock held (drm_ioctl). */
+static int
+drm_ioctl_locked(unsigned nr, caddr_t data)
+{
+	switch (nr) {
+	case DRM_NR_VERSION: {
+		struct drm_version *v = (struct drm_version *)data;
+		static const char nm[] = "msm";
+		v->version_major = 1; v->version_minor = 10; v->version_patchlevel = 0;
+		if (v->name && v->name_len >= 3u) {
+			if (copyout(nm, (user_addr_t)(uintptr_t)v->name, 3) != 0) { return EFAULT; }
+		}
+		v->name_len = 3u;        /* drmGetVersion reads this, then re-calls with a buffer */
+		v->date_len = 0u;
+		v->desc_len = 0u;
+		return 0;
+	}
+	case DRM_NR_GET_CAP: {
+		struct drm_get_cap *gc = (struct drm_get_cap *)data;
+		gc->value = 0;           /* no syncobj/prime for first light */
+		return 0;
+	}
+	case DRM_NR_GEM_CLOSE: {
+		struct drm_gem_close *gc = (struct drm_gem_close *)data;
+		return kgsl_do_gpumem_free(gc->handle) == 0 ? 0 : EINVAL;
+	}
+	case DRM_NR_MSM_GET_PARAM: {
+		struct drm_msm_param *mp = (struct drm_msm_param *)data;
+		uint64_t val = 0;
+		int e = drm_do_get_param(mp->param, &val);
+		if (e) { return e; }
+		mp->value = val;
+		return 0;
+	}
+	case DRM_NR_MSM_GEM_NEW: {
+		struct drm_msm_gem_new *gn = (struct drm_msm_gem_new *)data;
+		struct kgsl_bo_ent *bo = NULL;
+		if (kgsl_do_gpumem_alloc((vm_size_t)gn->size, gn->flags, &bo) != 0) { return ENOMEM; }
+		gn->handle = bo->id;
+		return 0;
+	}
+	case DRM_NR_MSM_GEM_INFO: {
+		struct drm_msm_gem_info *gi = (struct drm_msm_gem_info *)data;
+		struct kgsl_bo_ent *bo;
+		if (gi->info == MSM_INFO_IOS_PRESENT) {   /* Stage P1: fill scanout with a solid colour */
+			return drm_do_present((uint32_t)gi->value);
+		}
+		if (gi->info == MSM_INFO_IOS_PRESENT_IMG) {  /* P2a: upscale small GPU image to scanout */
+			return drm_do_present_img((user_addr_t)gi->value, gi->handle, gi->pad);
+		}
+		if (gi->info == MSM_INFO_IOS_PRESENT_BO) {   /* P2b: present a GPU-rendered BO (no readback) */
+			return drm_do_present_bo(gi->handle, (uint32_t)(gi->value & 0xffffu),
+			    (uint32_t)((gi->value >> 16) & 0xffffu), gi->len);
+		}
+		if (gi->info == MSM_INFO_IOS_READ_PANEL) {   /* debug: read scanout thumbnail */
+			return drm_do_read_panel((user_addr_t)gi->value, gi->handle, gi->len);
+		}
+		if (gi->info == MSM_INFO_IOS_GPU_LEVEL) {   /* the GPU's clock (legacy GMU DCVS by register) */
+			uint64_t o = 0;
+			int e = gpu_set_level((uint32_t)gi->value, &o);
+			gi->value = o;
+			return e;
+		}
+		if (gi->info == 0x88u) {   /* private: the panel's brightness, 0..2047 (DCS 0x51); out: DMA done */
+			int e = sweet_panel_brightness((uint32_t)gi->value);
+			gi->value = (uint64_t)(e == 0);
+			return e == 0 ? 0 : EIO;
+		}
+		if (gi->info == MSM_INFO_IOS_REBOOT) {   /* dev loop: reboot into fastboot (see sweet_reboot_fastboot) */
+			return sweet_reboot_fastboot((uint32_t)gi->value) == 0 ? 0 : EIO;
+		}
+		if (gi->info == MSM_INFO_IOS_IMPORT) {   /* zero-copy: IOSurface id (value) -> GEM handle */
+			uint32_t hnd = 0;
+			int e = drm_do_ios_import((uint32_t)gi->value, &hnd);
+			if (e) { return e; }
+			gi->handle = hnd;
+			return 0;
+		}
+		bo = kgsl_bo_find(gi->handle);
+		if (!bo) { return EINVAL; }
+		switch (gi->info) {
+		case MSM_INFO_GET_IOVA:   gi->value = bo->gpuaddr;                  return 0;
+		case MSM_INFO_GET_OFFSET: gi->value = (uint64_t)bo->id << 12;       return 0;  /* mmap token */
+		case MSM_INFO_IOS_MMAP: {     /* Route B: map the BO into this task, WC; return user VA */
+			uint64_t uva = 0;
+			int e = drm_do_gem_mmap(bo, &uva);
+			if (e) { return e; }
+			gi->value = uva;
+			return 0;
+		}
+		default: return EINVAL;   /* SET_NAME/METADATA optional; freedreno degrades */
+		}
+	}
+	case DRM_NR_MSM_GEM_CPU_PREP: {
+		/* Is the GPU done with a buffer (RedwoodGPU kMsmGemCpuPrep): its last submission here,
+		 * all it has been given if the buffer is not known. NOTE the shim encodes this request
+		 * Linux-_IOW, which XNU reads as IOC_OUT: nothing is copied in, so the request comes
+		 * zeroed -- then it is waited for as for no limit, all the GPU has been given. */
+		struct drm_msm_gem_cpu_prep *cp = (struct drm_msm_gem_cpu_prep *)data;
+		struct kgsl_bo_ent *bo = cp->handle ? kgsl_bo_find(cp->handle) : NULL;
+		uint32_t fence = bo ? bo->fence : gpu_last();
+		uint64_t ms;
+		if (cp->op & MSM_PREP_NOSYNC) {
+			ms = 0;
+		} else if (cp->timeout.tv_sec == 0 && cp->timeout.tv_nsec == 0) {
+			ms = GPU_PATIENCE_MS;
+		} else {
+			ms = drm_ms_until(&cp->timeout);
+		}
+		return gpu_wait(fence, ms) ? 0 : EBUSY;
+	}
+	case DRM_NR_MSM_GEM_SUBMIT: {
+		struct drm_msm_gem_submit *s = (struct drm_msm_gem_submit *)data;
+		uint32_t fence = 0;
+		int e = drm_do_gem_submit(s, &fence);
+		if (e) { return e; }
+		s->fence = fence;
+		return 0;
+	}
+	case DRM_NR_MSM_WAIT_FENCE: {
+		/* RedwoodGPU kMsmWaitFence. Zeroed (see CPU_PREP): all the GPU has been given. */
+		struct drm_msm_wait_fence *wf = (struct drm_msm_wait_fence *)data;
+		uint32_t fence = wf->fence ? wf->fence : gpu_last();
+		uint64_t ms = (wf->timeout.tv_sec == 0 && wf->timeout.tv_nsec == 0) ? GPU_PATIENCE_MS :
+		    drm_ms_until(&wf->timeout);
+		return gpu_wait(fence, ms) ? 0 : ETIMEDOUT;
+	}
+	case DRM_NR_MSM_GEM_MADVISE: {
+		/* RedwoodGPU: retained, always. Nothing here takes a buffer's memory away while its
+		 * handle is somebody's -- Mesa's cache gives an idle buffer back itself (GEM_CLOSE),
+		 * and freeing it under the handle (as was done here) left Mesa a mapped, cached,
+		 * possibly still-submitted buffer whose memory and addresses were someone else's. */
+		struct drm_msm_gem_madvise *gm = (struct drm_msm_gem_madvise *)data;
+		gm->retained = 1u;
+		return 0;
+	}
+	case DRM_NR_MSM_SUBMITQUEUE_NEW: {
+		struct drm_msm_submitqueue *sq = (struct drm_msm_submitqueue *)data;
+		sq->id = g_sq_next++;
+		return 0;
+	}
+	case DRM_NR_MSM_SUBMITQUEUE_CLOSE:
+	case DRM_NR_MSM_SUBMITQUEUE_QUERY:
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+drm_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag, __unused struct proc *p)
+{
+	unsigned nr  = (unsigned)(cmd & 0xffu);
+	unsigned typ = (unsigned)((cmd >> 8) & 0xffu);
+	int e;
+	if (typ != DRM_IOC_TYPE) {
+		return ENOTTY;
+	}
+	gpu_lock();
+	e = drm_ioctl_locked(nr, data);
+	gpu_unlock();
+	if (e == ENOTTY) {
+		printf("SWEET DRM: ioctl nr=%#x is not known here\n", nr);
+	}
+	return e;
+}
+
+static const struct cdevsw drm_cdevsw = {
+	.d_open       = kgsl_open,
+	.d_close      = kgsl_close,
+	.d_read       = kgsl_norw,
+	.d_write      = kgsl_norw,
+	.d_ioctl      = drm_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = kgsl_mmap,   /* map GEM BOs to userland (MSM_INFO_GET_OFFSET token) */
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = 0,
+};
+
+/* In-kernel self-test of the MSM-DRM GEM path: GET_PARAM(CHIP_ID), GEM_NEW x2,
+ * build a CP_MEM_WRITE IB in one targeting the other's iova, submit it via the
+ * shared ring core (the GEM_SUBMIT inner path), assign a fence, verify the store. */
+static void
+gpu_stage_v(void)
+{
+	uint64_t chip = 0;
+	struct kgsl_bo_ent *ib = NULL, *dst = NULL;
+	uint64_t ibva;
+	uint32_t ibdw, fence;
+	int rc;
+	uint32_t got;
+	if (!g_kgsl_ready) {
+		printf("SWEET DRM: [V] selftest skipped (submit path not published)\n");
+		return;
+	}
+	(void)drm_do_get_param(MSM_PARAM_CHIP_ID, &chip);
+	gpu_lock();
+	if (kgsl_do_gpumem_alloc(PAGE_SIZE, 0x20000u /*MSM_BO_WC*/, &ib) != 0 ||
+	    kgsl_do_gpumem_alloc(PAGE_SIZE, 0x20000u, &dst) != 0) {
+		gpu_unlock();
+		printf("SWEET DRM: [V] GEM_NEW FAIL\n"); return;
+	}
+	gpu_unlock();
+	*(volatile uint32_t *)dst->cpu_nc = 0;
+	((volatile uint32_t *)ib->cpu_nc)[0] = cp_type7(0x3Du, 3u);     /* CP_MEM_WRITE -> dst iova */
+	((volatile uint32_t *)ib->cpu_nc)[1] = (uint32_t)dst->gpuaddr;
+	((volatile uint32_t *)ib->cpu_nc)[2] = (uint32_t)(dst->gpuaddr >> 32);
+	((volatile uint32_t *)ib->cpu_nc)[3] = 0x5AFEDA7Au;
+	gpu_dcache_clean(ib->cpu_nc, PAGE_SIZE);    /* cacheable cva: flush IB + cleared dst to DRAM */
+	gpu_dcache_clean(dst->cpu_nc, PAGE_SIZE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	ibva = ib->gpuaddr; ibdw = 4u;
+	gpu_lock();
+	rc = kgsl_submit_ibs(&ibva, &ibdw, 1);
+	fence = rc == 0 ? gpu_last() : 0;
+	gpu_unlock();
+	gpu_dcache_clean(dst->cpu_nc, PAGE_SIZE);   /* invalidate: CPU re-reads GPU-written DRAM */
+	got = *(volatile uint32_t *)dst->cpu_nc;
+	printf("SWEET DRM: [V] MSM GEM SELFTEST chip_id=%#llx gem_ib=%u(iova=%#llx) gem_dst=%u(iova=%#llx) "
+	    "submit_rc=%d fence=%u readback=%#x(exp 5afeda7a) -> %s\n",
+	    (unsigned long long)chip, ib->id, (unsigned long long)ib->gpuaddr,
+	    dst->id, (unsigned long long)dst->gpuaddr, rc, fence, got,
+	    (rc == 0 && got == 0x5AFEDA7Au && chip == 0x06010800ull) ?
+	    "MSM-DRM GEM NEW+SUBMIT+FENCE OK (gallium-freedreno path)" : "FAIL");
+	gmub_flush();
+}
+
+static int g_drm_major = -1;
+static void
+gpu_drm_init(void)
+{
+	if (g_drm_major < 0) {
+		return;                 /* not registered (gpu_nodes_register) */
+	}
+	printf("SWEET DRM: /dev/dri/renderD128 (major=%d) name=msm -> MSM-DRM render node "
+	    "for gallium-freedreno GLES\n", g_drm_major);
+	gpu_stage_v();
+}
+
+/* Both device nodes, before the bring-up starts: an open waits for it (kgsl_open). Nothing of
+ * the GPU is touched here. */
+static void
+gpu_nodes_register(void)
+{
+	g_kgsl_major = cdevsw_add(-1, &kgsl_cdevsw);
+	if (g_kgsl_major < 0) {
+		printf("SWEET KGSL: cdevsw_add failed\n");
+	} else {
+		devfs_make_node(makedev(g_kgsl_major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "kgsl-3d0");
+	}
+	g_drm_major = cdevsw_add(-1, &drm_cdevsw);
+	if (g_drm_major < 0) {
+		printf("SWEET DRM: cdevsw_add failed\n");
+	} else {
+		/* Mesa's libdrm shim opens this node (drmOpenWithType("msm",...)); drmGetVersion
+		 * must then report name="msm". */
+		devfs_make_node(makedev(g_drm_major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "dri/renderD128");
+	}
+}
+
+static void
+gpu_probe(void)
+{
+	gpu_gcc = ml_io_map(GPU_GCC_PA, GPU_GCC_SIZE);
+	if (!gpu_gcc) {
+		printf("SWEET GPU: GCC map failed\n");
+		return;
+	}
+	/* GCC is always-on; these reads are safe and show the GPU clock state. */
+	printf("SWEET GPU: GCC gpu clk status (pre): ahb=%#x memnoc=%#x snoc=%#x axi=%#x\n",
+	    gpu_rd(gpu_gcc, GCC_GPU_CFG_AHB_CLK), gpu_rd(gpu_gcc, GCC_GPU_MEMNOC_GFX_CLK),
+	    gpu_rd(gpu_gcc, GCC_GPU_SNOC_DVM_CLK), gpu_rd(gpu_gcc, GCC_DDRSS_GPU_AXI_CLK));
+	/* Enable the GPU config/AHB + NoC branches so the GPUCC window is clocked.
+	 * BIT(0) turns a branch on; we never clear bits (never disable a live clock). */
+	gpu_wr(gpu_gcc, GCC_GPU_CFG_AHB_CLK,
+	    gpu_rd(gpu_gcc, GCC_GPU_CFG_AHB_CLK) | GCC_BRANCH_ENABLE);
+	gpu_wr(gpu_gcc, GCC_DDRSS_GPU_AXI_CLK,
+	    gpu_rd(gpu_gcc, GCC_DDRSS_GPU_AXI_CLK) | GCC_BRANCH_ENABLE);
+	gpu_wr(gpu_gcc, GCC_GPU_MEMNOC_GFX_CLK,
+	    gpu_rd(gpu_gcc, GCC_GPU_MEMNOC_GFX_CLK) | GCC_BRANCH_ENABLE);
+	gpu_wr(gpu_gcc, GCC_GPU_SNOC_DVM_CLK,
+	    gpu_rd(gpu_gcc, GCC_GPU_SNOC_DVM_CLK) | GCC_BRANCH_ENABLE);
+	delay_for_interval(200, NSEC_PER_USEC); /* ~200us for branches to settle */
+	printf("SWEET GPU: GCC gpu clk status (post): ahb=%#x memnoc=%#x snoc=%#x axi=%#x\n",
+	    gpu_rd(gpu_gcc, GCC_GPU_CFG_AHB_CLK), gpu_rd(gpu_gcc, GCC_GPU_MEMNOC_GFX_CLK),
+	    gpu_rd(gpu_gcc, GCC_GPU_SNOC_DVM_CLK), gpu_rd(gpu_gcc, GCC_DDRSS_GPU_AXI_CLK));
+
+	/* Now GPUCC should be reachable. This read is the Phase-0 make-or-break. */
+	gpu_gpucc = ml_io_map(GPU_GPUCC_PA, GPU_GPUCC_SIZE);
+	if (!gpu_gpucc) {
+		printf("SWEET GPU: GPUCC map failed\n");
+		return;
+	}
+	uint32_t cc = gpu_rd(gpu_gpucc, 0);
+	printf("SWEET GPU: davinci a618 (DT chipid %#x); gpucc[0]=%#x\n", GPU_DT_CHIPID, cc);
+	if (cc == 0xffffffffu) {
+		printf("SWEET GPU: GPUCC reads 0xffffffff - still gated (need GPU CX GDSC vote).\n");
+	} else {
+		printf("SWEET GPU: Phase 0 OK - GPUCC reachable after enabling GCC gpu clocks.\n");
+	}
+	/* Map the GPU power/clock state (all reads inside the reachable GPUCC
+	 * window). GDSCR bit31 = PWR_ON. Tells us what is already powered before we
+	 * attempt the GMU boot. Offsets from gpucc-sdmmagpie.c / a6xx_regs.h. */
+	uint32_t gx = gpu_rd(gpu_gpucc, GPUCC_GX_GDSCR);
+	uint32_t cx = gpu_rd(gpu_gpucc, GPUCC_CX_GDSCR);
+	uint32_t gmuclk = gpu_rd(gpu_gpucc, GPUCC_CX_GMU_CLK);
+	uint32_t cxoclk = gpu_rd(gpu_gpucc, GPUCC_CXO_CLK);
+	printf("SWEET GPU: GPUCC gx_gdsc=%#x(pwr_on=%d) cx_gdsc=%#x(pwr_on=%d) cx_gmu_clk=%#x cxo_clk=%#x\n",
+	    gx, (gx >> 31) & 1u, cx, (cx >> 31) & 1u, gmuclk, cxoclk);
+
+	if (gpu_level >= 2) {
+		gpu_tz_probe();
+	}
+	if (gpu_level >= 4) {
+		gpu_gmu_step1();
+	}
+	if (gpu_level >= 5) {
+		gpu_gmu_step2();
+	}
+	if (gpu_level >= 6) {
+		(void)gpu_gmu_boot();
+	}
+	/* Register the /dev/kgsl-3d0 UAPI node (+ in-kernel devinfo self-test) so
+	 * userland freedreno can bind once the root carries a client. */
+	gpu_kgsl_init();
+	/* Register the MSM-DRM render node (/dev/dri/renderD128) for the gallium-
+	 * freedreno GLES path, over the same proven ring/iova/submit core. */
+	gpu_drm_init();
+}
+
+/* Block (not busy-wait) for `secs` so the probe prints after USB + the host
+ * capture are up; the early-boot prints were scrolling past otherwise. */
+static void
+gpu_sleep(uint32_t secs)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(secs, NSEC_PER_SEC, &deadline);
+	assert_wait_deadline(&gpu_started, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* ---- SPMI PMIC-arbiter WRITE: set PON_SOFT_RB_SPARE = BOOTLOADER reason ----
+ * davinci's UEFI ABL reads the reboot target from the PMIC PON register (it
+ * persists across SoC reset), NOT the IMEM cookie (IMEM/PS_HOLD both went to
+ * MIUI). Mirror the proven observer-READ path (sweet_spmi.c) with an EXT_WRITEL
+ * on the chnls region. SPMI v5 regions (davinci DTB): core 0xc440000,
+ * chnls 0xc600000, obsrvr 0xe600000, cnfg 0xc40a000. Per-APID stride 0x80;
+ * CMD@+0 STATUS@+8 WDATA0@+0x10 RDATA0@+0x18. cmd=(opc<<27)|((addr&0xff)<<4);
+ * EXT_READL opc=1 (proven in the read path), EXT_WRITEL opc=0. Target =
+ * PON periph 0x08 reg SOFT_RB_SPARE 0x8f; BOOTLOADER reason 0x02 -> bits[7:1]. */
+#define SPMI_CORE_PA      0x0c440000u
+#define SPMI_CHNLS_PA     0x0c600000u
+#define SPMI_OBS_PA       0x0e600000u
+#define SPMI_CFG_PA       0x0c40a000u
+#define PON_PERIPH        0x08u
+#define PON_SOFT_RB_SPARE 0x8fu
+#define PON_REASON_BL     0x02u
+
+/* Read SOFT_RB_SPARE (periph 0x08 reg 0x8f) via the observer channel (direct
+ * reads work). Returns byte in *out; apid in *apid_out. -1 on failure. */
+static int
+spmi_pon_read(vm_offset_t core, vm_offset_t cfg, vm_offset_t obs,
+    unsigned count, unsigned *apid_out, uint8_t *out)
+{
+	unsigned i, apid = 0xffffu, ppid = (0u << 8) | PON_PERIPH;
+	for (i = 0; i < count; ++i) {               /* find APID; prefer owner EE 0 */
+		uint32_t map = *(volatile uint32_t *)(core + 0x900u + 4u * i);
+		if (!map || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		if (apid == 0xffffu ||
+		    ((*(volatile uint32_t *)(cfg + 0x700u + 4u * i)) & 7u) == 0u) {
+			apid = i;
+		}
+	}
+	if (apid == 0xffffu) {
+		return -1;
+	}
+	*apid_out = apid;
+	unsigned off = 0x80u * apid;
+	*(volatile uint32_t *)(obs + off) = (1u << 27) | ((PON_SOFT_RB_SPARE & 0xffu) << 4);
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (i = 0; i < 1000u; ++i) {
+		uint32_t st = *(volatile uint32_t *)(obs + off + 0x08u);
+		if (st & 1u) {
+			if (st & 0x0eu) {
+				return -1;
+			}
+			*out = (uint8_t)*(volatile uint32_t *)(obs + off + 0x18u);
+			return 0;
+		}
+		gmub_udelay(1);
+	}
+	return -1;
+}
+
+/* One byte of a PMIC register by the observer (EE 0) channel, as spmi_pon_read: reads only. */
+static vm_offset_t g_spmi_core, g_spmi_cfg, g_spmi_obs;
+static unsigned g_spmi_count;
+static int
+spmi_rd8(unsigned sid, unsigned addr, uint8_t *out)
+{
+	unsigned i, apid = 0xffffu, ppid = (sid << 8) | (addr >> 8);
+	if (!g_spmi_core) {
+		g_spmi_core = ml_io_map(SPMI_CORE_PA, 0x2000u);
+		g_spmi_cfg = ml_io_map(SPMI_CFG_PA, 0x1000u);
+		g_spmi_obs = ml_io_map(SPMI_OBS_PA, 0x10000u);
+		if (!g_spmi_core || !g_spmi_cfg || !g_spmi_obs) {
+			g_spmi_core = 0;
+			return -1;
+		}
+		g_spmi_count = (*(volatile uint32_t *)(g_spmi_core + 4)) & 0x7ffu;
+	}
+	for (i = 0; i < g_spmi_count && i < 512u; ++i) {
+		uint32_t map = *(volatile uint32_t *)(g_spmi_core + 0x900u + 4u * i);
+		if (!map || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		if (apid == 0xffffu || ((*(volatile uint32_t *)(g_spmi_cfg + 0x700u + 4u * i)) & 7u) == 0u) {
+			apid = i;
+		}
+	}
+	if (apid == 0xffffu) {
+		return -2;
+	}
+	*(volatile uint32_t *)(g_spmi_obs + 0x80u * apid) = (1u << 27) | ((addr & 0xffu) << 4);
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (i = 0; i < 1000u; ++i) {
+		uint32_t st = *(volatile uint32_t *)(g_spmi_obs + 0x80u * apid + 0x08u);
+		if (st & 1u) {
+			if (st & 0x0eu) {
+				return -3;
+			}
+			*out = (uint8_t)*(volatile uint32_t *)(g_spmi_obs + 0x80u * apid + 0x18u);
+			return 0;
+		}
+		gmub_udelay(1);
+	}
+	return -4;
+}
+
+/*
+ * What SweetBattery reads (patch 0062: PM6150 QG 0x48xx, charger 0x10xx/0x11xx, USB 0x13xx), raw,
+ * to see why it falls back to its static 100%: reads only.
+ */
+static void
+battery_report(void)
+{
+	static const uint16_t regs[] = { 0x4804, 0x4805, 0x4808, 0x48c0, 0x48c1, 0x48c2, 0x48c3, 0x1310, 0x110b,
+		0x1006, 0x1007, 0x100d, 0x1004, 0x1104, 0x1304 };
+	static bool listed;
+	char line[300];
+	int at = 0;
+	unsigned i;
+	for (i = 0; i < sizeof(regs) / sizeof(regs[0]); i++) {
+		uint8_t v = 0;
+		int e = spmi_rd8(0, regs[i], &v);
+		at += snprintf(line + at, sizeof(line) - (size_t)at, e ? " %04x:e%d" : " %04x:%02x", regs[i], e ? -e : v);
+	}
+	printf("SWEET BATT RAW:%s\n", line);
+	if (!listed && g_spmi_core) {
+		listed = true;
+		for (unsigned sid = 0; sid <= 2u; sid += 2u) {
+			at = 0;
+			for (i = 0; i < g_spmi_count && i < 512u && at < (int)sizeof(line) - 6; i++) {
+				uint32_t map = *(volatile uint32_t *)(g_spmi_core + 0x900u + 4u * i);
+				if (map && ((map >> 16) & 0xfu) == sid) {
+					at += snprintf(line + at, sizeof(line) - (size_t)at, " %02x", (map >> 8) & 0xffu);
+				}
+			}
+			printf("SWEET BATT SID%u peripherals:%s\n", sid, line);
+		}
+	}
+}
+
+static int
+spmi_set_pon_bootloader(void)
+{
+	vm_offset_t core = ml_io_map(SPMI_CORE_PA, 0x2000u);
+	vm_offset_t cfg  = ml_io_map(SPMI_CFG_PA, 0x1000u);
+	vm_offset_t obs  = ml_io_map(SPMI_OBS_PA, 0x10000u);
+	unsigned count, apid = 0xffffu;
+	uint32_t ver;
+	uint8_t old = 0, val, rb = 0xff;
+	uint64_t r[4];
+
+	if (!core || !cfg || !obs) {
+		printf("SWEET GPU: SPMI map failed\n");
+		return -1;
+	}
+	ver = *(volatile uint32_t *)core;
+	count = (*(volatile uint32_t *)(core + 4)) & 0x7ffu;
+	if (ver < 0x50000000u || ver >= 0x70000000u || !count || count > 512) {
+		printf("SWEET GPU: SPMI arb=%#x count=%u unsupported\n", ver, count);
+		return -1;
+	}
+	if (spmi_pon_read(core, cfg, obs, count, &apid, &old) != 0) {
+		printf("SWEET GPU: SPMI PON read failed (no APID / read err)\n");
+		return -1;
+	}
+	val = (uint8_t)((old & 0x01u) | (PON_REASON_BL << 1));  /* 0x04 in bits[7:1] */
+	/* WRITE via TZ SCM_IO_WRITE: EL3 stores to the XPU-blocked chnls region.
+	 * WDATA0 (chnls+off+0x10) = byte, then CMD (chnls+off) = EXT_WRITEL(opc0). */
+	unsigned off = 0x80u * apid;
+	gpu_smc(QCOM_SCM_IO_WRITE_FNID, 2, (uint64_t)SPMI_CHNLS_PA + off + 0x10u, val,
+	    0, 0, 0, r);
+	uint64_t w1 = r[0];
+	gpu_smc(QCOM_SCM_IO_WRITE_FNID, 2, (uint64_t)SPMI_CHNLS_PA + off,
+	    (0u << 27) | ((PON_SOFT_RB_SPARE & 0xffu) << 4), 0, 0, 0, r);
+	uint64_t w2 = r[0];
+	gmub_udelay(50);
+	(void)spmi_pon_read(core, cfg, obs, count, &apid, &rb);  /* confirm */
+	printf("SWEET GPU: PON via SCM apid=%u old=%#x new=%#x readback=%#x scm=%lld,%lld\n",
+	    apid, old, val, rb, (long long)w1, (long long)w2);
+	return (rb == val) ? 0 : -1;
+}
+
+/* Reboot to fastboot via the PMIC PON reason, then reset. Does not return on
+ * success. Lets the host drive the GPU dev loop hands-free. */
+static void
+gpu_reboot_fastboot(void)
+{
+	(void)spmi_set_pon_bootloader();   /* PON reason persists across the reset */
+	gmub_flush();                      /* flush the USB log before resetting */
+	uint64_t r[4];
+	gpu_smc(PSCI_SYSTEM_RESET, 0, 0, 0, 0, 0, 0, r);
+	vm_offset_t ph = ml_io_map(PSHOLD_PA, 0x1000u);   /* fallback if PSCI returns */
+	if (ph) {
+		*(volatile uint32_t *)ph = 0u;
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	for (;;) {
+		__asm__ volatile("wfe");
+	}
+}
+
+/*
+ * The reboot reason, written as Linux writes it (what TWRP's "reboot bootloader" does: qcom-pon's
+ * reboot-mode sets PON SOFT_RB_SPARE bits[7:1] = 2 over SPMI, then the reset; ABL reads it back).
+ * Linux spmi-pmic-arb v5: an APID's read/write channel is at chnls + 0x10000 * apid -- the
+ * observer channel, which the reads use, is at obsrvr + 0x10000 * ee + 0x80 * apid. The write
+ * tried before used the observer's 0x80 stride on the write region, i.e. another channel than
+ * ours, which the XPU refused; and then it went through TrustZone, which refused it as well.
+ */
+static int
+spmi_pon_write_direct(unsigned apid, uint8_t val)
+{
+	vm_offset_t ch = ml_io_map(SPMI_CHNLS_PA + 0x10000u * apid, 0x1000u);
+	unsigned i;
+	if (!ch) {
+		return -1;
+	}
+	*(volatile uint32_t *)(ch + 0x10u) = val;                                   /* WDATA0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x00u) = (0u << 27) | ((PON_SOFT_RB_SPARE & 0xffu) << 4) | 0u;   /* EXT_WRITEL, 1 byte */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (i = 0; i < 1000u; ++i) {
+		uint32_t st = *(volatile uint32_t *)(ch + 0x08u);                      /* STATUS */
+		if (st & 1u) {
+			return (st & 0x0eu) ? -2 : 0;
+		}
+		gmub_udelay(1);
+	}
+	return -3;
+}
+
+/* A PON register other than SOFT_RB_SPARE, by the same channel. */
+static int
+spmi_pon_wr(unsigned apid, uint8_t reg, uint8_t val)
+{
+	vm_offset_t ch = ml_io_map(SPMI_CHNLS_PA + 0x10000u * apid, 0x1000u);
+	unsigned i;
+	if (!ch) {
+		return -1;
+	}
+	*(volatile uint32_t *)(ch + 0x10u) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x00u) = (0u << 27) | ((reg & 0xffu) << 4) | 0u;
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (i = 0; i < 1000u; ++i) {
+		uint32_t st = *(volatile uint32_t *)(ch + 0x08u);
+		if (st & 1u) {
+			return (st & 0x0eu) ? -2 : 0;
+		}
+		gmub_udelay(1);
+	}
+	return -3;
+}
+
+static int
+sweet_reboot_fastboot(uint32_t mode)
+{
+	vm_offset_t core = ml_io_map(SPMI_CORE_PA, 0x2000u);
+	vm_offset_t cfg  = ml_io_map(SPMI_CFG_PA, 0x1000u);
+	vm_offset_t obs  = ml_io_map(SPMI_OBS_PA, 0x10000u);
+	unsigned count, apid = 0xffffu, owner;
+	uint8_t old = 0, val, rb = 0xff;
+	int rc;
+
+	if (!core || !cfg || !obs) {
+		printf("SWEET REBOOT: SPMI map failed\n");
+		return -1;
+	}
+	count = (*(volatile uint32_t *)(core + 4)) & 0x7ffu;
+	if (!count || count > 512 || spmi_pon_read(core, cfg, obs, count, &apid, &old) != 0) {
+		printf("SWEET REBOOT: PON not found / not readable (count %u)\n", count);
+		return -1;
+	}
+	owner = (*(volatile uint32_t *)(cfg + 0x700u + 4u * apid)) & 7u;
+	val = (uint8_t)((old & 0x01u) | (PON_REASON_BL << 1));
+	rc = spmi_pon_write_direct(apid, val);
+	gmub_udelay(50);
+	(void)spmi_pon_read(core, cfg, obs, count, &apid, &rb);
+	printf("SWEET REBOOT: PON apid %u (owner ee %u) SOFT_RB_SPARE %#x -> %#x: write %d, reads back %#x%s\n",
+	    apid, owner, old, val, rc, rb, rb == val ? " (SET: a reset now goes to fastboot)" : " (NOT set)");
+	{       /* and the IMEM cookie the downstream kernel also leaves (harmless if ABL ignores it) */
+		vm_offset_t imem = ml_io_map(IMEM_PA, IMEM_SIZE);
+		if (imem) {
+			*(volatile uint32_t *)(imem + IMEM_RESTART_REASON_OFF) = RESTART_REASON_FASTBOOT;
+			__asm__ volatile("dsb sy" ::: "memory");
+		}
+	}
+	if (mode == 0) {
+		return rb == val ? 0 : -1;
+	}
+	printf("SWEET REBOOT: resetting\n");
+	gpu_sleep(1);                      /* the line out over the network first */
+	{
+		uint64_t r[4];
+		gpu_smc(PSCI_SYSTEM_RESET, 0, 0, 0, 0, 0, 0, r);
+	}
+	return -1;
+}
+
+/*
+ * Power off and restart. Nothing set PE_halt_restart, so iOS's "slide to power off" and restart
+ * ended in halt_all_cpus()'s spin. As Linux's msm-poweroff and qpnp-power-on do it: the boot
+ * reason in SOFT_RB_SPARE cleared (sweetgpu_armfb leaves "bootloader" there, which would bring
+ * an intended restart up in fastboot), the PMIC's PS_HOLD reset type (PON 0x5a bits[3:0]; on
+ * this gen2 PON its enable, bit 7, is in 0x5b, cleared while the type changes) set to shutdown
+ * or hard reset, then PS_HOLD dropped: the PMIC does the rest. A restart tries PSCI
+ * SYSTEM_RESET first, as the fastboot reboot does. Panics keep the old path (fastboot when
+ * armed). Boot-arg sweethalt=0 leaves the hook unset.
+ */
+#define PON_PS_HOLD_RST_CTL     0x5au
+#define PON_PS_HOLD_RST_CTL2    0x5bu
+#define PON_RESET_EN            0x80u
+#define PON_TYPE_SHUTDOWN       0x04u
+#define PON_TYPE_HARD_RESET     0x07u
+enum { SWEET_PE_HALT = 0, SWEET_PE_RESTART = 1, SWEET_PE_UPS_HALT = 3 };   /* IOPlatformExpert.h kPE* */
+extern int (*PE_halt_restart)(unsigned int type);
+extern void sweet_camera_quiesce(void);        /* bsd/dev/sweet_camera.c: the sensor powered down first */
+
+static int
+sweet_halt_restart(unsigned int type)
+{
+	bool off = (type == SWEET_PE_HALT || type == SWEET_PE_UPS_HALT);
+	vm_offset_t core, cfg, obs, ph;
+	unsigned count, apid = 0xffffu;
+	uint8_t spare = 0, ctl = 0, ctl2 = 0;
+	uint64_t r[4];
+
+	if (!off && type != SWEET_PE_RESTART) {
+		return -1;
+	}
+	sweet_camera_quiesce();
+	core = ml_io_map(SPMI_CORE_PA, 0x2000u);
+	cfg = ml_io_map(SPMI_CFG_PA, 0x1000u);
+	obs = ml_io_map(SPMI_OBS_PA, 0x10000u);
+	count = core ? (*(volatile uint32_t *)(core + 4)) & 0x7ffu : 0;
+	if (cfg && obs && count && count <= 512 && spmi_pon_read(core, cfg, obs, count, &apid, &spare) == 0) {
+		int w0 = spmi_pon_wr(apid, PON_SOFT_RB_SPARE, (uint8_t)(spare & 0x01u));
+		(void)spmi_rd8(0, (PON_PERIPH << 8) | PON_PS_HOLD_RST_CTL, &ctl);
+		(void)spmi_rd8(0, (PON_PERIPH << 8) | PON_PS_HOLD_RST_CTL2, &ctl2);
+		int w1 = spmi_pon_wr(apid, PON_PS_HOLD_RST_CTL2, (uint8_t)(ctl2 & ~PON_RESET_EN));
+		gmub_udelay(500);               /* 10 sleep-clock cycles, with Linux's margin */
+		int w2 = spmi_pon_wr(apid, PON_PS_HOLD_RST_CTL,
+		    (uint8_t)((ctl & 0xf0u) | (off ? PON_TYPE_SHUTDOWN : PON_TYPE_HARD_RESET)));
+		int w3 = spmi_pon_wr(apid, PON_PS_HOLD_RST_CTL2, (uint8_t)(ctl2 | PON_RESET_EN));
+		printf("SWEET HALT: %s: reason %#x -> %#x, PS_HOLD type %#x -> %#x, writes %d %d %d %d\n",
+		    off ? "power off" : "restart", spare, spare & 0x01u, ctl,
+		    (ctl & 0xf0u) | (off ? PON_TYPE_SHUTDOWN : PON_TYPE_HARD_RESET), w0, w1, w2, w3);
+	} else {
+		printf("SWEET HALT: %s: PMIC PON not reachable\n", off ? "power off" : "restart");
+	}
+	gmub_flush();
+	gmub_udelay(200000);                    /* the line out over the network first */
+	if (!off) {
+		gpu_smc(PSCI_SYSTEM_RESET, 0, 0, 0, 0, 0, 0, r);
+	}
+	ph = ml_io_map(PSHOLD_PA, 0x1000u);
+	if (ph) {
+		*(volatile uint32_t *)ph = 0u;
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	for (;;) {
+		__asm__ volatile("wfe");
+	}
+}
+
+/*
+ * The GPU's clock, as Linux's a6xx_gmu_set_freq() sets it on a legacy GMU (the a618; davinci's own
+ * kernel has qcom,gpu-quirk-hfi-use-reg, the same register path): the perf level into
+ * GMU_DCVS_PERF_SETTING, "any bandwidth" into GMU_DCVS_BW_SETTING, and the DCVS OOB raised and
+ * cleared; the GMU firmware moves the GX clock and says how it went in GMU_DCVS_RETURN. davinci's
+ * levels (qcom,gpu-pwrlevels): 0 825, 1 800, 2 650, 3 565, 4 430, 5 355, 6 267, 7 180 MHz.
+ * With the lock held, the GPU idle first.
+ */
+#define GMUB_DCVS_ACK_OPTION    0x1CBFCu
+#define GMUB_DCVS_PERF_SETTING  0x1CBFDu
+#define GMUB_DCVS_BW_SETTING    0x1CBFEu
+#define GMUB_DCVS_RETURN        0x1CBFFu
+#define GMUB_OOB_DCVS_SET       (1u << 23)
+#define GMUB_OOB_DCVS_ACK       (1u << 31)
+static int
+gpu_set_level(uint32_t level, uint64_t *out)
+{
+	unsigned polls;
+	uint32_t info = 0, ret;
+	if (!g_kgsl_ready || !gpu_gmu || g_gpu_nlevels == 0) {
+		return EINVAL;
+	}
+	if (level >= g_gpu_nlevels) {           /* past the bin's slowest (7 on an 825 bin): the slowest */
+		level = g_gpu_nlevels - 1u;
+	}
+	if (!g_hfi_up) {                        /* without the table of speeds the GMU faults on DCVS */
+		return ENODEV;
+	}
+	(void)gpu_wait(gpu_last(), 1000u);
+	gmub_wr(GMUB_DCVS_ACK_OPTION, 0);       /* DCVS_ACK_NONBLOCK */
+	/* the GMU's index into the table it was sent: ascending, 0 the 0 Hz level (vendor gmu_dcvs_set:
+	 * num_gpupwrlevels - pwrlevel - 1); CLKSET_OPTION_ATLEAST; the bus vote left as it is (0xFF) */
+	gmub_wr(GMUB_DCVS_PERF_SETTING, (3u << 28) | (g_gpu_nlevels - level));
+	{       /* vendor BW_VOTE(idx); 0xFF: leave the bus as it is (only "off" in the table) */
+		uint32_t bw = g_bw_levels > 1u ? bus_level(g_gpu_mhz[level]) : 0xFFu;
+		gmub_wr(GMUB_DCVS_BW_SETTING, (bw << 12) | bw);
+	}
+	__asm__ volatile("dsb osh" ::: "memory");
+	gmub_wr(GMUB_HOST2GMU_INTR_SET, GMUB_OOB_DCVS_SET);
+	for (polls = 0; polls < 10000u; polls++) {             /* 100 ms */
+		info = gmub_rd(GMUB_GMU2HOST_INTR_INFO);
+		if (info & GMUB_OOB_DCVS_ACK) {
+			break;
+		}
+		gmub_udelay(10);
+	}
+	gmub_wr(GMUB_GMU2HOST_INTR_CLR, GMUB_OOB_DCVS_ACK);
+	gmub_wr(GMUB_HOST2GMU_INTR_SET, GMUB_OOB_DCVS_ACK);     /* clear the OOB (legacy: bit 31) */
+	ret = gmub_rd(GMUB_DCVS_RETURN);
+	if (g_level_quiet) {
+		if (info & GMUB_OOB_DCVS_ACK) {
+			g_gpu_level = level;
+		}
+		*out = (uint64_t)ret | ((uint64_t)((info & GMUB_OOB_DCVS_ACK) ? 1u : 0u) << 32);
+		return 0;
+	}
+	if (g_core) {           /* the clock it really runs at: the core's cycle counter over 2 ms */
+		uint64_t c0, c1, t0, t1, ns;
+		c0 = (uint64_t)gpu_rd(g_core, 0x401u << 2) << 32 | gpu_rd(g_core, 0x400u << 2);
+		t0 = mach_absolute_time();
+		gmub_udelay(2000);
+		c1 = (uint64_t)gpu_rd(g_core, 0x401u << 2) << 32 | gpu_rd(g_core, 0x400u << 2);
+		t1 = mach_absolute_time();
+		absolutetime_to_nanoseconds(t1 - t0, &ns);
+		printf("SWEET GPU: measured %llu MHz (%llu cycles in %llu us)\n", ns ? (c1 - c0) * 1000u / ns : 0,
+		    c1 - c0, ns / 1000u);
+	}
+	printf("SWEET GPU: level %u (%u MHz) asked: %s after %u polls (intr %#x), DCVS return %#x\n", level, g_gpu_mhz[level],
+	    (info & GMUB_OOB_DCVS_ACK) ? "acked" : "NOT acked", polls, info, ret);
+	if (info & GMUB_OOB_DCVS_ACK) {
+		g_gpu_level = level;
+	}
+	*out = (uint64_t)ret | ((uint64_t)((info & GMUB_OOB_DCVS_ACK) ? 1u : 0u) << 32);
+	return 0;
+}
+
+/*
+ * Wi-Fi, step 1 (boot-arg sweetwifi=1): the survey, reads only -- HackiOS redwood_wifi.c step_smem
+ * for davinci (WIFI-PLAN.md). The WCN3990's firmware runs in the modem, so the processor to look for is
+ * the modem (SMEM host 1): the shared memory area as the boot loader laid it out (dt: smem@86000000,
+ * 2 MB), the partition of us and the modem, and whether the modem has left its SMP2P item (428,
+ * qcom,smp2p-modem), its last words (421) or GLINK's descriptor (478) there: it has, if it ran since
+ * the phone was started. Nothing is written.
+ */
+#define WSMEM_PHYS      0x86000000u
+#define WSMEM_SIZE      0x00200000u
+#define WSMEM_US        0
+#define WSMEM_MODEM     1
+#define WSMEM_GLOBAL    0xfffe
+#define WSMEM_CANARY    0xa5a5
+struct wsmem_table_entry { uint32_t offset, size, flags; uint16_t host0, host1; uint32_t cacheline, reserved[7]; };
+struct wsmem_table { uint8_t magic[4]; uint32_t version, count, reserved[5]; };
+struct wsmem_partition { uint8_t magic[4]; uint16_t host0, host1; uint32_t size, free_uncached, free_cached, reserved[3]; };
+struct wsmem_entry { uint16_t canary, item; uint32_t size; uint16_t padding_data, padding_header; uint32_t reserved; };
+static volatile uint8_t *wsmem;
+
+/*
+ * Wi-Fi, step 2 (boot-arg sweetwifi=1, still reads only) -- HackiOS redwood_wifi.c step_mailbox and the
+ * doorbells, for davinci. Two always-on blocks, read as they are:
+ *   - the always-on processor's QMP mailbox (dt: qcom,qmp-aop@c300000, "msgram" 4 KB, 32-bit accesses):
+ *     it begins with a description of the two directions -- "their"/ucore = the AOP, "our"/mcore = us --
+ *     each with a link state, a channel state, the other side's acknowledgement, and where/how big its
+ *     mailbox is. The QMP protocol is SoC-independent, so the offsets are redwood's. We only read: the
+ *     magic tells whether this is the descriptor at all, and the link words whether a boot stage before
+ *     us has already brought the AOP channel up (UP 0x0000ffff / DOWN 0xffff0000 per direction).
+ *   - the one doorbell register that davinci rings every processor through (dt: syscon@17c0000c, the APCS
+ *     global IPC; 4 bytes). SM7150 is NOT redwood's IPCC@408000 (clients+signals): here each processor is
+ *     one bit of this single write-1-to-pulse register -- AOP = bit 0 (qcom,qmp-aop irq-reg-base+mask 1),
+ *     modem SMP2P = bit 14 (qcom,smp2p-modem ipc <..0 0xe>), modem GLINK = bit 12. Reading it only reports
+ *     the current latched word; nothing is written. This is the survey's last reads-only step before the
+ *     modem is ever loaded.
+ */
+#define WAOP_MSGRAM_PHYS   0x0c300000u            /* dt qcom,qmp-aop@c300000 reg[0] "msgram" */
+#define WAOP_MSGRAM_SIZE   0x00001000u            /* 4 KB (dt reg size); QMP descriptor + mailboxes */
+#define WAPCS_IPC_PHYS     0x17c0000cu            /* dt syscon@17c0000c: the APCS global IPC doorbell */
+/* QMP descriptor offsets (SoC-independent; redwood_wifi.c). "their" = AOP/ucore, "our" = us/mcore. */
+#define QMP_MAGIC          0x00
+#define QMP_MAGIC_VALUE    0x4d41494cu            /* "LIAM" / "MAIL" */
+#define QMP_VERSION        0x04
+#define QMP_FEATURES       0x08
+#define QMP_THEIR_LINK     0x0c
+#define QMP_THEIR_LINK_ACK 0x10
+#define QMP_THEIR_CHANNEL  0x14
+#define QMP_THEIR_CHAN_ACK 0x18
+#define QMP_THEIR_BOX_SIZE 0x1c
+#define QMP_THEIR_BOX      0x20
+#define QMP_OUR_LINK       0x24
+#define QMP_OUR_LINK_ACK   0x28
+#define QMP_OUR_CHANNEL    0x2c
+#define QMP_OUR_CHAN_ACK   0x30
+#define QMP_OUR_BOX_SIZE   0x34
+#define QMP_OUR_BOX        0x38
+#define QMP_UP             0x0000ffffu
+#define QMP_DOWN           0xffff0000u
+
+static uint32_t
+wmmio_rd32(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static const char *
+qmp_state(uint32_t v)
+{
+	return v == QMP_UP ? "UP" : v == QMP_DOWN ? "DOWN" : "?";
+}
+
+static vm_offset_t waop_base;    /* AOP QMP msgram (0xc300000), mapped once */
+static vm_offset_t wapcs_base;   /* APCS IPC doorbell page (0x17c00000), mapped once */
+static uint32_t    wifi_our_box; /* offset of our mailbox inside the msgram, set when the channel is open */
+
+static void
+wmmio_wr32(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dmb oshst" ::: "memory");
+}
+
+/* Map the two always-on blocks once; reused by the survey and the open. */
+static bool
+wifi_map_blocks(void)
+{
+	if (!waop_base) {
+		waop_base = ml_io_map(WAOP_MSGRAM_PHYS, WAOP_MSGRAM_SIZE);
+	}
+	if (!wapcs_base) {
+		wapcs_base = ml_io_map(WAPCS_IPC_PHYS & ~0xfffu, PAGE_SIZE);
+	}
+	return waop_base != 0;
+}
+
+/* Ring the always-on processor's doorbell: davinci sets bit 0 of the single APCS IPC register. */
+static void
+wifi_ring_aop(void)
+{
+	if (wapcs_base) {
+		wmmio_wr32(wapcs_base, WAPCS_IPC_PHYS & 0xfffu, 1u << 0);
+	}
+}
+
+/* Poll a QMP descriptor word until it reads `want`, up to `ms` ms (200 us steps). */
+static bool
+wifi_qmp_wait(uint32_t off, uint32_t want, unsigned ms)
+{
+	for (unsigned i = 0; i <= ms * 5u; i++) {
+		if (wmmio_rd32(waop_base, off) == want) {
+			return true;
+		}
+		delay_for_interval(200, NSEC_PER_USEC);
+	}
+	return false;
+}
+
+static void
+wifi_mailbox_survey(void)
+{
+	vm_offset_t aop, ipc;
+	uint32_t magic, ver, feat, boxsz, boxoff;
+
+	(void)wifi_map_blocks();
+	/* --- the always-on processor's QMP mailbox description (reads only) --- */
+	printf("SWEET WIFI: [2] the always-on processor's QMP mailbox at %#x, %#x bytes (reads only)\n",
+	    WAOP_MSGRAM_PHYS, WAOP_MSGRAM_SIZE);
+	aop = waop_base;
+	if (!aop) {
+		printf("SWEET WIFI: [2] cannot map the AOP mailbox\n");
+	} else {
+		magic  = wmmio_rd32(aop, QMP_MAGIC);
+		ver    = wmmio_rd32(aop, QMP_VERSION);
+		feat   = wmmio_rd32(aop, QMP_FEATURES);
+		printf("SWEET WIFI: [2] magic %#x (%s), version %#x, features %#x\n", magic,
+		    magic == QMP_MAGIC_VALUE ? "QMP descriptor" : "NOT a QMP descriptor", ver, feat);
+		if (magic != QMP_MAGIC_VALUE) {
+			printf("SWEET WIFI: [2] the mailbox has no description yet (AOP link not laid out from here)\n");
+		} else {
+			uint32_t tl = wmmio_rd32(aop, QMP_THEIR_LINK), tla = wmmio_rd32(aop, QMP_THEIR_LINK_ACK);
+			uint32_t tc = wmmio_rd32(aop, QMP_THEIR_CHANNEL), tca = wmmio_rd32(aop, QMP_THEIR_CHAN_ACK);
+			uint32_t ol = wmmio_rd32(aop, QMP_OUR_LINK), ola = wmmio_rd32(aop, QMP_OUR_LINK_ACK);
+			uint32_t oc = wmmio_rd32(aop, QMP_OUR_CHANNEL), oca = wmmio_rd32(aop, QMP_OUR_CHAN_ACK);
+			printf("SWEET WIFI: [2] their (AOP) link %#x (%s) ack %#x, channel %#x (%s) ack %#x\n",
+			    tl, qmp_state(tl), tla, tc, qmp_state(tc), tca);
+			printf("SWEET WIFI: [2] our link %#x (%s) ack %#x, channel %#x (%s) ack %#x\n",
+			    ol, qmp_state(ol), ola, oc, qmp_state(oc), oca);
+			boxsz  = wmmio_rd32(aop, QMP_OUR_BOX_SIZE);
+			boxoff = wmmio_rd32(aop, QMP_OUR_BOX);
+			printf("SWEET WIFI: [2] their box %#x/%#x bytes, our box %#x/%#x bytes\n",
+			    wmmio_rd32(aop, QMP_THEIR_BOX), wmmio_rd32(aop, QMP_THEIR_BOX_SIZE), boxoff, boxsz);
+			if (boxsz >= 68u && boxoff >= 0x3cu && (uint64_t)boxoff + boxsz <= WAOP_MSGRAM_SIZE) {
+				printf("SWEET WIFI: [2] length word in our box = %#x (0 = AOP has taken the last message)\n",
+				    wmmio_rd32(aop, boxoff));
+			}
+			if (tl == QMP_UP || ol == QMP_UP) {
+				printf("SWEET WIFI: [2] NOTE: a QMP link is already UP -- a stage before us opened the AOP\n");
+			}
+		}
+	}
+
+	/* --- the one APCS doorbell register davinci rings every processor through (reads only) --- */
+	printf("SWEET WIFI: [2] the APCS global IPC doorbell at %#x (reads only; bit 0 = AOP, 14 = modem SMP2P, 12 = modem GLINK)\n",
+	    WAPCS_IPC_PHYS);
+	ipc = wapcs_base;
+	if (!ipc) {
+		printf("SWEET WIFI: [2] cannot map the APCS IPC register\n");
+	} else {
+		uint32_t d = wmmio_rd32(ipc, WAPCS_IPC_PHYS & 0xfffu);
+		printf("SWEET WIFI: [2] doorbell register = %#x (pending bits: AOP=%u SMP2P=%u GLINK=%u)\n",
+		    d, (d >> 0) & 1u, (d >> 14) & 1u, (d >> 12) & 1u);
+	}
+	printf("SWEET WIFI: [2] survey done, reads only -- modem has not been touched\n");
+}
+
+/*
+ * Wi-Fi, step 3 (boot-arg sweetwifi=2): THE FIRST WRITE. Open the QMP channel to the always-on
+ * processor, Linux's qmp_open() a step at a time (HackiOS redwood_wifi.c step_mailbox_open): ack
+ * their link, raise ours and wait for their ack, raise our channel and wait for theirs, ack that
+ * and wait for their ack of ours. Each write is announced first; every write is to the AOP QMP
+ * descriptor or its doorbell only -- the modem is still NOT touched (that is a later step, gated
+ * higher). On any timeout we take our side back down so the AOP is left as we found it. The AOP
+ * is restarted only with the phone, so a channel a kernel before us opened is found open and left.
+ *
+ * Survey (2026-10-26) found: AOP link UP, our link/channel DOWN, doorbell clear -- the clean state
+ * to open from. our box = 0x128, size 0x2d8. Opening the AOP does not reset anything; it is the
+ * prerequisite for later telling the AOP "the modem image is loading" before the PAS auth+reset.
+ */
+static bool
+wifi_mailbox_open(void)
+{
+	uint32_t box, size, tl, ol, ola, tc, oca;
+
+	printf("SWEET WIFI: [3] OPEN the always-on processor's QMP channel (FIRST WRITE; AOP + its doorbell only)\n");
+	if (!wifi_map_blocks() || !wapcs_base) {
+		printf("SWEET WIFI: [3] cannot map the AOP mailbox / doorbell -- not opening\n");
+		return false;
+	}
+	if (wmmio_rd32(waop_base, QMP_MAGIC) != QMP_MAGIC_VALUE || wmmio_rd32(waop_base, QMP_VERSION) != 1u) {
+		printf("SWEET WIFI: [3] not a QMP descriptor this knows -- not opening\n");
+		return false;
+	}
+	box  = wmmio_rd32(waop_base, QMP_OUR_BOX);
+	size = wmmio_rd32(waop_base, QMP_OUR_BOX_SIZE);
+	if (size < 68u || box < 0x3cu || (uint64_t)box + size > WAOP_MSGRAM_SIZE || (box & 3u)) {
+		printf("SWEET WIFI: [3] our mailbox (%#x/%#x) is not where a message fits -- not opening\n", box, size);
+		return false;
+	}
+
+	/* Already fully open (a kernel before us)? Find it so, leave it. */
+	if (wmmio_rd32(waop_base, QMP_OUR_LINK) == QMP_UP && wmmio_rd32(waop_base, QMP_OUR_LINK_ACK) == QMP_UP &&
+	    wmmio_rd32(waop_base, QMP_OUR_CHANNEL) == QMP_UP && wmmio_rd32(waop_base, QMP_THEIR_CHANNEL) == QMP_UP &&
+	    wmmio_rd32(waop_base, QMP_OUR_CHAN_ACK) == QMP_UP) {
+		wifi_our_box = box;
+		printf("SWEET WIFI: [3] the channel is open already (opened before this kernel); our box %#x\n", box);
+		return true;
+	}
+
+	/* 1) acknowledge their link, then raise ours; ring; wait for their ack. */
+	tl = wmmio_rd32(waop_base, QMP_THEIR_LINK);
+	printf("SWEET WIFI: [3] write their-link-ack = %#x, our-link = UP, ring AOP doorbell\n", tl);
+	wmmio_wr32(waop_base, QMP_THEIR_LINK_ACK, tl);
+	wmmio_wr32(waop_base, QMP_OUR_LINK, QMP_UP);
+	wifi_ring_aop();
+	if (!wifi_qmp_wait(QMP_OUR_LINK_ACK, QMP_UP, 1000)) {
+		ola = wmmio_rd32(waop_base, QMP_OUR_LINK_ACK);
+		printf("SWEET WIFI: [3] AOP did NOT ack our link within 1 s (ack=%#x); taking our link down\n", ola);
+		wmmio_wr32(waop_base, QMP_OUR_LINK, QMP_DOWN);
+		wifi_ring_aop();
+		return false;
+	}
+	printf("SWEET WIFI: [3] AOP has seen our link\n");
+
+	/* 2) raise our channel; ring; wait for theirs. */
+	printf("SWEET WIFI: [3] write our-channel = UP, ring\n");
+	wmmio_wr32(waop_base, QMP_OUR_CHANNEL, QMP_UP);
+	wifi_ring_aop();
+	if (!wifi_qmp_wait(QMP_THEIR_CHANNEL, QMP_UP, 1000)) {
+		tc = wmmio_rd32(waop_base, QMP_THEIR_CHANNEL);
+		printf("SWEET WIFI: [3] AOP did NOT open its channel within 1 s (theirs=%#x); taking ours down\n", tc);
+		wmmio_wr32(waop_base, QMP_OUR_CHANNEL, QMP_DOWN);
+		wmmio_wr32(waop_base, QMP_OUR_LINK, QMP_DOWN);
+		wifi_ring_aop();
+		return false;
+	}
+	printf("SWEET WIFI: [3] AOP has opened its channel\n");
+
+	/* 3) acknowledge their channel; ring; wait for their ack of ours. */
+	printf("SWEET WIFI: [3] write their-channel-ack = UP, ring\n");
+	wmmio_wr32(waop_base, QMP_THEIR_CHAN_ACK, QMP_UP);
+	wifi_ring_aop();
+	if (!wifi_qmp_wait(QMP_OUR_CHAN_ACK, QMP_UP, 1000)) {
+		oca = wmmio_rd32(waop_base, QMP_OUR_CHAN_ACK);
+		printf("SWEET WIFI: [3] AOP did NOT ack our channel within 1 s (ack=%#x); taking ours down\n", oca);
+		wmmio_wr32(waop_base, QMP_OUR_CHANNEL, QMP_DOWN);
+		wmmio_wr32(waop_base, QMP_OUR_LINK, QMP_DOWN);
+		wifi_ring_aop();
+		return false;
+	}
+
+	ol  = wmmio_rd32(waop_base, QMP_OUR_LINK);
+	oca = wmmio_rd32(waop_base, QMP_OUR_CHAN_ACK);
+	wifi_our_box = box;
+	printf("SWEET WIFI: [3] THE QMP CHANNEL TO THE AOP IS OPEN (our link=%#x chan-ack=%#x box=%#x); modem still untouched\n",
+	    ol, oca, box);
+	return true;
+}
+
+#include <sys/uio.h>                    /* UIO_READ / UIO_SYSSPACE for vn_rdwr; here, not among the includes at the top, so later patches' context there still matches */
+/*
+ * Wi-Fi, step 4 (boot-arg sweetwifi=3): read the modem image from the iOS filesystem and check it
+ * against its own header (HackiOS redwood_wifi.c step_firmware, davinci). Reads only -- the files,
+ * and vnode stats of the segment files; NO hardware and NOT the modem. It only proves the image is
+ * whole and fits the reserved region, so the later PAS steps (header-to-TZ, segment copy, auth+reset)
+ * have something valid to work from.
+ *
+ * davinci reads from the iOS filesystem (vnode), not from the RAM disk as redwood does: the files are
+ * pushed to /usr/local/gltest/ by the dev loop (see sweet_push_exec_bit for the vnode idiom). So this
+ * runs on its OWN thread that waits for rootvnode -- never inline in the GPU bring-up, which is early.
+ *
+ * The image (Qualcomm mdt_loader): a 32-bit ELF whose header + program-header table + hash/cert blob
+ * are modem.mdt, and whose loadable segments are a file each, modem.bNN for header index NN (only the
+ * segments with file bytes get one). Device facts (2026-10-26): modem.mdt 9100 B, 31 program headers
+ * at 52 (32 B each); hash segment is index 1 (modem.b01, 8056 B); 52 + 32*31 + 8056 = 9100.
+ */
+#define WMODEM_REGION_PA   0x8b000000u          /* dt modem_region@8b000000 */
+#define WMODEM_REGION_SIZE 0x08400000u          /* 132 MiB */
+#define WMODEM_PAS_ID      4u                   /* dt qcom,mss@4080000 pas-id 4 (a later step uses it) */
+#define WMDT_DIR           "/usr/local/gltest/"
+#define WMDT_MAX_SEG       48u
+#define WMDT_HASH(f)       ((((f) >> 24) & 7u) == 2u)   /* the program header that is the hash/cert blob */
+
+struct wmdt_phdr { uint32_t type, offset, vaddr, paddr, filesz, memsz, flags, align; };
+static uint8_t wifi_mdt[0x4000];                /* modem.mdt (device's is 9100 B; cap 16 KiB) */
+static uint64_t wifi_mdt_size;                  /* set by step 4 when the image validates whole; 0 otherwise */
+static int wifi_level;                          /* sweetwifi=N, so the fw thread knows how far to go */
+
+/* Read up to `cap` bytes of a file into `buf`; *got = bytes read. 0 on success. (reads only) */
+static int
+wifi_read_file(const char *path, uint8_t *buf, uint32_t cap, uint64_t *got)
+{
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_kernel();
+	int e, resid = (int)cap;
+	if (vnode_lookup(path, 0, &vp, ctx) != 0) {
+		return -1;
+	}
+	e = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)cap, 0, UIO_SYSSPACE, IO_NODELOCKED,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	vnode_put(vp);
+	if (e != 0) {
+		return -1;
+	}
+	*got = (uint64_t)cap - (uint64_t)resid;
+	return 0;
+}
+
+/* Read len bytes at file offset off into buf (cacheable). 0 on success; *got = bytes read. */
+static int
+wifi_read_file_at(const char *path, uint8_t *buf, uint32_t len, off_t off, uint64_t *got)
+{
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_kernel();
+	int e, resid = (int)len;
+	if (vnode_lookup(path, 0, &vp, ctx) != 0) {
+		return -1;
+	}
+	e = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)len, off, UIO_SYSSPACE, IO_NODELOCKED,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	vnode_put(vp);
+	if (e != 0) {
+		return -1;
+	}
+	*got = (uint64_t)len - (uint64_t)resid;
+	return 0;
+}
+
+/* Stat a file's size without reading it. 0 on success. */
+static int
+wifi_file_size(const char *path, uint64_t *size)
+{
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_kernel();
+	struct vnode_attr va;
+	int e;
+	if (vnode_lookup(path, 0, &vp, ctx) != 0) {
+		return -1;
+	}
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_data_size);
+	e = vnode_getattr(vp, &va, ctx);
+	vnode_put(vp);
+	if (e != 0 || !VATTR_IS_SUPPORTED(&va, va_data_size)) {
+		return -1;
+	}
+	*size = va.va_data_size;
+	return 0;
+}
+
+static bool
+wifi_firmware_read_validate(void)
+{
+	char path[64];
+	uint64_t mdtsz = 0, total_file = 0;
+	uint32_t phnum, phoff, phentsize, hashsz = 0, lowest = ~0u, highest = 0, loadable = 0;
+
+	wifi_mdt_size = 0;
+	printf("SWEET WIFI: [4] read + validate the modem image at %smodem.{mdt,bNN} (reads only; modem untouched)\n", WMDT_DIR);
+	snprintf(path, sizeof(path), "%smodem.mdt", WMDT_DIR);
+	if (wifi_read_file(path, wifi_mdt, sizeof(wifi_mdt), &mdtsz) != 0) {
+		printf("SWEET WIFI: [4] cannot read %s -- push modem.mdt + modem.bNN into %s\n", path, WMDT_DIR);
+		return false;
+	}
+	phnum     = mdtsz >= 46u ? (uint32_t)(wifi_mdt[44] | wifi_mdt[45] << 8) : 0u;
+	phentsize = mdtsz >= 44u ? (uint32_t)(wifi_mdt[42] | wifi_mdt[43] << 8) : 0u;
+	phoff     = mdtsz >= 32u ? (uint32_t)(wifi_mdt[28] | wifi_mdt[29] << 8 | wifi_mdt[30] << 16 | wifi_mdt[31] << 24) : 0u;
+	if (memcmp(wifi_mdt, "\177ELF\1", 5) != 0 || phnum < 3u || phnum > WMDT_MAX_SEG || phentsize != 32u ||
+	    (uint64_t)phoff + 32ull * phnum > mdtsz) {
+		printf("SWEET WIFI: [4] %s is not a 32-bit MDT header (%02x %02x %02x %02x, phnum %u, phentsize %u, %llu bytes)\n",
+		    path, wifi_mdt[0], wifi_mdt[1], wifi_mdt[2], wifi_mdt[3], phnum, phentsize, mdtsz);
+		return false;
+	}
+	printf("SWEET WIFI: [4] %s: ELF32, %u program headers at %#x, %llu bytes\n", path, phnum, phoff, mdtsz);
+	for (uint32_t i = 0; i < phnum; i++) {
+		struct wmdt_phdr ph;
+		uint64_t fsz = 0;
+		memcpy(&ph, wifi_mdt + phoff + 32u * i, sizeof(ph));
+		if (WMDT_HASH(ph.flags)) {
+			hashsz = ph.filesz;
+		}
+		if (ph.type != 1u || WMDT_HASH(ph.flags) || ph.memsz == 0u) {
+			continue;               /* not a loaded segment */
+		}
+		if (ph.paddr < WMODEM_REGION_PA || ph.filesz > ph.memsz ||
+		    (uint64_t)ph.paddr + ph.memsz > (uint64_t)WMODEM_REGION_PA + WMODEM_REGION_SIZE) {
+			printf("SWEET WIFI: [4] segment %u (paddr %#x, %#x bytes) is NOT within the modem region %#x+%#x -- stop\n",
+			    i, ph.paddr, ph.memsz, WMODEM_REGION_PA, WMODEM_REGION_SIZE);
+			return false;
+		}
+		if (ph.filesz != 0u) {
+			snprintf(path, sizeof(path), "%smodem.b%02u", WMDT_DIR, i);
+			if (wifi_file_size(path, &fsz) != 0) {
+				printf("SWEET WIFI: [4] segment %u needs %s but it is not there -- stop\n", i, path);
+				return false;
+			}
+			if (fsz != ph.filesz) {
+				printf("SWEET WIFI: [4] %s is %llu bytes, the header says %u -- stop\n", path, fsz, ph.filesz);
+				return false;
+			}
+			total_file += fsz;
+		}
+		lowest  = ph.paddr < lowest ? ph.paddr : lowest;
+		highest = ph.paddr + ph.memsz > highest ? ph.paddr + ph.memsz : highest;
+		loadable++;
+	}
+	if (loadable == 0u || lowest != WMODEM_REGION_PA || (uint64_t)phoff + 32ull * phnum + hashsz != mdtsz) {
+		printf("SWEET WIFI: [4] not what PAS takes: %u loadable segments, lowest %#x (want %#x); %u + %u*32 + hashes %u vs %llu\n",
+		    loadable, lowest, WMODEM_REGION_PA, phoff, phnum, hashsz, mdtsz);
+		return false;
+	}
+	printf("SWEET WIFI: [4] THE MODEM IMAGE IS WHOLE: %u loadable segments, %llu bytes of segment files, header %llu B "
+	    "(hashes %u), spans %#x..%#x (%#x of the %#x-byte region). Ready for PAS (pas-id %u) -- NOT started.\n",
+	    loadable, total_file, mdtsz, hashsz, lowest, highest,
+	    ((highest + 0xfffu) & ~0xfffu) - WMODEM_REGION_PA, WMODEM_REGION_SIZE, WMODEM_PAS_ID);
+	wifi_mdt_size = mdtsz;
+	return true;
+}
+
+/*
+ * Wi-Fi, step 5 (boot-arg sweetwifi=4): ask TrustZone to AUTHENTICATE the modem image, WITHOUT
+ * releasing the modem. PAS is_supported(4) -> init_image(4, mdt) -> mem_setup(4, region). The modem
+ * Q6 stays in reset: there is NO segment copy and NO auth-and-reset here, so nothing on the modem
+ * runs. This proves one thing and only that: TrustZone accepts this device's signed modem image when
+ * it is handed over from our XNU. Mirrors sweet_gpu.c's GPU-zap PAS (gpu_scm_pas), with pas-id 4 and
+ * the modem's mdt/region. davinci's modem is qcom,pil-tz-generic/pas-id 4, so TZ does the whole load;
+ * init_image checks the signature of the metadata blob (modem.mdt: header + program table + hashes).
+ *
+ * THE segment copy into 0x8b000000 and auth-and-reset (SCM 0x42000205) -- which RELEASE the modem and
+ * are the reset-risk operations (a modem later shut down without a stop-ack has bricked restart until
+ * a reboot) -- are a separate, higher-gated step, to run deliberately with sweetgpu_armfb=1 armed.
+ */
+#define WMODEM_SCM_IS_SUPPORTED 0x42000207ull
+#define WMODEM_SCM_INIT_IMAGE   0x42000201ull
+#define WMODEM_SCM_MEM_SETUP    0x42000202ull
+
+/*
+ * Send ONE immediate RPMh ARC vote on the apps RSC (dt mailbox@18220000, "qcom,tcs-drv", drv-id 2),
+ * to power a rail the way the stock pil-tz driver's regulator_enable(vdd_cx)/regulator_enable(vdd_mss)
+ * does before pas_init_image. The AOP load_state message is only a notification; the real rail power
+ * is this RSC vote, which we were missing. Mirrors the downstream qcom-rpmh-mailbox.c (RSC v2.7):
+ *   reg_base = reg[1] = 0x18220d00; ACTIVE TCS (from qcom,tcs-config <2 2 ...>) is m=0; slot n=0.
+ * CMD_DATA is the ARC hardware-level INDEX into the resource's cmd-db VLVL list (NOT the vlvl value);
+ * we vote the top corner (nvals-1 = TURBO), matching the stock proxy vote. Reuses cmddb_find().
+ * Only touches the AP's own apps RSC active TCS, which nothing else on the AP drives here.
+ */
+#define WRSC_PAGE_PA     0x18220000u     /* page holding reg_base 0x18220d00 */
+#define WRSC_RB          0x00000d00u     /* reg_base offset within the page (reg[1]) */
+#define WRSC_IRQ_STATUS  0x04u
+#define WRSC_IRQ_CLEAR   0x08u
+#define WRSC_CMD_WAIT    0x10u
+#define WRSC_CONTROL     0x14u
+#define WRSC_STATUS      0x18u
+#define WRSC_CMD_ENABLE  0x1cu
+#define WRSC_CMD_MSGID   0x30u
+#define WRSC_CMD_ADDR    0x34u
+#define WRSC_CMD_DATA    0x38u
+#define WRSC_CMD_STATUS  0x3cu
+#define WRSC_MSGID_WR    0x10108u         /* LEN8 | RESP_REQ | WRITE (completing active write) */
+#define WRSC_AMC_ENABLE  0x10000u
+#define WRSC_AMC_TRIGGER 0x1000000u
+
+static vm_offset_t wrsc_page;             /* mapped 0x18220000; reg_base at +0xd00 */
+
+static int
+wifi_rpmh_vote(const char *res)
+{
+	uint16_t vals[16];
+	uint32_t addr = 0, nvals = 0, idx, s;
+	unsigned i;
+	vm_offset_t rb;
+
+	if (!wrsc_page && !(wrsc_page = ml_io_map(WRSC_PAGE_PA, 0x2000u))) {
+		printf("SWEET WIFI: [5] cannot map the apps RSC\n");
+		return -1;
+	}
+	rb = wrsc_page + WRSC_RB;              /* ACTIVE TCS m=0, slot n=0 */
+	if (cmddb_find(res, &addr, vals, &nvals) != 0 || nvals == 0u) {
+		printf("SWEET WIFI: [5] cmd-db lacks %s -- not voting\n", res);
+		return -1;
+	}
+	idx = nvals - 1u;                      /* top corner (TURBO), as the stock proxy vote */
+	printf("SWEET WIFI: [5] RPMh vote %s: cmd-db addr %#x, %u levels, hlvl idx %u (vlvl %u) [TURBO]\n",
+	    res, addr, nvals, idx, vals[idx]);
+	for (i = 0; i < 2000u && !(wmmio_rd32(rb, WRSC_STATUS) & 1u); i++) {
+		delay_for_interval(1, NSEC_PER_USEC);   /* wait TCS idle */
+	}
+	wmmio_wr32(rb, WRSC_CMD_ENABLE, 0);    /* clear any residue */
+	wmmio_wr32(rb, WRSC_CMD_WAIT, 0);
+	wmmio_wr32(rb, WRSC_CMD_MSGID, WRSC_MSGID_WR);
+	wmmio_wr32(rb, WRSC_CMD_ADDR, addr);
+	wmmio_wr32(rb, WRSC_CMD_DATA, idx);
+	wmmio_wr32(rb, WRSC_CMD_WAIT, 1u);     /* want completion on slot 0 */
+	wmmio_wr32(rb, WRSC_CMD_ENABLE, 1u);
+	wmmio_wr32(rb, WRSC_CONTROL, 0);                       /* trigger: 0 -> ENABLE -> ENABLE|TRIGGER */
+	for (i = 0; i < 1000u && wmmio_rd32(rb, WRSC_CONTROL) != 0u; i++) { }
+	wmmio_wr32(rb, WRSC_CONTROL, WRSC_AMC_ENABLE);
+	for (i = 0; i < 1000u && wmmio_rd32(rb, WRSC_CONTROL) != WRSC_AMC_ENABLE; i++) { }
+	wmmio_wr32(rb, WRSC_CONTROL, WRSC_AMC_ENABLE | WRSC_AMC_TRIGGER);
+	for (i = 0; i < 20000u && !(wmmio_rd32(rb, WRSC_IRQ_STATUS) & 1u); i++) {
+		delay_for_interval(1, NSEC_PER_USEC);
+	}
+	s = wmmio_rd32(rb, WRSC_CMD_STATUS);
+	wmmio_wr32(rb, WRSC_IRQ_CLEAR, 1u);
+	wmmio_wr32(rb, WRSC_CMD_ENABLE, 0);
+	wmmio_wr32(rb, WRSC_CMD_WAIT, 0);
+	printf("SWEET WIFI: [5] RPMh vote %s: cmd_status %#x (issued=%u compl=%u)%s\n", res, s, (s >> 8) & 1u,
+	    (s >> 16) & 1u, ((s & 0x100u) && (s & 0x10000u)) ? " OK" : " -- NOT confirmed");
+	return ((s & 0x100u) && (s & 0x10000u)) ? 0 : -1;
+}
+#define WMODEM_SCM_SHUTDOWN     0x42000206ull
+#define WGPU_PAS_ID             13u             /* known-good: the GPU zap PAS works for pas-id 13 */
+#define QMP_MSG_LEN             64u             /* Linux qmp_send always writes 64 bytes, text + zero pad */
+
+/*
+ * Send one QMP message to the always-on processor over the channel step 3 opened (Linux qmp_send):
+ * the text goes into our mailbox behind its length (a fixed 64), the AOP's doorbell is rung, and the
+ * AOP has taken it when the length reads back 0. davinci's modem is qcom,signal-aop: the modem's proxy
+ * power (cx, mss rails) is brought up by telling the AOP "{class: image, res: load_state, name: modem,
+ * val: on}" -- which is what the stock pil-tz driver does, and why step 5 could not authenticate with
+ * the modem rail off. Returns true if the AOP took the message.
+ */
+static bool
+wifi_mailbox_send(const char *text)
+{
+	uint32_t words[QMP_MSG_LEN / 4] = { 0 };
+	unsigned i;
+
+	if (!waop_base || wifi_our_box == 0u) {
+		printf("SWEET WIFI: [5] AOP channel not open -- cannot send \"%s\"\n", text);
+		return false;
+	}
+	strlcpy((char *)words, text, sizeof(words));
+	if (wmmio_rd32(waop_base, wifi_our_box) != 0u) {
+		printf("SWEET WIFI: [5] our AOP box still holds a message (%#x) -- not sending\n",
+		    wmmio_rd32(waop_base, wifi_our_box));
+		return false;
+	}
+	for (i = 0; i < QMP_MSG_LEN / 4u; i++) {
+		wmmio_wr32(waop_base, wifi_our_box + 4u + 4u * i, words[i]);
+	}
+	wmmio_wr32(waop_base, wifi_our_box, QMP_MSG_LEN);     /* the length, in front -> message is queued */
+	(void)wmmio_rd32(waop_base, wifi_our_box);
+	wifi_ring_aop();
+	if (!wifi_qmp_wait(wifi_our_box, 0, 1000)) {
+		printf("SWEET WIFI: [5] AOP did NOT take \"%s\" within 1 s -- taking it back\n", text);
+		wmmio_wr32(waop_base, wifi_our_box, 0);
+		return false;
+	}
+	printf("SWEET WIFI: [5] AOP took \"%s\"\n", text);
+	return true;
+}
+
+static void
+wifi_modem_pas_validate(void)
+{
+	vm_offset_t mdt_cva = 0, mdt_io = 0;
+	uint64_t mdt_pa = 0, x0, x1 = 0;
+	uint64_t i, mdtsz = wifi_mdt_size;
+
+	printf("SWEET WIFI: [5] ask TrustZone to AUTHENTICATE the modem image (pas-id %u); modem STAYS IN RESET -- not released\n",
+	    WMODEM_PAS_ID);
+	if (mdtsz == 0u || mdtsz > sizeof(wifi_mdt)) {
+		printf("SWEET WIFI: [5] no validated modem.mdt from step 4 -- not asking TZ\n");
+		return;
+	}
+	/* The metadata buffer MUST sit in a DDR bank XBL registered with TZ at boot. TZ RE (tz.bin) + the
+	 * sweetwifi=7 sweep (2026-10-29) proved the modem path (reader B) MAPS this buffer into TZ and rejects
+	 * with 0xffcffff6 = AC_ERR_NOT_DDR_MEMORY when its PA is not in that table. XNU's high RAM (gmub,
+	 * ~0xb7xxxxxx) is real DDR but NOT registered; the modem carveout IS (init_image accepted at both
+	 * 0x8b000000 and 0x93400000, rejected from gmub). Stage at the top of the carveout (0x93400000, in the
+	 * ~7 MiB spare above the image's 0x8b000000..0x92e00000) so it never collides with the loaded image. */
+	mdt_pa = 0x93400000ull;
+	(void)mdt_cva;
+	if (!(mdt_io = ml_io_map(mdt_pa, 0x4000))) {
+		printf("SWEET WIFI: [5] cannot map the modem-carveout mdt staging buffer at %#llx\n", (unsigned long long)mdt_pa);
+		return;
+	}
+	for (i = 0; i < mdtsz; i++) {
+		((volatile unsigned char *)mdt_io)[i] = wifi_mdt[i];
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	gmub_flush();
+	printf("SWEET WIFI: [5] mdt copied to pa %#llx (%llu bytes), elf %02x%02x%02x%02x (want 7f454c46)\n",
+	    (unsigned long long)mdt_pa, mdtsz, ((volatile unsigned char *)mdt_io)[0], ((volatile unsigned char *)mdt_io)[1],
+	    ((volatile unsigned char *)mdt_io)[2], ((volatile unsigned char *)mdt_io)[3]);
+
+	/* is_supported sweep: compare the modem (4) against the KNOWN-GOOD GPU (13). If TZ answers x1=1
+	 * for 13 but x1=0 for 4, TZ gates modem PAS from us specifically; if it answers 0 for both, the
+	 * call's convention just differs and the answer is not a reliable "supported" flag. (read-only) */
+	x1 = 0;
+	x0 = gpu_scm_pas(WMODEM_SCM_IS_SUPPORTED, 0x01u, (uint64_t)WGPU_PAS_ID, 0, 0, &x1);
+	printf("SWEET WIFI: [5] PAS is_supported(%u=GPU, known-good) -> x0=%#llx x1=%#llx\n",
+	    WGPU_PAS_ID, (unsigned long long)x0, (unsigned long long)x1);
+	x1 = 0;
+	x0 = gpu_scm_pas(WMODEM_SCM_IS_SUPPORTED, 0x01u, (uint64_t)WMODEM_PAS_ID, 0, 0, &x1);
+	printf("SWEET WIFI: [5] PAS is_supported(%u=modem) -> x0=%#llx x1=%#llx (x0=0 & x1=1 => TZ can PAS this peripheral)\n",
+	    WMODEM_PAS_ID, (unsigned long long)x0, (unsigned long long)x1);
+
+	/* AUTHORITATIVE (MiCode davinci-p-oss subsys-pil-tz.c pil_boot, RE'd 2026-10-29): the modem and the
+	 * GPU zap (pas-id 13, which authenticates fine here) run byte-identical pil_init_image_trusted code.
+	 * The metadata buffer is ordinary coherent DMA (NOT in the modem region), the bus vote is the same
+	 * global scm_pas client both use, and there is NO hyp/scm_assign before init_image on this SoC. So
+	 * the mdt buffer / bus / region are all ruled out -- 0xffcffff6 is TZ's PAS AUTH of the modem
+	 * metadata failing. And our modem.mdt is byte-identical (md5) to the one THIS TZ accepts under MIUI,
+	 * so TZ *can* authenticate it: the reject is a TZ-STATE difference between the MIUI boot and ours.
+	 *
+	 * The one concrete deviation we had from stock pil_boot was an unconditional shutdown(4) BEFORE
+	 * init_image -- stock does init_image first, no shutdown. Two cases to tell apart in one boot:
+	 *   (A) our boot chain (ABL) left pas-id 4 already-inited -> re-init rejected; shutdown clears it.
+	 *   (B) our pre-shutdown itself wedged an otherwise-clean PAS state.
+	 * So: power on (cheap, proven-harmless insurance), then init_image FIRST with no shutdown (exactly
+	 * like stock). Only if rejected, shutdown(4) to clear stale PAS bookkeeping and retry. The pair of
+	 * return codes says which case we are in -- or, if both reject identically, that it is a genuine
+	 * TZ auth/secure-state reject beyond this code path. */
+	(void)wifi_mailbox_send("{class: image, res: load_state, name: modem, val: on}");
+	(void)wifi_rpmh_vote("cx.lvl");
+	(void)wifi_rpmh_vote("mss.lvl");
+	delay_for_interval(20, NSEC_PER_MSEC);          /* let the rails settle */
+
+	x1 = 0;
+	x0 = gpu_scm_pas(WMODEM_SCM_INIT_IMAGE, 0x82u, (uint64_t)WMODEM_PAS_ID, mdt_pa, 0, &x1);
+	printf("SWEET WIFI: [5] PAS init_image(%u, mdt) [attempt A, NO prior shutdown -- matches stock pil_boot] -> x0=%#llx x1=%#llx\n",
+	    WMODEM_PAS_ID, (unsigned long long)x0, (unsigned long long)x1);
+	if (x0 != 0u) {
+		uint64_t sx1 = 0, sx0;
+		printf("SWEET WIFI: [5] attempt A rejected (x0=%#llx); clearing PAS state with shutdown(%u) and retrying\n",
+		    (unsigned long long)x0, WMODEM_PAS_ID);
+		sx0 = gpu_scm_pas(WMODEM_SCM_SHUTDOWN, 0x01u, (uint64_t)WMODEM_PAS_ID, 0, 0, &sx1);
+		printf("SWEET WIFI: [5] PAS shutdown(%u) -> x0=%#llx x1=%#llx\n",
+		    WMODEM_PAS_ID, (unsigned long long)sx0, (unsigned long long)sx1);
+		gmub_flush();
+		x1 = 0;
+		x0 = gpu_scm_pas(WMODEM_SCM_INIT_IMAGE, 0x82u, (uint64_t)WMODEM_PAS_ID, mdt_pa, 0, &x1);
+		printf("SWEET WIFI: [5] PAS init_image(%u, mdt) [attempt B, AFTER shutdown] -> x0=%#llx x1=%#llx\n",
+		    WMODEM_PAS_ID, (unsigned long long)x0, (unsigned long long)x1);
+	}
+	if (x0 != 0u) {
+		printf("SWEET WIFI: [5] TZ REJECTED the modem image on BOTH attempts (x0=%#llx). The mdt is byte-identical to "
+		    "MIUI's, power/bus/buffer/region are ruled out -- this is a TZ-side PAS authentication/secure-state reject, "
+		    "not something this code path sets up wrong. Stop; modem untouched, in reset.\n", (unsigned long long)x0);
+		(void)wifi_mailbox_send("{class: image, res: load_state, name: modem, val: off}");
+		return;
+	}
+	printf("SWEET WIFI: [5] init_image ACCEPTED (x0=0) -- TZ authenticated the modem metadata.\n");
+
+	x0 = gpu_scm_pas(WMODEM_SCM_MEM_SETUP, 0x03u, (uint64_t)WMODEM_PAS_ID, (uint64_t)WMODEM_REGION_PA,
+	    (uint64_t)WMODEM_REGION_SIZE, &x1);
+	printf("SWEET WIFI: [5] PAS mem_setup(%u, %#x, %#x) -> x0=%#llx x1=%#llx\n", WMODEM_PAS_ID, WMODEM_REGION_PA,
+	    WMODEM_REGION_SIZE, (unsigned long long)x0, (unsigned long long)x1);
+	if (x0 != 0u) {
+		printf("SWEET WIFI: [5] mem_setup refused (x0=%#llx) -- stop; modem in reset\n", (unsigned long long)x0);
+		(void)wifi_mailbox_send("{class: image, res: load_state, name: modem, val: off}");
+		return;
+	}
+	printf("SWEET WIFI: [5] TRUSTZONE ACCEPTS THE MODEM IMAGE (signature ok, region set). Modem STILL IN RESET. "
+	    "Next (higher-gated, reset-risk): copy the 29 segments in, then auth-and-reset to RELEASE the modem.\n");
+	/* validate-only step: release the AOP proxy power again (we are not proceeding to auth here). */
+	(void)wifi_mailbox_send("{class: image, res: load_state, name: modem, val: off}");
+}
+
+/* sweetwifi=8: RELEASE THE MODEM -- the reset-risk step. mdt is staged in the carveout (registered DDR,
+ * fixes AC_ERR_NOT_DDR_MEMORY), init_image + mem_setup, then the loadable segments are copied from
+ * modem.bNN into 0x8b000000+(paddr-base) and auth_and_reset (0x42000205) brings the modem Q6 out of
+ * reset. cx/mss + AOP load_state are left ON (the modem needs them to run). armfb=1 turns any panic into
+ * a drop to fastboot; a modem that wedges just needs a reboot. After auth we watch the APCS doorbell for
+ * signs of life. Still no HLOS services yet (QRTR/rmtfs = M2/M3), so the modem may idle or crash after a
+ * few seconds -- that is expected; the milestone here is auth_and_reset(4)=0 = out of reset. */
+#define WMODEM_SCM_AUTH_RESET 0x42000205ull
+static void wifi_modem_liveness(void);   /* defined after the wsmem helpers */
+static void wifi_smp2p_up(void);         /* M2a: SMP2P bring-up, defined after the wsmem helpers */
+static void wifi_glink_attach(void);     /* M2b: GLINK FIFO attach */
+static void wifi_glink_link(void);       /* M2c: GLINK version + open IPCRTR */
+static void wrmtfs_load(void);           /* M3a: rmtfs (defined after wifi_glink_link) */
+static bool wrmtfs_setup(void);
+static void wrmtfs_start(void);
+static void wservreg_load(void);         /* M3b: service-registry locator (pd-mapper) */
+static void
+wifi_modem_release(void)
+{
+	char path[64];
+	uint64_t x0, x1 = 0, i, mdtsz = wifi_mdt_size;
+	uint32_t phnum, phoff, copied = 0;
+	vm_offset_t mio, region = 0, stage_cva = 0;
+	uint64_t stage_pa = 0;
+
