+/*
+ * The graphics accelerator Metal looks for (HackiOS MiniIOMobileFramebuffer.cpp IOAcceleratorES): its
+ * MetalPluginName is the bundle Metal opens, /System/Library/Extensions/<name>.bundle, and its
+ * MetalPluginClassName the device class in it (RedwoodMetal, from HackiOS's redwoodmetal.m). Only
+ * with boot-arg sweetmetal=1: a process handed a half-made device aborts rather than falls back, so
+ * the bundle itself says which processes get one (/usr/local/gltest/metal_allow) -- the window
+ * server stays on OpenGL ES.
+ */
+class IOAcceleratorES : public IOService
+{
+	OSDeclareDefaultStructors(IOAcceleratorES);
+};
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
+static void
+sweet_publish_accelerator(IOService *provider)
+{
+	uint32_t metal = 0;
+	if (!PE_parse_boot_argn("sweetmetal", &metal, sizeof(metal)) || metal == 0) {
+		return;
+	}
+	IOAcceleratorES *accelerator = OSTypeAlloc(IOAcceleratorES);
+	if (accelerator != NULL && accelerator->init() && accelerator->attach(provider)) {
+		accelerator->setName("sgx");
+		accelerator->setProperty("MetalPluginName", "RedwoodMetal");
+		accelerator->setProperty("MetalPluginClassName", "RedwoodMetalDevice");
+		/*
+		 * OpenGL ES: libGFXShared (gfxInitializeLibrary) reads these off this same service and
+		 * opens /System/Library/Extensions/<name>.bundle/<name> -- the Metal one when
+		 * IOGLESDefaultUseMetal is true. AppleMetalGLRenderer is Apple's GLES on Metal, so an
+		 * application's own EAGLContext runs on RedwoodMetal (the processes metal_allow names).
+		 * Without them EAGLContext found no renderer at all and gave applications no context.
+		 */
+		/* SweetGLES (/System/Library/Extensions/SweetGLES.bundle) is this port's OpenGL ES: loaded
+		 * by GLEngine in every process that makes a GL context, it hands the application's gl*
+		 * straight to Mesa (freedreno) and keeps GLEngine out of every call. Apple's GLES-on-Metal
+		 * stays named as the Metal renderer, chosen with the com.apple.opengles UseMetal default. */
+		accelerator->setProperty("IOGLESBundleName", "SweetGLES");
+		accelerator->setProperty("IOGLESMetalBundleName", "AppleMetalGLRenderer");
+		accelerator->setProperty("IOGLESDefaultUseMetal", kOSBooleanFalse);
+		accelerator->registerService();
+		IOLog("SWEET FB: IOAcceleratorES published (sweetmetal=%u): MetalPluginName RedwoodMetal\n", metal);
+	}
+	OSSafeReleaseNULL(accelerator);
+}
+
+bool
+AppleCLCD::start(IOService *provider)
+{
+	fScanout = -1;
+	{
+		int v = 0;
+		if (PE_parse_boot_argn("sweetfb_scanout", &v, sizeof(v)) && v != 0) {
+			sweet_surface_display_pool_init();    /* early: while memory is in one piece */
+		}
+	}
+	/*
+	 * present() waits for the GPU to be done with a surface before it shows it (sweet_gpu_surface_wait,
+	 * on the vsync timer's thread): said so for the GL bridge (HackiOS eagl.c display_waits), which
+	 * then no longer glFinish()es every frame -- the window server goes on with its next frame while
+	 * the GPU draws this one, instead of waiting for it (3-14 ms of every frame).
+	 */
+	setProperty("RedwoodWaitsForGPU", kOSBooleanTrue);
+	PE_Video video;
+
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	PE_current_console(&video);
+	fPhys = video.v_baseAddr;
+	fWidth = (uint32_t)video.v_width;
+	fHeight = (uint32_t)video.v_height;
+	fRowBytes = (uint32_t)video.v_rowBytes;
+	if (fPhys == 0 || fWidth == 0 || fHeight == 0 || fRowBytes < fWidth * 4) {
+		IOLog("SWEET FB: no boot framebuffer\n");
+		return false;
+	}
+	int native = 0;
+	PE_parse_boot_argn("sweetfb_native", &native, sizeof(native));
+	fLogicalW = fWidth;
+	fLogicalH = fHeight;
+	if (!native && fWidth <= SWEET_FB_LOGICAL_W && fHeight <= SWEET_FB_LOGICAL_H) {
+		fLogicalW = SWEET_FB_LOGICAL_W;
+		fLogicalH = SWEET_FB_LOGICAL_H;
+	}
+	fOffX = (int32_t)(fLogicalW - fWidth) / 2;
+	fOffY = (int32_t)(fLogicalH - fHeight) / 2;
+	{
+		/* (SweetHID.cpp maps the touches by the same boot-args) */
+		int v = 1;
+		(void)PE_parse_boot_argn("sweetfb_scale", &v, sizeof(v));
+		fScale = v != 0 && (fLogicalW != fWidth || fLogicalH != fHeight);
+		if (fScale) {
+			fRuns = (ScaleRun *)IOMallocData(sizeof(ScaleRun) * fWidth);
+			fRowMap = (uint32_t *)IOMallocData(sizeof(uint32_t) * fHeight);
+		}
+	}
+	publishModes();
+	fLock = IOLockAlloc();
+	fPresentLock = IOLockAlloc();
+	fPresentCall = thread_call_allocate_with_priority(&AppleCLCD::presentCallout, this, THREAD_CALL_PRIORITY_HIGH);
+	{
+		int v = 1;
+		(void)PE_parse_boot_argn("sweetfb_immediate", &v, sizeof(v));
+		fImmediate = v != 0;
+	}
+	fClients = OSArray::withCapacity(4);
+	fSurface = sweet_surface_create_physical(fPhys, fWidth, fHeight, fRowBytes, SWEET_FB_FORMAT_BGRA);
+	fPixels = fSurface != NULL ? fSurface->kernelAddress() : 0;
+	fWorkLoop = IOWorkLoop::workLoop();
+	if (fLock == NULL || fClients == NULL || fPixels == 0 || fWorkLoop == NULL) {
+		IOLog("SWEET FB: setup failed\n");
+		OSSafeReleaseNULL(fSurface);    /* stays published: also held by the table */
+		OSSafeReleaseNULL(fWorkLoop);
+		return false;
+	}
+	fVsync = IOTimerEventSource::timerEventSource(this, &AppleCLCD::vsyncFired);
+	if (fVsync == NULL || fWorkLoop->addEventSource(fVsync) != kIOReturnSuccess) {
+		IOLog("SWEET FB: no vsync timer\n");
+		return false;
+	}
+	uint32_t hz = 60;
+	PE_parse_boot_argn("sweetfb_hz", &hz, sizeof(hz));
+	{
+		uint32_t threads = 3;
+		thread_t thread;
+		PE_parse_boot_argn("sweetfb_threads", &threads, sizeof(threads));
+		fThreads = threads >= 1 && threads <= 8 ? threads : 1;
+		fHelperLock = IOLockAlloc();
+		for (unsigned i = 0; fHelperLock != NULL && i + 1 < fThreads; i++) {
+			if (kernel_thread_start(&AppleCLCD::helperMain, this, &thread) != KERN_SUCCESS) {
+				fThreads = i + 1;
+				break;
+			}
+			thread_deallocate(thread);
+		}
+		if (fHelperLock == NULL) {
+			fThreads = 1;
+		}
+	}
+	fFlushTicks = (hz == 0 || hz >= 60) ? 1 : 60 / hz;
+	fVsync->setTimeoutUS(SWEET_FB_VSYNC_US);
+
+	setProperty(kIOUserClientClassKey, "IOMobileFramebufferUserClient");
+	setProperty("external", false);
+	/*
+	 * As Apple's display drivers publish it: a dictionary (QuartzCore and VideoToolbox read
+	 * PlaneBaseAlignmentLinear out of it; VideoToolbox's FigGetAlignmentForIOSurfaceOutputToDisplayService sent
+	 * a plain number CFDictionaryGetValue and mediaserverd died building Camera.app's preview). No
+	 * DisplayPipeStrideRequirements: the panel's own rows (4320 bytes) are not 64-aligned; both fall back.
+	 */
+	{
+		OSDictionary *alignment = OSDictionary::withCapacity(1);
+		OSNumber *linear = OSNumber::withNumber(64ULL, 32);
+
+		if (alignment != NULL && linear != NULL) {
+			alignment->setObject("PlaneBaseAlignmentLinear", linear);
+			setProperty("DisplayPipePlaneBaseAlignment", alignment);
+		}
+		OSSafeReleaseNULL(linear);
+		OSSafeReleaseNULL(alignment);
+	}
+	registerService();
+	sweet_publish_accelerator(provider);
+	IOLog("SWEET FB: AppleCLCD %ux%u stride %u at 0x%llx, default surface %u, presented as %ux%u%s\n",
+	    fWidth, fHeight, fRowBytes, fPhys, fSurface->id, fLogicalW, fLogicalH,
+	    fScale ? ", scaled to the panel" : (fLogicalW != fWidth || fLogicalH != fHeight) ? ", centered crop" : "");
+	return true;
+}
+
+void
+AppleCLCD::copyRows(const RowJob *job, int32_t y0, int32_t y1)
+{
+	for (int32_t y = y0; y < y1; y++) {
+		uintptr_t to = job->dst + (uint64_t)y * job->rowBytes;
+		uintptr_t from = job->src + (uint64_t)(job->rowMap != NULL ? job->rowMap[y] : (uint32_t)y) * job->stride;
+		if (job->runs == NULL) {
+			memcpy((void *)to, (const void *)from, job->bytes);
+			continue;
+		}
+		for (uint32_t i = 0; i < job->nruns; i++) {
+			const ScaleRun *run = &job->runs[i];
+			memcpy((void *)(to + (uint64_t)run->dst * 4), (const void *)(from + (uint64_t)run->src * 4), (size_t)run->n * 4);
+		}
+	}
+}
+
+/* A helper: waits for a frame, copies its share of the rows (share index + 1; the presenter takes 0). */
+void
+AppleCLCD::helperMain(void *self, __unused wait_result_t wr)
+{
+	AppleCLCD *fb = (AppleCLCD *)self;
+	uint64_t done = 0;
+	unsigned index;
+
+	IOLockLock(fb->fHelperLock);
+	index = fb->fHelpersStarted++;
+	IOLockUnlock(fb->fHelperLock);
+	for (;;) {
+		const RowJob *job;
+		IOLockLock(fb->fHelperLock);
+		while (fb->fHelperGeneration == done) {
+			IOLockSleep(fb->fHelperLock, &fb->fHelperGeneration, THREAD_UNINT);
+		}
+		done = fb->fHelperGeneration;
+		job = fb->fHelperJob;
+		IOLockUnlock(fb->fHelperLock);
+		copyRows(job, (int32_t)((int64_t)job->rows * (index + 1) / fb->fThreads),
+		    (int32_t)((int64_t)job->rows * (index + 2) / fb->fThreads));
+		IOLockLock(fb->fHelperLock);
+		if (--fb->fHelpersBusy == 0) {
+			IOLockWakeup(fb->fHelperLock, &fb->fHelpersBusy, true);
+		}
+		IOLockUnlock(fb->fHelperLock);
+	}
+}
+
+/* The rows shared out: the helpers take theirs, this thread the first share, then waits for them. */
+void
+AppleCLCD::copyFrame(const RowJob *job)
+{
+	if (fThreads <= 1 || fHelpersStarted + 1 < fThreads) {
+		copyRows(job, 0, job->rows);
+		return;
+	}
+	IOLockLock(fHelperLock);
+	fHelperJob = job;
+	fHelpersBusy = fThreads - 1;
+	fHelperGeneration++;
+	IOLockWakeup(fHelperLock, &fHelperGeneration, false);
+	IOLockUnlock(fHelperLock);
+	copyRows(job, 0, (int32_t)((int64_t)job->rows / fThreads));
+	IOLockLock(fHelperLock);
+	while (fHelpersBusy != 0) {
+		IOLockSleep(fHelperLock, &fHelpersBusy, THREAD_UNINT);
+	}
+	IOLockUnlock(fHelperLock);
+}
+
+void
+AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	AppleCLCD *fb = (AppleCLCD *)owner;
+	uint64_t now = mach_absolute_time();
+	uint64_t count = ++fb->fVsyncCount;
+	if (sweet_tl_on && sweet_tl_nt < SWEET_TL_TICKS) {
+		sweet_tl_tick[sweet_tl_nt] = sweet_tl_us();
+		sweet_tl_nt = sweet_tl_nt + 1;
+	}
+	/*
+	 * What a vsync says, as IOMobileFramebuffer says it (and HackiOS's MiniIOMobileFramebuffer):
+	 * three 64-bit numbers in six halves -- the time of this refresh, the same again (when it was
+	 * presented), and the count. This sent the count first and the time second: CoreAnimation took
+	 * the count for the refresh's time, long past, and planned its frames from that -- starting
+	 * each one ~11 ms after the tick, too late to be done by the next. The time is the tick's
+	 * deadline, not whenever this ran.
+	 */
+	uint64_t at = fb->fNextTick != 0 && fb->fNextTick <= now ? fb->fNextTick : now;
+	uint64_t values[6] = {
+		(uint32_t)at, (uint32_t)(at >> 32),
+		(uint32_t)at, (uint32_t)(at >> 32),
+		(uint32_t)count, (uint32_t)(count >> 32),
+	};
+
+	IOLockLock(fb->fLock);
+	for (unsigned int i = 0; i < fb->fClients->getCount(); i++) {
+		IOMobileFramebufferUserClient *client =
+		    (IOMobileFramebufferUserClient *)fb->fClients->getObject(i);
+		client->notify(SWEET_FB_NOTIFY_VSYNC, values, 6);
+	}
+	if (0 && fb->fPowerOff) {   /* POWER-OFF HANDLING DISABLED: backboardd auto-dims the display
+	                             * seconds after boot (no backlight service), which skipped the panel
+	                             * flush and left the screen black. Keep flushing the live rendered
+	                             * frame regardless of power state on this research bench. */
+		/* Fade out: halve every channel each vsync, then black, then idle. */
+		uint32_t step = fb->fFadeStep;
+		if (step <= 6) {
+			fb->fFadeStep = step + 1;
+		}
+		IOLockUnlock(fb->fLock);
+		if (0 && step <= 6) {   /* fade/blank DISABLED: keep the last rendered frame on the panel
+		                         * when backboardd auto-dims (no backlight svc), so the rendered
+		                         * lock/home screen stays visible on this research bench. */
+			for (uint32_t y = 0; y < fb->fHeight; y++) {
+				volatile uint32_t *row = (volatile uint32_t *)(fb->fPixels + (uint64_t)y * fb->fRowBytes);
+				for (uint32_t x = 0; x < fb->fWidth; x++) {
+					row[x] = step < 6 ? (row[x] >> 1) & 0x7f7f7f7f : 0;
+				}
+			}
+		}
+		sender->setTimeoutUS(SWEET_FB_VSYNC_US);
+		return;
+	}
+	bool flush = fb->fDirty && (count % fb->fFlushTicks) == 0;
+	IOLockUnlock(fb->fLock);
+	if (flush) {
+		/*
+		 * On the present thread, not here: a present waits for the GPU to be done with the frame
+		 * (up to SWEET_SWAP_GPU_MS), and while this waited no tick came -- with the GPU behind
+		 * (the widget panel, ~28 ms of GPU a frame) the ticks stopped for 70-110 ms at a time,
+		 * and CoreAnimation, which draws on them, with them. Boot-arg sweetfb_tickpresent=1: here.
+		 */
+		static int here = -1;
+		if (here < 0) {
+			int v = 0;
+			(void)PE_parse_boot_argn("sweetfb_tickpresent", &v, sizeof(v));
+			here = v != 0;
+		}
+		if (!here && fb->fPresentCall != NULL) {
+			thread_call_enter(fb->fPresentCall);
+		} else {
+			fb->presentPending();
+		}
+	}
+	{
+		static int want = -1;
+		uint64_t now = mach_absolute_time(), ns = 0;
+		if (want < 0) {
+			int v = 0;
+			want = PE_parse_boot_argn("sweetfb_fps", &v, sizeof(v)) && v != 0;
+		}
+		if (fb->fRateSince == 0) {
+			fb->fRateSince = now;
+		}
+		absolutetime_to_nanoseconds(now - fb->fRateSince, &ns);
+		if (ns >= 1000000000ull) {
+			if (want && fb->fRateSwaps != 0) {
+				/*
+				 * And how often the panel itself is refreshed: INTF1's frame counter (sde_hw_intf.c
+				 * INTF_FRAME_COUNT 0x0AC, INTF1 at MDP + 0x6b800). The frames CoreAnimation can show
+				 * are no more than that, whatever this timer says.
+				 */
+				static vm_offset_t intf;
+				static uint32_t last_frames;
+				uint32_t frames = 0;
+				if (intf == 0) {
+					intf = ml_io_map_unmappable(SWEET_MDP_PA + 0x6b000u, 0x1000u, 0x7u /* VM_WIMG_IO */);
+				}
+				if (intf != 0) {
+					frames = *(volatile uint32_t *)(intf + 0x800u + 0x0acu);
+				}
+				IOLog("SWEET FPS: %u swaps, %u shown (%u scanned out), %u late, in %llu ms; panel %u frames\n", fb->fRateSwaps,
+				    fb->fRateShown, fb->fRateFlips, fb->fRateLate, ns / 1000000ull, frames - last_frames);
+				last_frames = frames;
+			}
+			fb->fRateSwaps = fb->fRateShown = fb->fRateFlips = fb->fRateLate = 0;
+			fb->fRateSince = now;
+		}
+		/* re-armed for the next 1/60 s from the last deadline, not from now: re-armed after the
+		 * work (which waits for the GPU) every tick was longer than 16.7 ms and "60 Hz" ran at 40-50 */
+		uint64_t period = 0;
+		nanoseconds_to_absolutetime((uint64_t)SWEET_FB_VSYNC_US * 1000ull, &period);
+		if (fb->fNextTick == 0) {
+			fb->fNextTick = now;
+		}
+		fb->fNextTick += period;
+		static int phase_lock = -1;
+		if (phase_lock < 0) {
+			/*
+			 * Off unless boot-arg sweetfb_phaselock=1: since a swap is flipped as it comes (0107), the
+			 * moment the engine takes a flip follows CoreAnimation's frame, which follows this tick --
+			 * chasing it stretched the tick to 17-18 ms, and CoreAnimation, which draws on it, to
+			 * ~53 frames a second. The panel itself runs at 60 Hz (XBL's SAMSUNG_EA_NOTCH_FHD: 60 Hz,
+			 * DSC, 682 MHz bit clock): a fixed 16.67 ms is what to give.
+			 */
+			int v = 0;
+			(void)PE_parse_boot_argn("sweetfb_phaselock", &v, sizeof(v));
+			phase_lock = v != 0;
+		}
+		if (phase_lock && fb->fLatchAt != 0 && now - fb->fLatchAt < period * 60u) {
+			/*
+			 * In step with the panel: the display engine takes a flip at the start of the panel's
+			 * frame (its own timing, not this timer's), and SwapWait waits for that. A tick just
+			 * before a frame starts has its flip on the panel at once, and CoreAnimation the whole
+			 * frame for the next; one just after waited a whole frame, and the next swap came late.
+			 * Each tick moves at most 1 ms towards LEAD before the panel's frame start.
+			 */
+			uint64_t lead = 0, step = 0;
+			nanoseconds_to_absolutetime(2500000ull, &lead);
+			nanoseconds_to_absolutetime(1000000ull, &step);
+			int64_t off = (int64_t)((fb->fNextTick + lead - fb->fLatchAt) % period);   /* past a frame start */
+			if (off > (int64_t)period / 2) {
+				off -= (int64_t)period;
+			}
+			off = off > (int64_t)step ? (int64_t)step : off < -(int64_t)step ? -(int64_t)step : off;
+			fb->fNextTick -= off;
+		}
+		if (fb->fNextTick <= now) {
+			fb->fNextTick = now + period;   /* fell behind (a long GPU wait): start again from here */
+		}
+		AbsoluteTime deadline;
+		*(uint64_t *)&deadline = fb->fNextTick;
+		sender->wakeAtTime(deadline);
+	}
+}
+
+void
+AppleCLCD::addClient(IOMobileFramebufferUserClient *client)
+{
+	IOLockLock(fLock);
+	fClients->setObject(client);
+	IOLockUnlock(fLock);
+}
+
+void
+AppleCLCD::removeClient(IOMobileFramebufferUserClient *client)
+{
+	IOLockLock(fLock);
+	unsigned int i = fClients->getNextIndexOfObject(client, 0);
+	if (i != (unsigned int)-1) {
+		fClients->removeObject(i);
