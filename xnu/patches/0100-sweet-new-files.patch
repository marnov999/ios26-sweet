diff --git a/iokit/Kernel/arm/SweetBacklight.cpp b/iokit/Kernel/arm/SweetBacklight.cpp
new file mode 100644
index 0000000..7031302
--- /dev/null
+++ b/iokit/Kernel/arm/SweetBacklight.cpp
@@ -0,0 +1,152 @@
+/*
+ * SweetBacklight: the panel's brightness for iOS. backboardd's CoreBrightness looks for a service
+ * with the property backlight-control (IOPropertyMatch, IOServiceNotificationUser) and, failing to
+ * find one, has nothing to send the brightness slider's value to. This is that service: it carries
+ * backlight-control and an IODisplayParameters "brightness" range, takes what is set on it
+ * (setProperties), and sends the panel DCS 0x51 through bsd/dev/sweet_gpu.c's
+ * sweet_panel_brightness() (davinci's Samsung AMOLED: 0..2047).
+ *
+ * What iOS sets, and how, is logged (the first sixty times), so the mapping can follow what
+ * CoreBrightness really does; a number under "brightness" (or IODisplayParameters.brightness.value)
+ * is taken on the published scale.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSBoolean.h>
+#include <libkern/c++/OSString.h>
+#include <libkern/c++/OSSerialize.h>
+
+extern "C" int sweet_panel_brightness(uint32_t level);
+
+#define SWEET_BL_SCALE  65536u          /* the published range: 0..65536 (IODisplayParameters, as on a Mac) */
+#define SWEET_BL_PANEL  2047u           /* the panel's own maximum */
+#define SWEET_BL_START  0x218u          /* dt qcom,mdss-dsi-bl-default-level */
+
+/* The class is called what CoreBrightness matches (CBDisplayContaineriOS: IOServiceMatching("AppleARMBacklight")). */
+#define SweetBacklight AppleARMBacklight
+class SweetBacklight : public IOService {
+	OSDeclareDefaultStructors(SweetBacklight);
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+	IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type, OSDictionary *properties,
+	    IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+private:
+	unsigned fLogged;
+	uint32_t fValue;                     /* on the published scale */
+	void publish(uint32_t value);
+	void take(uint32_t value, const char *how);
+};
+
+OSDefineMetaClassAndStructors(SweetBacklight, IOService);
+
+void
+SweetBacklight::publish(uint32_t value)
+{
+	OSDictionary *params = OSDictionary::withCapacity(1);
+	OSDictionary *brightness = OSDictionary::withCapacity(3);
+	OSNumber *min = OSNumber::withNumber(0ull, 32), *max = OSNumber::withNumber(SWEET_BL_SCALE, 32),
+	    *cur = OSNumber::withNumber(value, 32);
+	if (params && brightness && min && max && cur) {
+		brightness->setObject("min", min);
+		brightness->setObject("max", max);
+		brightness->setObject("value", cur);
+		params->setObject("brightness", brightness);
+		setProperty("IODisplayParameters", params);
+		setProperty("brightness", cur);
+	}
+	OSSafeReleaseNULL(min);
+	OSSafeReleaseNULL(max);
+	OSSafeReleaseNULL(cur);
+	OSSafeReleaseNULL(brightness);
+	OSSafeReleaseNULL(params);
+}
+
+void
+SweetBacklight::take(uint32_t value, const char *how)
+{
+	uint32_t level;
+	if (value > SWEET_BL_SCALE) {
+		value = SWEET_BL_SCALE;
+	}
+	level = (uint32_t)(((uint64_t)value * SWEET_BL_PANEL + SWEET_BL_SCALE / 2) / SWEET_BL_SCALE);
+	if (level == 0 && value != 0) {
+		level = 1;                       /* the slider's bottom is dim, not black */
+	}
+	fValue = value;
+	publish(value);
+	IOLog("SWEET BACKLIGHT: %s %u/%u -> panel %u: %d\n", how, value, SWEET_BL_SCALE, level, sweet_panel_brightness(level));
+}
+
+bool
+SweetBacklight::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	fValue = (uint32_t)(((uint64_t)SWEET_BL_START * SWEET_BL_SCALE) / SWEET_BL_PANEL);
+	setProperty("backlight-control", kOSBooleanTrue);
+	publish(fValue);
+	registerService();
+	IOLog("SWEET BACKLIGHT: published (backlight-control), brightness %u/%u\n", fValue, SWEET_BL_SCALE);
+	return true;
+}
+
+static bool
+sweet_bl_number(OSObject *o, uint32_t *out)
+{
+	OSNumber *n = OSDynamicCast(OSNumber, o);
+	if (n) {
+		*out = n->unsigned32BitValue();
+		return true;
+	}
+	return false;
+}
+
+IOReturn
+SweetBacklight::setProperties(OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	uint32_t value = 0;
+	if (fLogged < 60) {
+		OSSerialize *s = OSSerialize::withCapacity(512);
+		fLogged++;
+		if (s && properties->serialize(s)) {
+			IOLog("SWEET BACKLIGHT: set %.400s\n", s->text());
+		}
+		OSSafeReleaseNULL(s);
+	}
+	if (!dict) {
+		return kIOReturnBadArgument;
+	}
+	if (sweet_bl_number(dict->getObject("IOMFBBrightnessLevel"), &value)) {   /* CoreBrightness Display.m */
+		take(value, "IOMFBBrightnessLevel");
+		return kIOReturnSuccess;
+	}
+	if (sweet_bl_number(dict->getObject("brightness"), &value)) {
+		take(value, "brightness");
+		return kIOReturnSuccess;
+	}
+	{
+		OSDictionary *params = OSDynamicCast(OSDictionary, dict->getObject("IODisplayParameters"));
+		OSDictionary *b = params ? OSDynamicCast(OSDictionary, params->getObject("brightness")) : NULL;
+		if (b && sweet_bl_number(b->getObject("value"), &value)) {
+			take(value, "IODisplayParameters");
+			return kIOReturnSuccess;
+		}
+	}
+	return kIOReturnSuccess;                 /* accepted (and logged) */
+}
+
+IOReturn
+SweetBacklight::newUserClient(task_t owningTask, void *securityID, UInt32 type, OSDictionary *properties,
+    IOUserClient **handler)
+{
+	IOLog("SWEET BACKLIGHT: a user client of type %u asked for\n", (unsigned)type);
+	return IOService::newUserClient(owningTask, securityID, type, properties, handler);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/iokit/Kernel/arm/SweetBattery.cpp b/iokit/Kernel/arm/SweetBattery.cpp
new file mode 100644
index 0000000..2272503
--- /dev/null
+++ b/iokit/Kernel/arm/SweetBattery.cpp
@@ -0,0 +1,496 @@
+/*
+ * Built-in iOS battery bring-up service. Default: 100%, AC, not charging.
+ * sweetbattery=1: read-only PM6150. Primary: MIUI's own battery % (bsd/dev/
+ * sweet_qg.c: bit-exact port of the QTI QG daemon + qpnp-qg, polled every
+ * 1 s / 200 ms). If the QG is unusable: the old voltage-derived estimate,
+ * polled every 30 seconds (UNCALIBRATED).
+ * See report.md for binary evidence, register provenance and integration.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <device/device_types.h> /* io_buf_ptr_t for private OSKext headers */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOWorkLoop.h>
+#include <IOKit/IOTimerEventSource.h>
+#include <IOKit/pwr_mgt/IOPMPowerSource.h>
+#include <libkern/c++/OSCollectionIterator.h>
+#include <pexpert/pexpert.h>
+#include "../../../bsd/dev/sweet_qg.h"
+/* bsd/dev/sweet_spmi.c */
+extern "C" int sweet_spmi_init(void);
+extern "C" int sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
+extern "C" void clock_set_calendar_microtime(unsigned long secs, uint32_t microsecs);
+
+/*
+ * The time of day, from the PMIC's RTC (PM6150 RTC_RW at 0x6000: RTC_EN is 0x46 bit 7, the
+ * seconds counter RDATA0..3 at 0x48..0x4b, rtc-pm8xxx's pmic5 layout), read twice around byte 0
+ * so a carry between the reads is caught. Without it every boot began at the epoch ("December
+ * 31, 1969" in Notes, in the lock screen, in every file's date). Whether MIUI keeps this counter
+ * at UTC is what the log line answers: Qualcomm's time_daemon may instead keep it free-running
+ * and the wall time as an offset in its own data. Set only when it reads as a date after 2020;
+ * boot-arg sweettime_offset=N (seconds) is added first.
+ */
+static int64_t
+sweet_rtc_set_clock(void)
+{
+	uint8_t b[4], again = 0, ctrl = 0;
+	bool ok = false;
+	if (sweet_spmi_init() != 0) {
+		IOLog("SWEET RTC: no SPMI\n");
+		return -1;
+	}
+	for (int tries = 0; tries < 3 && !ok; tries++) {
+		ok = true;
+		for (unsigned i = 0; i < 4; i++) {
+			ok = ok && sweet_spmi_read(0, 0x6048 + i, &b[i]) == 0;
+		}
+		ok = ok && sweet_spmi_read(0, 0x6048, &again) == 0 && again == b[0];
+	}
+	(void)sweet_spmi_read(0, 0x6046, &ctrl);
+	if (!ok) {
+		IOLog("SWEET RTC: unreadable (ctrl %#x)\n", ctrl);
+		return -2;
+	}
+	uint32_t raw = (uint32_t)b[0] | ((uint32_t)b[1] << 8) | ((uint32_t)b[2] << 16) | ((uint32_t)b[3] << 24);
+	int64_t offset = 0;
+	(void)PE_parse_boot_argn("sweettime_offset", &offset, sizeof(offset));
+	int64_t secs = (int64_t)raw + offset;
+	bool plausible = secs >= 1577836800 && secs < 4102444800;   /* 2020 .. 2100 */
+	IOLog("SWEET RTC: counter %u s (enable %d), offset %lld -> %lld: %s\n", raw, (ctrl >> 7) & 1,
+	    (long long)offset, (long long)secs, plausible ? "the time of day set" : "not a date, left alone");
+	if (plausible) {
+		clock_set_calendar_microtime((unsigned long)secs, 0);
+	}
+	return raw;
+}
+
+class SweetBattery : public IOPMPowerSource {
+	OSDeclareDefaultStructors(SweetBattery);
+public:
+	bool init(OSDictionary *dictionary = NULL) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+private:
+	IOWorkLoop *fLoop;
+	IOTimerEventSource *fTimer;
+	bool fTimerAdded, fRunning, fReal, fQG;
+	int fLastMode;
+	uint32_t fQGDelay;
+	struct sweet_qg_status fQGStatus;
+	void publishQG(void);
+	void putNumber(const char *key, UInt32 value);
+	void putBool(const char *key, bool value);
+	void publish(unsigned percent, unsigned mv, int ma, bool external,
+	    bool capable, bool charging, bool full, bool measured, bool currentValid);
+	void poll(void);
+	static void timerFired(OSObject *owner, IOTimerEventSource *sender);
+	static IOReturn stopPolling(OSObject *owner, void *, void *, void *, void *);
+	static bool readWord(unsigned address, uint16_t *value);
+	static unsigned estimatePercent(unsigned mv);
+};
+OSDefineMetaClassAndStructors(SweetBattery, IOPMPowerSource);
+
+bool
+SweetBattery::init(OSDictionary *dictionary)
+{
+	/* IOCatalogue calls init(dictionary). This XNU's IOPMPowerSource only
+	 * overrides init(void): explicitly run it to allocate its PS dictionary
+	 * and symbols, then copy the matching personality into the registry. */
+	if (!IOPMPowerSource::init()) {
+		return false;
+	}
+	fLoop = NULL;
+	fTimer = NULL;
+	fTimerAdded = fRunning = fReal = fQG = false;
+	fQGDelay = 1000;
+	if (dictionary) {
+		OSCollectionIterator *it = OSCollectionIterator::withCollection(dictionary);
+		if (!it) {
+			return false;
+		}
+		OSObject *object;
+		bool ok = true;
+		while ((object = it->getNextObject())) {
+			const OSSymbol *key = OSDynamicCast(OSSymbol, object);
+			if (!key || !setProperty(key, dictionary->getObject(key))) {
+				ok = false;
+				break;
+			}
+		}
+		it->release();
+		if (!ok) {
+			return false;
+		}
+	}
+	fLastMode = -1;
+	return true;
+}
+
+extern "C" volatile uint32_t sweet_battery_mv;   /* bsd/dev/sweet_gpu.c: the clock governor's low-battery cap */
+
+void
+SweetBattery::putNumber(const char *key, UInt32 value)
+{
+	const OSSymbol *symbol = OSSymbol::withCString(key);
+	OSNumber *number = OSNumber::withNumber(value, 32);
+	if (symbol && number) {
+		setPSProperty(symbol, number);
+	}
+	OSSafeReleaseNULL(number);
+	OSSafeReleaseNULL(symbol);
+}
+
+void
+SweetBattery::putBool(const char *key, bool value)
+{
+	const OSSymbol *symbol = OSSymbol::withCString(key);
+	if (symbol) {
+		setPSProperty(symbol, value ? kOSBooleanTrue : kOSBooleanFalse);
+		symbol->release();
+	}
+}
+
+void
+SweetBattery::publish(unsigned percent, unsigned mv, int ma, bool external,
+    bool capable, bool charging, bool full, bool measured, bool currentValid)
+{
+	/* Use consistent mAh units (DT nominal=5020). powerd computes C*100/M. */
+	const unsigned capacity = (5020u * percent + 50u) / 100u;
+	setBatteryInstalled(true);
+	setCurrentCapacity(capacity);
+	setMaxCapacity(5020);
+	setExternalConnected(external);
+	setExternalChargeCapable(capable);
+	setIsCharging(charging);
+	setAtWarnLevel(false);
+	/* An uncalibrated voltage curve must not assert a critical shutdown. */
+	setAtCriticalLevel(false);
+	setVoltage(mv);
+	setAmperage(ma);
+	setTimeRemaining(-1); /* Unknown; never publish zero minutes on error. */
+	setCycleCount(0);     /* Placeholder: cycle learning is not implemented. */
+	putBool("FullyCharged", full);
+	putBool("AppleRawExternalConnected", external);
+	putNumber("AppleRawCurrentCapacity", capacity);
+	putNumber("AppleRawMaxCapacity", 5020);
+	putNumber("DesignCapacity", 5020);
+	putNumber("InstantAmperage", (UInt32)ma);
+	/* iOS battery convention: centidegrees C; fixed 25 C, NOT measured. */
+	putNumber("Temperature", 2500);
+	putBool("SweetBatteryHardwareSampleValid", measured);
+	putBool("SweetBatteryCurrentValid", currentValid);
+	putBool("SweetBatterySOCEstimated", measured);
+	putBool("SweetBatteryTemperatureEstimated", true);
+	putBool("SweetBatteryFallback", !measured);
+	putNumber("SweetBatteryPercent", percent);
+
+	/* IOPMCopyBatteryInfo's per-source compatibility dictionary. */
+	OSDictionary *legacy = OSDictionary::withCapacity(7);
+	if (legacy) {
+		const char *keys[] = {kIOBatteryCurrentChargeKey, kIOBatteryCapacityKey,
+		    kIOBatteryVoltageKey, kIOBatteryAmperageKey, kIOBatteryCycleCountKey,
+		    kIOBatteryFlagsKey};
+		UInt32 values[] = {capacity, 5020, mv, (UInt32)ma, 0,
+		    (UInt32)(kIOBatteryInstalled | (external ? kIOBatteryChargerConnect : 0) |
+		    (charging ? kIOBatteryCharge : 0))};
+		for (unsigned i = 0; i < sizeof(values) / sizeof(values[0]); ++i) {
+			OSNumber *number = OSNumber::withNumber(values[i], 32);
+			if (number) {
+				legacy->setObject(keys[i], number);
+				number->release();
+			}
+		}
+		setLegacyIOBatteryInfo(legacy);
+		legacy->release();
+	}
+	updateStatus(); /* Flush PS properties and send 0xe0024100 on change. */
+	if (measured) {
+		sweet_battery_mv = mv;
+	}
+	int mode = measured ? 1 : 0;
+	if (mode != fLastMode) {
+		IOLog("SWEET BATTERY: %s, %u%% %umV external=%d charging=%d\n",
+		    measured ? "PM6150 / estimated SOC" : "static fallback",
+		    percent, mv, external, charging);
+		fLastMode = mode;
+	}
+}
+
+/* sweetbattery=1 with a working QG: what MIUI would show (sweet_qg.c). */
+void
+SweetBattery::publishQG(void)
+{
+	const struct sweet_qg_status *s = &fQGStatus;
+	unsigned percent = s->percent < 0 ? 0u : (s->percent > 100 ? 100u : (unsigned)s->percent);
+	int ma = -s->ua / 1000;             /* Linux: + = discharge; IOPMPowerSource: + = charging */
+	unsigned mv = s->mv > 0 ? (unsigned)s->mv : 0u;
+	unsigned learned = s->learned_mah > 0 ? (unsigned)s->learned_mah : 4000u;
+	setBatteryInstalled(true);
+	setCurrentCapacity(percent);
+	setMaxCapacity(100);
+	setExternalConnected(s->external != 0);
+	setExternalChargeCapable(s->charge_capable != 0);
+	setIsCharging(s->charging != 0);
+	setAtWarnLevel(false);
+	setAtCriticalLevel(s->critical != 0);   /* MIUI's force-shutdown condition */
+	setVoltage(mv);
+	setAmperage(ma);
+	setTimeRemaining(-1);
+	setCycleCount(0);
+	putBool("FullyCharged", s->full != 0);
+	putBool("AppleRawExternalConnected", s->external != 0);
+	putNumber("AppleRawCurrentCapacity", s->charge_counter_uah > 0 ? (UInt32)(s->charge_counter_uah / 1000) : 0);
+	putNumber("AppleRawMaxCapacity", learned);
+	putNumber("NominalChargeCapacity", learned);
+	putNumber("DesignCapacity", 4000);
+	putNumber("InstantAmperage", (UInt32)ma);
+	/* centidegrees C; NOT measured until the VADC conversion exists (TODO write) */
+	putNumber("Temperature", (UInt32)(s->temp_dc * 10));
+	putBool("SweetBatteryHardwareSampleValid", true);
+	putBool("SweetBatteryCurrentValid", true);
+	putBool("SweetBatterySOCEstimated", false);
+	putBool("SweetBatteryTemperatureEstimated", true);
+	putBool("SweetBatteryFallback", false);
+	putNumber("SweetBatteryPercent", percent);
+	/* Linux qpnp-qg / QG daemon internals (negative values read as 2^32 - n) */
+	putNumber("SweetQGMsoc", (UInt32)s->msoc);
+	putNumber("SweetQGCatchUpSoc", (UInt32)s->catch_up_soc);
+	putNumber("SweetQGSysSoc", (UInt32)s->sys_soc);
+	putNumber("SweetQGBattSoc", (UInt32)s->batt_soc);
+	putNumber("SweetQGCcSoc", (UInt32)s->cc_soc);
+	putNumber("SweetQGFullSoc", (UInt32)s->full_soc);
+	putNumber("SweetQGMaintSoc", (UInt32)s->maint_soc);
+	putNumber("SweetQGChargeFull", (UInt32)s->charge_full);
+	putNumber("SweetQGPsStatus", (UInt32)s->ps_status);
+	putNumber("SweetQGChargeDone", (UInt32)s->charge_done);
+	putNumber("SweetQGHealth", (UInt32)s->health);
+	putNumber("SweetQGCurrentUA", (UInt32)s->ua);
+	putNumber("SweetQGTempDeciC", (UInt32)s->temp_dc);
+	putNumber("SweetQGTempSource", (UInt32)s->temp_src);
+	putNumber("SweetQGLearnedMah", (UInt32)s->learned_mah);
+	putNumber("SweetQGFifoRT", (UInt32)s->fifo_rt);
+	putNumber("SweetQGAccCount", (UInt32)s->acc_count);
+	putNumber("SweetQGFifoLen", (UInt32)s->fifo_len);
+	putNumber("SweetQGFifoCount", (UInt32)s->fifo_count);
+	putNumber("SweetQGFifoIntervalMs", (UInt32)s->fifo_interval_ms);
+	putNumber("SweetQGFifoCycles", (UInt32)s->fifo_cycles);
+	putNumber("SweetQGFifoGaps", (UInt32)s->fifo_gaps);
+	putNumber("SweetQGFifoRejects", (UInt32)s->fifo_rejects);
+	putNumber("SweetQGFifoSource", (UInt32)s->fifo_source);
+	putNumber("SweetQGDaemonCycles", (UInt32)s->daemon_cycles);
+	putNumber("SweetQGDaemonWrites", (UInt32)s->daemon_writes);
+	putNumber("SweetQGGoodOcv", (UInt32)s->good_ocv_events);
+	putNumber("SweetQGSpmiErrors", (UInt32)s->spmi_errors);
+	putNumber("SweetQGMultiByte", (UInt32)s->multibyte);
+	putNumber("SweetQGPonSoc", (UInt32)s->pon_soc);
+	putNumber("SweetQGPonCalcSoc", (UInt32)s->pon_calc_soc);
+	putNumber("SweetQGPonUsedSdam", (UInt32)s->pon_used_shutdown);
+	putNumber("SweetQGSdamSoc", (UInt32)s->sdam_soc);
+	putNumber("SweetQGSdamAgeS", (UInt32)s->sdam_age_s);
+	putNumber("SweetQGSdamMagicOk", (UInt32)s->sdam_magic_ok);
+	putNumber("SweetQGRtc", (UInt32)s->rtc_s);
+
+	OSDictionary *legacy = OSDictionary::withCapacity(7);
+	if (legacy) {
+		const char *keys[] = {kIOBatteryCurrentChargeKey, kIOBatteryCapacityKey,
+		    kIOBatteryVoltageKey, kIOBatteryAmperageKey, kIOBatteryCycleCountKey,
+		    kIOBatteryFlagsKey};
+		UInt32 values[] = {percent, 100, mv, (UInt32)ma, 0,
+		    (UInt32)(kIOBatteryInstalled | (s->external ? kIOBatteryChargerConnect : 0) |
+		    (s->charging ? kIOBatteryCharge : 0))};
+		for (unsigned i = 0; i < sizeof(values) / sizeof(values[0]); ++i) {
+			OSNumber *number = OSNumber::withNumber(values[i], 32);
+			if (number) {
+				legacy->setObject(keys[i], number);
+				number->release();
+			}
+		}
+		setLegacyIOBatteryInfo(legacy);
+		legacy->release();
+	}
+	updateStatus();
+	if (mv) {
+		sweet_battery_mv = mv;
+	}
+	if (fLastMode != 2) {
+		IOLog("SWEET BATTERY: MIUI QG engine, %u%% %umV %dmA external=%d charging=%d\n",
+		    percent, mv, ma, s->external, s->charging);
+		fLastMode = 2;
+	}
+}
+
+/* Keep the proven single-byte observer command. Read two matching whole
+ * words to reject most torn ADC samples without writing the QG HOLD bit.
+ * This is a bounded consistency check, not a hardware snapshot guarantee. */
+bool
+SweetBattery::readWord(unsigned address, uint16_t *value)
+{
+	uint16_t previous = 0;
+	for (unsigned attempt = 0; attempt < 4; ++attempt) {
+		uint8_t lo, hi;
+		if (sweet_spmi_read(0, address, &lo) ||
+		    sweet_spmi_read(0, address + 1, &hi)) {
+			return false;
+		}
+		uint16_t next = (uint16_t)((unsigned)lo | ((unsigned)hi << 8));
+		if (attempt && next == previous) {
+			*value = next;
+			return true;
+		}
+		previous = next;
+	}
+	return false;
+}
+
+unsigned
+SweetBattery::estimatePercent(unsigned mv)
+{
+	/* Generic single-cell curve, intentionally NOT advertised as QG SOC.
+	 * Load sag, temperature, aging and charging introduce large errors. */
+	static const unsigned volts[] = {3400, 3500, 3600, 3700, 3800, 3900,
+	    4000, 4100, 4200, 4350};
+	static const unsigned soc[] = {1, 5, 10, 20, 40, 60, 75, 85, 93, 100};
+	if (mv <= volts[0]) {
+		return soc[0];
+	}
+	for (unsigned i = 1; i < sizeof(volts) / sizeof(volts[0]); ++i) {
+		if (mv < volts[i]) {
+			return soc[i - 1] + (mv - volts[i - 1]) * (soc[i] - soc[i - 1]) /
+			       (volts[i] - volts[i - 1]);
+		}
+	}
+	return 100;
+}
+
+void
+SweetBattery::poll(void)
+{
+	uint8_t type, present, usb, path, charger, error, temperature;
+	uint16_t rawVoltage;
+	bool valid = fReal &&
+	    !sweet_spmi_read(0, 0x4804, &type) && type == 0x0d &&
+	    !sweet_spmi_read(0, 0x4808, &present) && (present & 1u) &&
+	    readWord(0x48c0, &rawVoltage) && rawVoltage != 0x8000 &&
+	    !sweet_spmi_read(0, 0x1310, &usb) &&
+	    !sweet_spmi_read(0, 0x110b, &path) &&
+	    !sweet_spmi_read(0, 0x1006, &charger) &&
+	    !sweet_spmi_read(0, 0x1007, &error) &&
+	    !sweet_spmi_read(0, 0x100d, &temperature);
+	unsigned mv = valid ? (unsigned)(((uint64_t)rawVoltage * 194637u) / 1000000u) : 0;
+	/* Zero, reset, floating, or implausible data cannot become 0% battery. */
+	valid = valid && mv >= 2800 && mv <= 4600;
+	if (!valid) {
+		publish(100, 4200, 0, true, true, false, true, false, false);
+		return;
+	}
+	bool external = (usb & 0x10u) != 0;
+	bool capable = external && (path & 0x10u) && (path & 1u) && !(path & 0x40u);
+	unsigned state = charger & 7u;
+	bool charging = capable && state >= 1 && state <= 4 &&
+	    !(error & 2u) && !(temperature & 0x0cu);
+	/* Inhibit (0) does not by itself establish full capacity. */
+	bool full = external && state == 5 && !(error & 2u);
+	int ma = 0;
+	uint8_t subtype;
+	uint16_t rawCurrent;
+	bool currentValid = !sweet_spmi_read(0, 0x4805, &subtype) &&
+	    (subtype == 3 || subtype == 4) && readWord(0x48c2, &rawCurrent) &&
+	    rawCurrent != 0x8000;
+	if (currentValid) {
+		int signedRaw = (rawCurrent & 0x8000u) ? (int)rawCurrent - 65536 : (int)rawCurrent;
+		/* Linux: negative=charging; IOPMPowerSource: positive=charging, mA. */
+		ma = (int)(-((int64_t)signedRaw * (subtype == 3 ? 152588 : 305176)) / 1000000);
+	}
+	publish(full ? 100 : estimatePercent(mv), mv, ma, external, capable,
+	    charging, full, true, currentValid);
+}
+
+void
+SweetBattery::timerFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	SweetBattery *self = OSDynamicCast(SweetBattery, owner);
+	if (self && self->fRunning) {
+		if (self->fQG) {
+			self->fQGDelay = sweet_qg_poll(&self->fQGStatus);
+			if (self->fQGStatus.changed) {
+				self->publishQG();
+			}
+			sender->setTimeoutMS(self->fQGDelay);
+			return;
+		}
+		self->poll();
+		sender->setTimeoutMS(30000);
+	}
+}
+
+bool
+SweetBattery::start(IOService *provider)
+{
+	if (!IOPMPowerSource::start(provider)) {
+		return false;
+	}
+	/* the raw counter also as a property (SweetRTCCounter; -1 no SPMI, -2 unreadable): the log
+	 * line comes before the USB console does */
+	setProperty("SweetRTCCounter", (unsigned long long)sweet_rtc_set_clock(), 64);
+	int real = 0;
+	(void)PE_parse_boot_argn("sweetbattery", &real, sizeof(real));
+	fReal = real == 1 && sweet_spmi_init() == 0;
+	/* MIUI's own algorithm when the QG is readable; else the estimate below */
+	fQG = fReal && sweet_qg_start(&fQGStatus) == 0;
+	/* Publish a complete source BEFORE registerService wakes powerd. */
+	if (fQG) {
+		publishQG();
+	} else {
+		poll();
+	}
+	if (fReal) {
+		fLoop = IOWorkLoop::workLoop();
+		fTimer = IOTimerEventSource::timerEventSource(this, &SweetBattery::timerFired);
+		if (fLoop && fTimer && fLoop->addEventSource(fTimer) == kIOReturnSuccess) {
+			fTimerAdded = true;
+			fRunning = true;
+			fTimer->setTimeoutMS(fQG ? fQGDelay : 30000);
+		} else {
+			fReal = false;
+			fQG = false;
+			poll();
+			IOLog("SWEET BATTERY: timer unavailable; static fallback\n");
+		}
+	}
+	registerService();
+	return true;
+}
+
+void
+SweetBattery::stop(IOService *provider)
+{
+	if (fLoop && fTimerAdded) {
+		/* Serialize against a running timer callback, including rearming. */
+		(void)fLoop->runAction(&SweetBattery::stopPolling, this);
+		fLoop->removeEventSource(fTimer);
+		fTimerAdded = false;
+	}
+	IOPMPowerSource::stop(provider);
+}
+
+IOReturn
+SweetBattery::stopPolling(OSObject *owner, void *, void *, void *, void *)
+{
+	SweetBattery *self = OSDynamicCast(SweetBattery, owner);
+	if (!self) {
+		return kIOReturnBadArgument;
+	}
+	self->fRunning = false;
+	self->fTimer->cancelTimeout();
+	self->fTimer->disable();
+	return kIOReturnSuccess;
+}
+
+void
+SweetBattery::free(void)
+{
+	OSSafeReleaseNULL(fTimer);
+	OSSafeReleaseNULL(fLoop);
+	IOPMPowerSource::free();
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
new file mode 100644
index 0000000..2545cf9
--- /dev/null
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -0,0 +1,271 @@
+/*
+ * A55 SMP bring-up for sweet using XNU's legacy IOCPU interface and PSCI.
+ * The architected timer and SGI1 already enter through pe_fiq/sleh_irq.
+ * CPU_OFF, suspend and the A76 cores still require separate platform work.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOCPU.h>
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+#include <arm64/proc_reg.h>
+#include <machine/atomic.h>
+#include <kern/clock.h>
+#include <kern/processor.h>
+#include <kern/thread.h>
+#include <mach/mach_time.h>
+#include <pexpert/pexpert.h>
+
+extern "C" void sweet_secondary_entry(void);
+extern "C" boolean_t sweet_cpu_signal_is_enabled(unsigned int cpu);
+
+class SweetCPU;
+static SweetCPU *sweet_cpus[MAX_CPUS];
+static uint32_t sweet_cpus_registered;
+
+/* SMCCC 1.0: x0 is the signed PSCI result; do not assume x1-x17 survive. */
+static int32_t
+sweet_psci_cpu_on(uint64_t target, uint64_t entry, uint64_t context)
+{
+	register uint64_t x0 __asm__("x0") = 0xC4000003ULL;
+	register uint64_t x1 __asm__("x1") = target;
+	register uint64_t x2 __asm__("x2") = entry;
+	register uint64_t x3 __asm__("x3") = context;
+	__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+	    "x14", "x15", "x16", "x17", "cc", "memory");
+	return (int32_t)x0;
+}
+
+class SweetCPU : public IOCPU {
+	OSDeclareDefaultStructors(SweetCPU);
+	const OSSymbol *cpuName = NULL;
+	uint32_t initialized = 0; /* release/acquire publication after initCPU sends SGI */
+
+public:
+	static void startAll(void *arg, wait_result_t result);
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	void initCPU(bool boot) APPLE_KEXT_OVERRIDE;
+	void quiesceCPU(void) APPLE_KEXT_OVERRIDE;
+	kern_return_t startCPU(vm_offset_t start_paddr, vm_offset_t arg_paddr) APPLE_KEXT_OVERRIDE;
+	void haltCPU(void) APPLE_KEXT_OVERRIDE;
+	void signalCPU(IOCPU *target) APPLE_KEXT_OVERRIDE;
+	const OSSymbol *getCPUName(void) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetCPU, IOCPU);
+
+bool
+SweetCPU::start(IOService *provider)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	OSNumber *logical = OSDynamicCast(OSNumber, provider->getProperty("logical-cpu-id"));
+	OSData *reg = OSDynamicCast(OSData, provider->getProperty("reg"));
+
+	if (logical == NULL || reg == NULL || reg->getLength() != sizeof(uint32_t) ||
+	    logical->unsigned32BitValue() >= topology->num_cpus) {
+		return false;
+	}
+	const ml_topology_cpu_t *cpu = &topology->cpus[logical->unsigned32BitValue()];
+	if (*(const uint32_t *)reg->getBytesNoCopy() != cpu->phys_id) {
+		return false;
+	}
+	/* MPIDR Aff1 = core: 0x000-0x500 A55, 0x600/0x700 A76 */
+	if (cpu->phys_id > 0x700 || (cpu->phys_id & 0xff) != 0 ||
+	    topology->num_cpus > SWEET_SMP_MAX_CPUS) {
+		panic("SWEET CPU: invalid topology cpu=%u mpidr=0x%x count=%u",
+		    cpu->cpu_id, cpu->phys_id, topology->num_cpus);
+	}
+	if (!IOCPU::start(provider)) {
+		return false;
+	}
+	cpuName = OSSymbol::withCStringNoCopy("Kryo 470");
+	if (cpuName == NULL) {
+		return false;
+	}
+	setCPUNumber(cpu->cpu_id);
+
+	ml_processor_info_t info = {};
+	info.cpu_id = reinterpret_cast<cpu_id_t>(this);
+	info.phys_id = cpu->phys_id;
+	info.log_id = cpu->cpu_id;
+	info.cluster_id = cpu->cluster_id;
+	info.cluster_type = cpu->cluster_type;
+	info.l2_cache_id = cpu->l2_cache_id;
+	info.l2_cache_size = cpu->l2_cache_size;
+	info.l3_cache_id = cpu->l3_cache_id;
+	info.l3_cache_size = cpu->l3_cache_size;
+	perfmon_interrupt_handler_func pmi_handler = NULL;
+	kern_return_t result = ml_processor_register(&info, &machProcessor, &ipi_handler, &pmi_handler);
+	if (result != KERN_SUCCESS) {
+		panic("SWEET CPU: ml_processor_register failed: %d", result);
+	}
+	if (pmi_handler != NULL) {
+		panic("SWEET CPU: PMI routing is not implemented");
+	}
+
+	registerService();
+	__atomic_store_n(&sweet_cpus[cpu->cpu_id], this, __ATOMIC_RELEASE);
+	__atomic_add_fetch(&sweet_cpus_registered, 1, __ATOMIC_ACQ_REL);
+	if (cpu == topology->boot_cpu) {
+		thread_t thread;
+		result = kernel_thread_start(&SweetCPU::startAll, NULL, &thread);
+		if (result != KERN_SUCCESS) {
+			panic("SWEET CPU: cannot create startup thread: %d", result);
+		}
+		thread_deallocate(thread);
+	}
+	return true;
+}
+
+/* Do not wait in a nub's start(): matching can be asynchronous or serialized. */
+void
+SweetCPU::startAll(void *arg __unused, wait_result_t result __unused)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	uint32_t requested = 1;
+	PE_parse_boot_argn("cpus", &requested, sizeof(requested));
+	IOLog("SWEET CPU: requested=%u selected=%u (limit=%u)\n",
+	    requested, topology->num_cpus, SWEET_SMP_MAX_CPUS);
+
+	uint64_t deadline;
+	nanoseconds_to_deadline(10 * NSEC_PER_SEC, &deadline);
+	while (__atomic_load_n(&sweet_cpus_registered, __ATOMIC_ACQUIRE) != topology->num_cpus) {
+		if (mach_absolute_time() > deadline) {
+			for (unsigned int i = 0; i < topology->num_cpus; i++) {
+				if (__atomic_load_n(&sweet_cpus[i], __ATOMIC_ACQUIRE) == NULL) {
+					IOLog("SWEET CPU: cpu=%u NOT registered (IOKit matching timeout)\n", i);
+				}
+			}
+			panic("SWEET CPU: CPU registration timeout");
+		}
+		IOSleep(1);
+	}
+	/* The supplied ADT has cpu0 as the boot CPU and ascending A55 nodes. */
+	if (topology->boot_cpu->cpu_id != 0 || topology->boot_cpu->phys_id != 0) {
+		panic("SWEET CPU: expected boot MPIDR 0 and logical CPU 0");
+	}
+	for (unsigned int i = 0; i < topology->num_cpus; i++) {
+		SweetCPU *cpu = __atomic_load_n(&sweet_cpus[i], __ATOMIC_ACQUIRE);
+		kern_return_t kr = processor_start(cpu->machProcessor);
+		if (kr != KERN_SUCCESS) {
+			panic("SWEET CPU: cpu=%u processor_start failed: %d", i, kr);
+		}
+		/* processor_start() is asynchronous for secondaries in this XNU. */
+		nanoseconds_to_deadline(5 * NSEC_PER_SEC, &deadline);
+		while (__atomic_load_n(&cpu->initialized, __ATOMIC_ACQUIRE) == 0 ||
+		    !sweet_cpu_signal_is_enabled(i)) {
+			if (mach_absolute_time() > deadline) {
+				IOLog("SWEET CPU: cpu=%u mpidr=0x%x NOT alive after 5s\n",
+				    i, topology->cpus[i].phys_id);
+				panic("SWEET CPU: cpu=%u startup timeout (reset/MMU/GIC/SGI)", i);
+			}
+			IOSleep(1);
+		}
+		IOLog("SWEET CPU: cpu=%u mpidr=0x%x came alive; SGI1 OK\n",
+		    i, topology->cpus[i].phys_id);
+	}
+	/* Publish exactly once, after every selected CPU has completed initCPU(). */
+	ml_cpu_init_completed();
+	__atomic_load_n(&sweet_cpus[topology->boot_cpu->cpu_id], __ATOMIC_ACQUIRE)->cpusRunning();
+	IOService::publishResource(gIOAllCPUInitializedKey, kOSBooleanTrue);
+	ml_set_max_cpus(topology->max_cpu_id + 1);
+	IOLog("SWEET CPU: %u/%u CPUs initialized, SGI1 verified\n",
+	    topology->num_cpus, topology->num_cpus);
+	thread_terminate(current_thread());
+}
+
+void
+SweetCPU::free(void)
+{
+	OSSafeReleaseNULL(cpuName);
+	IOCPU::free();
+}
+
+void
+SweetCPU::initCPU(bool boot)
+{
+	if (!boot) {
+		panic("SWEET CPU: cpu=%u resume is not implemented", getCPUNumber());
+	}
+	assert(cpu_number() == (int)getCPUNumber());
+
+	ml_broadcast_cpu_event(CPU_BOOTED, getCPUNumber());
+
+	/* Secondary startup runs at splsched: queue the self-IPI and return.
+	 * startAll waits for its delivery after the startup thread unmasks IRQs.
+	 * Waiting here with DAIF.I set would deadlock every secondary. */
+	signalCPU(this);
+	setCPUState(kIOCPUStateRunning);
+	kprintf("SWEET CPU: cpu=%u entered initCPU mpidr=0x%llx EL%llu IRQs=%u\n",
+	    getCPUNumber(), __builtin_arm_rsr64("MPIDR_EL1") & 0xffffULL,
+	    __builtin_arm_rsr64("CurrentEL") >> 2, ml_get_interrupts_enabled());
+	__atomic_store_n(&initialized, 1, __ATOMIC_RELEASE);
+}
+
+void
+SweetCPU::signalCPU(IOCPU *target)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	unsigned int logical = target->getCPUNumber();
+	if (logical >= topology->num_cpus) {
+		panic("SWEET CPU: invalid SGI target %u", logical);
+	}
+	/* Use the TARGET affinity, including Aff1, never the sender's MPIDR. */
+	uint64_t mpidr = topology->cpus[logical].phys_id;
+	unsigned int aff0 = mpidr & 0xff;
+	if (aff0 >= 16) {
+		panic("SWEET CPU: SGI target requires unsupported range selector");
+	}
+	uint64_t sgi = (((mpidr >> 32) & 0xff) << 48) |
+	    (((mpidr >> 16) & 0xff) << 32) |
+	    (((mpidr >> 8) & 0xff) << 16) |
+	    ((uint64_t)SWEET_IPI_SGI << 24) | (1ULL << aff0);
+	__builtin_arm_dsb(DSB_ISHST);
+	__builtin_arm_wsr64("ICC_SGI1R_EL1", sgi);
+	__builtin_arm_isb(ISB_SY);
+}
+
+kern_return_t
+SweetCPU::startCPU(vm_offset_t start_paddr, vm_offset_t arg_paddr)
+{
+	const ml_topology_cpu_t *cpu = &ml_get_topology_info()->cpus[getCPUNumber()];
+	/* cpu_start() passes NULL,NULL: x20/x21 are set by LowResetVectorBase. */
+	if (start_paddr != 0 || arg_paddr != 0 || cpu->phys_id == 0 ||
+	    __atomic_load_n(&initialized, __ATOMIC_ACQUIRE) != 0) {
+		panic("SWEET CPU: cpu=%u unsupported restart", getCPUNumber());
+	}
+	vm_offset_t entry = ml_static_vtop((vm_offset_t)&sweet_secondary_entry);
+	IOLog("SWEET CPU: cpu=%u CPU_ON target=0x%x entry_pa=0x%llx context=%u\n",
+	    getCPUNumber(), cpu->phys_id, (uint64_t)entry, getCPUNumber());
+	__builtin_arm_dsb(DSB_SY);
+	int32_t rc = sweet_psci_cpu_on(cpu->phys_id, entry, getCPUNumber());
+	IOLog("SWEET CPU: cpu=%u PSCI CPU_ON rc=%d\n", getCPUNumber(), rc);
+	/* cpu_start() discards PE_cpu_start's return; do not silently carry on. */
+	if (rc != 0) {
+		panic("SWEET CPU: cpu=%u NOT alive: PSCI CPU_ON rc=%d", getCPUNumber(), rc);
+	}
+	return KERN_SUCCESS;
+}
+
+void
+SweetCPU::quiesceCPU(void)
+{
+	panic("SWEET CPU: CPU quiesce is not implemented");
+}
+
+void
+SweetCPU::haltCPU(void)
+{
+	panic("SWEET CPU: CPU halt/suspend is not implemented");
+}
+
+const OSSymbol *
+SweetCPU::getCPUName(void)
+{
+	return cpuName;
+}
+#endif /* SWEET */
diff --git a/iokit/Kernel/arm/SweetEntitlements.cpp b/iokit/Kernel/arm/SweetEntitlements.cpp
new file mode 100644
index 0000000..6186541
--- /dev/null
+++ b/iokit/Kernel/arm/SweetEntitlements.cpp
@@ -0,0 +1,184 @@
+/*
+ * Entitlements for the SWEET built-in AMFI interface (bsd/kern/sweet_amfi.c).
+ *
+ * Apple's AMFI keeps a CoreEntitlements context per code signature; that
+ * library is closed. Here each signature with an XML entitlements blob gets
+ * a SweetEntitlements object: the blob parsed into an OSDictionary (the
+ * representation IOKit and the kernel KPIs hand out) plus the original XML,
+ * which csops(CS_OPS_ENTITLEMENTS_BLOB) returns. The blob was already
+ * checked against the code directory by csblob_get_entitlements().
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSBoolean.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSString.h>
+#include <libkern/c++/OSUnserialize.h>
+#include <kern/cs_blobs.h>
+
+class SweetEntitlements : public OSObject {
+	OSDeclareDefaultStructors(SweetEntitlements);
+
+public:
+	OSDictionary *dict;
+	CS_GenericBlob *xml;            /* the signature's blob, header included */
+	size_t xml_len;
+
+	bool init(void) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetEntitlements, OSObject);
+
+bool
+SweetEntitlements::init(void)
+{
+	return OSObject::init();
+}
+
+void
+SweetEntitlements::free(void)
+{
+	OSSafeReleaseNULL(dict);
+	if (xml) {
+		kfree_data(xml, xml_len);
+		xml = NULL;
+	}
+	OSObject::free();
+}
+
+static SweetEntitlements *
+sweet_ent(const void *obj)
+{
+	return OSDynamicCast(SweetEntitlements, (OSObject *)(uintptr_t)obj);
+}
+
+extern "C" {
+/* Parsed entitlements for one XML blob (header included), or NULL. Retained. */
+void *
+sweet_entitlements_create(const CS_GenericBlob *blob, size_t blob_len)
+{
+	if (blob == NULL || blob_len <= sizeof(CS_GenericBlob) ||
+	    ntohl(blob->magic) != CSMAGIC_EMBEDDED_ENTITLEMENTS ||
+	    ntohl(blob->length) != blob_len) {
+		return NULL;
+	}
+
+	/* OSUnserializeXML needs a terminating NUL inside the buffer. */
+	size_t text_len = blob_len - sizeof(CS_GenericBlob);
+	char *text = (char *)kalloc_data(text_len + 1, Z_WAITOK);
+	if (text == NULL) {
+		return NULL;
+	}
+	memcpy(text, blob->data, text_len);
+	text[text_len] = '\0';
+	OSObject *parsed = OSUnserializeXML(text, text_len + 1);
+	kfree_data(text, text_len + 1);
+
+	OSDictionary *dict = OSDynamicCast(OSDictionary, parsed);
+	if (dict == NULL) {
+		OSSafeReleaseNULL(parsed);
+		return NULL;
+	}
+
+	SweetEntitlements *ent = OSTypeAlloc(SweetEntitlements);
+	CS_GenericBlob *xml = (CS_GenericBlob *)kalloc_data(blob_len, Z_WAITOK);
+	if (ent == NULL || !ent->init() || xml == NULL) {
+		OSSafeReleaseNULL(ent);
+		if (xml) {
+			kfree_data(xml, blob_len);
+		}
+		dict->release();
+		return NULL;
+	}
+	memcpy(xml, blob, blob_len);
+	ent->dict = dict;
+	ent->xml = xml;
+	ent->xml_len = blob_len;
+	return ent;
+}
+
+/* The entitlements as an OSDictionary. Retained. */
+void *
+sweet_entitlements_copy_dict(const void *obj)
+{
+	SweetEntitlements *ent = sweet_ent(obj);
+	if (ent == NULL) {
+		return NULL;
+	}
+	ent->dict->retain();
+	return ent->dict;
+}
+
+/* A kalloc_data copy of the XML blob; the caller frees it (blob length). */
+bool
+sweet_entitlements_copy_xml(const void *obj, CS_GenericBlob **out)
+{
+	SweetEntitlements *ent = sweet_ent(obj);
+	if (ent == NULL) {
+		return false;
+	}
+	CS_GenericBlob *copy = (CS_GenericBlob *)kalloc_data(ent->xml_len, Z_WAITOK);
+	if (copy == NULL) {
+		return false;
+	}
+	memcpy(copy, ent->xml, ent->xml_len);
+	*out = copy;
+	return true;
+}
+
+/* name is true (a boolean entitlement). */
+bool
+sweet_entitlements_bool(const void *obj, const char *name)
+{
+	SweetEntitlements *ent = sweet_ent(obj);
+	return ent != NULL && ent->dict->getObject(name) == kOSBooleanTrue;
+}
+
+/* name is the string value, or an array containing it. */
+bool
+sweet_entitlements_string(const void *obj, const char *name, const char *value)
+{
+	SweetEntitlements *ent = sweet_ent(obj);
+	if (ent == NULL || value == NULL) {
+		return false;
+	}
+	OSObject *v = ent->dict->getObject(name);
+	OSString *s = OSDynamicCast(OSString, v);
+	if (s != NULL) {
+		return s->isEqualTo(value);
+	}
+	OSArray *a = OSDynamicCast(OSArray, v);
+	for (unsigned int i = 0; a != NULL && i < a->getCount(); i++) {
+		s = OSDynamicCast(OSString, a->getObject(i));
+		if (s != NULL && s->isEqualTo(value)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* Number of entitlements. */
+unsigned int
+sweet_entitlements_count(const void *obj)
+{
+	SweetEntitlements *ent = sweet_ent(obj);
+	return ent != NULL ? ent->dict->getCount() : 0;
+}
+
+/* The value of name, or NULL. Retained. */
+void *
+sweet_entitlements_copy_object(const void *obj, const char *name)
+{
+	SweetEntitlements *ent = sweet_ent(obj);
+	OSObject *v = ent != NULL ? ent->dict->getObject(name) : NULL;
+	if (v != NULL) {
+		v->retain();
+	}
+	return v;
+}
+}
+#endif /* SWEET */
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
new file mode 100644
index 0000000..2b12526
--- /dev/null
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -0,0 +1,1667 @@
+/*
+ * Built-in IOMobileFramebuffer for SWEET: the ABL's continuous-splash
+ * framebuffer (1080x2400 a8r8g8b8 in RAM, the panel scans it out by
+ * itself) as the main display, driven by CoreAnimation's CPU renderer.
+ *
+ * IOMobileFramebuffer.framework (iOS 16.7) counts /arm-io children with
+ * device_type "display-subsystem", waits for that many services matching
+ * IOServiceMatching("IOMobileFramebuffer"), opens each with type 0 and
+ * reads canvas-width/canvas-height from the service's provider. The class
+ * here (AppleCLCD, an IOMobileFramebuffer) matches the /arm-io/disp0 nub.
+ *
+ * User client selectors used by CoreAnimation:
+ *   3  GetLayerDefaultSurface [layer, ?] -> [IOSurface port name]
+ *   4  SwapBegin -> [swap id]
+ *   5  SwapEnd, struct 0x46c: +0x50 swap id, +0x54 IOSurface id per layer
+ *      (4 layers), +0x64 rect a / +0xc4 rect b per layer (int x,y,w,h),
+ *      +0x104 enabled layer mask
+ *   6  SwapWait, 7 GetID, 8 GetDisplaySize -> [w, h],
+ *   12 RequestPowerChange [state]: 0 = display off (backboardd, power
+ *      button / auto-lock), else on. Off fades the panel out over a few
+ *      vsyncs (halving each pixel) and keeps it black until on again;
+ *      the panel itself stays powered (AMOLED black pixels are off).
+ *   18 IsMainDisplay,
+ *   28 GetDotPitch, 72 Enable/DisableNotifications [func, refcon, type, 0]
+ * Everything else is accepted and logged once.
+ *
+ * SwapEnd copies the enabled layers' surfaces into the panel memory (CPU
+ * copy; scaled to the panel unless sweetfb_scale=0, below), or has the
+ * display engine fetch the frame itself (sweetfb_scanout=1). Vsync
+ * (notification type 5) is a 60 Hz timer that sends (count,
+ * mach_absolute_time, 0) as 32-bit halves to clients that enabled it,
+ * through the port they registered (IOConnectSetNotificationPort).
+ *
+ * The panel memory itself is published as an IOSurface and returned as the
+ * default framebuffer surface. The kernel text console keeps drawing over
+ * the GUI by default: boot-arg sweetfb_noconsole=1 stops drawing it from
+ * the first swap on (it still reaches the persistent log; panics draw).
+ */
+#include "SweetSurface.h"
+
+extern "C" int sweet_console_muted;     /* osfmk/console/serial_console.c */
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOWorkLoop.h>
+#include <IOKit/IOTimerEventSource.h>
+#include <kern/thread_call.h>
+#include <IOKit/system.h>
+#include <pexpert/pexpert.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <sys/proc.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <libkern/c++/OSSerialize.h>
+extern "C" int sweet_panel_power(int on);
+extern "C" void sweet_panel_new_frame(void);   /* bsd/dev/sweet_gpu.c: light the panel after a wake */
+extern "C" uint32_t sweet_fb_scanout_id;       /* bsd/kern/sweet_amfi.c kern.sweet_scanout_id: the surface on the panel */
+extern "C" void sweet_dpu_survey(void);
+extern "C" void sweet_prof_start(void);
+extern "C" vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, uint32_t);
+extern "C" void sweet_dvfs_kick(void);      /* bsd/dev/sweet_gpu.c: wake the clocks (something is drawn) */
+
+enum {
+	kSweetFBGetLayerDefaultSurface  = 3,
+	kSweetFBSwapBegin               = 4,
+	kSweetFBSwapEnd                 = 5,
+	kSweetFBSwapWait                = 6,
+	kSweetFBGetID                   = 7,
+	kSweetFBGetDisplaySize          = 8,
+	kSweetFBRequestPowerChange      = 12,
+	kSweetFBIsMainDisplay           = 18,
+	kSweetFBGetDotPitch             = 28,
+	kSweetFBNotifications           = 72,
+	kSweetFBSupportedFrameInfo      = 74,
+	kSweetFBGetCurrentAbsoluteTime  = 77,
+	kSweetFBGetBlock                = 79,
+};
+
+#define SWEET_FB_SWAP_REC_SIZE          0x46c
+/* the display engine's registers (scanOut) */
+#define SWEET_MDP_PA            0x0ae00000u
+#define SWEET_MDP_CTL0_FLUSH    (0x2000u + 0x018u)
+#define SWEET_MDP_VIG0_ADDR     (0x5000u + 0x014u)
+#define SWEET_MDP_VIG0_STRIDE   (0x5000u + 0x024u)
+#define SWEET_MDP_FLUSH_VIG0    0x1u
+/*
+ * VIG0's sizes, its pixel extension and its scaler (scalerOn): sde_hw_sspp.c, sde_hw_util.c
+ * (SDE_SCALER_QSEED3 / QSEED3LITE), the scaler at dt qcom,sde-vig-qseed-off 0xa00 into the pipe.
+ */
+#define SWEET_MDP_VIG0              0x5000u                     /* dt qcom,sde-sspp-off */
+#define SWEET_MDP_VIG0_SRC_SIZE     (SWEET_MDP_VIG0 + 0x000u)   /* h << 16 | w, fetched */
+#define SWEET_MDP_VIG0_SRC_XY       (SWEET_MDP_VIG0 + 0x008u)
+#define SWEET_MDP_VIG0_OUT_SIZE     (SWEET_MDP_VIG0 + 0x00cu)   /* h << 16 | w, into LM0 */
+#define SWEET_MDP_VIG0_OUT_XY       (SWEET_MDP_VIG0 + 0x010u)
+#define SWEET_MDP_VIG0_FORMAT       (SWEET_MDP_VIG0 + 0x030u)
+#define SWEET_MDP_VIG0_FORMAT_ALPHA (1u << 8)                   /* SRCC3_EN: the format's alpha is used */
+#define SWEET_MDP_VIG0_DECIMATION   (SWEET_MDP_VIG0 + 0x0b4u)
+#define SWEET_MDP_VIG0_PE(c)        (SWEET_MDP_VIG0 + 0x100u + 0x10u * (c))     /* c 0, 1 (1 and 2), 2 (3): +0 LR, +4 TB, +8 REQ_PIXELS */
+#define SWEET_MDP_VIG0_QSEED        (SWEET_MDP_VIG0 + 0xa00u)
+#define SWEET_QSEED_VERSION         0x00u
+#define SWEET_QSEED_OP_MODE         0x04u
+#define SWEET_QSEED_STEP_Y_H        0x10u       /* (and _Y_V 0x14, _UV_H 0x18, _UV_V 0x1c) */
+#define SWEET_QSEED_PRELOAD         0x20u
+#define SWEET_QSEED_SRC_SIZE_Y      0x40u       /* (and _UV 0x44) */
+#define SWEET_QSEED_DST_SIZE        0x48u
+#define SWEET_QSEED_INIT_Y_H        0x90u       /* (and _Y_V 0x94, _UV_H 0x98, _UV_V 0x9c; not on version 0x1002) */
+#define SWEET_QSEED_PHASE_SHIFT     21          /* sde_plane.c PHASE_STEP_SHIFT: a source pixel is 1 << 21 */
+#define SWEET_QSEED_PRELOAD_H       4           /* sde_hw_util.c QSEED3_DEFAULT_PRELOAD_H / _V */
+#define SWEET_QSEED_PRELOAD_V       3
+#define SWEET_QSEED_OP_ENABLE       (1u << 0)
+#define SWEET_QSEED_OP_ALPHA        (1u << 10)  /* the format has alpha... */
+#define SWEET_QSEED_OP_8BIT         (1u << 14)  /* ...and is not a 10-bit one */
+#define SWEET_QSEED_OP_Y_BILINEAR   (3u << 16)  /* y_rgb_filter_cfg SDE_SCALE_BIL: no coefficient tables */
+#define SWEET_QSEED_OP_A_BILINEAR   (1u << 29)  /* alpha_filter_cfg SDE_SCALE_ALPHA_BIL */
+#define SWEET_QSEED_OP_BLEND        (1u << 31)  /* blend_cfg 1 */
+#define SWEET_FB_SCALER_REGS        32
+
+struct sweet_fb_reg {
+	uint32_t off, val;
+};
+
+/*
+ * The frame timeline (asked with the profiler, bsd/dev/sweet_prof.c): for every swap, when it came
+ * (SwapEnd), when the GPU was done with it, when it was flipped, when the display engine took the
+ * flip, and when SwapWait for it was entered and returned; and every vsync tick. Microseconds of
+ * mach_absolute_time, as the GL bridge's "tl:" lines, for tools/sweet-timeline.py.
+ */
+struct sweet_tl_swap {
+	uint32_t id;
+	uint64_t arrive, gpu, flip, latch, win, wout;
+};
+#define SWEET_TL_SWAPS 600
+#define SWEET_TL_TICKS 2000
+static struct sweet_tl_swap sweet_tl[SWEET_TL_SWAPS];
+static uint64_t sweet_tl_tick[SWEET_TL_TICKS];
+static volatile uint32_t sweet_tl_on, sweet_tl_n, sweet_tl_nt;
+
+static uint64_t
+sweet_tl_us(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000ull;
+}
+
+static struct sweet_tl_swap *
+sweet_tl_find(uint32_t id)
+{
+	uint32_t n = sweet_tl_n < SWEET_TL_SWAPS ? sweet_tl_n : SWEET_TL_SWAPS;
+	for (uint32_t i = n; i > 0 && i + 16 > n; i--) {
+		if (sweet_tl[i - 1].id == id) {
+			return &sweet_tl[i - 1];
+		}
+	}
+	return NULL;
+}
+
+extern "C" void sweet_fb_timeline(int on);
+extern "C" void
+sweet_fb_timeline(int on)
+{
+	if (on) {
+		sweet_tl_n = sweet_tl_nt = 0;
+		sweet_tl_on = 1;
+		return;
+	}
+	sweet_tl_on = 0;
+	uint32_t n = sweet_tl_n < SWEET_TL_SWAPS ? sweet_tl_n : SWEET_TL_SWAPS;
+	uint32_t nt = sweet_tl_nt < SWEET_TL_TICKS ? sweet_tl_nt : SWEET_TL_TICKS;
+	IOLog("TL begin %u swaps %u ticks\n", n, nt);
+	for (uint32_t i = 0; i < nt; i++) {
+		IOLog("TL v %llu\n", sweet_tl_tick[i]);
+		if ((i & 63u) == 63u) {
+			IOSleep(40);
+		}
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		struct sweet_tl_swap *t = &sweet_tl[i];
+		IOLog("TL s %u %llu %llu %llu %llu %llu %llu\n", t->id, t->arrive, t->gpu, t->flip, t->latch, t->win, t->wout);
+		if ((i & 63u) == 63u) {
+			IOSleep(40);
+		}
+	}
+	IOLog("TL end\n");
+}
+
+#define SWEET_FB_LAYERS                 4
+#define SWEET_FB_NOTIFY_TYPES           8
+#define SWEET_FB_NOTIFY_VSYNC           5
+#define SWEET_FB_VSYNC_US               16667
+#define SWEET_FB_DOT_PITCH              458     /* ppi, as the iPhone X panel */
+/*
+ * The iOS userland only has status bar / layout data for real iPhone
+ * screens (UIKit: "No status bar visual provider for screen", the red
+ * rdar://45025538 bar for 360x800 points). The display is therefore
+ * presented as the iPhone X panel, 1125x2436 (375x812 points @3x), and
+ * shown scaled onto the whole 1080x2340 panel (the same 19.5:9), as an
+ * iPhone 12 mini shows the same 1125x2436 on its 1080x2340 one: by the
+ * display engine's scaler when it fetches the frame itself, else by the
+ * copy. Boot-arg sweetfb_scale=0 shows the centered 1080x2340 part of it
+ * instead (cropped), sweetfb_native=1 presents the real panel size.
+ */
+#define SWEET_FB_LOGICAL_W              1125
+#define SWEET_FB_LOGICAL_H              2436
+#define SWEET_FB_FORMAT_BGRA            0x42475241
+
+class IOMobileFramebuffer : public IOService {
+	OSDeclareDefaultStructors(IOMobileFramebuffer);
+};
+
+OSDefineMetaClassAndStructors(IOMobileFramebuffer, IOService);
+
+class IOMobileFramebufferUserClient;
+
+class AppleCLCD : public IOMobileFramebuffer {
+	OSDeclareDefaultStructors(AppleCLCD);
+
+	IOWorkLoop         *fWorkLoop;
+	IOTimerEventSource *fVsync;
+	uint64_t            fVsyncCount;
+
+	static void vsyncFired(OSObject *owner, IOTimerEventSource *sender);
+
+	/*
+	 * Putting a frame on the panel is a copy of ~10 MB by the CPU (there is no display
+	 * controller of ours behind the framebuffer). As HackiOS MiniIOMobileFramebuffer does it:
+	 * read from the surface's own cached kernel address (the GPU's surfaces are pushed out of
+	 * this processor's cache before every submission that names them, so nothing stale is
+	 * there), not the write-combined mapping -- reads through that one are uncached, and a
+	 * frame took tens of milliseconds -- and share the rows out among helper threads on the
+	 * other cores (boot-arg sweetfb_threads, default 3: the presenting thread and two helpers).
+	 */
+	/* scaled (fScale): a panel row is runs of consecutive source pixels (1125 -> 1080: 46 runs, 24 of every 25) */
+	struct ScaleRun {
+		uint32_t dst, src, n;   /* panel pixel (from the job's first), source pixel (likewise), how many */
+	};
+	struct RowJob {
+		uintptr_t src;          /* first pixel of the first row to copy */
+		uint64_t  stride;       /* bytes from one source row to the next */
+		uintptr_t dst;          /* first pixel of the first panel row */
+		uint64_t  rowBytes;     /* bytes from one panel row to the next */
+		size_t    bytes;        /* bytes of a row */
+		int32_t   rows;
+		const ScaleRun *runs;   /* scaled: the row's runs (NULL: the row as it is) */
+		uint32_t  nruns;
+		const uint32_t *rowMap; /* scaled: the source row (from the first) of each panel row */
+	};
+	IOLock            *fHelperLock;
+	const RowJob      *fHelperJob;
+	uint64_t           fHelperGeneration;
+	unsigned           fHelpersBusy, fHelpersStarted, fThreads;
+	static void helperMain(void *self, wait_result_t wr);
+	static void copyRows(const RowJob *job, int32_t y0, int32_t y1);
+	void copyFrame(const RowJob *job);
+
+public:
+	uint64_t      fPhys;
+	uint32_t      fWidth, fHeight, fRowBytes;
+	uint32_t      fLogicalW, fLogicalH;     /* size reported to userland */
+	int32_t       fOffX, fOffY;             /* logical origin of the panel */
+	uintptr_t     fPixels;          /* kernel mapping of the panel memory */
+	IOMemoryMap  *fMap;
+	SweetSurface *fSurface;         /* the panel memory as an IOSurface */
+	IOLock       *fLock;            /* swaps and client list */
+	OSArray      *fClients;
+	uint32_t      fSwapID;
+	bool          fConsolePaused;
+	uint8_t       fPending[SWEET_FB_SWAP_REC_SIZE];     /* latest swap, not yet shown */
+	bool          fDirty;
+	uint8_t       fEarly[SWEET_FB_SWAP_REC_SIZE];       /* the one before it, not shown yet either: */
+	bool          fHasEarly;                            /* shown first, at the next tick */
+	uint32_t      fFlushTicks;    /* vsync ticks between panel copies */
+	bool          fPowerOff;      /* RequestPowerChange(0) */
+	int           fScanout;       /* boot-arg sweetfb_scanout: the display engine fetches the surface itself */
+	vm_offset_t   fMdp;           /* MDP registers: CTL0 and VIG0 */
+	bool          fScanning;      /* VIG0 is on a surface of iOS's, not on the boot framebuffer */
+	SweetSurface *fShown[2];      /* the surface on screen, and the one before it (still fetched for a frame) */
+	uint32_t      fFlips;
+	volatile uint32_t fShownSwap;   /* the id of the last swap shown (SwapWait waits for it) */
+	volatile uint64_t fLatchAt;     /* when the display engine last took a flip: a panel frame's start */
+	IOLock       *fPresentLock;     /* one present at a time (the tick's, SwapEnd's) */
+	thread_call_t fPresentCall;     /* SwapEnd's present, on a thread of its own (not the caller's) */
+	static void   presentCallout(thread_call_param_t self, thread_call_param_t unused);
+	bool          fImmediate;       /* boot-arg sweetfb_immediate (default 1): SwapEnd flips at once */
+	void          presentPending(void);
+	void          publishModes(void);
+	bool          swapShown(uint32_t id, uint64_t timeoutMS);
+	/* the frame rate, per second (boot-arg sweetfb_fps=1): swaps from backboardd, frames shown, of
+	 * which scanned out, and gaps of more than 20 ms between shown frames */
+	uint32_t      fRateSwaps, fRateShown, fRateFlips, fRateLate;
+	uint64_t      fRateSince, fLastShown;
+	uint64_t      fNextTick;      /* the timer's next deadline: a fixed 60 Hz cadence, not 16.7 ms after the work */
+	bool scanOut(SweetSurface *s, uint64_t pa, uint32_t stride, bool scaled);
+	void scanBack(void);
+	bool          fScale;         /* boot-arg sweetfb_scale (default 1): the presented size onto the whole panel */
+	bool          fScaled;        /* VIG0 fetches the presented size and its scaler shrinks it (scalerOn) */
+	int           fScalerState;   /* 0 not looked at yet, 1 the boot loader's values kept, -1 not usable */
+	struct sweet_fb_reg fScalerSave[SWEET_FB_SCALER_REGS];    /* the boot loader's (put back by scalerOff) */
+	unsigned      fScalerRegs;
+	ScaleRun     *fRuns;          /* scaled copies: a panel row's runs, and each panel row's source row */
+	uint32_t     *fRowMap;
+	bool          scalerOn(void);
+	void          scalerOff(void);
+	uint32_t      fFadeStep;      /* fade-out steps done while off */
+
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+	void addClient(IOMobileFramebufferUserClient *client);
+	void removeClient(IOMobileFramebufferUserClient *client);
+	void swap(const uint8_t *rec);
+	void present(const uint8_t *rec);
+};
