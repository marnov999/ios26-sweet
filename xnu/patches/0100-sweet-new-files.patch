+#define SENSORS                 (sizeof(sensors) / sizeof(sensors[0]))
+static const struct sensor_hw *hw = &sensors[SWEET_CAMERA_ULTRA];
+static unsigned hw_index = SWEET_CAMERA_ULTRA;
