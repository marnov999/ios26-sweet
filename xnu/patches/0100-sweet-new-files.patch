+	IOLockUnlock(fLock);
+}
+
+static uint32_t
+get32(const uint8_t *p, uint32_t off)
+{
+	uint32_t v;
+	memcpy(&v, p + off, 4);
+	return v;
+}
+
+static uint32_t sweet_fb_swaps_logged;
+
+/* sweet_gpu.c: wait for the GPU to be done with the last submission naming a surface. */
+extern "C" int sweet_gpu_surface_wait(uint32_t surf_id, uint32_t ms);
+#define SWEET_SWAP_GPU_MS 100   /* a frame the GPU has not drawn by then is shown as it is (HackiOS: 500; the vsync workloop waits here) */
+static uint64_t sweet_fb_swap_count;
+
+/* Copy each enabled layer's surface into the panel memory (no scaling). */
+/*
+ * A swap only records the frame: copying 10 MB into the panel on every
+ * swap (backboardd presents at 60 Hz) took the whole CPU. The vsync timer
+ * shows the latest frame every fFlushTicks ticks (boot-arg sweetfb_hz,
+ * default 10 Hz).
+ */
+/*
+ * Show the swap waiting to be shown (the earlier of two first). From the vsync tick, and with
+ * scanout from SwapEnd itself (fImmediate): CoreAnimation waits for each swap to be on the
+ * panel before it draws the next (SwapWait), so a swap kept for the next tick of a timer that
+ * is not the panel's cost it up to a frame every frame. Flipped at once, the display engine
+ * takes it at the start of the panel's next frame, as a phone's display does. A flip the
+ * engine has not taken yet is waited for first (not overwritten: that frame would be lost).
+ */
+void
+AppleCLCD::presentPending(void)
+{
+	uint8_t *rec = (uint8_t *)IOMallocData(SWEET_FB_SWAP_REC_SIZE);
+	if (rec == NULL) {
+		return;
+	}
+	IOLockLock(fPresentLock);
+	IOLockLock(fLock);
+	bool have = fDirty;
+	if (have && fHasEarly) {
+		memcpy(rec, fEarly, SWEET_FB_SWAP_REC_SIZE);   /* (the latest stays for the next) */
+		fHasEarly = false;
+	} else if (have) {
+		memcpy(rec, fPending, SWEET_FB_SWAP_REC_SIZE);
+		fDirty = false;
+	}
+	IOLockUnlock(fLock);
+	if (have) {
+		uint32_t flips = fFlips;
+		uint64_t now = mach_absolute_time(), ns = 0, until = 0;
+		static int latch_wait = -1;     /* boot-arg sweetfb_latchwait=1: a flip waits for the last to be taken */
+		if (latch_wait < 0) {
+			int v = 0;
+			(void)PE_parse_boot_argn("sweetfb_latchwait", &v, sizeof(v));
+			latch_wait = v != 0;
+		}
+		if (latch_wait && fScanning && fMdp != 0) {
+			volatile uint32_t *r = (volatile uint32_t *)fMdp;
+			clock_interval_to_deadline(20, kMillisecondScale, &until);
+			while ((r[SWEET_MDP_CTL0_FLUSH / 4] & SWEET_MDP_FLUSH_VIG0) != 0 && mach_absolute_time() < until) {
+				IODelay(100);
+			}
+		}
+		present(rec);
+		IOLockLock(fLock);
+		memcpy((void *)&fShownSwap, rec + 0x50, sizeof(uint32_t));   /* (the swap's id, +0x50) */
+		IOLockWakeup(fLock, (event_t)&fShownSwap, false);
+		IOLockUnlock(fLock);
+		fRateShown++;
+		fRateFlips += fFlips - flips;
+		if (fLastShown != 0) {
+			absolutetime_to_nanoseconds(now - fLastShown, &ns);
+			fRateLate += ns > 20000000ull;
+		}
+		fLastShown = now;
+	}
+	IOLockUnlock(fPresentLock);
+	IOFreeData(rec, SWEET_FB_SWAP_REC_SIZE);
+}
+
+void
+AppleCLCD::presentCallout(thread_call_param_t self, __unused thread_call_param_t unused)
+{
+	((AppleCLCD *)self)->presentPending();
+}
+
+void
+AppleCLCD::swap(const uint8_t *rec)
+{
+	IOLockLock(fLock);
+	/*
+	 * Two swaps within one tick (CoreAnimation's frames do not come exactly 16.7 ms apart): the
+	 * first is kept and shown at the next tick, the second at the one after -- not the first
+	 * dropped and the next tick left with nothing new, a frame missed in a steady motion (the
+	 * "micro lags"). A third before either is shown drops the oldest.
+	 */
+	if (fDirty && fFlushTicks == 1) {
+		memcpy(fEarly, fPending, SWEET_FB_SWAP_REC_SIZE);
+		fHasEarly = true;
+	}
+	memcpy(fPending, rec, SWEET_FB_SWAP_REC_SIZE);
+	fDirty = true;
+	fRateSwaps++;
+	sweet_dvfs_kick();
+	if (sweet_tl_on) {
+		uint32_t i = sweet_tl_n;
+		if (i < SWEET_TL_SWAPS) {
+			bzero(&sweet_tl[i], sizeof(sweet_tl[i]));
+			memcpy(&sweet_tl[i].id, rec + 0x50, sizeof(uint32_t));
+			sweet_tl[i].arrive = sweet_tl_us();
+			sweet_tl_n = i + 1;
+		}
+	}
+	IOLockUnlock(fLock);
+	if (fImmediate && fScanout > 0) {
+		/*
+		 * Not on the caller's thread: a present waits for the GPU to be done with the frame (1.5-3
+		 * ms, sweet_gpu_surface_wait), and the caller is CoreAnimation's render thread, which could
+		 * be drawing the next frame meanwhile -- the heaviest frames missed their tick by that much.
+		 */
+		if (fPresentCall != NULL) {
+			thread_call_enter(fPresentCall);
+		} else {
+			presentPending();
+		}
+	}
+	if ((++sweet_fb_swap_count % 1000) == 0) {
+		IOLog("SWEET FB: %llu swaps\n", sweet_fb_swap_count);
+	}
+}
+
+/*
+ * Scanning out (boot-arg sweetfb_scanout=1), as Android's composer has the display engine do: no
+ * copy, the engine fetches iOS's surface itself. The boot loader leaves pipe VIG0 fetching its
+ * framebuffer (SRC0_ADDR 0x9c000000, 1080x2340, stride 4320; dt qcom,sde-sspp-off: vig0 0x5000)
+ * through CTL0 to INTF1, whose tear check refreshes the command-mode panel by itself every frame
+ * (INTF_TEAR autorefresh, sweet_dpu.c's survey). A swap writes the surface's address and stride
+ * into VIG0 and VIG0's flush bit into CTL0 (sde_hw_ctl: SSPP_VIG0 = bit 0): the engine takes the
+ * double-buffered registers at the next frame's start, so there is no tearing. The surface has to
+ * be one physical piece below 4 GB (SweetSurface allocates CoreAnimation's full-screen ones so);
+ * anything else is copied as before, with VIG0 back on the boot framebuffer. Scaled (fScale), VIG0
+ * fetches the whole 1125x2436 surface and its scaler shrinks it to the panel (scalerOn): the boot
+ * loader's 1:1 setup of the pipe is changed at the first flip, and put back by scanBack.
+ */
+
+/* VIG0's last flush taken by the display engine (or MS gone by): what is written now is all taken together at the next */
+static bool
+sweet_fb_flush_taken(volatile uint32_t *r, uint32_t ms)
+{
+	uint64_t until = 0;
+	clock_interval_to_deadline(ms, kMillisecondScale, &until);
+	while ((r[SWEET_MDP_CTL0_FLUSH / 4] & SWEET_MDP_FLUSH_VIG0) != 0) {
+		if (mach_absolute_time() >= until) {
+			return false;
+		}
+		IODelay(100);
+	}
+	return true;
+}
+
+/*
+ * VIG0 fetching SW x SH and its scaler giving DW x DH to LM0, as the vendor driver sets a pipe up when
+ * nobody gave it scaler data (sde_plane.c _sde_plane_setup_scaler3 -> sde_hw_sspp.c setup_rects,
+ * setup_pe, sde_hw_util.c sde_hw_setup_scaler3): bilinear, so no coefficient tables to load; a phase
+ * step of SW / DW source pixels (21 fraction bits: 1125 -> 1080 is 0x215555, 2436 -> 2340 0x215015);
+ * initial phase 0; the preload of QSEED3 (4 across, 3 down); no pixel extension (the pipe's
+ * PE_OVERRIDE is set, so REQ_PIXELS is what it fetches: the whole source). The scaler's op mode last.
+ */
+static unsigned
+sweet_fb_scaler_config(struct sweet_fb_reg *c, uint32_t sw, uint32_t sh, uint32_t dw, uint32_t dh, bool alpha)
+{
+	uint32_t src = (sh << 16) | sw, dst = (dh << 16) | dw;
+	uint32_t step_x = (uint32_t)(((uint64_t)sw << SWEET_QSEED_PHASE_SHIFT) / dw);
+	uint32_t step_y = (uint32_t)(((uint64_t)sh << SWEET_QSEED_PHASE_SHIFT) / dh);
+	uint32_t preload = SWEET_QSEED_PRELOAD_H | (SWEET_QSEED_PRELOAD_V << 8) | (SWEET_QSEED_PRELOAD_H << 16) |
+	    (SWEET_QSEED_PRELOAD_V << 24);
+	uint32_t op = SWEET_QSEED_OP_ENABLE | SWEET_QSEED_OP_Y_BILINEAR | SWEET_QSEED_OP_BLEND | SWEET_QSEED_OP_8BIT;
+	const uint32_t q = SWEET_MDP_VIG0_QSEED;
+	unsigned n = 0;
+
+	if (alpha) {
+		op |= SWEET_QSEED_OP_ALPHA | SWEET_QSEED_OP_A_BILINEAR;
+	}
+	c[n++] = { SWEET_MDP_VIG0_SRC_SIZE, src };
+	c[n++] = { SWEET_MDP_VIG0_SRC_XY, 0 };
+	c[n++] = { SWEET_MDP_VIG0_OUT_SIZE, dst };
+	c[n++] = { SWEET_MDP_VIG0_OUT_XY, 0 };
+	c[n++] = { SWEET_MDP_VIG0_DECIMATION, 0 };
+	for (uint32_t i = 0; i < 3; i++) {     /* colour 0, colours 1 and 2, colour 3: LR, TB, REQ_PIXELS */
+		c[n++] = { SWEET_MDP_VIG0_PE(i) + 0x0u, 0 };
+		c[n++] = { SWEET_MDP_VIG0_PE(i) + 0x4u, 0 };
+		c[n++] = { SWEET_MDP_VIG0_PE(i) + 0x8u, src };
+	}
+	c[n++] = { q + SWEET_QSEED_INIT_Y_H + 0x0u, 0 };
+	c[n++] = { q + SWEET_QSEED_INIT_Y_H + 0x4u, 0 };
+	c[n++] = { q + SWEET_QSEED_INIT_Y_H + 0x8u, 0 };
+	c[n++] = { q + SWEET_QSEED_INIT_Y_H + 0xcu, 0 };
+	c[n++] = { q + SWEET_QSEED_STEP_Y_H + 0x0u, step_x };
+	c[n++] = { q + SWEET_QSEED_STEP_Y_H + 0x4u, step_y };
+	c[n++] = { q + SWEET_QSEED_STEP_Y_H + 0x8u, step_x };      /* (RGB: no subsampled chroma) */
+	c[n++] = { q + SWEET_QSEED_STEP_Y_H + 0xcu, step_y };
+	c[n++] = { q + SWEET_QSEED_PRELOAD, preload };
+	c[n++] = { q + SWEET_QSEED_SRC_SIZE_Y + 0x0u, src };
+	c[n++] = { q + SWEET_QSEED_SRC_SIZE_Y + 0x4u, src };
+	c[n++] = { q + SWEET_QSEED_DST_SIZE, dst };
+	c[n++] = { q + SWEET_QSEED_OP_MODE, op };
+	return n;
+}
+#define SWEET_FB_SCALER_SRC     0       /* (indexes into that: logged) */
+#define SWEET_FB_SCALER_OUT     2
+#define SWEET_FB_SCALER_REQ     7
+#define SWEET_FB_SCALER_STEP    18
+#define SWEET_FB_SCALER_DST     25
+
+/*
+ * The scaler on (VIG0 fetching the presented size): the first time, its version read (a scaler that
+ * is not there, or the first QSEED3 with its other phase registers, is not used: the frames are then
+ * copied, scaled by the CPU) and what the boot loader had in these registers kept. Written while no
+ * flush is pending, so that the next flush (scanOut's, with the address) has the engine take all of
+ * them at one frame's start.
+ */
+bool
+AppleCLCD::scalerOn(void)
+{
+	volatile uint32_t *r = (volatile uint32_t *)fMdp;
+	struct sweet_fb_reg c[SWEET_FB_SCALER_REGS];
+	bool alpha = (r[SWEET_MDP_VIG0_FORMAT / 4] & SWEET_MDP_VIG0_FORMAT_ALPHA) != 0;
+	unsigned n = sweet_fb_scaler_config(c, fLogicalW, fLogicalH, fWidth, fHeight, alpha);
+
+	if (fScalerState < 0) {
+		return false;
+	}
+	if (fScalerState == 0) {
+		uint32_t version = r[(SWEET_MDP_VIG0_QSEED + SWEET_QSEED_VERSION) / 4];
+		if (version == 0 || version == 0xffffffffu || version == 0x1002u) {
+			IOLog("SWEET FB: VIG0's scaler reads version %#x: not used (frames copied, scaled by the CPU)\n", version);
+			fScalerState = -1;
+			return false;
+		}
+		for (unsigned i = 0; i < n; i++) {
+			fScalerSave[i].off = c[i].off;
+			fScalerSave[i].val = r[c[i].off / 4];
+		}
+		fScalerRegs = n;
+		fScalerState = 1;
+		IOLog("SWEET FB: VIG0's scaler version %#x; the boot loader's src %#x out %#x req %#x, scaler op %#x step %#x/%#x "
+		    "dst %#x\n", version, fScalerSave[SWEET_FB_SCALER_SRC].val, fScalerSave[SWEET_FB_SCALER_OUT].val,
+		    fScalerSave[SWEET_FB_SCALER_REQ].val, fScalerSave[n - 1].val, fScalerSave[SWEET_FB_SCALER_STEP].val,
+		    fScalerSave[SWEET_FB_SCALER_STEP + 1].val, fScalerSave[SWEET_FB_SCALER_DST].val);
+	}
+	if (!sweet_fb_flush_taken(r, 40)) {
+		IOLog("SWEET FB: scaler on: VIG0's last flush still not taken after 40 ms\n");
+	}
+	for (unsigned i = 0; i < n; i++) {
+		r[c[i].off / 4] = c[i].val;
+	}
+	fScaled = true;
+	IOLog("SWEET FB: VIG0 scaled: %ux%u -> %ux%u, step %#x/%#x, scaler op %#x\n", fLogicalW, fLogicalH, fWidth,
+	    fHeight, c[SWEET_FB_SCALER_STEP].val, c[SWEET_FB_SCALER_STEP + 1].val, c[n - 1].val);
+	return true;
+}
+
+/* The boot loader's 1:1 setup back (the next flush takes it), for its framebuffer. */
+void
+AppleCLCD::scalerOff(void)
+{
+	volatile uint32_t *r = (volatile uint32_t *)fMdp;
+	if (!fScaled) {
+		return;
+	}
+	(void)sweet_fb_flush_taken(r, 40);
+	for (unsigned i = 0; i < fScalerRegs; i++) {
+		r[fScalerSave[i].off / 4] = fScalerSave[i].val;
+	}
+	fScaled = false;
+}
+
+bool
+AppleCLCD::scanOut(SweetSurface *s, uint64_t pa, uint32_t stride, bool scaled)
+{
+	if (fMdp == 0 && (fMdp = ml_io_map_unmappable(SWEET_MDP_PA, 0x6000u, 0x7u /* VM_WIMG_IO */)) == 0) {
+		return false;
+	}
+	if (scaled && !fScaled && !scalerOn()) {
+		return false;
+	} else if (!scaled && fScaled) {
+		scalerOff();
+	}
+	volatile uint32_t *r = (volatile uint32_t *)fMdp;
+	r[SWEET_MDP_VIG0_ADDR / 4] = (uint32_t)pa;
+	r[SWEET_MDP_VIG0_STRIDE / 4] = (r[SWEET_MDP_VIG0_STRIDE / 4] & 0xffff0000u) | (stride & 0xffffu);
+	__asm__ volatile("dsb sy" ::: "memory");
+	r[SWEET_MDP_CTL0_FLUSH / 4] = SWEET_MDP_FLUSH_VIG0;
+	__asm__ volatile("dsb sy" ::: "memory");
+	sweet_panel_new_frame();
+	sweet_fb_scanout_id = s->id;
+	if (s != fShown[0]) {
+		OSSafeReleaseNULL(fShown[1]);        /* two flips old: no longer fetched */
+		fShown[1] = fShown[0];
+		s->retain();
+		fShown[0] = s;
+	}
+	if (!fScanning || fFlips < 4) {
+		IOLog("SWEET FB: scanning out surface %u at %#llx, stride %u%s (flip %u)\n", s->id, pa, stride,
+		    fScaled ? ", scaled" : "", fFlips);
+	}
+	fScanning = true;
+	fFlips++;
+	return true;
+}
+
+/*
+ * SwapWait: until the swap is on the panel. CoreAnimation asks this before it draws into the
+ * buffer that swap replaced; answered at once, as before, it drew into the buffer the display
+ * engine was still fetching -- tearing, and frames run ahead of the panel then bunched. On the
+ * panel means: shown at a tick (or a later swap was), and when it was scanned out, the display
+ * engine has taken the new address -- CTL0's flush bits read back set until the engine latches
+ * them at the start of the panel's next frame.
+ */
+bool
+AppleCLCD::swapShown(uint32_t id, uint64_t timeoutMS)
+{
+	static uint32_t told;
+	uint64_t began = mach_absolute_time(), deadline, ns = 0;
+	bool shown = true;
+	uint64_t win = sweet_tl_on ? sweet_tl_us() : 0;
+	clock_interval_to_deadline((uint32_t)timeoutMS, kMillisecondScale, &deadline);
+	IOLockLock(fLock);
+	while ((int32_t)(fShownSwap - id) < 0 && id <= fSwapID) {
+		if (IOLockSleepDeadline(fLock, (event_t)&fShownSwap, *(AbsoluteTime *)&deadline, THREAD_UNINT) == THREAD_TIMED_OUT) {
+			shown = false;
+			break;
+		}
+	}
+	IOLockUnlock(fLock);
+	if (shown && fScanning && fMdp != 0) {
+		volatile uint32_t *r = (volatile uint32_t *)fMdp;
+		bool pending = false;
+		while ((r[SWEET_MDP_CTL0_FLUSH / 4] & SWEET_MDP_FLUSH_VIG0) != 0 && mach_absolute_time() < deadline) {
+			pending = true;
+			IODelay(100);
+		}
+		if (pending) {
+			fLatchAt = mach_absolute_time();   /* (seen to change: within 0.1 ms of the frame's start) */
+		}
+	}
+	if (sweet_tl_on) {
+		struct sweet_tl_swap *t = sweet_tl_find(id);
+		if (t != NULL && t->win == 0) {
+			t->win = win;
+			t->wout = sweet_tl_us();
+			t->latch = t->wout;         /* (on the panel by then: latched, or the flush already taken) */
+		}
+	}
+	if (told < 12) {
+		told++;
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+		IOLog("SWEET FB: swap wait for %u (shown %u, last begun %u): %s after %llu us\n", id, fShownSwap, fSwapID,
+		    shown ? "on the panel" : "timed out", ns / 1000ull);
+	}
+	return shown;
+}
+
+/*
+ * The display's modes, as CoreAnimation reads them (HackiOS MiniIOMobileFramebuffer publishModes):
+ * TimingElements and ColorElements, one timing of the presented size at 60 Hz (16.16), one colour
+ * mode, 8-bit RGB; GetBlock 0x40 answers with their identifiers as "the current mode". Without
+ * them CoreAnimation had no refresh rate from the display to plan its frames by.
+ */
+#define SWEET_FB_TIMING_ID 1
+#define SWEET_FB_COLOR_ID  1
+static void
+sweet_fb_set_number(OSDictionary *d, const char *key, uint64_t v)
+{
+	OSNumber *n = OSNumber::withNumber(v, 64);
+	if (n != NULL) {
+		d->setObject(key, n);
+		n->release();
+	}
+}
+
+void
+AppleCLCD::publishModes(void)
+{
+	OSDictionary *timing = OSDictionary::withCapacity(8), *horizontal = OSDictionary::withCapacity(4);
+	OSDictionary *vertical = OSDictionary::withCapacity(4), *color = OSDictionary::withCapacity(8);
+	OSArray *timings = OSArray::withCapacity(1), *colors = OSArray::withCapacity(1);
+	const uint64_t rate = 60ull << 16;
+	if (timing && horizontal && vertical && color && timings && colors) {
+		sweet_fb_set_number(color, "ID", SWEET_FB_COLOR_ID);
+		sweet_fb_set_number(color, "PixelEncoding", 0);
+		sweet_fb_set_number(color, "Depth", 8);
+		sweet_fb_set_number(color, "Colorimetry", 1);
+		sweet_fb_set_number(color, "EOTF", 1);
+		sweet_fb_set_number(color, "DynamicRange", 0);
+		sweet_fb_set_number(color, "Score", 1);
+		color->setObject("IsVirtual", kOSBooleanFalse);
+		colors->setObject(color);
+		sweet_fb_set_number(horizontal, "Active", fLogicalW);
+		sweet_fb_set_number(horizontal, "Total", fLogicalW);
+		sweet_fb_set_number(horizontal, "SyncRate", rate);
+		sweet_fb_set_number(horizontal, "PreciseSyncRate", rate);
+		sweet_fb_set_number(vertical, "Active", fLogicalH);
+		sweet_fb_set_number(vertical, "Total", fLogicalH);
+		sweet_fb_set_number(vertical, "SyncRate", rate);
+		sweet_fb_set_number(vertical, "PreciseSyncRate", rate);
+		sweet_fb_set_number(timing, "ID", SWEET_FB_TIMING_ID);
+		sweet_fb_set_number(timing, "Score", 1);
+		timing->setObject("IsVirtual", kOSBooleanFalse);
+		timing->setObject("IsOverscanned", kOSBooleanFalse);
+		timing->setObject("HorizontalAttributes", horizontal);
+		timing->setObject("VerticalAttributes", vertical);
+		timing->setObject("ColorModes", colors);
+		timings->setObject(timing);
+		setProperty("TimingElements", timings);
+		setProperty("ColorElements", colors);
+	}
+	OSSafeReleaseNULL(timings);
+	OSSafeReleaseNULL(colors);
+	OSSafeReleaseNULL(timing);
+	OSSafeReleaseNULL(horizontal);
+	OSSafeReleaseNULL(vertical);
+	OSSafeReleaseNULL(color);
+}
+
+void
+AppleCLCD::scanBack(void)
+{
+	if (!fScanning) {
+		return;
+	}
+	volatile uint32_t *r = (volatile uint32_t *)fMdp;
+	scalerOff();        /* (scaled: the boot framebuffer is the panel's size) */
+	r[SWEET_MDP_VIG0_ADDR / 4] = (uint32_t)fPhys;
+	r[SWEET_MDP_VIG0_STRIDE / 4] = (r[SWEET_MDP_VIG0_STRIDE / 4] & 0xffff0000u) | (fRowBytes & 0xffffu);
+	__asm__ volatile("dsb sy" ::: "memory");
+	r[SWEET_MDP_CTL0_FLUSH / 4] = SWEET_MDP_FLUSH_VIG0;
+	fScanning = false;
+	IOLog("SWEET FB: back on the boot framebuffer\n");
+}
+
+/* Scaled: the first panel pixel (of PANEL) whose centre is on logical pixel L or after it (of LOGICAL). */
+static int32_t
+sweet_fb_panel_at(int32_t l, uint32_t logical, uint32_t panel)
+{
+	int64_t num = 2 * (int64_t)l * panel - logical;
+	int64_t p = num <= 0 ? 0 : (num + 2 * (int64_t)logical - 1) / (2 * (int64_t)logical);
+	return (int32_t)(p > (int64_t)panel ? panel : p);
+}
+
+/* Scaled: the logical pixel under panel pixel P's centre. */
+static uint32_t
+sweet_fb_logical_at(int32_t p, uint32_t logical, uint32_t panel)
+{
+	return (uint32_t)(((2 * (uint64_t)p + 1) * logical) / (2 * (uint64_t)panel));
+}
+
+void
+AppleCLCD::present(const uint8_t *rec)
+{
+	uint32_t mask = get32(rec, 0x104);
+
+
+	if (!fConsolePaused) {
+		int quiet = 0;
+		fConsolePaused = true;
+		if (PE_parse_boot_argn("sweetfb_noconsole", &quiet, sizeof(quiet)) && quiet != 0) {
+			/* Not PE_initialize_console(kPEDisableScreen): its console switch
+			 * writes the read-only-late cons_ops_index and panics. */
+			sweet_console_muted = 1;
+		}
+	}
+
+	for (uint32_t layer = 0; layer < SWEET_FB_LAYERS; layer++) {
+		uint32_t id = get32(rec, 0x54 + 4 * layer);
+		const uint8_t *a = rec + 0x64 + 16 * layer;
+		const uint8_t *b = rec + 0xc4 + 16 * layer;
+		int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4);
+		int32_t dx = (int32_t)get32(b, 0), dy = (int32_t)get32(b, 4);
+		int32_t w = (int32_t)get32(b, 8), h = (int32_t)get32(b, 12);
+
+		if (!(mask & (1u << layer)) || id == 0) {
+			continue;
+		}
+		SweetSurface *s = sweet_surface_copy(id);
+		if (sweet_fb_swaps_logged < 16) {
+			sweet_fb_swaps_logged++;
+			IOLog("SWEET FB: swap %u layer %u surface %u %ux%u fmt 0x%x bpr %u a %d,%d %ux%u b %d,%d %dx%d\n",
+			    get32(rec, 0x50), layer, id, s ? s->width : 0, s ? s->height : 0,
+			    s ? s->pixelFormat : 0, s ? s->bytesPerRow : 0, sx, sy, get32(a, 8),
+			    get32(a, 12), dx, dy, w, h);
+		}
+		if (s == NULL || s == fSurface) {
+			OSSafeReleaseNULL(s);
+			continue;
+		}
+		/* the GPU may still be drawing it (submissions are not waited for): HackiOS MiniIOSurfaceDrawn */
+		bool gpu_done = sweet_gpu_surface_wait(id, SWEET_SWAP_GPU_MS);
+		if (sweet_tl_on && layer == 0) {
+			struct sweet_tl_swap *t = sweet_tl_find(get32(rec, 0x50));
+			if (t != NULL) {
+				t->gpu = sweet_tl_us();
+			}
+		}
+		if (!gpu_done) {
+			static uint32_t told;
+			if (told++ < 8) {
+				IOLog("SWEET FB: present: the GPU is not done with surface %u after %u ms; shown as it is\n",
+				    id, SWEET_SWAP_GPU_MS);
+			}
+		}
+		/* the surface's own cached address when it has one (see RowJob), else the kernel map */
+		IOBufferMemoryDescriptor *bmd = OSDynamicCast(IOBufferMemoryDescriptor, s->memory);
+		uintptr_t src = bmd != NULL ? (uintptr_t)bmd->getBytesNoCopy() : s->kernelAddress();
+		uint32_t bpe = s->bytesPerElement ? s->bytesPerElement : 4;
+		if (w <= 0 || h <= 0) {
+			w = (int32_t)s->width;
+			h = (int32_t)s->height;
+		}
+		if (sx < 0 || sy < 0) {
+			sx = sy = 0;
+		}
+		if (dx < 0 || dy < 0) {
+			dx = dy = 0;
+		}
+		/*
+		 * Logical (presented) display coordinates -> panel coordinates: cropped, the centered part
+		 * (sweetfb_scale=0); scaled, the layer stays in logical coordinates (and is scaled below).
+		 */
+		int32_t areaW = (int32_t)(fScale ? fLogicalW : fWidth), areaH = (int32_t)(fScale ? fLogicalH : fHeight);
+		if (!fScale) {
+			dx -= fOffX;
+			dy -= fOffY;
+		}
+		if (dx < 0) {
+			sx -= dx;
+			w += dx;
+			dx = 0;
+		}
+		if (dy < 0) {
+			sy -= dy;
+			h += dy;
+			dy = 0;
+		}
+		if (w > (int32_t)s->width - sx) {
+			w = (int32_t)s->width - sx;
+		}
+		if (h > (int32_t)s->height - sy) {
+			h = (int32_t)s->height - sy;
+		}
+		if (w > areaW - dx) {
+			w = areaW - dx;
+		}
+		if (h > areaH - dy) {
+			h = areaH - dy;
+		}
+		uint64_t last = (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow +
+		    (uint64_t)(sx + w) * 4;
+		if (w <= 0 || h <= 0 || s->elementWidth != 1 || s->elementHeight != 1 ||
+		    s->memory == NULL || last > s->memory->getLength()) {
+			src = 0;
+		}
+		if (fScanout < 0) {
+			int v = 0;
+			fScanout = PE_parse_boot_argn("sweetfb_scanout", &v, sizeof(v)) && v != 0;
+		}
+		if (fScanout && src != 0 && bpe == 4 && (mask & 0xfu) == 1u && dx == 0 && dy == 0 &&
+		    w == areaW && h == areaH) {
+			uint64_t off = (uint64_t)s->offset + (uint64_t)sy * s->bytesPerRow + (uint64_t)sx * 4;
+			uint64_t need = (uint64_t)(h - 1) * s->bytesPerRow + (uint64_t)w * 4;
+			IOByteCount seg = 0;
+			addr64_t pa = s->memory->getPhysicalSegment(off, &seg, kIOMemoryMapperNone);
+			if (pa != 0 && seg >= need && pa + need <= 0x100000000ull && scanOut(s, pa, s->bytesPerRow, fScale)) {
+				if (sweet_tl_on) {
+					struct sweet_tl_swap *t = sweet_tl_find(get32(rec, 0x50));
+					if (t != NULL) {
+						t->flip = sweet_tl_us();
+					}
+				}
+				s->release();
+				continue;
+			}
+			{
+				static uint32_t told;
+				if (told++ < 6) {
+					IOLog("SWEET FB: not scanned out: surface %u pa %#llx, %llu of %llu bytes in one piece\n", s->id,
+					    (unsigned long long)pa, (unsigned long long)seg, (unsigned long long)need);
+				}
+			}
+		} else if (fScanout) {
+			static uint32_t told;
+			if (told++ < 6) {
+				IOLog("SWEET FB: not scanned out: mask %#x src %d bpe %u at %d,%d %dx%d (%s %dx%d)\n", mask, src != 0, bpe,
+				    dx, dy, w, h, fScale ? "presented" : "panel", areaW, areaH);
+			}
+		}
+		if (fScanning) {
+			scanBack();
+		}
+		if (src != 0 && bpe == 4 && !fScale) {
+			RowJob job;
+			job.src = src + s->offset + (uint64_t)sy * s->bytesPerRow + (uint64_t)sx * 4;
+			job.stride = s->bytesPerRow;
+			job.dst = fPixels + (uint64_t)dy * fRowBytes + (uint64_t)dx * 4;
+			job.rowBytes = fRowBytes;
+			job.bytes = (size_t)w * 4;
+			job.rows = h;
+			job.runs = NULL;
+			job.nruns = 0;
+			job.rowMap = NULL;
+			copyFrame(&job);
+		} else if (src != 0 && bpe == 4 && fRuns != NULL && fRowMap != NULL) {
+			/*
+			 * Scaled by the CPU (a frame the display engine does not fetch itself), nearest rather
+			 * than the scaler's bilinear but onto the same place: panel pixel X shows logical pixel
+			 * ((2X + 1) * 1125) / (2 * 1080), the one under its centre, so a layer covers the same
+			 * part of the panel either way and a touch lands where it is drawn. The panel pixels of
+			 * the layer are those whose logical pixel is in it.
+			 */
+			int32_t x0 = sweet_fb_panel_at(dx, fLogicalW, fWidth), x1 = sweet_fb_panel_at(dx + w, fLogicalW, fWidth);
+			int32_t y0 = sweet_fb_panel_at(dy, fLogicalH, fHeight), y1 = sweet_fb_panel_at(dy + h, fLogicalH, fHeight);
+			uint32_t runs = 0;
+			for (int32_t x = x0; x < x1; x++) {
+				uint32_t from = sweet_fb_logical_at(x, fLogicalW, fWidth) - (uint32_t)dx;
+				if (runs != 0 && fRuns[runs - 1].src + fRuns[runs - 1].n == from) {
+					fRuns[runs - 1].n++;
+				} else {
+					fRuns[runs].dst = (uint32_t)(x - x0);
+					fRuns[runs].src = from;
+					fRuns[runs].n = 1;
+					runs++;
+				}
+			}
+			for (int32_t y = y0; y < y1; y++) {
+				fRowMap[y - y0] = sweet_fb_logical_at(y, fLogicalH, fHeight) - (uint32_t)dy;
+			}
+			if (x1 > x0 && y1 > y0) {
+				RowJob job;
+				job.src = src + s->offset + (uint64_t)sy * s->bytesPerRow + (uint64_t)sx * 4;
+				job.stride = s->bytesPerRow;
+				job.dst = fPixels + (uint64_t)y0 * fRowBytes + (uint64_t)x0 * 4;
+				job.rowBytes = fRowBytes;
+				job.bytes = (size_t)(x1 - x0) * 4;
+				job.rows = y1 - y0;
+				job.runs = fRuns;
+				job.nruns = runs;
+				job.rowMap = fRowMap;
+				copyFrame(&job);
+			}
+		}
+		s->release();
+	}
+}
+
+extern "C" task_t sweet_window_server_task;      /* osfmk/kern/sched_prim.c */
+
+bool
+IOMobileFramebufferUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fTask = owningTask;
+	{
+		/* the window server: its threads get the big cores (osfmk/kern/sched_prim.c choose_processor) */
+		char name[32] = "";
+		proc_selfname(name, sizeof(name));
+		if (strcmp(name, "backboardd") == 0) {
+			sweet_window_server_task = owningTask;
+		}
+	}
+	return true;
+}
+
+bool
+IOMobileFramebufferUserClient::start(IOService *provider)
+{
+	fFB = OSDynamicCast(AppleCLCD, provider);
+	if (fFB == NULL || !IOUserClient::start(provider)) {
+		return false;
+	}
+	fFB->addClient(this);
+	return true;
+}
+
+IOReturn
+IOMobileFramebufferUserClient::clientClose(void)
+{
+	if (fFB != NULL) {
+		fFB->removeClient(this);
+		IOLockLock(fFB->fLock);
+		mach_port_t old = fPort;
+		fPort = MACH_PORT_NULL;
+		IOLockUnlock(fFB->fLock);
+		if (old != MACH_PORT_NULL) {
+			releaseNotificationPort(old);
+		}
+	}
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOMobileFramebufferUserClient::registerNotificationPort(mach_port_t port, __unused UInt32 type,
+    __unused io_user_reference_t refCon)
+{
+	mach_port_t old;
+	IOLockLock(fFB->fLock);
+	old = fPort;
+	fPort = port;
+	IOLockUnlock(fFB->fLock);
+	if (old != MACH_PORT_NULL) {
+		releaseNotificationPort(old);
+	}
+	return kIOReturnSuccess;
+}
+
+/* Called with the framebuffer lock held. */
+void
+IOMobileFramebufferUserClient::notify(uint32_t type, const uint64_t *values, uint32_t count)
+{
+	OSAsyncReference64 ref;
+
+	if (type >= SWEET_FB_NOTIFY_TYPES || fFunc[type] == 0 || fPort == MACH_PORT_NULL) {
+		return;
+	}
+	bzero(ref, sizeof(ref));
+	setAsyncReference64(ref, fPort, (mach_vm_address_t)fFunc[type], fRefcon[type], fTask);
+	sendAsyncResult64WithOptions(ref, kIOReturnSuccess, (io_user_reference_t *)values, count,
+	    kIOUserNotifyOptionCanDrop);
+}
+
+static uint64_t sweet_fb_logged;        /* selectors already logged (< 64) */
+
+IOReturn
+IOMobileFramebufferUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	IOReturn ret = kIOReturnSuccess;
+	uint64_t out[2] = { 0, 0 };
+	uint32_t outCount = 0;
+
+	switch (selector) {
+	case kSweetFBGetLayerDefaultSurface:
+		out[0] = sweet_surface_port_in_task(fFB->fSurface, fTask);
+		outCount = 1;
+		break;
+	case kSweetFBSwapBegin:
+		IOLockLock(fFB->fLock);
+		out[0] = ++fFB->fSwapID;
+		IOLockUnlock(fFB->fLock);
+		outCount = 1;
+		break;
+	case kSweetFBSwapEnd: {
+		uint8_t rec[SWEET_FB_SWAP_REC_SIZE];
+		if (args->structureInputDescriptor != NULL ||
+		    args->structureInputSize < SWEET_FB_SWAP_REC_SIZE) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		memcpy(rec, args->structureInput, sizeof(rec));
+		fFB->swap(rec);
+		break;
+	}
+	case kSweetFBSwapWait: {
+		static uint32_t told;
+		if (told < 6) {
+			told++;
+			IOLog("SWEET FB: SwapWait in %u: %#llx %#llx %#llx\n", args->scalarInputCount,
+			    args->scalarInputCount > 0 ? args->scalarInput[0] : 0, args->scalarInputCount > 1 ? args->scalarInput[1] : 0,
+			    args->scalarInputCount > 2 ? args->scalarInput[2] : 0);
+		}
+		/*
+		 * Answered at once (boot-arg sweetfb_swapwait=1: until the swap is on the panel): waiting,
+		 * however short, put CoreAnimation in step with the panel's latches instead of the vsync
+		 * it is told of, 18.6 ms a frame; answered at once it draws every 16.7 (60 a second).
+		 */
+		static int wait = -1;
+		if (wait < 0) {
+			int v = 0;
+			(void)PE_parse_boot_argn("sweetfb_swapwait", &v, sizeof(v));
+			wait = v != 0;
+		}
+		if (wait && args->scalarInputCount >= 1) {
+			fFB->swapShown((uint32_t)args->scalarInput[0], 50);
+		}
+		break;
+	}
+	case kSweetFBSupportedFrameInfo:        /* in: type; out: how many, and their tags: none */
+		out[0] = 0;
+		outCount = 1;
+		break;
+	case kSweetFBGetCurrentAbsoluteTime:
+		out[0] = mach_absolute_time();
+		outCount = 1;
+		break;
+	case kSweetFBGetBlock:                  /* in: which block; out: its bytes (0x40: the current mode) */
+		if (args->structureOutputDescriptor == NULL && args->structureOutput != NULL) {
+			bzero(args->structureOutput, args->structureOutputSize);
+			if (args->scalarInputCount >= 1 && args->scalarInput[0] == 0x40 && args->structureOutputSize >= 12) {
+				uint32_t ids[2] = { SWEET_FB_COLOR_ID, SWEET_FB_TIMING_ID };
+				memcpy((uint8_t *)args->structureOutput + 4, ids, sizeof(ids));
+			}
+			return kIOReturnSuccess;    /* (not zeroed again below) */
+		}
+		break;
+	case kSweetFBGetID:
+		out[0] = 0;
+		outCount = 1;
+		break;
+	case kSweetFBGetDisplaySize:
+		out[0] = fFB->fLogicalW;
+		out[1] = fFB->fLogicalH;
+		outCount = 2;
+		break;
+	case kSweetFBIsMainDisplay:
+		out[0] = 1;
+		outCount = 1;
+		break;
+	case kSweetFBGetDotPitch:
+		out[0] = SWEET_FB_DOT_PITCH;
+		outCount = 1;
+		break;
+	case kSweetFBNotifications:
+		if (args->scalarInputCount >= 3 && args->scalarInput[2] < SWEET_FB_NOTIFY_TYPES) {
+			uint32_t type = (uint32_t)args->scalarInput[2];
+			IOLockLock(fFB->fLock);
+			fFunc[type] = args->scalarInput[0];
+			fRefcon[type] = args->scalarInput[1];
+			IOLockUnlock(fFB->fLock);
+			char name[32];
+			proc_selfname(name, sizeof(name));
+			IOLog("SWEET FB: %s notifications type %u %s\n", name, type,
+			    args->scalarInput[0] ? "on" : "off");
+		}
+		break;
+	case kSweetFBRequestPowerChange:
+		if (args->scalarInputCount >= 1) {
+			uint32_t dpu = 0;
+			bool off = args->scalarInput[0] == 0;
+			IOLockLock(fFB->fLock);
+			if (off != fFB->fPowerOff) {
+				fFB->fPowerOff = off;
+				fFB->fFadeStep = 0;
+				fFB->fDirty = true;     /* on: redraw the latest frame */
+			}
+			IOLockUnlock(fFB->fLock);
+			/* the panel dark while iOS has the display off (it still shows the last frame, and iOS
+			 * takes no touches then: it looked frozen), its brightness back when on */
+			IOLog("SWEET FB: display %s (panel %d)\n", off ? "off" : "on", sweet_panel_power(off ? 0 : 1));
+			if (!off) {
+				sweet_prof_start();       /* (once) the profiler's thread, asked by /tmp/prof_go */
+			}
+			if (!off && PE_parse_boot_argn("sweetdpu", &dpu, sizeof(dpu)) && dpu) {
+				sweet_dpu_survey();       /* once: the display engine as the boot loader left it */
+			}
+		}
+		break;
+	default:
+		break;
+	}
+
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = i < outCount ? out[i] : 0;
+	}
+	if (args->structureOutputDescriptor == NULL && args->structureOutput != NULL) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+	if (selector >= 64 || !(sweet_fb_logged & (1ULL << selector))) {
+		if (selector < 64) {
+			sweet_fb_logged |= 1ULL << selector;
+		}
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET FB: %s sel %u in %u/%u out %u/%u -> 0x%x\n", name, selector,
+		    args->scalarInputCount, args->structureInputSize,
+		    args->scalarOutputCount, args->structureOutputSize, ret);
+	}
+	return ret;
+}
+#endif /* SWEET */
diff --git a/iokit/Kernel/arm/SweetKeyStore.cpp b/iokit/Kernel/arm/SweetKeyStore.cpp
new file mode 100644
index 0000000..3e930fa
--- /dev/null
+++ b/iokit/Kernel/arm/SweetKeyStore.cpp
@@ -0,0 +1,291 @@
+/*
+ * Built-in AppleKeyStore for SWEET: a device without a passcode whose
+ * system keybag is always loaded and unlocked.
+ *
+ * Apple's AppleKeyStore kext (closed, SEP-backed) owns the keybags behind
+ * data protection. libaks (AppleKeyStore.framework, statically in keybagd)
+ * opens IOServiceMatching("AppleKeyStore") with type 0, calls selector 0,
+ * then one selector per aks_* function (iOS 16.7 numbering below). keybagd
+ * --init asks for the system bag (14) and only loads systembag.kb when the
+ * answer is kIOReturnNotFound; answering with a handle is the path a
+ * userspace reboot takes, so no bag file is needed.
+ *
+ * Every call is logged (selector, caller, argument shapes, result) so the
+ * next selectors the system needs show up on the console; unknown ones fail
+ * with kIOReturnUnsupported.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <libkern/c++/OSString.h>
+#include <sys/proc.h>
+
+/* libaks selectors (AppleKeyStore.framework, iOS 16.7). */
+enum {
+	kAKSOpen             = 0,
+	kAKSCreateBag        = 2,
+	kAKSSaveBag          = 3,
+	kAKSUnloadBag        = 4,
+	kAKSSetSystem        = 5,
+	kAKSLoadBag          = 6,
+	kAKSGetLockState     = 7,
+	kAKSUnlockDevice     = 9,
+	kAKSWrapKey          = 10,
+	kAKSUnwrapKey        = 11,
+	kAKSUnlockBag        = 12,
+	kAKSLockBag          = 13,
+	kAKSGetSystem        = 14,
+	kAKSGetDeviceState   = 17,
+	kAKSGetExtDeviceState = 35,     /* aks_get_extended_device_state */
+	kAKSAssertHold       = 26,
+	kAKSAssertDrop       = 27,
+	kAKSUnloadSessionBags = 55,
+	kAKSNotifyStateSet   = 102,
+	kAKSNotifyStateIsSet = 103,
+	kAKSAssertConsume    = 101,     /* aks_assert_consume */
+};
+
+/* The system (device) bag handle. */
+#define SWEET_AKS_SYSTEM_HANDLE 0
+
+/*
+ * aks lock state bits (aks_get_lock_state): bit 2 is "unlocked since boot"
+ * (MobileKeyBag MKBDeviceUnlockedSinceBoot); clear lock bits = unlocked.
+ */
+#define SWEET_AKS_LOCK_STATE    0x4
+
+class AppleKeyStore : public IOService {
+	OSDeclareDefaultStructors(AppleKeyStore);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleKeyStore, IOService);
+
+bool
+AppleKeyStore::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "AppleKeyStoreUserClient");
+	registerService();
+	IOLog("SWEET AKS: AppleKeyStore registered (no passcode, unlocked)\n");
+	return true;
+}
+
+class AppleKeyStoreUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(AppleKeyStoreUserClient);
+
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleKeyStoreUserClient, IOUserClient);
+
+IOReturn
+AppleKeyStoreUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+/* Copy len bytes to the caller's output structure (inband or descriptor). */
+static IOReturn
+sweet_aks_struct_out(IOExternalMethodArguments *args, const void *buf, uint32_t len)
+{
+	if (args->structureOutputDescriptor != NULL) {
+		if (len > args->structureOutputDescriptor->getLength()) {
+			return kIOReturnNoSpace;
+		}
+		args->structureOutputDescriptor->writeBytes(0, buf, len);
+		args->structureOutputDescriptorSize = len;
+		return kIOReturnSuccess;
+	}
+	if (args->structureOutput == NULL || len > args->structureOutputSize) {
+		return kIOReturnNoSpace;
+	}
+	memcpy(args->structureOutput, buf, len);
+	args->structureOutputSize = len;
+	return kIOReturnSuccess;
+}
+
+/* Append SEQUENCE { UTF8String key, INTEGER value } (short forms only). */
+static uint32_t
+sweet_aks_der_pair(uint8_t *p, const char *key, uint8_t value)
+{
+	uint32_t klen = (uint32_t)strlen(key);
+	uint32_t n = 0;
+	p[n++] = 0x30;
+	p[n++] = (uint8_t)(2 + klen + 3);
+	p[n++] = 0x0c;
+	p[n++] = (uint8_t)klen;
+	memcpy(p + n, key, klen);
+	n += klen;
+	p[n++] = 0x02;
+	p[n++] = 0x01;
+	p[n++] = value;
+	return n;
+}
+
+/*
+ * Device state (selector 17): a DER SET of key/INTEGER pairs that libaks
+ * decode_extended_state reads: ss state, sls lock state (MKBGetDeviceLockState:
+ * 0 = unlocked), sb backoff, sfa failed attempts, sgs generation, sas
+ * assertions, sgpe grace period, srcd recovery countdown.
+ */
+static IOReturn
+sweet_aks_device_state(IOExternalMethodArguments *args)
+{
+	static const struct {
+		const char *key;
+		uint8_t value;
+	} fields[] = {
+		{ "ss", SWEET_AKS_LOCK_STATE }, { "sls", 0 }, { "sb", 0 }, { "sfa", 0 },
+		{ "sgs", 0 }, { "sas", 0 }, { "sgpe", 0 }, { "srcd", 0 },
+	};
+	uint8_t buf[128];
+	uint32_t n = 2;
+	for (unsigned int i = 0; i < sizeof(fields) / sizeof(fields[0]); i++) {
+		n += sweet_aks_der_pair(buf + n, fields[i].key, fields[i].value);
+	}
+	buf[0] = 0x31;
+	buf[1] = (uint8_t)(n - 2);
+	return sweet_aks_struct_out(args, buf, n);
+}
+
+static uint32_t
+sweet_aks_struct_out_size(IOExternalMethodArguments *args)
+{
+	return args->structureOutputDescriptor != NULL ?
+	       (uint32_t)args->structureOutputDescriptor->getLength() : args->structureOutputSize;
+}
+
+/* Copy the caller's input structure (inband or descriptor) into buf; returns the length. */
+static uint32_t
+sweet_aks_struct_in(IOExternalMethodArguments *args, void *buf, uint32_t cap)
+{
+	uint32_t len = args->structureInputDescriptor != NULL ?
+	    (uint32_t)args->structureInputDescriptor->getLength() : args->structureInputSize;
+	if (len > cap) {
+		len = cap;
+	}
+	if (args->structureInputDescriptor != NULL) {
+		args->structureInputDescriptor->readBytes(0, buf, len);
+	} else if (args->structureInput != NULL) {
+		memcpy(buf, args->structureInput, len);
+	} else {
+		len = 0;
+	}
+	return len;
+}
+
+IOReturn
+AppleKeyStoreUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	IOReturn ret = kIOReturnSuccess;
+	uint32_t in_scalars = args->scalarInputCount;
+	uint32_t in_struct = args->structureInputDescriptor != NULL ?
+	    (uint32_t)args->structureInputDescriptor->getLength() : args->structureInputSize;
+	uint32_t out_scalars = args->scalarOutputCount;
+	uint32_t out_struct = sweet_aks_struct_out_size(args);
+	uint64_t arg0 = in_scalars > 0 ? args->scalarInput[0] : 0;
+
+	switch (selector) {
+	case kAKSOpen:
+	case kAKSUnloadBag:
+	case kAKSSetSystem:
+	case kAKSUnlockDevice:
+	case kAKSUnlockBag:
+	case kAKSLockBag:
+	case kAKSAssertHold:
+	case kAKSAssertDrop:
+	case kAKSAssertConsume:
+	case kAKSUnloadSessionBags:
+	case kAKSNotifyStateSet:
+		args->scalarOutputCount = 0;
+		break;
+	case kAKSGetSystem:
+		if (out_scalars < 1) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		args->scalarOutput[0] = SWEET_AKS_SYSTEM_HANDLE;
+		args->scalarOutputCount = 1;
+		break;
+	case kAKSGetLockState:
+		if (out_scalars < 1) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		args->scalarOutput[0] = SWEET_AKS_LOCK_STATE;
+		args->scalarOutputCount = 1;
+		break;
+	case kAKSNotifyStateIsSet:
+		/* Nothing was ever set: answer "not set". */
+		if (out_scalars < 1) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		args->scalarOutput[0] = 0;
+		args->scalarOutputCount = 1;
+		break;
+	case kAKSGetDeviceState:
+	case kAKSGetExtDeviceState:
+		args->scalarOutputCount = 0;
+		ret = sweet_aks_device_state(args);
+		break;
+	case kAKSWrapKey: {
+		/*
+		 * securityd wraps each keychain item key here; returning unsupported (the old default) means
+		 * no item can be stored, so the keychain stays empty and e.g. the Wi-Fi PSK never persists.
+		 * With no secure element, wrap reversibly: the key bytes plus an 8-byte tag. Opaque -- it
+		 * round-trips back out through kAKSUnwrapKey.
+		 */
+		uint8_t key[256];
+		uint32_t klen = sweet_aks_struct_in(args, key, sizeof(key) - 8);
+		memcpy(key + klen, "SWEETKW\0", 8);
+		ret = sweet_aks_struct_out(args, key, klen + 8);
+		if (ret == kIOReturnSuccess && out_scalars >= 1) {
+			args->scalarOutput[0] = klen + 8;
+			args->scalarOutputCount = 1;
+		}
+		break;
+	}
+	case kAKSUnwrapKey: {
+		uint8_t key[256];
+		uint32_t wlen = sweet_aks_struct_in(args, key, sizeof(key));
+		if (wlen < 8) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		ret = sweet_aks_struct_out(args, key, wlen - 8);
+		if (ret == kIOReturnSuccess && out_scalars >= 1) {
+			args->scalarOutput[0] = wlen - 8;
+			args->scalarOutputCount = 1;
+		}
+		break;
+	}
+	default:
+		ret = kIOReturnUnsupported;
+		break;
+	}
+
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	IOLog("SWEET AKS: %s sel %u arg0 %llu in %u/%u out %u/%u -> 0x%x\n", name, selector,
+	    arg0, in_scalars, in_struct, out_scalars, out_struct, ret);
+	return ret;
+}
+#endif /* SWEET */
diff --git a/iokit/Kernel/arm/SweetPlatformExpert.cpp b/iokit/Kernel/arm/SweetPlatformExpert.cpp
new file mode 100644
index 0000000..0631685
--- /dev/null
+++ b/iokit/Kernel/arm/SweetPlatformExpert.cpp
@@ -0,0 +1,82 @@
+/*
+ * Minimal device-tree platform expert for Redmi Note 10 Pro (sweet).
+ * Uses XNU's normal platform, power-domain and nub initialization. Hardware
+ * interrupt and power-management services are supplied by separate drivers.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <IOKit/IOLib.h>
+
+class SweetPlatformExpert : public IODTPlatformExpert {
+	OSDeclareDefaultStructors(SweetPlatformExpert);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void processTopLevel(IORegistryEntry *root) APPLE_KEXT_OVERRIDE;
+	const char *deleteList(void) APPLE_KEXT_OVERRIDE;
+	const char *excludeList(void) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetPlatformExpert, IODTPlatformExpert);
+
+bool
+SweetPlatformExpert::start(IOService *provider)
+{
+	IOLog("SWEET: starting device-tree platform expert\n");
+	if (!IODTPlatformExpert::start(provider)) {
+		return false;
+	}
+	registerService();
+	IOLog("SWEET: platform expert registered\n");
+	return true;
+}
+
+const char *
+SweetPlatformExpert::deleteList(void)
+{
+	return "()";
+}
+
+const char *
+SweetPlatformExpert::excludeList(void)
+{
+	return "('chosen', 'defaults', 'cpus', 'options')";
+}
+
+void
+SweetPlatformExpert::processTopLevel(IORegistryEntry *root)
+{
+	/*
+	 * The stock implementation requires an Apple NVRAM /options node.
+	 * SWEET has no NVRAM controller; publish real CPU/device nodes without
+	 * inventing one. createNubs adds the topology's logical CPU/cluster IDs.
+	 */
+	IORegistryEntry *cpus = root->childFromPath("cpus", gIODTPlane);
+	if (cpus != NULL) {
+		createNubs(this, IODTFindMatchingEntries(cpus, kIODTExclusive, NULL));
+		cpus->release();
+	}
+	createNubs(this, IODTFindMatchingEntries(root, kIODTExclusive, excludeList()));
+
+	/*
+	 * No AppleARMIO driver publishes the /arm-io children: do it here so
+	 * built-in drivers (the display, AppleCLCD) can match them. The GIC is
+	 * driven by the platform code and gets no nub. The nubs hang off this
+	 * platform expert: IOPlatformDevice::compareName asks its provider.
+	 */
+	IORegistryEntry *armio = root->childFromPath("arm-io", gIODTPlane);
+	if (armio != NULL) {
+		createNubs(this, IODTFindMatchingEntries(armio, kIODTExclusive, "('gic')"));
+		armio->release();
+	}
+}
+
+/*
+ * hw.target / hw.product come from IODTPlatformExpert: the first root
+ * "compatible" string and "model" (D22AP / iPhone10,3 in the ADT), which
+ * is what the iPhone userland (MobileGestalt) expects.
+ */
+#endif /* SWEET */
diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
new file mode 100644
index 0000000..bed0efd
--- /dev/null
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -0,0 +1,1601 @@
+/*
+ * Built-in IOSurface for SWEET.
+ *
+ * Apple's IOSurface kext is closed. IOSurface.framework (iOS 16.7) finds
+ * IOServiceNameMatching("IOCoreSurfaceRoot"), opens it with type 0 and
+ * talks to the user client below:
+ *
+ *   sel 13  limits: struct out 0x18, u16 at +0x16 must be 1 (ABI version),
+ *           +0 offset alignment mask, +4 bytes-per-row alignment mask
+ *   sel 0   create: scalar [parent id], struct in = serialized property
+ *           dictionary (binary or XML), struct out = lock result (0xa68)
+ *   sel 4   lookup by id: scalar [id], struct out = lock result
+ *   sel 34  lookup by mach port: scalar [port name], struct out = lock result
+ *   sel 35  create mach port: scalars [id, options], scalar out [port name]
+ *   traps   0/1 use count +/- (id, category), 2 lock / 3 unlock
+ *           (id, options, &seed), 4/5 release (id)
+ *
+ * Use counts: the library counts uses per process and calls trap 0 when its
+ * count for a category goes 0 -> 1, trap 1 when it goes back to 0;
+ * IOSurfaceIsInUse reads the system-wide counts (u32 per category at +0x18
+ * of the state page), which surface pools (CMPhoto's, CoreVideo's) go by
+ * before they hand a surface out again.
+ *
+ * The lock result tells the library where the surface lives in the
+ * caller's address space: +0 pixels, +8 shared state page (registry id,
+ * seed at +0xc), +0x10 timestamps, then id, sizes and geometry (layout in
+ * sweet_surface_fill_result). Every surface is wired kernel memory mapped
+ * into each task that creates or looks it up; mappings are counted per
+ * client and dropped on release or close.
+ *
+ * Values, notifications, accelerators and shared events are accepted and
+ * ignored (logged once per selector).
+ */
+#include "SweetSurface.h"
+extern "C" boolean_t pmap_is_modified(ppnum_t pn);
+extern "C" void pmap_clear_modify(ppnum_t pn);
+extern "C" void pmap_clear_refmod_options(ppnum_t pn, unsigned int mask, unsigned int options, void *arg);
+#define SWEET_VM_MEM_MODIFIED   0x01            /* osfmk/vm/pmap.h VM_MEM_MODIFIED */
+#define SWEET_PMAP_FF_WIRED     0x10000         /* osfmk/vm/pmap.h PMAP_OPTIONS_FF_WIRED */
+extern "C" boolean_t pmap_valid_page(ppnum_t pn);
+extern "C" vm_offset_t ml_static_ptovirt(vm_offset_t);
+extern "C" void sweet_gpu_reap_dead_now(void);       /* bsd/dev/sweet_gpu.c */
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/system.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSUnserialize.h>
+#include <sys/proc.h>
+
+enum {
+	kSweetSurfaceCreate             = 0,
+	kSweetSurfaceLookup             = 4,
+	kSweetSurfaceLimits             = 13,
+	kSweetSurfaceLookupFromPort     = 34,
+	kSweetSurfaceCreatePort         = 35,
+};
+
+enum {
+	kSweetSurfaceTrapIncrementUse   = 0,
+	kSweetSurfaceTrapDecrementUse   = 1,
+	kSweetSurfaceTrapLock           = 2,
+	kSweetSurfaceTrapUnlock         = 3,
+	kSweetSurfaceTrapDetach         = 4,
+	kSweetSurfaceTrapRelease        = 5,
+};
+
+#define SWEET_SURFACE_RESULT_SIZE       0xa68
+#define SWEET_SURFACE_MAX_ID            4096
+#define SWEET_SURFACE_MAX_DIM           16384
+#define SWEET_SURFACE_MAX_ALLOC         (256u << 20)
+#define SWEET_SURFACE_MAX_PROPS         (64u << 10)
+#define SWEET_SURFACE_ROW_ALIGN         64
+#define SWEET_SURFACE_TIMESTAMPS        0x800   /* offset in the state page */
+#define SWEET_SURFACE_STATE_SEED        0xc     /* u32 in the state page */
+#define SWEET_SURFACE_STATE_USES        0x18    /* u32 per use count category (2) in the state page */
+#define kIOSurfaceLockReadOnly          0x1
+
+static IOLock       *sweet_surface_lock;
+static SweetSurface *sweet_surface_table[SWEET_SURFACE_MAX_ID];
+static uint32_t      sweet_surface_users[SWEET_SURFACE_MAX_ID];
+static uint32_t      sweet_surface_next_id = 1;
+static uint32_t      sweet_surface_creates_logged;
+static uint64_t      sweet_surface_wired;       /* bytes of buffer surfaces */
+#define SWEET_SURFACE_WIRED_MAX         (1536ull << 20)
+
+OSDefineMetaClassAndStructors(SweetSurface, OSObject);
+
+/*
+ * The display pool (boot-arg sweetfb_scanout=1): CoreAnimation's full-screen surfaces have to be one
+ * physical piece for the display engine to fetch them (SweetFramebuffer scanOut), and 11 MB in one
+ * piece is not to be had once the system has run a while -- so three are made at the start, while
+ * memory is whole, and a full-screen surface takes a free one (it goes back when the surface goes).
+ */
+#define SWEET_DISPLAY_POOL      4       /* two shown (SweetFramebuffer holds them) and two being drawn */
+#define SWEET_DISPLAY_W         1125u
+#define SWEET_DISPLAY_H         2436u
+#define SWEET_DISPLAY_BPR       4608u
+static IOBufferMemoryDescriptor *sweet_display_pool[SWEET_DISPLAY_POOL];
+bool sweet_display_busy[SWEET_DISPLAY_POOL];
+
+void
+sweet_surface_display_pool_init(void)
+{
+	vm_size_t size = round_page((vm_size_t)SWEET_DISPLAY_BPR * SWEET_DISPLAY_H);
+	for (unsigned i = 0; i < SWEET_DISPLAY_POOL; i++) {
+		IOByteCount seg = 0;
+		if (sweet_display_pool[i] != NULL) {
+			continue;
+		}
+		sweet_display_pool[i] = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+		    kIODirectionInOut | kIOMemoryPhysicallyContiguous, size, 0x00000000FFFFF000ull);
+		addr64_t pa = sweet_display_pool[i] ? sweet_display_pool[i]->getPhysicalSegment(0, &seg, kIOMemoryMapperNone) : 0;
+		IOLog("SWEET SURF: display buffer %u: %s at %#llx, %llu of %lu bytes in one piece\n", i,
+		    sweet_display_pool[i] ? "made" : "NOT MADE", (unsigned long long)pa, (unsigned long long)seg, (unsigned long)size);
+	}
+}
+
+static IOBufferMemoryDescriptor *
+sweet_display_take(uint32_t size, uint32_t *slot)
+{
+	for (unsigned i = 0; i < SWEET_DISPLAY_POOL; i++) {
+		if (sweet_display_pool[i] != NULL && !sweet_display_busy[i] && sweet_display_pool[i]->getLength() >= size) {
+			sweet_display_busy[i] = true;
+			sweet_display_pool[i]->retain();
+			*slot = i + 1;
+			return sweet_display_pool[i];
+		}
+	}
+	return NULL;
+}
+
+void
+SweetSurface::free()
+{
+	if (OSDynamicCast(IOBufferMemoryDescriptor, memory) != NULL) {
+		OSAddAtomic64(-(SInt64)allocSize, (volatile SInt64 *)&sweet_surface_wired);
+	}
+	if (wrapped && memory != NULL) {
+		memory->complete();   /* balance the prepare() from the IOSurfaceAddress wrap */
+	}
+	if (poolSlot != 0) {
+		extern bool sweet_display_busy[];
+		sweet_display_busy[poolSlot - 1] = false;   /* the pool keeps its own reference */
+	}
+	if (pages != NULL) {
+		IOFree(pages, pageCount * sizeof(pages[0]));
+	}
+	OSSafeReleaseNULL(kernelMap);
+	OSSafeReleaseNULL(memory);
+	OSSafeReleaseNULL(state);
+	OSObject::free();
+}
+
+uintptr_t
+SweetSurface::kernelAddress()
+{
+	IOBufferMemoryDescriptor *buffer = OSDynamicCast(IOBufferMemoryDescriptor, memory);
+	if (buffer != NULL) {
+		return (uintptr_t)buffer->getBytesNoCopy();
+	}
+	IOLockLock(sweet_surface_lock);
+	if (kernelMap == NULL && memory != NULL && !kernelMapFailed) {
+		kernelMap = memory->map(kIOMapWriteCombineCache);
+		kernelMapFailed = kernelMap == NULL;   /* (memory an application lent for reading only) */
+	}
+	IOLockUnlock(sweet_surface_lock);
+	return kernelMap != NULL ? (uintptr_t)kernelMap->getVirtualAddress() : 0;
+}
+
+static uint32_t *
+sweet_surface_seed(SweetSurface *s)
+{
+	return (uint32_t *)((uint8_t *)s->state->getBytesNoCopy() + SWEET_SURFACE_STATE_SEED);
+}
+
+/*
+ * Give the surface an id and a table slot; the table holds one retain and a
+ * user count (creators, client mappings, kernel holders). Lock held.
+ */
+static bool
+sweet_surface_insert_locked(SweetSurface *s)
+{
+	for (uint32_t n = 0; n < SWEET_SURFACE_MAX_ID - 1; n++) {
+		uint32_t id = sweet_surface_next_id;
+		sweet_surface_next_id = id + 1 < SWEET_SURFACE_MAX_ID ? id + 1 : 1;
+		if (sweet_surface_table[id] == NULL) {
+			s->id = id;
+			s->retain();
+			sweet_surface_table[id] = s;
+			sweet_surface_users[id] = 1;
+			*(uint64_t *)s->state->getBytesNoCopy() = id;   /* registry id */
+			return true;
+		}
+	}
+	return false;
+}
+
+/* Add a user to a surface that may have left the table (port lookups). */
+static bool
+sweet_surface_get(SweetSurface *s)
+{
+	bool ok = true;
+	IOLockLock(sweet_surface_lock);
+	if (sweet_surface_table[s->id] == s) {
+		sweet_surface_users[s->id]++;
+	} else if (sweet_surface_table[s->id] == NULL) {
+		s->retain();
+		sweet_surface_table[s->id] = s;
+		sweet_surface_users[s->id] = 1;
+	} else {
+		ok = false;
+	}
+	IOLockUnlock(sweet_surface_lock);
+	return ok;
+}
+
+/* Drop a user; the last one removes the surface from the table. */
+static void
+sweet_surface_put(SweetSurface *s)
+{
+	bool drop = false;
+	IOLockLock(sweet_surface_lock);
+	if (sweet_surface_table[s->id] == s && --sweet_surface_users[s->id] == 0) {
+		sweet_surface_table[s->id] = NULL;
+		drop = true;
+	}
+	IOLockUnlock(sweet_surface_lock);
+	if (drop) {
+		s->release();
+	}
+}
+
+SweetSurface *
+sweet_surface_copy(uint32_t id)
+{
+	SweetSurface *s = NULL;
+	if (id == 0 || id >= SWEET_SURFACE_MAX_ID || sweet_surface_lock == NULL) {
+		return NULL;
+	}
+	IOLockLock(sweet_surface_lock);
+	s = sweet_surface_table[id];
+	if (s != NULL) {
+		s->retain();
+	}
+	IOLockUnlock(sweet_surface_lock);
+	return s;
+}
+
+/* Export an imported surface's wired physical pages for GPU (freedreno) mapping;
+ * fills pa[] with 4K page phys + geometry. The backing is wired (IOBuffer) or
+ * physical/held (wrap), so the phys pages are stable for the GPU's use. Returns 0
+ * on success. Called from the GPU driver's MSM_INFO_IOS_IMPORT handler to enable
+ * zero-copy GPU sampling of CoreAnimation surfaces instead of per-frame
+ * glTexImage2D copies (which leaked a fresh ~12 MB BO per frame -> OOM). */
+extern "C" int
+sweet_surface_gpu_pages(uint32_t id, uint64_t *pa, unsigned maxpages, unsigned *npages,
+    uint32_t *allocSize, uint32_t *width, uint32_t *height, uint32_t *bytesPerRow,
+    uint32_t *pixelFormat)
+{
+	SweetSurface *s = sweet_surface_copy(id);
+	unsigned n = 0;
+	IOByteCount off;
+	if (s == NULL) { return -1; }
+	if (s->memory == NULL) { s->release(); return -1; }
+	/* Memory of a program's own with a surface made around it is not in whole pages, and seldom
+	 * in rows the GPU takes (HackiOS surfaceBuffer refuses it): the GL bridge copies it instead. */
+	if (s->wrapped) { s->release(); return -1; }
+	/* One entry per 4K GPU page (the GPU maps 4K pages; a 16K kernel page is four of them). */
+	for (off = 0; off < s->allocSize; off += 4096) {
+		IOByteCount seglen = 0;
+		addr64_t phys = s->memory->getPhysicalSegment(off, &seglen, kIOMemoryMapperNone);
+		if (phys == 0 || n >= maxpages) { s->release(); return -1; }
+		pa[n++] = (uint64_t)(phys & ~((addr64_t)4095));
+	}
+	*npages = n;
+	*allocSize = s->allocSize;
+	*width = s->width; *height = s->height;
+	*bytesPerRow = s->bytesPerRow; *pixelFormat = s->pixelFormat;
+	s->release();
+	return 0;
+}
+
+/*
+ * The GPU's hold on a surface (HackiOS RedwoodGPU surfaceBuffer: "the surface is held for as
+ * long as the buffer is there"), its seed (bumped by whoever writes it and unlocks it), and
+ * its pixels pushed out of this processor's cache: the GPU maps surfaces uncached, and what a
+ * CPU writer left in the cache would otherwise be read stale -- and evict later over what the
+ * GPU drew. Cache maintenance by VA acts on the physical lines whatever the VA's attributes,
+ * so the buffer's own (cached) kernel address is used when there is one, else the kernel map.
+ */
+extern "C" void *
+sweet_surface_gpu_ref(uint32_t id)
+{
+	return sweet_surface_copy(id);
+}
+
+extern "C" void
+sweet_surface_gpu_unref(void *surface)
+{
+	if (surface != NULL) {
+		((SweetSurface *)surface)->release();
+	}
+}
+
+extern "C" uint32_t
+sweet_surface_gpu_seed(void *surface)
+{
+	return *sweet_surface_seed((SweetSurface *)surface);
+}
+
+extern "C" void
+sweet_surface_gpu_flush(void *surface)
+{
+	SweetSurface *s = (SweetSurface *)surface;
+	IOBufferMemoryDescriptor *bmd;
+	uintptr_t va, line, end;
+	if (s == NULL || s->memory == NULL) {
+		return;
+	}
+	bmd = OSDynamicCast(IOBufferMemoryDescriptor, s->memory);
+	va = bmd != NULL ? (uintptr_t)bmd->getBytesNoCopy() : s->kernelAddress();
+	if (va == 0) {
+		return;
+	}
+	end = va + s->memory->getLength();
+	for (line = va & ~(uintptr_t)63; line < end; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
+ * Only what a processor wrote, pushed out of the cache: XNU sets a page's "modified" bit at the
+ * first write after the bit was cleared (the clear makes every mapping of it read-only again),
+ * so the pages with it set are the ones whose lines may be in the cache. Each is cleared, then
+ * pushed out (a write between the two faults and sets the bit again). Pushing out the whole of
+ * every surface a submission named was 500 MB a second of cache maintenance in the window
+ * server; it draws almost everything with the GPU. Returns the bytes pushed out, or -1 when the
+ * memory is not pages the VM keeps bits for (the panel's): then the caller pushes out all of it.
+ */
+static struct sweet_surface_page *
+sweet_surface_pages(SweetSurface *s)
+{
+	struct sweet_surface_page *list = s->pages;
+	uint64_t length, off;
+	uint32_t count = 0, most;
+	if (list != NULL || s->memory == NULL) {
+		return list;
+	}
+	/* by physical page, not by PAGE_SIZE steps of the memory: what an application lends starts
+	 * where its allocation does, anywhere in a page, and then every step lies in two pages */
+	length = s->memory->getLength();
+	most = (uint32_t)(length / PAGE_SIZE) + 2u;
+	list = (struct sweet_surface_page *)IOMalloc(most * sizeof(list[0]));
+	if (list == NULL) {
+		return NULL;
+	}
+	for (off = 0; off < length && count < most; count++) {
+		IOByteCount seg = 0;
+		addr64_t pa = s->memory->getPhysicalSegment(off, &seg, kIOMemoryMapperNone);
+		uint64_t in_page = PAGE_SIZE - (pa & PAGE_MASK);
+		uint64_t len = in_page < length - off ? in_page : length - off;
+		list[count].pn = (ppnum_t)(pa >> PAGE_SHIFT);
+		if (pa == 0 || !pmap_valid_page(list[count].pn)) {
+			list[count].pn = 0;
+		}
+		list[count].off = (uint32_t)off;
+		list[count].len = (uint32_t)len;
+		list[count].poff = (uint32_t)(pa & PAGE_MASK);
+		off += len;
+	}
+	IOLockLock(sweet_surface_lock);
+	if (s->pages == NULL) {
+		s->pageCount = most;            /* (the allocation's size, for IOFree) */
+		s->pages = list;
+		if (count < most) {
+			list[count].len = 0;    /* end */
+		}
+		list = NULL;
+	}
+	IOLockUnlock(sweet_surface_lock);
+	if (list != NULL) {
+		IOFree(list, most * sizeof(list[0]));
+	}
+	return s->pages;
+}
+
+static int64_t
+sweet_surface_push_written(SweetSurface *s)
+{
+	struct sweet_surface_page *list = sweet_surface_pages(s);
+	int64_t pushed = 0;
+	uint32_t pages = 0;
+	if (list == NULL) {
+		return -1;
+	}
+	for (uint32_t i = 0; i < s->pageCount && list[i].len != 0; i++) {
+		if (list[i].pn == 0) {
+			static uint32_t told;
+			if (told++ < 8) {
+				IOLog("SWEET SURF: surface %u %ux%u: page %u is not the VM's: pushed out whole\n", s->id, s->width,
+				    s->height, i);
+			}
+			return -1;
+		}
+		if (!pmap_is_modified(list[i].pn)) {
+			continue;
+		}
+		/*
+		 * Wired mappings too (the applications' maps of their surfaces are wired): without
+		 * PMAP_OPTIONS_FF_WIRED the pmap leaves their write permission alone, the next write does
+		 * not fault, and "modified" was never cleared -- every surface was pushed out whole at
+		 * every submission, 160 MB in five seconds of the widget panel, in the flushes of the
+		 * window server's frames. Boot-arg sweetsurf_ffwired=0: as before.
+		 */
+		static int ff_wired = -1;
+		if (ff_wired < 0) {
+			int v = 1;
+			(void)PE_parse_boot_argn("sweetsurf_ffwired", &v, sizeof(v));
+			ff_wired = v != 0;
+		}
+		if (ff_wired) {
+			pmap_clear_refmod_options(list[i].pn, SWEET_VM_MEM_MODIFIED, SWEET_PMAP_FF_WIRED, NULL);
+		} else {
+			pmap_clear_modify(list[i].pn);
+		}
+		/* by the kernel's own (cached) view of all memory: no mapping to make, none of a different kind */
+		uintptr_t at = (uintptr_t)ml_static_ptovirt((vm_offset_t)ptoa(list[i].pn)) + list[i].poff;
+		for (uintptr_t line = at & ~(uintptr_t)63, end = at + list[i].len; line < end; line += 64) {
+			__asm__ volatile ("dc civac, %0" : : "r" (line) : "memory");
+		}
+		pushed += list[i].len;
+		pages++;
+	}
+	if (pushed != 0) {
+		static uint32_t looks;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		OSBitOrAtomic(1u, &s->cpuWritten);
+		if (looks++ % 400u < 3u) {
+			/* (which surfaces are written by a processor, how much of them: the first of every 400) */
+			IOLog("SWEET SURF: surface %u %ux%u (display buffer %u): %u pages written since the last look\n", s->id,
+			    s->width, s->height, s->poolSlot, pages);
+		}
+	}
+	return pushed;
+}
+
+extern "C" int64_t
+sweet_surface_gpu_push_written(void *surface)
+{
+	SweetSurface *s = (SweetSurface *)surface;
+	if (s != NULL && s->poolSlot != 0) {
+		/*
+		 * CoreAnimation's own framebuffers (the display pool): only the GPU draws into them, and
+		 * their pages never say otherwise -- an IOSurface's user mappings are wired, and the pmap
+		 * leaves a page with a wired mapping "modified" (arm_force_fast_fault skips wired PTEs, so
+		 * phys_attribute_clear keeps the bit). Pushing all of one out every frame was 11 MB of
+		 * cache maintenance a frame for nothing. Pushed out whole at first use only (the caller).
+		 */
+		return 0;
+	}
+	return s != NULL && s->memory != NULL ? sweet_surface_push_written(s) : -1;
+}
+
+/* The table lock; the framebuffer may publish a surface before the root starts. */
+static void
+sweet_surface_init_lock(void)
+{
+	if (sweet_surface_lock == NULL) {
+		IOLock *lock = IOLockAlloc();
+		if (!OSCompareAndSwapPtr(NULL, lock, &sweet_surface_lock)) {
+			IOLockFree(lock);
+		}
+	}
+}
+
+static SweetSurface *
+sweet_surface_alloc(void)
+{
+	sweet_surface_init_lock();
+	SweetSurface *s = OSTypeAlloc(SweetSurface);
+	if (s == NULL || !s->init()) {
+		OSSafeReleaseNULL(s);
+		return NULL;
+	}
+	s->state = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared, page_size, page_size);
+	if (s->state == NULL) {
+		s->release();
+		return NULL;
+	}
+	bzero(s->state->getBytesNoCopy(), page_size);
+	return s;
+}
+
+static bool
+sweet_surface_publish(SweetSurface *s)
+{
+	bool ok;
+	IOLockLock(sweet_surface_lock);
+	ok = sweet_surface_insert_locked(s);
+	IOLockUnlock(sweet_surface_lock);
+	return ok;
+}
+
+SweetSurface *
+sweet_surface_create_physical(uint64_t phys, uint32_t width, uint32_t height,
+    uint32_t bytesPerRow, uint32_t pixelFormat)
+{
+	SweetSurface *s = sweet_surface_alloc();
+	if (s == NULL) {
+		return NULL;
+	}
+	s->width = width;
+	s->height = height;
+	s->bytesPerRow = bytesPerRow;
+	s->bytesPerElement = 4;
+	s->elementWidth = s->elementHeight = 1;
+	s->pixelFormat = pixelFormat;
+	s->allocSize = (uint32_t)round_page(bytesPerRow * height);
+	s->memory = IOMemoryDescriptor::withPhysicalAddress(phys, s->allocSize, kIODirectionInOut);
+	s->mapCache = kIOMapWriteCombineCache;
+	if (s->memory == NULL || !sweet_surface_publish(s)) {
+		s->release();
+		return NULL;
+	}
+	return s;
+}
+
+/*
+ * A Mach send right for a surface (IOSurfaceCreateMachPort). It holds a table
+ * user-count on the surface for as long as the port exists, so a surface handed
+ * to another process cannot leave the id table -- a later lookup-by-id from that
+ * process then still finds it (this is what stopped cross-process glyph/icon
+ * surfaces resolving to id 0). Mirrors MiniIOSurface IOSurfaceSendRight (cpp:789)
+ * + makeSendRight surfaceHold (cpp:1340) + IOSurfaceSendRight::free (cpp:806).
+ */
+class SweetSurfaceSendRight : public OSObject {
+	OSDeclareDefaultStructors(SweetSurfaceSendRight);
+
+public:
+	SweetSurface *surface;
+
+	bool init() APPLE_KEXT_OVERRIDE { surface = NULL; return OSObject::init(); }
+	void free() APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetSurfaceSendRight, OSObject);
+
+void
+SweetSurfaceSendRight::free()
+{
+	if (surface != NULL) {
+		sweet_surface_put(surface);     /* drop the table user-count taken in sweet_surface_port_in_task */
+		surface = NULL;
+	}
+	OSObject::free();
+}
+
+mach_port_name_t
+sweet_surface_port_in_task(SweetSurface *s, task_t task)
+{
+	mach_port_name_t name = 0;
+	SweetSurfaceSendRight *right = OSTypeAlloc(SweetSurfaceSendRight);
+	if (right == NULL || !right->init()) {
+		OSSafeReleaseNULL(right);
+		return 0;
+	}
+	if (!sweet_surface_get(s)) {            /* re-insert into the table + bump users for the port's life */
+		right->release();
+		return 0;
+	}
+	right->surface = s;
+	IOUserClient::copyPortNameForObjectInTask(task, right, &name);
+	right->release();                       /* the port holds the only reference now */
+	return name;
+}
+
+static uint32_t
+sweet_dict_u32(OSDictionary *dict, const char *key, uint32_t def)
+{
+	OSNumber *n = OSDynamicCast(OSNumber, dict->getObject(key));
+	return n != NULL ? n->unsigned32BitValue() : def;
+}
+
+static uint32_t
+sweet_div_up(uint32_t a, uint32_t b)
+{
+	return b > 1 ? (a + b - 1) / b : a;
+}
+
+static uint32_t
+sweet_row_bytes(uint32_t width, uint32_t ew, uint32_t bpe)
+{
+	uint64_t row = (uint64_t)sweet_div_up(width, ew) * bpe;
+	return (uint32_t)((row + SWEET_SURFACE_ROW_ALIGN - 1) & ~(uint64_t)(SWEET_SURFACE_ROW_ALIGN - 1));
+}
+
+/* Bytes per element when the client did not say (mirrors MiniIOSurface defaultBytesPerElement cpp:365). */
+#define SWEET_FOURCC(a, b, c, d) ((uint32_t)(a) << 24 | (uint32_t)(b) << 16 | (uint32_t)(c) << 8 | (uint32_t)(d))
+static uint32_t
+sweet_default_bpe(uint32_t format)
+{
+	switch (format) {
+	case SWEET_FOURCC('L', '0', '0', '8'):
+	case SWEET_FOURCC('A', '0', '0', '8'):
+	case 0x00000008:
+		return 1;
+	case SWEET_FOURCC('L', '5', '6', '5'):
+	case SWEET_FOURCC('B', '5', '6', '5'):
+	case SWEET_FOURCC('L', '5', '5', '5'):
+	case SWEET_FOURCC('2', 'v', 'u', 'y'):
+	case SWEET_FOURCC('y', 'u', 'v', 's'):
+	case SWEET_FOURCC('y', 'u', 'v', 'f'):
+	case SWEET_FOURCC('L', '0', '1', '6'):
+	case SWEET_FOURCC('L', '0', '0', 'h'):
+		return 2;
+	case SWEET_FOURCC('R', 'G', 'h', 'A'):
+		return 8;
+	case SWEET_FOURCC('R', 'G', 'f', 'A'):
+		return 16;
+	default:
+		return 4;
+	}
+}
+
+/* Geometry from the creation properties (IOSurface.h keys). */
+static IOReturn
+sweet_surface_layout(SweetSurface *s, OSDictionary *props)
+{
+	uint64_t end;
+
+	s->width = sweet_dict_u32(props, "IOSurfaceWidth", 0);
+	s->height = sweet_dict_u32(props, "IOSurfaceHeight", 0);
+	s->pixelFormat = sweet_dict_u32(props, "IOSurfacePixelFormat", 0);
+	s->bytesPerElement = (uint16_t)sweet_dict_u32(props, "IOSurfaceBytesPerElement",
+	    sweet_default_bpe(s->pixelFormat));
+	s->elementWidth = (uint8_t)sweet_dict_u32(props, "IOSurfaceElementWidth", 1);
+	s->elementHeight = (uint8_t)sweet_dict_u32(props, "IOSurfaceElementHeight", 1);
+	/* iOS wide-gamut / 10-bit formats CoreAnimation draws as BGRA; our GL bridge renders only
+	 * single-plane BGRA, so substitute them (matches HackiOS MiniIOSurface) and drop plane info. */
+	bool sweet_fmt_subst = (s->pixelFormat == 'w30r' || s->pixelFormat == 'l10r' ||
+	    s->pixelFormat == 'w30R' || s->pixelFormat == 'b3a8');
+	if (sweet_fmt_subst) {
+		s->pixelFormat = 'BGRA';
+		s->bytesPerElement = 4;
+		s->elementWidth = s->elementHeight = 1;
+	}
+	s->cacheMode = sweet_dict_u32(props, "IOSurfaceCacheMode", 0);
+	s->offset = sweet_dict_u32(props, "IOSurfaceOffset", 0);
+	if (s->width > SWEET_SURFACE_MAX_DIM || s->height > SWEET_SURFACE_MAX_DIM ||
+	    s->bytesPerElement > 64 || s->elementWidth == 0 || s->elementHeight == 0) {
+		return kIOReturnBadArgument;
+	}
+	s->bytesPerRow = sweet_dict_u32(props, "IOSurfaceBytesPerRow",
+	    sweet_row_bytes(s->width, s->elementWidth, s->bytesPerElement));
+	if (s->bytesPerRow < (uint64_t)sweet_div_up(s->width, s->elementWidth) * s->bytesPerElement) {
+		return kIOReturnBadArgument;
+	}
+	/*
+	 * CAMetalLayer's drawables ("CAMetalLayer Display Drawable") are asked for at width * 4 bytes a
+	 * row -- PencilKit's 1128-pixel canvas came as 4512 -- which a6xx cannot import
+	 * (fd_resource_from_handle's pitchalign 6: 64 bytes), so the Metal driver had no drawable and
+	 * Notes' ink was never drawn. Those rows are rounded up to the alignment this kernel advertises;
+	 * CoreAnimation and the GPU both read a drawable's row back. Only those: rounding every
+	 * client-sized row (the first try) sheared images whose writers keep the row they asked for
+	 * (Notes' toolbar icons came out striped).
+	 */
+	/*
+	 * Which ones: the drawable is created without a name (CoreAnimation names it afterwards), as
+	 * BGRA, one plane, width * 4 rounded to 16 (1125 pixels: 4512); every image writer seen keeping its own row names
+	 * its surface at creation (CoreUI, QuartzCore, CoreVideo). So: rounded when unnamed and so
+	 * shaped (or named CAMetalLayer...), kept otherwise; each decision logged, the first 24.
+	 */
+	OSString *name = OSDynamicCast(OSString, props->getObject("IOSurfaceName"));
+	OSArray *plane_info = OSDynamicCast(OSArray, props->getObject("IOSurfacePlaneInfo"));
+	/* one-plane plane info counts as single-plane: CAMetalLayer passes its drawable's row there too */
+	bool one_plane = plane_info == NULL || plane_info->getCount() == 1;
+	/* and PencilKit's own canvas ("PencilKit", 1125x2436 at 4512): a surface it wraps as a Metal
+	 * texture and draws only on the GPU */
+	/* named ones only: an unnamed BGRA surface rounded (0157) was an image decoder's, which then
+	 * walked its rows past the end of its buffer -- SpringBoard crashed in DecodeRow */
+	bool drawable = name != NULL && (strncmp(name->getCStringNoCopy(), "CAMetalLayer", 12) == 0 ||
+	    strcmp(name->getCStringNoCopy(), "PencilKit") == 0);
+	if ((s->bytesPerRow % SWEET_SURFACE_ROW_ALIGN) != 0 && one_plane) {
+		static unsigned told;
+		if (told < 24 || drawable || s->width >= 1000) {
+			told++;
+			IOLog("SWEET SURF: %ux%u asked %u bytes a row (not a multiple of %u), name %s: %s\n", s->width,
+			    s->height, s->bytesPerRow, SWEET_SURFACE_ROW_ALIGN, name ? name->getCStringNoCopy() : "(none)",
+			    drawable ? "rounded up" : "kept");
+		}
+		if (drawable) {
+			s->bytesPerRow = (uint32_t)((s->bytesPerRow + SWEET_SURFACE_ROW_ALIGN - 1) &
+			    ~(uint64_t)(SWEET_SURFACE_ROW_ALIGN - 1));
+		}
+	}
+	end = (uint64_t)s->offset + (uint64_t)s->bytesPerRow * sweet_div_up(s->height, s->elementHeight);
+
+	OSArray *planes = sweet_fmt_subst ? NULL : OSDynamicCast(OSArray, props->getObject("IOSurfacePlaneInfo"));
+	s->planeCount = 0;
+	if (planes != NULL) {
+		uint64_t next = s->offset;
+		if (planes->getCount() > SWEET_SURFACE_MAX_PLANES) {
+			return kIOReturnBadArgument;
+		}
+		for (unsigned int i = 0; i < planes->getCount(); i++) {
+			OSDictionary *pd = OSDynamicCast(OSDictionary, planes->getObject(i));
+			struct sweet_surface_plane *p = &s->planes[i];
+			if (pd == NULL) {
+				return kIOReturnBadArgument;
+			}
+			p->width = sweet_dict_u32(pd, "IOSurfacePlaneWidth", s->width);
+			p->height = sweet_dict_u32(pd, "IOSurfacePlaneHeight", s->height);
+			p->bytesPerElement = (uint16_t)sweet_dict_u32(pd, "IOSurfacePlaneBytesPerElement", 1);
+			p->elementWidth = (uint8_t)sweet_dict_u32(pd, "IOSurfacePlaneElementWidth", 1);
+			p->elementHeight = (uint8_t)sweet_dict_u32(pd, "IOSurfacePlaneElementHeight", 1);
+			if (p->width > SWEET_SURFACE_MAX_DIM || p->height > SWEET_SURFACE_MAX_DIM ||
+			    p->bytesPerElement > 64 || p->elementWidth == 0 || p->elementHeight == 0) {
+				return kIOReturnBadArgument;
+			}
+			p->bytesPerRow = sweet_dict_u32(pd, "IOSurfacePlaneBytesPerRow",
+			    sweet_row_bytes(p->width, p->elementWidth, p->bytesPerElement));
+			bool rounded = false;
+			if (planes->getCount() == 1 && (p->bytesPerRow % SWEET_SURFACE_ROW_ALIGN) != 0 &&
+			    (drawable || s->width >= 1000)) {
+				OSString *pn = OSDynamicCast(OSString, props->getObject("IOSurfaceName"));
+				IOLog("SWEET SURF: %ux%u plane 0 asked %u bytes a row, name %s: %s\n", s->width, s->height,
+				    p->bytesPerRow, pn ? pn->getCStringNoCopy() : "(none)", drawable ? "rounded up" : "kept");
+			}
+			if (drawable && planes->getCount() == 1 && (p->bytesPerRow % SWEET_SURFACE_ROW_ALIGN) != 0) {
+				/* the drawable's own row, as the surface's above (0157) */
+				p->bytesPerRow = (uint32_t)((p->bytesPerRow + SWEET_SURFACE_ROW_ALIGN - 1) &
+				    ~(uint64_t)(SWEET_SURFACE_ROW_ALIGN - 1));
+				rounded = true;
+			}
+			p->offset = sweet_dict_u32(pd, "IOSurfacePlaneOffset", (uint32_t)next);
+			p->size = sweet_dict_u32(pd, "IOSurfacePlaneSize",
+			    p->bytesPerRow * sweet_div_up(p->height, p->elementHeight));
+			if (rounded && p->size < p->bytesPerRow * sweet_div_up(p->height, p->elementHeight)) {
+				p->size = p->bytesPerRow * sweet_div_up(p->height, p->elementHeight);
+			}
+			next = round_page((uint64_t)p->offset + p->size);
+			if ((uint64_t)p->offset + p->size > end) {
+				end = (uint64_t)p->offset + p->size;
+			}
+		}
+		s->planeCount = planes->getCount();
+	} else if (!sweet_fmt_subst && s->width != 0 && s->height != 0) {
+		/* two-plane YCbCr asked for without plane info: luma, then interleaved chroma (MiniIOSurface
+		 * biplanarLayout); *2 for the 10-bit ones, in 16 bits */
+		uint32_t hs = 0, vs = 0, wide = 0, f = s->pixelFormat;
+		if (f == '420v' || f == '420f') { hs = 2; vs = 2; }
+		else if (f == '422v' || f == '422f') { hs = 2; vs = 1; }
+		else if (f == '444v' || f == '444f') { hs = 1; vs = 1; }
+		else if (f == 'x420' || f == 'xf20') { hs = 2; vs = 2; wide = 1; }
+		else if (f == 'x422' || f == 'xf22') { hs = 2; vs = 1; wide = 1; }
+		else if (f == 'x444' || f == 'xf44') { hs = 1; vs = 1; wide = 1; }
+		if (hs != 0) {
+			struct sweet_surface_plane *y = &s->planes[0], *c = &s->planes[1];
+			bzero(y, sizeof(*y));
+			bzero(c, sizeof(*c));
+			y->width = s->width;
+			y->height = s->height;
+			y->bytesPerElement = wide ? 2 : 1;
+			y->elementWidth = y->elementHeight = 1;
+			y->bytesPerRow = sweet_row_bytes(y->width, 1, y->bytesPerElement);
+			y->offset = 0;
+			y->size = y->bytesPerRow * y->height;
+			c->width = sweet_div_up(s->width, hs);
+			c->height = sweet_div_up(s->height, vs);
+			c->bytesPerElement = wide ? 4 : 2;
+			c->elementWidth = c->elementHeight = 1;
+			c->bytesPerRow = sweet_row_bytes(c->width, 1, c->bytesPerElement);
+			c->offset = y->size;
+			c->size = c->bytesPerRow * c->height;
+			s->planeCount = 2;
+			if ((uint64_t)c->offset + c->size > end) {
+				end = (uint64_t)c->offset + c->size;
+			}
+		}
+	}
+
+	uint64_t alloc = sweet_dict_u32(props, "IOSurfaceAllocSize", 0);
+	if (alloc < end) {
+		alloc = end;
+	}
+	alloc = round_page(alloc);
+	if (alloc == 0 || alloc > SWEET_SURFACE_MAX_ALLOC) {
+		return kIOReturnNoMemory;
+	}
+	s->allocSize = (uint32_t)alloc;
+	return kIOReturnSuccess;
+}
+
+/* Per-client mapping of one surface. */
+class SweetSurfaceRef : public OSObject {
+	OSDeclareDefaultStructors(SweetSurfaceRef);
+
+public:
+	SweetSurface *surface;
+	IOMemoryMap  *data;
+	IOMemoryMap  *state;
+	uint32_t      count;
+	uint32_t      uses[2];          /* this client's share of the surface's use counts (traps 0/1) */
+	bool          detached;         /* client let go (trap 4) but has not released yet (trap 5) */
+
+	bool init() APPLE_KEXT_OVERRIDE { detached = false; uses[0] = uses[1] = 0; return OSObject::init(); }
+	void free() APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetSurfaceRef, OSObject);
+
+static volatile SInt32 *
+sweet_surface_uses(SweetSurface *s, uint32_t category)
+{
+	return (volatile SInt32 *)((uint8_t *)s->state->getBytesNoCopy() + SWEET_SURFACE_STATE_USES + 4 * category);
+}
+
+void
+SweetSurfaceRef::free()
+{
+	/* uses this client still held (released the surface or exited while using it) end with it */
+	for (uint32_t c = 0; c < 2 && surface != NULL; c++) {
+		if (uses[c] != 0) {
+			OSAddAtomic(-(SInt32)uses[c], sweet_surface_uses(surface, c));
+			uses[c] = 0;
+		}
+	}
+	OSSafeReleaseNULL(data);
+	OSSafeReleaseNULL(state);
+	if (surface != NULL) {
+		sweet_surface_put(surface);
+		surface->release();
+		surface = NULL;
+	}
+	OSObject::free();
+}
