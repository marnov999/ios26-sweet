+OSDefineMetaClassAndStructors(IOSurfaceRootUserClient, IOUserClient);
+
+static uint64_t sweet_surf_logged;      /* selectors / traps already logged (< 64) */
+
+static void
+sweet_surf_log_once(const char *what, uint32_t n)
+{
+	uint32_t bit = (what[0] == 't' ? 48 : 0) + n;
+	if (bit >= 64 || (sweet_surf_logged & (1ULL << bit))) {
+		return;
+	}
+	sweet_surf_logged |= 1ULL << bit;
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	IOLog("SWEET SURF: %s %s %u\n", name, what, n);
+}
+
+bool
+IOSurfaceRootUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fTask = owningTask;
+	fLock = IOLockAlloc();
+	fRefs = OSArray::withCapacity(16);
+	return fLock != NULL && fRefs != NULL;
+}
+
+void
+IOSurfaceRootUserClient::free()
+{
+	OSSafeReleaseNULL(fRefs);
+	if (fLock != NULL) {
+		IOLockFree(fLock);
+		fLock = NULL;
+	}
+	IOUserClient::free();
+}
+
+IOReturn
+IOSurfaceRootUserClient::clientClose(void)
+{
+	IOLockLock(fLock);
+	fRefs->flushCollection();
+	IOLockUnlock(fLock);
+	terminate();
+	return kIOReturnSuccess;
+}
+
+/* Lock held. */
+SweetSurfaceRef *
+IOSurfaceRootUserClient::findRef(uint32_t id, bool detached, unsigned int *index)
+{
+	for (unsigned int i = 0; i < fRefs->getCount(); i++) {
+		SweetSurfaceRef *ref = (SweetSurfaceRef *)fRefs->getObject(i);
+		if (ref->surface->id == id && ref->detached == detached) {
+			if (index != NULL) {
+				*index = i;
+			}
+			return ref;
+		}
+	}
+	return NULL;
+}
+
+/*
+ * Count one more create/lookup of s by this client, mapping it into the
+ * task the first time. Takes over the caller's user count on s.
+ */
+IOReturn
+IOSurfaceRootUserClient::addRef(SweetSurface *s, SweetSurfaceRef **refOut)
+{
+	IOLockLock(fLock);
+	SweetSurfaceRef *ref = findRef(s->id, false, NULL);
+	if (ref != NULL && ref->surface == s) {
+		ref->count++;
+		IOLockUnlock(fLock);
+		sweet_surface_put(s);
+		*refOut = ref;
+		return kIOReturnSuccess;
+	}
+	IOLockUnlock(fLock);
+
+	ref = OSTypeAlloc(SweetSurfaceRef);
+	if (ref == NULL || !ref->init()) {
+		OSSafeReleaseNULL(ref);
+		sweet_surface_put(s);
+		return kIOReturnNoMemory;
+	}
+	s->retain();
+	ref->surface = s;
+	ref->count = 1;
+	/* The creator of a surface around its own memory has the pixels where they are: it is
+	 * told that address, and nothing is mapped a second time (HackiOS returnSurface). */
+	if (!(s->wrapped && s->clientTask == fTask)) {
+		ref->data = s->memory->createMappingInTask(fTask, 0, kIOMapAnywhere | s->mapCache);
+	}
+	ref->state = s->state->createMappingInTask(fTask, 0, kIOMapAnywhere | kIOMapReadOnly);
+	if ((ref->data == NULL && !(s->wrapped && s->clientTask == fTask)) || ref->state == NULL) {
+		ref->release();
+		return kIOReturnVMError;
+	}
+	IOLockLock(fLock);
+	SweetSurfaceRef *raced = findRef(s->id, false, NULL);
+	if (raced != NULL && raced->surface == s) {
+		/* Another thread mapped it meanwhile: count there, drop ours. */
+		raced->count++;
+		IOLockUnlock(fLock);
+		ref->release();
+		*refOut = raced;
+		return kIOReturnSuccess;
+	}
+	fRefs->setObject(ref);
+	IOLockUnlock(fLock);
+	ref->release();         /* fRefs holds it */
+	*refOut = ref;
+	return kIOReturnSuccess;
+}
+
+static void
+put32(uint8_t *p, uint32_t off, uint32_t v)
+{
+	memcpy(p + off, &v, 4);
+}
+
+static void
+put64(uint8_t *p, uint32_t off, uint64_t v)
+{
+	memcpy(p + off, &v, 8);
+}
+
+/* IOSurface.framework's lock result (copied to IOSurfaceClient + 0x68). */
+static void
+sweet_surface_fill_result(SweetSurface *s, SweetSurfaceRef *ref, uint8_t *out)
+{
+	bzero(out, SWEET_SURFACE_RESULT_SIZE);
+	put64(out, 0x00, ref->data != NULL ? ref->data->getAddress() : s->clientAddress);
+	put64(out, 0x08, ref->state->getAddress());
+	put64(out, 0x10, ref->state->getAddress() + SWEET_SURFACE_TIMESTAMPS);
+	put32(out, 0x18, s->id);
+	put32(out, 0x1c, s->allocSize);
+	put32(out, 0x20, s->width);
+	put32(out, 0x24, s->height);
+	put32(out, 0x28, s->bytesPerRow);
+	put32(out, 0x2c, s->offset);
+	put32(out, 0x30, s->pixelFormat);
+	put32(out, 0x34, s->allocSize);
+	put32(out, 0x38, s->planeCount);
+	memcpy(out + 0x40, &s->bytesPerElement, 2);
+	out[0x42] = s->elementWidth;
+	out[0x43] = s->elementHeight;
+	put32(out, 0x44, s->cacheMode);
+	put32(out, 0x50, s->parentID);
+	put32(out, 0x54, 1);
+	/*
+	 * The planes, as IOSurface.framework reads them (HackiOS MiniIOSurface.h struct minisurf_plane):
+	 * width 0x00, height 0x04, offset 0x0c, bytes per row 0x10 (it was written at 0x08, a reserved
+	 * word: every IOSurfaceGetBytesPerRowOfPlane() answered 0, and VideoToolbox's decodes into
+	 * planes came out empty -- the wallpaper's HEIC pictures were all zero), size 0x14, element
+	 * 0x18..0x1b, components 0x1c..0x34. A surface without planes still has its one plane described
+	 * here (MiniIOSurface resultSize: at least one), the header's count staying 0.
+	 */
+	uint32_t described = s->planeCount ? s->planeCount : 1;
+	for (uint32_t i = 0; i < described && i < SWEET_SURFACE_MAX_PLANES; i++) {
+		uint8_t *p = out + 0x68 + i * 0x80;
+		struct sweet_surface_plane one;
+		const struct sweet_surface_plane *pl = &s->planes[i];
+		if (s->planeCount == 0) {
+			bzero(&one, sizeof(one));
+			one.width = s->width;
+			one.height = s->height;
+			one.bytesPerRow = s->bytesPerRow;
+			one.offset = 0;
+			one.size = s->bytesPerRow * sweet_div_up(s->height, s->elementHeight);
+			one.bytesPerElement = s->bytesPerElement;
+			one.elementWidth = s->elementWidth;
+			one.elementHeight = s->elementHeight;
+			pl = &one;
+		}
+		put32(p, 0x00, pl->width);
+		put32(p, 0x04, pl->height);
+		put32(p, 0x0c, pl->offset);
+		put32(p, 0x10, pl->bytesPerRow);
+		put32(p, 0x14, pl->size);
+		memcpy(p + 0x18, &pl->bytesPerElement, 2);
+		p[0x1a] = pl->elementWidth;
+		p[0x1b] = pl->elementHeight;
+		if (s->planeCount == 0 && (s->pixelFormat == 'BGRA' || s->pixelFormat == 'RGBA')) {
+			/* MiniIOSurface describeComponents: in memory order; names 1 alpha 2 red 3 green 4 blue */
+			static const uint8_t bgra[4] = { 4, 3, 2, 1 }, rgba[4] = { 2, 3, 4, 1 };
+			const uint8_t *names = s->pixelFormat == 'BGRA' ? bgra : rgba;
+			p[0x1c] = 4;
+			for (unsigned c = 0; c < 4; c++) {
+				p[0x20 + c] = 8;                   /* bit depth */
+				p[0x24 + c] = (uint8_t)(8 * c);    /* bit offset */
+				p[0x28 + c] = names[c];
+				p[0x2c + c] = 1;                   /* unsigned integer */
+				p[0x30 + c] = 1;                   /* full range */
+			}
+		}
+	}
+}
+
+static IOReturn
+sweet_struct_out(IOExternalMethodArguments *args, const void *buf, uint32_t len)
+{
+	if (args->structureOutputDescriptor != NULL) {
+		if (len > args->structureOutputDescriptor->getLength()) {
+			return kIOReturnNoSpace;
+		}
+		args->structureOutputDescriptor->writeBytes(0, buf, len);
+		args->structureOutputDescriptorSize = len;
+		return kIOReturnSuccess;
+	}
+	if (args->structureOutput == NULL || len > args->structureOutputSize) {
+		return kIOReturnNoSpace;
+	}
+	memcpy(args->structureOutput, buf, len);
+	args->structureOutputSize = len;
+	return kIOReturnSuccess;
+}
+
+static uint32_t sweet_surface_lookups_logged;
+
+/*
+ * Log a lookup/return outcome: the surface geometry, whether its backing mapped,
+ * and how much of that backing is non-zero (mirrors MiniIOSurface cpp:1311-1313),
+ * so an empty cross-process result (id 0 in the sampler) can be told apart from a
+ * resolved-but-blank one. Gated: first 64, plus every failure.
+ */
+static void
+sweet_surf_log_lookup(const char *how, uint32_t reqid, SweetSurface *s, IOReturn ret, bool mapped)
+{
+	if (ret == kIOReturnSuccess && sweet_surface_lookups_logged >= 64) {
+		return;
+	}
+	sweet_surface_lookups_logged++;
+	uint32_t id = reqid, w = 0, h = 0, fmt = 0, planes = 0, nonzero = 0, total = 0;
+	if (s != NULL) {
+		id = s->id; w = s->width; h = s->height; fmt = s->pixelFormat; planes = s->planeCount;
+		uintptr_t base = s->kernelAddress();
+		uint64_t len = s->memory != NULL ? s->memory->getLength() : 0;
+		if (base != 0 && len >= 4) {
+			const uint8_t *p = (const uint8_t *)base;
+			for (uint64_t at = 0; at + 4 <= len; at += 64) {
+				nonzero += (p[at] | p[at + 1] | p[at + 2] | p[at + 3]) != 0;
+				total++;
+			}
+		}
+	}
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	IOLog("SWEET SURF: %s lookup/%s id %u %ux%u fmt 0x%x planes %u mapped %d nonzero %u/%u -> 0x%x\n",
+	    name, how, id, w, h, fmt, planes, mapped, nonzero, total, ret);
+}
+
+/* Map s for this client and answer with its lock result. Takes s's user count. */
+IOReturn
+IOSurfaceRootUserClient::returnSurface(SweetSurface *s, IOExternalMethodArguments *args)
+{
+	SweetSurfaceRef *ref = NULL;
+	IOReturn ret = addRef(s, &ref);
+	if (ret != kIOReturnSuccess) {
+		sweet_surf_log_lookup("ret", s->id, s, ret, false);   /* createMappingInTask failed */
+		return ret;
+	}
+	uint8_t *out = (uint8_t *)IOMallocZeroData(SWEET_SURFACE_RESULT_SIZE);
+	if (out == NULL) {
+		ret = kIOReturnNoMemory;
+	} else {
+		sweet_surface_fill_result(s, ref, out);
+		ret = sweet_struct_out(args, out, SWEET_SURFACE_RESULT_SIZE);
+		IOFreeData(out, SWEET_SURFACE_RESULT_SIZE);
+	}
+	sweet_surf_log_lookup("ret", s->id, s, ret, true);
+	if (ret != kIOReturnSuccess) {
+		/* The caller never learns the id: undo this create/lookup. */
+		trapRelease((void *)(uintptr_t)s->id, NULL, NULL, NULL, NULL, NULL);
+	}
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::create(IOExternalMethodArguments *args)
+{
+	const char *buf = (const char *)args->structureInput;
+	uint32_t len = args->structureInputSize;
+	char *copy = NULL;
+	IOReturn ret;
+
+	if (args->structureInputDescriptor != NULL) {
+		len = (uint32_t)args->structureInputDescriptor->getLength();
+		if (len == 0 || len > SWEET_SURFACE_MAX_PROPS) {
+			return kIOReturnBadArgument;
+		}
+		copy = (char *)IOMallocData(len);
+		if (copy == NULL) {
+			return kIOReturnNoMemory;
+		}
+		args->structureInputDescriptor->readBytes(0, copy, len);
+		buf = copy;
+	}
+	OSObject *obj = (buf != NULL && len > 0) ? OSUnserializeXML(buf, len) : NULL;
+	if (copy != NULL) {
+		IOFreeData(copy, len);
+	}
+	OSDictionary *props = OSDynamicCast(OSDictionary, obj);
+	if (props == NULL) {
+		OSSafeReleaseNULL(obj);
+		IOLog("SWEET SURF: create: bad property dictionary (%u bytes)\n", len);
+		return kIOReturnBadArgument;
+	}
+
+	SweetSurface *s = sweet_surface_alloc();
+	if (s == NULL) {
+		props->release();
+		return kIOReturnNoMemory;
+	}
+	s->parentID = args->scalarInputCount > 0 ? (uint32_t)args->scalarInput[0] : 0;
+	ret = sweet_surface_layout(s, props);
+	if (ret == kIOReturnSuccess) {
+		OSNumber *wrapAddr = OSDynamicCast(OSNumber, props->getObject("IOSurfaceAddress"));
+		if (wrapAddr != NULL) {
+			/* WRAP: the surface's pixels ARE the creator's own memory -- CoreAnimation
+			 * wraps its pictures / glyph atlases / app-drawn layer contents via
+			 * IOSurfaceAddress so the render server can sample them as-is. Map that
+			 * range instead of handing back a fresh zero buffer (which rendered all
+			 * content white). Mirrors HackiOS MiniIOSurface. No wired charge -- we
+			 * allocate no pixels of our own. */
+			IOMemoryDescriptor *md = NULL;
+			IOReturn held = kIOReturnNoMemory;
+			s->wrapped = true;
+			s->clientTask = fTask;
+			s->clientAddress = wrapAddr->unsigned64BitValue();
+			/* As HackiOS MiniIOSurface: the memory is as big as its owner says, not a byte
+			 * more (rounding up to whole pages ran past the owner's allocation and the
+			 * hold failed: every icon CoreAnimation wraps came back kIOReturnVMError), and
+			 * a picture that is only shown is held for reading (kIODirectionOut: the
+			 * device reads it) when it cannot be held for writing -- kIODirectionIn, as
+			 * here before, wants it writable too. */
+			{
+				uint64_t need = (uint64_t)s->offset +
+				    (uint64_t)s->bytesPerRow * sweet_div_up(s->height, s->elementHeight);
+				uint64_t told = sweet_dict_u32(props, "IOSurfaceAllocSize", 0);
+				s->allocSize = (uint32_t)(told > need ? told : need);
+			}
+			for (int a = 0; a < 2 && held != kIOReturnSuccess; a++) {   /* InOut, then read-only */
+				OSSafeReleaseNULL(md);
+				md = IOMemoryDescriptor::withAddressRange((mach_vm_address_t)s->clientAddress,
+				    s->allocSize, (a == 0 ? kIODirectionInOut : kIODirectionOut), s->clientTask);
+				held = (md != NULL) ? md->prepare() : kIOReturnNoMemory;
+			}
+			if (held != kIOReturnSuccess) {
+				OSSafeReleaseNULL(md);
+				ret = kIOReturnVMError;
+			} else {
+				s->memory = md;
+				s->mapCache = kIOMapDefaultCache;
+				if (!sweet_surface_publish(s)) {
+					ret = kIOReturnNoResources;
+				}
+			}
+		} else {
+		IOBufferMemoryDescriptor *mem = NULL;
+		if ((uint64_t)OSAddAtomic64(s->allocSize, (volatile SInt64 *)&sweet_surface_wired) +
+		    s->allocSize <= SWEET_SURFACE_WIRED_MAX) {
+			/* boot-arg sweetfb_scanout=1: a full-screen BGRA surface (what CoreAnimation presents,
+			 * 1125x2436) gets a buffer of the display pool, one physical piece below 4 GB, so that
+			 * the display engine can fetch it as it is (SweetFramebuffer scanOut); else as any other */
+			/* (only the window server's: PosterBoard makes a dozen full-screen BGRA surfaces of its own for
+			   the wallpaper, which took the pool, and the frames then went back to being copied, torn) */
+			char maker[32] = "";
+			proc_selfname(maker, sizeof(maker));
+			if (s->width == SWEET_DISPLAY_W && s->height == SWEET_DISPLAY_H && s->pixelFormat == 'BGRA' &&
+			    s->planeCount == 0 && s->bytesPerRow == SWEET_DISPLAY_BPR && strcmp(maker, "backboardd") == 0) {
+				mem = sweet_display_take(s->allocSize, &s->poolSlot);
+				if (mem == NULL) {
+					sweet_gpu_reap_dead_now();      /* (a dead window server's buffers may hold them) */
+					mem = sweet_display_take(s->allocSize, &s->poolSlot);
+				}
+				if (mem == NULL) {
+					static uint32_t told;
+					if (told++ < 4) {
+						IOLog("SWEET SURF: no display buffer free for a full-screen surface\n");
+					}
+				}
+			}
+			if (mem == NULL) {
+				mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+				    kIODirectionInOut | kIOMemoryKernelUserShared, s->allocSize, page_size);
+			}
+		}
+		if (mem == NULL) {
+			OSAddAtomic64(-(SInt64)s->allocSize, (volatile SInt64 *)&sweet_surface_wired);
+			ret = kIOReturnNoMemory;
+		} else {
+			bzero(mem->getBytesNoCopy(), s->allocSize);
+			s->memory = mem;
+			s->mapCache = kIOMapDefaultCache;
+			if (!sweet_surface_publish(s)) {
+				ret = kIOReturnNoResources;
+			}
+		}
+		}
+	}
+	if (ret != kIOReturnSuccess || sweet_surface_creates_logged < 64) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		sweet_surface_creates_logged++;
+		IOLog("SWEET SURF: %s create id %u %ux%u fmt 0x%x bpe %u bpr %u planes %u size %u keys %u wrap %d -> 0x%x\n",
+		    name, s->id, s->width, s->height, s->pixelFormat, s->bytesPerElement,
+		    s->bytesPerRow, s->planeCount, s->allocSize, props->getCount(), s->wrapped, ret);
+	}
+	props->release();
+	if (ret != kIOReturnSuccess) {
+		s->release();
+		return ret;
+	}
+	ret = returnSurface(s, args);   /* takes the creator's user count */
+	s->release();
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	uint64_t arg0 = args->scalarInputCount > 0 ? args->scalarInput[0] : 0;
+
+	switch (selector) {
+	case kSweetSurfaceLimits: {
+		uint8_t limits[0x18] = { 0 };
+		put32(limits, 0x0, SWEET_SURFACE_ROW_ALIGN - 1);
+		put32(limits, 0x4, SWEET_SURFACE_ROW_ALIGN - 1);
+		limits[0x16] = 1;
+		sweet_surf_log_once("sel", selector);
+		return sweet_struct_out(args, limits, sizeof(limits));
+	}
+	case kSweetSurfaceCreate:
+		return create(args);
+	case kSweetSurfaceLookup: {
+		SweetSurface *s = sweet_surface_copy((uint32_t)arg0);
+		IOReturn ret = kIOReturnNotFound;
+		if (s != NULL) {
+			ret = sweet_surface_get(s) ? returnSurface(s, args) : kIOReturnNotFound;
+			s->release();
+		} else {
+			/* id not in the table: the sampler gets an empty IOSurface (id 0) */
+			sweet_surf_log_lookup("id", (uint32_t)arg0, NULL, kIOReturnNotFound, false);
+		}
+		sweet_surf_log_once("sel", selector);
+		return ret;
+	}
+	case kSweetSurfaceLookupFromPort: {
+		OSObject *obj = NULL;
+		IOReturn ret = IOUserClient::copyObjectForPortNameInTask(fTask, (mach_port_name_t)arg0, &obj);
+		SweetSurfaceSendRight *right = OSDynamicCast(SweetSurfaceSendRight, obj);
+		SweetSurface *s = right != NULL ? right->surface : NULL;
+		if (ret == kIOReturnSuccess) {
+			ret = (s != NULL && sweet_surface_get(s)) ? returnSurface(s, args) : kIOReturnBadArgument;
+		}
+		if (ret != kIOReturnSuccess) {
+			sweet_surf_log_lookup("port", s != NULL ? s->id : 0, s, ret, false);
+		}
+		OSSafeReleaseNULL(obj);
+		sweet_surf_log_once("sel", selector);
+		return ret;
+	}
+	case kSweetSurfaceCreatePort: {
+		SweetSurface *s = sweet_surface_copy((uint32_t)arg0);
+		if (s == NULL || args->scalarOutputCount < 1) {
+			OSSafeReleaseNULL(s);
+			return kIOReturnNotFound;
+		}
+		args->scalarOutput[0] = sweet_surface_port_in_task(s, fTask);
+		args->scalarOutputCount = 1;
+		s->release();
+		sweet_surf_log_once("sel", selector);
+		return kIOReturnSuccess;
+	}
+	case 200: {     /* SWEET: has surface arg0 been written by a processor since the last ask? (eagl.c surface_changed) */
+		/*
+		 * The GL bridge copies some surfaces into textures and has to notice when they are drawn
+		 * into; not every writer moves the seed, so it added up all their memory every frame --
+		 * 15% of the window server's processor time. The pages know: XNU keeps a "modified" bit
+		 * per page, set by the first write after it was cleared. Asked here and cleared, a page
+		 * at a time; out: 1 written, 0 not. The GPU's submissions read the same bits (they push
+		 * out of the cache only the written pages) and leave cpuWritten set for this.
+		 */
+		SweetSurface *s = sweet_surface_copy((uint32_t)arg0);
+		uint64_t dirty;
+		if (s == NULL || s->memory == NULL || args->scalarOutputCount < 1) {
+			OSSafeReleaseNULL(s);
+			return kIOReturnNotFound;
+		}
+		dirty = sweet_surface_push_written(s) < 0 ? 1 : 0;
+		dirty |= OSBitAndAtomic(0u, &s->cpuWritten) & 1u;
+		args->scalarOutput[0] = dirty;
+		args->scalarOutputCount = 1;
+		s->release();
+		sweet_surf_log_once("sel", selector);
+		return kIOReturnSuccess;
+	}
+	case 201: {     /* SWEET: selector 200 for up to 64 surfaces at once (in: their ids, u32 each; out: a mask, 1 written) */
+		/* (one Mach message a frame instead of one a surface: each costs the window server's render thread a kmsg
+		   made, copied in and out, and an IOKit dispatch) */
+		const uint32_t *ids = (const uint32_t *)args->structureInput;
+		uint32_t n = args->structureInputSize / sizeof(uint32_t);
+		uint64_t mask = 0;
+		if (ids == NULL || n == 0 || n > 64 || args->scalarOutputCount < 1) {
+			return kIOReturnBadArgument;
+		}
+		for (uint32_t i = 0; i < n; i++) {
+			SweetSurface *s = sweet_surface_copy(ids[i]);
+			uint64_t dirty = 1;                     /* (a surface not found: as written, so it is copied and seen to) */
+			if (s != NULL && s->memory != NULL) {
+				dirty = sweet_surface_push_written(s) < 0 ? 1 : 0;
+				dirty |= OSBitAndAtomic(0u, &s->cpuWritten) & 1u;
+			}
+			OSSafeReleaseNULL(s);
+			mask |= dirty << i;
+		}
+		args->scalarOutput[0] = mask;
+		args->scalarOutputCount = 1;
+		sweet_surf_log_once("sel", selector);
+		return kIOReturnSuccess;
+	}
+	case 6:         /* WrapClientImage: a surface around memory of the caller's own */
+	case 7:         /* WrapClientMemory */
+		/*
+		 * Not done here, and said so (HackiOS MiniIOSurface: kIOReturnUnsupported). The
+		 * framework then returns NULL and CoreAnimation uploads the picture as an ordinary
+		 * texture. Answered "success" with nothing filled in (the default below), the
+		 * framework made an empty surface (id 0, no memory, null color info): the GPU
+		 * renderer drew the lock screen's text and pictures from it as black, and the
+		 * window server crashed on its color info.
+		 */
+		sweet_surf_log_once("sel", selector);
+		return kIOReturnUnsupported;
+	default:
+		/* Values, notifications, ownership, timestamps...: accept and ignore. */
+		for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+			args->scalarOutput[i] = 0;
+		}
+		if (args->structureOutput != NULL) {
+			bzero(args->structureOutput, args->structureOutputSize);
+		}
+		sweet_surf_log_once("sel", selector);
+		return kIOReturnSuccess;
+	}
+}
+
+IOReturn
+IOSurfaceRootUserClient::useCount(uintptr_t id, uintptr_t category, int delta)
+{
+	if (category >= 2) {
+		return kIOReturnBadArgument;
+	}
+	IOLockLock(fLock);
+	SweetSurfaceRef *ref = findRef((uint32_t)id, false, NULL);
+	if (ref == NULL) {
+		ref = findRef((uint32_t)id, true, NULL);
+	}
+	if (ref == NULL) {
+		IOLockUnlock(fLock);
+		return kIOReturnNotFound;
+	}
+	if (delta > 0) {
+		ref->uses[category]++;
+		OSIncrementAtomic(sweet_surface_uses(ref->surface, (uint32_t)category));
+	} else if (ref->uses[category] != 0) {
+		ref->uses[category]--;
+		OSDecrementAtomic(sweet_surface_uses(ref->surface, (uint32_t)category));
+	}
+	IOLockUnlock(fLock);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapIncrementUse(void *id, void *category, void *, void *, void *, void *)
+{
+	return useCount((uintptr_t)id, (uintptr_t)category, 1);
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapDecrementUse(void *id, void *category, void *, void *, void *, void *)
+{
+	return useCount((uintptr_t)id, (uintptr_t)category, -1);
+}
+
+static IOReturn
+sweet_surface_seed_out(SweetSurface *s, void *seedOut, bool bump)
+{
+	uint32_t seed = bump ? OSIncrementAtomic((volatile SInt32 *)sweet_surface_seed(s)) + 1 :
+	    *sweet_surface_seed(s);
+	if (seedOut != NULL && copyout(&seed, (user_addr_t)seedOut, sizeof(seed)) != 0) {
+		return kIOReturnBadArgument;
+	}
+	return kIOReturnSuccess;
+}
+
+/* Retained surface this client created or looked up, or NULL. */
+static SweetSurface *
+sweet_surface_held(IOLock *lock, OSArray *refs, uint32_t id)
+{
+	SweetSurface *s = NULL;
+	IOLockLock(lock);
+	for (unsigned int i = 0; i < refs->getCount(); i++) {
+		SweetSurfaceRef *ref = (SweetSurfaceRef *)refs->getObject(i);
+		if (ref->surface->id == id) {
+			s = ref->surface;
+			s->retain();
+			break;
+		}
+	}
+	IOLockUnlock(lock);
+	return s;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapLock(void *id, __unused void *options, void *seedOut,
+    void *, void *, void *)
+{
+	SweetSurface *s = sweet_surface_held(fLock, fRefs, (uint32_t)(uintptr_t)id);
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	IOReturn ret = sweet_surface_seed_out(s, seedOut, false);
+	s->release();
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapUnlock(void *id, void *options, void *seedOut,
+    void *, void *, void *)
+{
+	SweetSurface *s = sweet_surface_held(fLock, fRefs, (uint32_t)(uintptr_t)id);
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	IOReturn ret = sweet_surface_seed_out(s, seedOut,
+	    !((uintptr_t)options & kIOSurfaceLockReadOnly));
+	s->release();
+	return ret;
+}
+
+/*
+ * A client drops a surface in two steps (mirrors MiniIOSurface cpp:1784/1798):
+ * trap 4 "detach" marks the ref while the client still holds its own lock, trap 5
+ * "release" drops it. A lookup of the same surface in between finds no non-detached
+ * ref and builds a fresh view instead of colliding with the dying one.
+ */
+IOReturn
+IOSurfaceRootUserClient::trapDetach(void *id, void *, void *, void *, void *, void *)
+{
+	IOLockLock(fLock);
+	SweetSurfaceRef *ref = findRef((uint32_t)(uintptr_t)id, false, NULL);
+	if (ref != NULL) {
+		ref->detached = true;
+	}
+	IOLockUnlock(fLock);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapRelease(void *id, void *, void *, void *, void *, void *)
+{
+	unsigned int index;
+	IOLockLock(fLock);
+	SweetSurfaceRef *ref = findRef((uint32_t)(uintptr_t)id, true, &index);    /* a detached view first */
+	if (ref == NULL) {
+		ref = findRef((uint32_t)(uintptr_t)id, false, &index);
+	}
+	if (ref != NULL && --ref->count == 0) {
+		fRefs->removeObject(index);     /* unmaps and drops the user count */
+	}
+	IOLockUnlock(fLock);
+	return ref != NULL ? kIOReturnSuccess : kIOReturnNotFound;
+}
+
+static IOExternalTrap sweet_surface_traps[] = {
+	[kSweetSurfaceTrapIncrementUse]  = { NULL, (IOTrap) & IOSurfaceRootUserClient::trapIncrementUse },
+	[kSweetSurfaceTrapDecrementUse]  = { NULL, (IOTrap) & IOSurfaceRootUserClient::trapDecrementUse },
+	[kSweetSurfaceTrapLock]          = { NULL, (IOTrap) & IOSurfaceRootUserClient::trapLock },
+	[kSweetSurfaceTrapUnlock]        = { NULL, (IOTrap) & IOSurfaceRootUserClient::trapUnlock },
+	[kSweetSurfaceTrapDetach]        = { NULL, (IOTrap) & IOSurfaceRootUserClient::trapDetach },
+	[kSweetSurfaceTrapRelease]       = { NULL, (IOTrap) & IOSurfaceRootUserClient::trapRelease },
+};
+
+IOExternalTrap *
+IOSurfaceRootUserClient::getTargetAndTrapForIndex(IOService **targetP, UInt32 index)
+{
+	if (index >= sizeof(sweet_surface_traps) / sizeof(sweet_surface_traps[0])) {
+		sweet_surf_log_once("trap", index);
+		return NULL;
+	}
+	sweet_surf_log_once("trap", index);
+	*targetP = this;
+	return &sweet_surface_traps[index];
+}
+#endif /* SWEET */
diff --git a/iokit/Kernel/arm/SweetSurface.h b/iokit/Kernel/arm/SweetSurface.h
new file mode 100644
index 0000000..de57d77
--- /dev/null
+++ b/iokit/Kernel/arm/SweetSurface.h
@@ -0,0 +1,82 @@
+/*
+ * Built-in IOSurface for SWEET (see SweetSurface.cpp).
+ *
+ * Shared with SweetFramebuffer.cpp: the framebuffer looks surfaces up by
+ * id when a swap names them and publishes the panel memory itself as the
+ * default framebuffer surface.
+ */
+#ifndef _SWEET_SURFACE_H
+#define _SWEET_SURFACE_H
+
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <libkern/c++/OSObject.h>
+#include <mach/mach_types.h>
+
+#define SWEET_SURFACE_MAX_PLANES        20
+
+struct sweet_surface_plane {
+	uint32_t width, height, bytesPerRow, offset, size;
+	uint16_t bytesPerElement;
+	uint8_t  elementWidth, elementHeight;
+};
+
+/* One physical page of a surface's memory: which, and the bytes of the memory that are in it. */
+struct sweet_surface_page {
+	ppnum_t  pn;            /* 0: not a page the VM keeps "modified" bits for */
+	uint32_t off, len;      /* the memory's bytes [off, off + len) ... */
+	uint32_t poff;          /* ... are at this offset in the page */
+};
+
+class SweetSurface : public OSObject {
+	OSDeclareDefaultStructors(SweetSurface);
+
+public:
+	uint32_t id;
+	uint32_t width, height, bytesPerRow, offset, pixelFormat, allocSize;
+	uint16_t bytesPerElement;
+	uint8_t  elementWidth, elementHeight;
+	uint32_t cacheMode, planeCount, parentID;
+	struct sweet_surface_plane planes[SWEET_SURFACE_MAX_PLANES];
+
+	IOMemoryDescriptor       *memory;       /* pixels (buffer or physical) */
+	IOOptionBits              mapCache;     /* cache mode for user mappings */
+	IOBufferMemoryDescriptor *state;        /* shared state page, read-only for users */
+	IOMemoryMap              *kernelMap;    /* lazily created for kernel copies */
+	bool                      wrapped;      /* backing is the creator's OWN memory (IOSurfaceAddress wrap) */
+	uint32_t                  poolSlot;     /* 1 + the display pool buffer it has, 0: none */
+	task_t                    clientTask;   /* task whose VA clientAddress lives in (for complete()) */
+	uint64_t                  clientAddress;
+	struct sweet_surface_page *pages;       /* the pixels' pages (made on first need) */
+	bool                      kernelMapFailed; /* (not to be tried again: every try printed a backtrace) */
+	uint32_t                  pageCount;
+	volatile UInt32           cpuWritten;   /* a processor wrote a page since selector 200 last asked */
+
+	bool init() APPLE_KEXT_OVERRIDE { wrapped = false; clientTask = NULL; clientAddress = 0; pages = NULL; pageCount = 0; cpuWritten = 0; kernelMapFailed = false; return OSObject::init(); }
+	void free() APPLE_KEXT_OVERRIDE;
+
+	/* Kernel address of the pixels (mapped on first use), or 0. */
+	uintptr_t kernelAddress();
+};
+
+/* Retained surface for an id, or NULL. */
+SweetSurface *sweet_surface_copy(uint32_t id);
+
+/*
+ * Publish physical memory (the panel framebuffer) as a surface. Returns a
+ * retained surface that stays in the id table until released by the caller
+ * and every user.
+ */
+/* boot-arg sweetfb_scanout=1: physically contiguous full-screen buffers, made early (AppleCLCD::start) */
+void sweet_surface_display_pool_init(void);
+SweetSurface *sweet_surface_create_physical(uint64_t phys, uint32_t width,
+    uint32_t height, uint32_t bytesPerRow, uint32_t pixelFormat);
+
+/* Send right for the surface in task (IOSurfaceLookupFromMachPort). */
+mach_port_name_t sweet_surface_port_in_task(SweetSurface *surface, task_t task);
+
+#endif /* SWEET */
+#endif /* _SWEET_SURFACE_H */
diff --git a/iokit/Kernel/arm/SweetWatchdog.cpp b/iokit/Kernel/arm/SweetWatchdog.cpp
new file mode 100644
index 0000000..8f53742
--- /dev/null
+++ b/iokit/Kernel/arm/SweetWatchdog.cpp
@@ -0,0 +1,107 @@
+/*
+ * Built-in IOWatchdog for SWEET.
+ *
+ * watchdogd (launchd job with _PanicOnCrash) opens IOServiceMatching(
+ * "IOWatchdog") with type 1 and exits when it is missing, which panics the
+ * system. On Apple hardware the kext arms a SoC watchdog that resets the
+ * device unless watchdogd keeps checking in. SWEET has no reset path, so
+ * this service accepts every call (check-in 1, enable/disable userspace
+ * monitoring 3/4, 0/5, struct calls 2 and 9) and does nothing; each
+ * selector is logged the first time it is used.
+ *
+ * watchdogd also writes the device boot stage to the PMU: it looks up
+ * the IOService with IOPMUPrimary = 1 and crashes when there is none
+ * (customer builds ignore -wdt_no_pmu). SWEET has no Apple PMU, so this
+ * service carries IOPMUPrimary and accepts property writes.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <sys/proc.h>
+
+class IOWatchdog : public IOService {
+	OSDeclareDefaultStructors(IOWatchdog);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOWatchdog, IOService);
+
+IOReturn
+IOWatchdog::setProperties(__unused OSObject *properties)
+{
+	return kIOReturnSuccess;
+}
+
+bool
+IOWatchdog::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "IOWatchdogUserClient");
+	setProperty("IOPMUPrimary", 1ULL, 32);
+	registerService();
+	IOLog("SWEET WDT: IOWatchdog registered (accepts check-ins, never fires)\n");
+	return true;
+}
+
+class IOWatchdogUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(IOWatchdogUserClient);
+
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOWatchdogUserClient, IOUserClient);
+
+IOReturn
+IOWatchdogUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+static uint64_t sweet_wdt_logged;       /* selectors already logged (< 64) */
+
+IOReturn
+IOWatchdogUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = 0;
+	}
+	if (args->structureOutputDescriptor != NULL) {
+		IOByteCount len = args->structureOutputDescriptor->getLength();
+		for (IOByteCount off = 0; off < len; off += 8) {
+			static const uint64_t zero = 0;
+			args->structureOutputDescriptor->writeBytes(off, &zero, len - off < 8 ? len - off : 8);
+		}
+	} else if (args->structureOutput != NULL) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+
+	if (selector >= 64 || !(sweet_wdt_logged & (1ULL << selector))) {
+		if (selector < 64) {
+			sweet_wdt_logged |= 1ULL << selector;
+		}
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET WDT: %s sel %u in %u/%u out %u/%u -> ok\n", name, selector,
+		    args->scalarInputCount, args->structureInputSize,
+		    args->scalarOutputCount, args->structureOutputSize);
+	}
+	return kIOReturnSuccess;
+}
+#endif /* SWEET */
