+/*
+ * The display off and on (IOMFB RequestPowerChange from backboardd, the power button / auto-lock).
+ * Level 0 alone only dims an AMOLED: the last frame stayed on, faintly. So, as the panel driver does
+ * (dsi_panel off/on commands): brightness 0, DCS display off (0x28) and enter sleep (0x10), and the
+ * display engine's refresh left off while asleep (no frames fetched); back: exit sleep (0x11), the
+ * 120 ms it needs, refresh on, display on (0x29), the brightness. While off, the clocks thread runs
+ * everything at its lowest (g_clocks_dark). Boot-arg sweetpanel_sleep=0: the old dimming only.
+ */
+static int panel_dcs_cmd(uint8_t cmd, bool refresh_stays_off);
+static int panel_power_up(void);
+static void panel_reset_line(bool high);
+extern void sweet_touch_resume(void);
+extern int sweet_rpmh_vreg_vote(const char *res, unsigned mv, bool on);
+static bool     g_panel_asleep;
+static uint32_t g_panel_refresh = ~0u;     /* INTF1 autorefresh config before sleep (~0: none saved) */
+
+int
+sweet_panel_power(int on)
+{
+	static int sleep_ok = -1, rails = 0;
+	int r;
+	if (sleep_ok < 0) {
+		sleep_ok = 1;
+		(void)PE_parse_boot_argn("sweetpanel_sleep", &sleep_ok, sizeof(sleep_ok));
+		/* Boot-arg sweetpanel_rails=1 (a trial): asleep, also our vote for the panel's 3.0 V vdda
+		 * (L18A) off, as dsi_panel_power_off takes its supplies away -- the aftermarket LCD of this
+		 * phone keeps its backlight lit through display off + sleep in, and goes dark under MIUI. */
+		(void)PE_parse_boot_argn("sweetpanel_rails", &rails, sizeof(rails));
+	}
+	if (!on) {
+		g_panel_off = true;
+		r = panel_dcs_brightness(0u);
+		if (sleep_ok && !g_panel_asleep) {
+			/* MIUI's qcom,mdss-dsi-off-command for this panel (dtbo 14, "ss ea fhd cmd dsi panel"):
+			 * 05 .. 28 (display off), 05 .. 78 .. 10 (enter sleep, then 0x78 = 120 ms) */
+			int a = panel_dcs_cmd(0x28, false), b = panel_dcs_cmd(0x10, true);
+			gmub_udelay(120000);
+			g_panel_asleep = true;
+			printf("SWEET PANEL: asleep (display off %d, sleep in %d)\n", a, b);
+			if (rails) {
+				/* dsi_panel_power_off: the reset line low, then the supplies */
+				panel_reset_line(false);
+				printf("SWEET PANEL: vdda (L18A) vote off -> %d\n", sweet_rpmh_vreg_vote("ldoa18", 3000, false));
+			}
+		}
+		return r;
+	}
+	if (g_panel_asleep && rails) {
+		/* The supply was off, so the panel lost everything: powered and brought up from reset as
+		 * dsi_panel_power_on + the panel's on-commands do (just sleep out + display on left it
+		 * dark, seen 2026-10-26: the screen never came back). */
+		g_wake_at = mach_absolute_time();
+		g_wake_pending = 1u;
+		g_panel_off = false;
+		sweet_dvfs_wake_now();
+		int up = panel_power_up();
+		g_panel_asleep = false;
+		printf("SWEET PANEL: awake after power-up (%d); dark until the first frame\n", up);
+		sweet_touch_resume();
+		return 0;
+	}
+	if (g_panel_asleep) {
+		g_wake_at = mach_absolute_time();
+		g_wake_pending = 1u;
+		g_panel_off = false;
+		sweet_dvfs_wake_now();
+		int a = panel_dcs_cmd(0x11, true);
+		gmub_udelay(120000);                    /* exit sleep -> display on: 120 ms (MIPI DCS) */
+		int b = panel_dcs_cmd(0x29, true);      /* the refresh comes back with the first frame */
+		g_panel_asleep = false;
+		g_panel_off = false;
+		printf("SWEET PANEL: awake (sleep out %d, display on %d); dark until the first frame\n", a, b);
+		sweet_touch_resume();
+		return 0;
+	}
+	g_panel_off = false;
+	return panel_dcs_brightness(g_panel_level);
+}
