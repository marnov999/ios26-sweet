+++ b/bsd/dev/hakios.apple80211.c
@@ -0,0 +1,809 @@
+/*
+ * Darwin-on-hakios: Apple80211, answered in the kernel.
+ *
+ * iOS's Wi-Fi side -- wifid, and through it Settings and the status bar -- talks to a Wi-Fi
+ * driver in requests that were once ioctls and are, where the driver offers no user client,
+ * ioctls still: SIOCGA80211 and SIOCSA80211 on any socket, with a struct apple80211req that
+ * names the interface, a request type, a value, and a buffer in the caller's memory
+ * (IO80211.framework: Apple80211Get/Set and their kin all end there). XNU hands an interface
+ * ioctl it does not know to the interface, so they arrive in bsd/dev/hakios.net.c, which
+ * passes them here when its link is a radio.
+ *
+ * What is asked is answered from the station boundary (sys/hakios.sta.h): the radio's power,
+ * its channels, a scan and what it heard, the network joined. What happens there by itself is
+ * told to iOS the way a driver tells it: kernel events of class 6 (IEEE 802.11), subclass 1,
+ * whose code is Apple80211's own event number and whose data begins with the interface's name
+ * in 16 bytes (IO80211.framework reads them from a PF_SYSTEM socket and compares the name).
+ *
+ * Every request is still written to the log -- who asks, get or set, the type, the value, the
+ * length -- because which of them wifid needs is found that way. Never what a request carries:
+ * a network's name or its key may be in there.
+ *
+ * The request types and the layouts are Apple's. The old ones are as the headers of its open
+ * IO80211 sources once described them (apple80211_ioctl.h, apple80211_var.h); where iOS 16.5
+ * differs the layout was read out of IO80211.framework of 16.5, which fills and reads the same
+ * structures on the other side (Apple80211GetWithIOCTL, _getScanData, _addScanResultToList,
+ * _performAssociation, _dispatchAsyncAssocEvent, _dispatchLinkChangedEvent).
+ *
+ * A join: ASSOCIATE (20) carries the network's name, perhaps its access point, and the
+ * passphrase as typed (the framework does not make the key of it), and is answered at once;
+ * when the station has joined or failed, event 9 says so, and ASSOCIATE_RESULT (21) gives the
+ * outcome as one of Apple80211's result numbers, which the framework turns into its errors:
+ * 1 success, 21 "invalid PMK" (a wrong passphrase), 9 a timeout, 2 anything else.
+ */
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <sys/errno.h>
+#include <sys/kern_event.h>
+#include <sys/kernel.h>
+#include <sys/proc.h>
+#include <sys/hakios.net.h>
+#include <sys/hakios.sta.h>
+#include <sys/sweet_wifi.h>
+#include <sys/sockio.h>
+#include <sys/systm.h>
+
+#define SIOCSA80211             0x802869c8u     /* _IOW('i', 200, struct apple80211req) */
+#define SIOCGA80211             0xc02869c9u     /* _IOWR('i', 201, struct apple80211req) */
+
+struct apple80211req {
+	char req_if_name[16];
+	int32_t req_type;
+	int32_t req_val;
+	uint32_t req_len;
+	user_addr_t req_data __attribute__((aligned(8)));
+};
+
+/* (as far as they have come by: the names help reading the log) */
+static const char *
+type_name(int32_t type)
+{
+	static const struct {
+		int32_t type;
+		const char *name;
+	} names[] = {
+		{ 1, "SSID" }, { 2, "AUTH_TYPE" }, { 3, "CIPHER_KEY" }, { 4, "CHANNEL" }, { 5, "POWERSAVE" }, { 6, "PROTMODE" },
+		{ 7, "TXPOWER" }, { 8, "RATE" }, { 9, "BSSID" }, { 10, "SCAN_REQ" }, { 11, "SCAN_RESULT" }, { 12, "CARD_CAPABILITIES" },
+		{ 13, "STATE" }, { 14, "PHY_MODE" }, { 15, "OP_MODE" }, { 16, "RSSI" }, { 17, "NOISE" }, { 18, "INT_MIT" }, { 19, "POWER" },
+		{ 20, "ASSOCIATE" }, { 21, "ASSOCIATE_RESULT" }, { 22, "DISASSOCIATE" }, { 23, "STATUS_DEV_NAME" }, { 24, "IBSS_MODE" },
+		{ 25, "HOST_AP_MODE" }, { 26, "AP_MODE" }, { 27, "SUPPORTED_CHANNELS" }, { 28, "LOCALE" }, { 29, "DEAUTH" },
+		{ 30, "COUNTERMEASURES" }, { 32, "RATE_SET" }, { 42, "STATION_LIST" }, { 43, "DRIVER_VERSION" },
+		{ 44, "HARDWARE_VERSION" }, { 46, "RSN_IE" }, { 47, "BACKGROUND_SCAN" }, { 48, "AP_IE_LIST" }, { 49, "STATS" },
+		{ 50, "ASSOCIATION_STATUS" }, { 51, "COUNTRY_CODE" }, { 54, "RADIO_INFO" }, { 57, "MCS" }, { 66, "MCS_INDEX_SET" },
+		{ 79, "STA_STATS" }, { 80, "ROAM_THRESH" }, { 85, "IE" }, { 86, "SCAN_REQ_MULTIPLE" }, { 87, "BTCOEX_MODE" },
+		{ 90, "SCANCACHE_CLEAR" }, { 94, "VIRTUAL_IF_CREATE" }, { 95, "VIRTUAL_IF_DELETE" }, { 103, "CURRENT_NETWORK" },
+		{ 106, "RSSI_BOUNDS" }, { 107, "ROAM" }, { 207, "CHANNELS_INFO" }, { 254, "HW_SUPPORTED_CHANNELS" },
+	};
+
+	for (unsigned i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+		if (names[i].type == type) {
+			return names[i].name;
+		}
+	}
+	return "?";
+}
+
+/* ---- the layouts ------------------------------------------------------------------------------------------ */
+
+#define CHANNEL_20MHZ           0x2u
+#define CHANNEL_2GHZ            0x8u
+#define CHANNEL_5GHZ            0x10u
+#define CHANNEL_ACTIVE          0x80u           /* the radio may send there */
+#define CHANNEL_DFS             0x100u
+
+struct apple80211_channel {
+	uint32_t version, channel, flags;
+};
+
+/* SUPPORTED_CHANNELS (27) and HW_SUPPORTED_CHANNELS (254): 4824 bytes */
+struct apple80211_channels {
+	uint32_t version, count;
+	struct apple80211_channel channels[401];
+	uint32_t unused;
+};
+
+/* CHANNELS_INFO (207): 10016 bytes; of each channel a byte in each of several rows, and a word of flags */
+struct apple80211_channels_info {
+	uint8_t unknown_0[12];
+	uint16_t count;
+	uint8_t unknown_1[800];
+	uint8_t number[400], indoor[400], dfs[400], passive[400], wide_40[400], wide_80[400];
+	uint8_t unknown_2[1602];
+	uint32_t flags[400];
+	uint8_t unknown_3[3600];
+} __attribute__((packed));
+
+/* SCAN_REQ (10): 5456 bytes */
+struct apple80211_scan_request {
+	uint32_t version, bss_type;
+	uint8_t bssid[6], unused_0[2];
+	uint32_t ssid_length;
+	uint8_t ssid[32];
+	uint32_t scan_type;                     /* 1: asking, 2: listening only */
+	uint32_t phy_mode;
+	uint16_t dwell_ms, unused_1;
+	uint32_t rest_ms;
+	uint32_t channel_count;
+	struct apple80211_channel channels[400];
+	uint64_t flags;
+	uint32_t unused_2;
+	uint32_t name_count;                    /* networks asked for by name, each in 56 bytes */
+	uint8_t names[10][56];
+	uint32_t short_ssid, unused_3;
+};
+
+/* SCAN_RESULT (11) and CURRENT_NETWORK (103): 1164 bytes */
+struct apple80211_scan_result {
+	uint32_t version;
+	struct apple80211_channel channel;
+	uint16_t noise_known;
+	int16_t noise, snr, rssi;
+	uint16_t beacon_interval, capability;
+	uint8_t bssid[6];
+	uint8_t rate_count, unused_0;
+	uint32_t rates[15];                     /* Mbit/s */
+	uint8_t ssid_length, ssid[32], unused_1[3];
+	uint32_t age_ms;
+	uint8_t flags, unused_2;
+	uint16_t elements_length;               /* comes in as the room there is */
+	uint8_t elements[1024];
+};
+
+/* ASSOCIATE (20): 592 bytes; of what follows the key (the RSN element wifid built, flags) nothing is used */
+struct apple80211_assoc {
+	uint32_t version;
+	uint16_t mode, auth_lower, auth_upper, unused_0;
+	uint32_t ssid_length;
+	uint8_t ssid[32];
+	uint8_t bssid[6], unused_1[2];
+	uint32_t key_version, key_length, key_cipher;   /* cipher 10: a passphrase as typed; 6: the key (from 64 hex digits) */
+	uint16_t key_flags, key_index;
+	uint8_t key[64];
+	uint8_t rest[0x250 - 0x88];
+};
+
+#define CIPHER_PMK              6
+#define CIPHER_PASSPHRASE       10
+#define AUTH_WPA3_SAE           0x1000u
+
+/* the link event's data (at least 32 bytes, or the framework drops the event) */
+struct apple80211_link_changed {
+	uint8_t down, unused_0[3];
+	int32_t rssi;
+	uint16_t snr, noise;
+	uint8_t unused_1[4];
+	uint8_t involuntary, unused_2[3];
+	uint32_t reason, subreason;
+	uint8_t unused_3[4];
+};
+
+_Static_assert(sizeof(struct apple80211_assoc) == 592 && offsetof(struct apple80211_assoc, key) == 0x48,
+    "the association request as iOS 16.5 has it");
+_Static_assert(sizeof(struct apple80211_link_changed) == 32 && offsetof(struct apple80211_link_changed, reason) == 0x14,
+    "the link event as iOS 16.5 reads it");
+_Static_assert(sizeof(struct apple80211_channels) == 4824, "the channel list as iOS 16.5 has it");
+_Static_assert(sizeof(struct apple80211_channels_info) == 10016 && offsetof(struct apple80211_channels_info, number) == 0x32e &&
+    offsetof(struct apple80211_channels_info, flags) == 0x12d0, "the channels' description as iOS 16.5 has it");
+_Static_assert(sizeof(struct apple80211_scan_request) == 5456 && offsetof(struct apple80211_scan_request, channels) == 0x48 &&
+    offsetof(struct apple80211_scan_request, flags) == 0x1308 && offsetof(struct apple80211_scan_request, names) == 0x1318,
+    "the scan request as iOS 16.5 has it");
+_Static_assert(sizeof(struct apple80211_scan_result) == 1164 && offsetof(struct apple80211_scan_result, ssid_length) == 0x60 &&
+    offsetof(struct apple80211_scan_result, age_ms) == 0x84 && offsetof(struct apple80211_scan_result, elements) == 0x8c,
+    "a scan's result as iOS 16.5 has it");
+
+/* Apple80211's events (APPLE80211_M_...) */
+enum { EVENT_POWER_CHANGED = 1, EVENT_SSID_CHANGED = 2, EVENT_BSSID_CHANGED = 3, EVENT_LINK_CHANGED = 4, EVENT_ASSOC_DONE = 9,
+       EVENT_SCAN_DONE = 10 };
+
+static const char interface_name[16] = "en0";   /* (bsd/dev/hakios.net.c makes one interface, and that is its name) */
+
+static LCK_GRP_DECLARE(apple80211_lock_group, "hakios-apple80211");
+static LCK_MTX_DECLARE(apple80211_lock, &apple80211_lock_group);
+static unsigned result_next;                    /* which of what the last scan heard a SCAN_RESULT request gets next */
+static uint32_t join_result;                    /* of the last join asked for: 0 while it runs, then Apple80211's number */
+
+/* ---- channels ---------------------------------------------------------------------------------------- */
+
+static unsigned
+channel_number(unsigned frequency)
+{
+	return frequency == 2484 ? 14 : frequency < 4000 ? (frequency - 2407) / 5 : (frequency - 5000) / 5;
+}
+
+static unsigned
+channel_frequency(const struct apple80211_channel *channel)
+{
+	bool low = channel->flags & CHANNEL_2GHZ ? true : channel->flags & CHANNEL_5GHZ ? false : channel->channel <= 14;
+
+	if (channel->channel == 0 || channel->channel > 196 || (channel->flags & 0x2000)) {     /* (0x2000: 6 GHz) */
+		return 0;
+	}
+	return low ? (channel->channel == 14 ? 2484 : 2407 + 5 * channel->channel) : 5000 + 5 * channel->channel;
+}
+
+static void
+channel_fill(struct apple80211_channel *channel, unsigned frequency, unsigned flags)
+{
+	channel->version = 1;
+	channel->channel = channel_number(frequency);
+	channel->flags = CHANNEL_20MHZ | (frequency < 4000 ? CHANNEL_2GHZ : CHANNEL_5GHZ) | (flags & HAKIOS_STA_CHANNEL_PASSIVE ?
+	    0 : CHANNEL_ACTIVE) | (flags & HAKIOS_STA_CHANNEL_RADAR ? CHANNEL_DFS : 0);
+}
+
+/* ---- what the caller is given back ------------------------------------------------------------------- */
+
+/* At most as many bytes as it has room for. */
+static int
+give(const struct apple80211req *request, const void *data, size_t length)
+{
+	return request->req_data == USER_ADDR_NULL ? 0 : copyout(data, request->req_data, length < request->req_len ? length :
+	       request->req_len);
+}
+
+/* An access point in the form a scan's result has; the caller has said how much room for elements there is. */
+static int
+give_network(const struct apple80211req *request, const struct hakios_sta_bss *bss)
+{
+	struct apple80211_scan_result *result = kalloc_data(sizeof(*result), Z_WAITOK | Z_ZERO);
+	unsigned room = sizeof(result->elements);
+	int error;
+
+	if (result == NULL) {
+		return ENOMEM;
+	}
+	if (request->req_len >= sizeof(*result) && copyin(request->req_data, result, offsetof(struct apple80211_scan_result,
+	    elements)) == 0 && result->elements_length < room) {
+		room = result->elements_length;
+	}
+	bzero(result, sizeof(*result));
+	result->version = 1;
+	channel_fill(&result->channel, bss->frequency, 0);
+	result->rssi = bss->rssi;
+	result->beacon_interval = bss->beacon_interval;
+	result->capability = bss->capability;
+	memcpy(result->bssid, bss->bssid, sizeof(result->bssid));
+	result->ssid_length = bss->ssid_length;
+	memcpy(result->ssid, bss->ssid, bss->ssid_length);
+	result->age_ms = bss->age_ms;
+	result->elements_length = (uint16_t)(bss->elements_length <= room ? bss->elements_length : 0);
+	memcpy(result->elements, bss->elements, result->elements_length);
+	/* the rates it says it has (elements 1 and 50: units of 500 kbit/s, the top bit marks the ones everybody must have) */
+	for (unsigned at = 0; at + 2 <= bss->elements_length && at + 2 + bss->elements[at + 1] <= bss->elements_length;
+	    at += 2 + bss->elements[at + 1]) {
+		for (unsigned i = 0; (bss->elements[at] == 1 || bss->elements[at] == 50) && i < bss->elements[at + 1]; i++) {
+			unsigned rate = (bss->elements[at + 2 + i] & 0x7f) / 2;
+
+			if (rate != 0 && rate <= 54 && result->rate_count < 15) {
+				result->rates[result->rate_count++] = rate;
+			}
+		}
+	}
+	error = give(request, result, sizeof(*result));
+	kfree_data(result, sizeof(*result));
+	return error;
+}
+
+/* ---- get ---------------------------------------------------------------------------------------------- */
+
+static int
+get(struct apple80211req *request)
+{
+	struct hakios_sta_state *state;
+	int error = 0;
+
+	switch (request->req_type) {
+	case 43:
+	case 44: {                              /* the driver's and the hardware's name: the text alone, in 256 bytes */
+		char name[256] = { 0 };
+		strlcpy(name, hakios_is_raphael() ? "raphael: ath10k for the WCN3998" : "redwood: ath11k for the WCN6750", sizeof(name));
+
+		return give(request, name, sizeof(name));
+	}
+	case 12: {
+		/*
+		 * What the card can do, a bit each (apple80211_var.h: APPLE80211_CAP_*): the 13 bytes are the
+		 * bits alone, from the first (the framework hands in a buffer that begins after the old
+		 * header's version word). AES, AES-CCM, power management, short slot and preamble, WPA2, WME,
+		 * short guard interval at 20 MHz. Read wrong, the framework sees no WPA2 and builds no join
+		 * for a WPA2 network ("Unable to join").
+		 */
+		uint8_t bits[13] = { 0 };
+		static const uint8_t has[] = { 2, 3, 6, 9, 10, 14, 17, 19 };
+
+		for (unsigned i = 0; i < sizeof(has); i++) {
+			bits[has[i] / 8] |= (uint8_t)(1u << (has[i] % 8));
+		}
+		/*
+		 * iOS 16.5 IO80211: byte 9 bit 3 selects WPA3-SAE, so the framework hands the ASSOCIATE the
+		 * passphrase the user typed (CIPHER_PASSPHRASE) instead of a pre-computed WPA2 PMK -- which is
+		 * what SAE needs. The WCN3990 + our lx SAE do WPA3-SAE (davinci as well as the raphael
+		 * reference), so advertise it unconditionally; without it iOS treats every network as WPA2 and
+		 * a WPA3 join fails with "SAE needs the original passphrase".
+		 */
+		bits[6] |= 1;                         /* protected management frames (PMF) */
+		bits[9] |= 8;                         /* WPA3 Personal; no FT or enterprise */
+		return give(request, bits, sizeof(bits));
+	}
+	case 19: {                              /* the radio's power: one radio. Until the driver is up it counts as on: it */
+		struct {                        /* is being brought up, and iOS asks this once, early */
+			uint32_t version, radios, state[4];
+		} answer = { .version = 1, .radios = 1, .state = { !hakios_sta_present() || hakios_sta_powered() } };
+
+		return give(request, &answer, sizeof(answer));
+	}
+	case 15:                                /* the mode: a station (APPLE80211_M_STA) */
+		request->req_val = 1;
+		return 0;
+	case 27:
+	case 254: {                             /* the channels the radio may tune to */
+		struct apple80211_channels *answer;
+		struct hakios_sta_channel channels[96];
+		unsigned count = hakios_sta_channels(channels, 96);
+
+		if (count == 0 || (answer = kalloc_data(sizeof(*answer), Z_WAITOK | Z_ZERO)) == NULL) {
+			return count == 0 ? ENXIO : ENOMEM;
+		}
+		answer->version = 1;
+		answer->count = count;
+		for (unsigned i = 0; i < count; i++) {
+			channel_fill(&answer->channels[i], channels[i].frequency, channels[i].flags);
+		}
+		error = give(request, answer, sizeof(*answer));
+		kfree_data(answer, sizeof(*answer));
+		return error;
+	}
+	case 207: {                             /* ... and more of each */
+		struct apple80211_channels_info *answer;
+		struct hakios_sta_channel channels[96];
+		unsigned count = hakios_sta_channels(channels, 96);
+
+		if (count == 0 || (answer = kalloc_data(sizeof(*answer), Z_WAITOK | Z_ZERO)) == NULL) {
+			return count == 0 ? ENXIO : ENOMEM;
+		}
+		answer->count = (uint16_t)count;
+		for (unsigned i = 0; i < count; i++) {
+			struct apple80211_channel channel;
+
+			channel_fill(&channel, channels[i].frequency, channels[i].flags);
+			answer->number[i] = (uint8_t)channel.channel;
+			answer->dfs[i] = (channels[i].flags & HAKIOS_STA_CHANNEL_RADAR) != 0;
+			answer->passive[i] = (channels[i].flags & HAKIOS_STA_CHANNEL_PASSIVE) != 0;
+			answer->flags[i] = channel.flags;
+		}
+		error = give(request, answer, sizeof(*answer));
+		kfree_data(answer, sizeof(*answer));
+		return error;
+	}
+	case 21:                                /* how the last join went (0: not over yet) */
+		lck_mtx_lock(&apple80211_lock);
+		request->req_val = (int32_t)join_result;
+		lck_mtx_unlock(&apple80211_lock);
+		return 0;
+	case 11: {                              /* what the last scan heard, one access point a request; EIO: that was all */
+		struct hakios_sta_bss *bss = kalloc_data(sizeof(*bss), Z_WAITOK);
+		unsigned index;
+		bool there;
+
+		if (bss == NULL) {
+			return ENOMEM;
+		}
+		lck_mtx_lock(&apple80211_lock);
+		index = result_next++;
+		lck_mtx_unlock(&apple80211_lock);
+		there = hakios_sta_heard(index, bss);
+		error = there ? give_network(request, bss) : EIO;
+		kfree_data(bss, sizeof(*bss));
+		return error;
+	}
+	default:
+		break;
+	}
+
+	/* the rest is about the network joined, and there is none unless the station says so */
+	if ((state = kalloc_data(sizeof(*state), Z_WAITOK)) == NULL) {
+		return ENOMEM;
+	}
+	hakios_sta_state(state);
+	switch (request->req_type) {
+	case 13:                                /* the state: APPLE80211_S_INIT 0, _SCAN 1, _AUTH 2, _ASSOC 3, _RUN 4 */
+		request->req_val = state->phase == HAKIOS_STA_JOINED ? 4 : state->phase == HAKIOS_STA_JOINING ? 2 :
+		    state->phase == HAKIOS_STA_SCANNING ? 1 : 0;
+		break;
+	case 1:                                 /* its name; the length goes back in the request */
+		if (state->phase != HAKIOS_STA_JOINED) {
+			error = ENXIO;
+		} else if ((error = give(request, state->bss.ssid, state->bss.ssid_length)) == 0) {
+			request->req_len = state->bss.ssid_length;
+		}
+		break;
+	case 9:                                 /* its access point's address */
+		error = state->phase != HAKIOS_STA_JOINED ? ENXIO : give(request, state->bss.bssid, 6);
+		break;
+	case 4: {                               /* its channel */
+		struct {
+			uint32_t version;
+			struct apple80211_channel channel;
+		} answer = { .version = 1 };
+
+		if (state->phase != HAKIOS_STA_JOINED) {
+			error = ENXIO;
+		} else {
+			channel_fill(&answer.channel, state->bss.frequency, 0);
+			error = give(request, &answer, sizeof(answer));
+		}
+		break;
+	}
+	case 16: {                              /* how strongly it is heard: dBm, per radio and all together, twice over */
+		struct {
+			uint32_t version, radios, unit;
+			int32_t each[4], all, each_ext[4], all_ext;
+		} answer = { .version = 1, .radios = 1, .each = { state->bss.rssi }, .all = state->bss.rssi,
+			     .each_ext = { state->bss.rssi }, .all_ext = state->bss.rssi };
+
+		error = state->phase != HAKIOS_STA_JOINED ? ENXIO : give(request, &answer, sizeof(answer));
+		break;
+	}
+	case 103:                               /* all of it, as a scan's result */
+		error = state->phase != HAKIOS_STA_JOINED ? ENXIO : give_network(request, &state->bss);
+		break;
+	case 2: {                               /* how it was joined: open system, then WPA2 with a passphrase */
+		struct {
+			uint32_t version, lower, upper, extended;
+		} answer = { .version = 1, .lower = 1, .upper = 8 };
+
+		error = state->phase != HAKIOS_STA_JOINED ? ENXIO : give(request, &answer, sizeof(answer));
+		break;
+	}
+	default:
+		error = EOPNOTSUPP;
+		break;
+	}
+	kfree_data(state, sizeof(*state));
+	return error;
+}
+
+/* ---- set ---------------------------------------------------------------------------------------------- */
+
+static int
+set_scan(const struct apple80211req *request, char *said, size_t said_size)
+{
+	struct apple80211_scan_request *asked;
+	struct hakios_sta_scan *what;
+	unsigned unknown = 0;
+	int error;
+
+	if (request->req_len != sizeof(*asked)) {
+		return EINVAL;
+	}
+	if (!hakios_sta_present()) {
+		return EBUSY;                   /* (the radio is still being brought up: the framework tries again) */
+	}
+	asked = kalloc_data(sizeof(*asked), Z_WAITOK);
+	what = kalloc_data(sizeof(*what), Z_WAITOK | Z_ZERO);
+	if (asked == NULL || what == NULL || (error = copyin(request->req_data, asked, sizeof(*asked))) != 0) {
+		error = asked == NULL || what == NULL ? ENOMEM : error;
+		goto out;
+	}
+	if (asked->ssid_length <= sizeof(what->ssid)) {
+		what->ssid_length = (uint8_t)asked->ssid_length;
+		memcpy(what->ssid, asked->ssid, asked->ssid_length);
+	}
+	what->passive = asked->scan_type == 2;
+	what->dwell_ms = asked->dwell_ms;
+	/* (more channels than there is room to name: every channel) */
+	for (unsigned i = 0; i < asked->channel_count && i < 400 && asked->channel_count <= 64; i++) {
+		unsigned frequency = channel_frequency(&asked->channels[i]);
+
+		if (frequency != 0) {
+			what->frequencies[what->frequency_count++] = (uint16_t)frequency;
+		} else {
+			unknown++;
+		}
+	}
+	snprintf(said, said_size, " (a scan: type %u, %u channels of which %u are not the radio's, %u ms on each, a name of %u bytes, "
+	    "%u more names, flags %#llx)", asked->scan_type, asked->channel_count, unknown, asked->dwell_ms, asked->ssid_length,
+	    asked->name_count, asked->flags);
+	if (asked->channel_count != 0 && asked->channel_count <= 64 && what->frequency_count == 0) {
+		error = EINVAL;                 /* (nothing of what is asked for is a channel of this radio's) */
+	} else {
+		lck_mtx_lock(&apple80211_lock);
+		result_next = 0;
+		lck_mtx_unlock(&apple80211_lock);
+		error = hakios_sta_ask_scan(what);
+	}
+out:
+	if (asked != NULL) {
+		kfree_data(asked, sizeof(*asked));
+	}
+	if (what != NULL) {
+		kfree_data(what, sizeof(*what));
+	}
+	return error;
+}
+
+static int
+set_join(const struct apple80211req *request, char *said, size_t said_size)
+{
+	struct apple80211_assoc *asked;
+	struct hakios_sta_join *what;
+	int error;
+
+	if (request->req_len < offsetof(struct apple80211_assoc, rest)) {
+		return EINVAL;
+	}
+	asked = kalloc_data(sizeof(*asked), Z_WAITOK | Z_ZERO);
+	what = kalloc_data(sizeof(*what), Z_WAITOK | Z_ZERO);
+	if (asked == NULL || what == NULL || (error = copyin(request->req_data, asked, offsetof(struct apple80211_assoc, rest))) != 0) {
+		error = asked == NULL || what == NULL ? ENOMEM : error;
+		goto out;
+	}
+	/* (lengths and kinds only: the name, the access point and the key stay out of the log) */
+	snprintf(said, said_size, " (a join: a name of %u bytes, %s access point, authentication %#x/%#x, a key of %u bytes of kind %u)",
+	    asked->ssid_length, asked->bssid[0] | asked->bssid[1] | asked->bssid[2] | asked->bssid[3] | asked->bssid[4] |
+	    asked->bssid[5] ? "a given" : "any", asked->auth_lower, asked->auth_upper, asked->key_length, asked->key_cipher);
+	if (asked->ssid_length == 0 || asked->ssid_length > sizeof(what->ssid)) {
+		error = EINVAL;
+		goto out;
+	}
+	what->ssid_length = (uint8_t)asked->ssid_length;
+	memcpy(what->ssid, asked->ssid, asked->ssid_length);
+	memcpy(what->bssid, asked->bssid, sizeof(what->bssid));
+	if (asked->key_length == 0) {
+		what->security = HAKIOS_STA_OPEN;
+	} else if (asked->key_cipher == CIPHER_PASSPHRASE && asked->key_length >= 8 && asked->key_length <= 63) {
+		what->security = asked->auth_upper & AUTH_WPA3_SAE ? HAKIOS_STA_WPA3_SAE : HAKIOS_STA_WPA2_PSK;
+		what->passphrase_length = (uint8_t)asked->key_length;
+		memcpy(what->passphrase, asked->key, asked->key_length);
+	} else if (asked->key_cipher == CIPHER_PMK && asked->key_length == sizeof(what->pmk)) {
+		if (asked->auth_upper & AUTH_WPA3_SAE) { error = EINVAL; goto out; }
+		what->security = HAKIOS_STA_WPA2_PSK;
+		memcpy(what->pmk, asked->key, sizeof(what->pmk));
+	} else {
+		error = EINVAL;
+		goto out;
+	}
+	lck_mtx_lock(&apple80211_lock);
+	join_result = 0;
+	lck_mtx_unlock(&apple80211_lock);
+	error = hakios_sta_ask_join(what);
+out:
+	if (asked != NULL) {
+		memset_s(asked, sizeof(*asked), 0, sizeof(*asked));
+		kfree_data(asked, sizeof(*asked));
+	}
+	if (what != NULL) {
+		memset_s(what, sizeof(*what), 0, sizeof(*what));
+		kfree_data(what, sizeof(*what));
+	}
+	return error;
+}
+
+static int
+set(const struct apple80211req *request, char *said, size_t said_size)
+{
+	switch (request->req_type) {
+	case 20:
+		return set_join(request, said, said_size);
+	case 22:                                /* leave the network */
+		return hakios_sta_ask_leave();
+	case 19: {                              /* the radio's power */
+		struct {
+			uint32_t version, radios, state[4];
+		} asked;
+		int error;
+
+		if (request->req_len < sizeof(asked) || (error = copyin(request->req_data, &asked, sizeof(asked))) != 0) {
+			return request->req_len < sizeof(asked) ? EINVAL : error;
+		}
+		snprintf(said, said_size, " (power: %s)", asked.state[0] ? "on" : "off");
+		return hakios_sta_ask_power(asked.state[0] != 0);
+	}
+	case 10:
+		return set_scan(request, said, said_size);
+	case 383: {
+		/*
+		 * iOS 16 WPA3/SAE path: once the card advertises WPA3 (CARD_CAPABILITIES byte 9 bit 3), wifid
+		 * drives the join through req_type 383 instead of 20, and will not fall through to 20 while it
+		 * is refused -- so a WPA3 join spins. Its payload begins with the same apple80211_assoc the
+		 * ASSOCIATE (20) uses (SSID, auth, and the typed passphrase as CIPHER_PASSPHRASE); when it does,
+		 * join on it. Otherwise accept it as a no-op so wifid proceeds. (Lengths and kinds only in the
+		 * log; the name and key stay out.)
+		 */
+		struct apple80211_assoc *a;
+		int looks_like_join = 0;
+
+		/*
+		 * One-shot: dump the raw 383 blob so its real layout (where the SSID "." and the passphrase
+		 * live) can be read -- on WPA3 auto-join wifid drives the join through 383 only (never set 20),
+		 * and the apple80211_assoc parse below comes out garbage, so we never start SAE and it spins.
+		 */
+		{
+			static int dumped;
+			if (!dumped && request->req_len >= 8 && request->req_len <= 8192) {
+				uint32_t want = request->req_len < 512 ? request->req_len : 512;
+				uint8_t *blob = kalloc_data(request->req_len, Z_WAITOK | Z_ZERO);
+				int cerr = blob != NULL ? copyin(request->req_data, blob, request->req_len) : -1;
+
+				dumped = 1;
+				printf("apple80211: 383 dump: req_len=%u copyin=%d (first %u bytes below)\n", request->req_len, cerr, want);
+				for (uint32_t off = 0; blob != NULL && cerr == 0 && off < want; off += 32) {
+					char line[160]; int p = 0;
+					p += snprintf(line + p, sizeof(line) - p, "383@%4u:", off);
+					for (uint32_t i = off; i < off + 32 && i < want; i++) {
+						p += snprintf(line + p, sizeof(line) - p, "%02x", blob[i]);
+					}
+					p += snprintf(line + p, sizeof(line) - p, " |");
+					for (uint32_t i = off; i < off + 32 && i < want; i++) {
+						p += snprintf(line + p, sizeof(line) - p, "%c", blob[i] >= 0x20 && blob[i] < 0x7f ? blob[i] : '.');
+					}
+					printf("%s\n", line);
+				}
+				if (blob != NULL) {
+					kfree_data(blob, request->req_len);
+				}
+			}
+		}
+
+		if (request->req_len >= offsetof(struct apple80211_assoc, rest) &&
+		    (a = kalloc_data(sizeof(*a), Z_WAITOK | Z_ZERO)) != NULL) {
+			if (copyin(request->req_data, a, offsetof(struct apple80211_assoc, rest)) == 0) {
+				snprintf(said, said_size, " (383: %u bytes; as a join: a name of %u bytes, authentication %#x/%#x, "
+				    "a key of %u bytes of kind %u)", request->req_len, a->ssid_length, a->auth_lower, a->auth_upper,
+				    a->key_length, a->key_cipher);
+				looks_like_join = a->ssid_length >= 1 && a->ssid_length <= 32 &&
+				    a->key_cipher == CIPHER_PASSPHRASE && a->key_length >= 8 && a->key_length <= 63;
+			}
+			memset_s(a, sizeof(*a), 0, sizeof(*a));
+			kfree_data(a, sizeof(*a));
+		}
+		return looks_like_join ? set_join(request, said, said_size) : 0;
+	}
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+/* ---- events -------------------------------------------------------------------------------------------- */
+
+static void
+post(uint32_t code, const void *data, uint32_t length)
+{
+	struct kev_msg message = { .vendor_code = KEV_VENDOR_APPLE, .kev_class = KEV_IEEE80211_CLASS, .kev_subclass = 1,
+		                   .event_code = code };
+	char name[16];
+
+	memcpy(name, interface_name, sizeof(name));
+	message.dv[0].data_length = sizeof(name);
+	message.dv[0].data_ptr = name;
+	if (length != 0) {
+		message.dv[1].data_length = length;
+		message.dv[1].data_ptr = __DECONST(void *, data);
+	}
+	kev_post_msg(&message);
+}
+
+/* What the station side says has happened (bsd/dev/hakios.sta.c calls this, on its thread or the station's). */
+void
+hakios_apple80211_event(enum hakios_sta_event event, int status)
+{
+	static unsigned said;
+
+	if (said < 200) {
+		said++;
+		printf("apple80211: the station says: %s, %d\n", event == HAKIOS_STA_POWER ? "power" : event == HAKIOS_STA_SCAN_DONE ?
+		    "a scan is over" : event == HAKIOS_STA_JOIN_DONE ? "a join is over" : "the link", status);
+	}
+	switch (event) {
+	case HAKIOS_STA_POWER:
+		post(EVENT_POWER_CHANGED, NULL, 0);
+		break;
+	case HAKIOS_STA_SCAN_DONE:
+		lck_mtx_lock(&apple80211_lock);
+		result_next = 0;
+		lck_mtx_unlock(&apple80211_lock);
+		post(EVENT_SCAN_DONE, NULL, 0);
+		break;
+	case HAKIOS_STA_JOIN_DONE:
+		lck_mtx_lock(&apple80211_lock);
+		join_result = status == 0 ? 1 : status == EAUTH ? 21 : status == ETIMEDOUT ? 9 : 2;
+		lck_mtx_unlock(&apple80211_lock);
+		post(EVENT_ASSOC_DONE, NULL, 0);
+		break;
+	case HAKIOS_STA_LINK: {
+		struct apple80211_link_changed link = { .down = status != 1, .involuntary = status != 1 && status != 0,
+			                                .reason = status != 1 && status != 0 ? 4 : 0 };      /* (4: gone, not asked) */
+		struct hakios_sta_state *state = kalloc_data(sizeof(*state), Z_WAITOK | Z_ZERO);
+
+		if (state != NULL) {
+			hakios_sta_state(state);
+			link.rssi = status == 1 ? state->bss.rssi : 0;
+			kfree_data(state, sizeof(*state));
+		}
+		post(EVENT_SSID_CHANGED, NULL, 0);
+		post(EVENT_BSSID_CHANGED, NULL, 0);
+		post(EVENT_LINK_CHANGED, &link, sizeof(link));
+		break;
+	}
+	}
+}
+
+/* ---- the requests as they arrive --------------------------------------------------------------------- */
+
+/*
+ * How often each kind of request came and how it fared: said when the run ends, because the
+ * lines said along the way can be lost with the middle of a long log.
+ */
+static struct {
+	int32_t type;
+	bool set;
+	unsigned times, answered;
+	int last_error;
+} kinds[96];
+static unsigned kind_count;
+
+static void
+note(const struct apple80211req *request, bool is_set, int error)
+{
+	unsigned i;
+
+	lck_mtx_lock(&apple80211_lock);
+	for (i = 0; i < kind_count && !(kinds[i].type == request->req_type && kinds[i].set == is_set); i++) {
+	}
+	if (i < sizeof(kinds) / sizeof(kinds[0])) {
+		if (i == kind_count) {
+			kinds[kind_count++] = (typeof(kinds[0])) { .type = request->req_type, .set = is_set };
+		}
+		kinds[i].times++;
+		kinds[i].answered += error == 0;
+		kinds[i].last_error = error != 0 ? error : kinds[i].last_error;
+	}
+	lck_mtx_unlock(&apple80211_lock);
+}
+
+void
+hakios_apple80211_summary(void)
+{
+	static bool said;
+
+	if (said) {
+		return;
+	}
+	said = true;
+	for (unsigned i = 0; i < kind_count; i++) {
+		printf("apple80211: in this run: %s %d (%s) %u times, answered %u times%s", kinds[i].set ? "set" : "get", kinds[i].type,
+		    type_name(kinds[i].type), kinds[i].times, kinds[i].answered, kinds[i].last_error == 0 ? "\n" : "");
+		if (kinds[i].last_error != 0) {
+			printf("; the last refusal: %d%s\n", kinds[i].last_error, kinds[i].last_error == EOPNOTSUPP ? " (not built)" : "");
+		}
+	}
+}
+
+/* An Apple80211 request for the radio's interface, from the process that is running now. */
+errno_t
+hakios_apple80211_ioctl(u_long command, void *data)
+{
+	static unsigned said;
+	struct apple80211req *request = data;
+	char who[32] = "?", what[200] = "";
+	bool is_set = command == SIOCSA80211;
+	int error;
+
+	if (command != SIOCSA80211 && command != SIOCGA80211) {
+		return EOPNOTSUPP;
+	}
+	proc_selfname(who, sizeof(who));
+	error = is_set ? set(request, what, sizeof(what)) : get(request);
+	note(request, is_set, error);
+	/* (a request that is repeated for ever is said a few hundred times) */
+	if (said < 800) {
+		said++;
+		printf("apple80211: %s %s %d (%s), value %d, %u bytes%s: %s", who, is_set ? "sets" : "gets", request->req_type,
+		    type_name(request->req_type), request->req_val, request->req_len, what, error == 0 ? "answered\n" : error ==
+		    EOPNOTSUPP ? "REFUSED\n" : "");
+		if (error != 0 && error != EOPNOTSUPP) {
+			printf("error %d\n", error);
+		}
+	}
+	return error;
+}
diff --git a/bsd/dev/hakios.lx.c b/bsd/dev/hakios.lx.c
new file mode 100644
index 0000000..3381b68
--- /dev/null
+++ b/bsd/dev/hakios.lx.c
@@ -0,0 +1,589 @@
+/*
+ * Darwin-on-hakios: the kernel's side of the Wi-Fi driver's object.
+ *
+ * The driver of the phone's radio is Linux's ath11k, compiled unmodified outside this tree on a
+ * layer that gives it the kernel interfaces it expects, and tied into one object that the
+ * kernel links when it is there (tools/mk-ath11k.sh and wifi/lx in the repository; the kernel
+ * is built with that object when xnu-build.sh finds it). The object shows one name, lx_start(),
+ * and asks for the calls of sys/hakios.lx.h, which are here: memory, time, threads, one lock
+ * to sleep under, the kernel's options. What it asks of the radio itself -- its firmware's
+ * files, its view of memory, the processor its firmware runs on -- is hakios.wifi.c's to
+ * answer, which knows the phone.
+ *
+ * A kernel built without the object has the lx_start() at the end of this file, which says so.
+ */
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <kern/thread.h>
+#include <os/atomic_private.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+#include <sys/random.h>
+#include <sys/hakios.lx.h>
+#include <sys/hakios.net.h>
+#include <sys/sweet_wifi.h>
+#include <sys/systm.h>
+#include <vm/memory_types.h>
+#include <vm/vm_kern.h>
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+extern uint64_t kvtophys(vm_offset_t va);       /* pmap_paddr_t */
+extern kern_return_t thread_terminate(thread_t thread);
+extern void thread_set_thread_name(thread_t thread, const char *name);
+
+#define say hakios_wifi_say
+
+static LCK_GRP_DECLARE(lx_lock_group, "hakios-lx");
+static LCK_MTX_DECLARE(lx_lock, &lx_lock_group);
+
+/* ---- memory ------------------------------------------------------------------------------------------ */
+
+void *
+lx_os_alloc(unsigned long size)
+{
+	return kalloc_data(size, Z_WAITOK | Z_ZERO);
+}
+
+void
+lx_os_free(void *memory, unsigned long size)
+{
+	kfree_data(memory, size);
+}
+
+/*
+ * In one physical piece, so that it can be mapped a second time without this processor's cache
+ * in between (as hakios.adreno.c does with what it shares with the GPU); the first, cached
+ * view is written out and never used again.
+ */
+void *
+lx_os_radio_memory(unsigned long size, unsigned long long *address)
+{
+	vm_offset_t cached = 0, uncached;
+	uint64_t physical;
+
+	size = round_page(size);
+	if (kmem_alloc_contig(kernel_map, &cached, size, 0, 0, 0, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) !=
+	    KERN_SUCCESS) {
+		say("lx: no %lu bytes of memory in one piece\n", size);
+		return NULL;
+	}
+	physical = kvtophys(cached);
+	bzero((void *)cached, size);
+	for (vm_offset_t line = cached; line < cached + size; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy");
+	uncached = ml_io_map_unmappable(physical, size, VM_WIMG_WCOMB);
+	if (uncached == 0 || !hakios_wifi_radio_map(physical, size, address)) {
+		return NULL;
+	}
+	return (void *)uncached;
+}
+
+void *
+lx_os_map_registers(unsigned long long physical, unsigned long size)
+{
+	unsigned long long page = trunc_page(physical);
+	vm_offset_t mapped = ml_io_map_unmappable(page, round_page(physical + size) - page, VM_WIMG_IO);
+
+	return mapped == 0 ? NULL : (void *)(mapped + (physical - page));
+}
+
+/* ---- saying things ----------------------------------------------------------------------------------- */
+
+void
+lx_os_print(const char *text)
+{
+	say("%s", text);
+}
+
+void
+lx_os_tell(const char *text)
+{
+	hakios_wifi_tell("%s", text);
+}
+
+void
+lx_os_panic(const char *text)
+{
+	panic("%s", text);
+}
+
+/* ---- time, threads, sleeping --------------------------------------------------------------------------- */
+
+unsigned long long
+lx_os_nanoseconds(void)
+{
+	uint64_t nanoseconds;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &nanoseconds);
+	return nanoseconds;
+}
+
+void *
+lx_os_thread_self(void)
+{
+	return current_thread();
+}
+
+struct lx_thread {
+	void (*function)(void *);
+	void *argument;
+};
+
+static void
+lx_thread_runs(void *parameter, __unused wait_result_t result)
+{
+	struct lx_thread start = *(struct lx_thread *)parameter;
+
+	kfree_type(struct lx_thread, parameter);
+	start.function(start.argument);
+	thread_terminate(current_thread());
+}
+
+int
+lx_os_thread(const char *name, void (*function)(void *), void *argument)
+{
+	struct lx_thread *start = kalloc_type(struct lx_thread, Z_WAITOK | Z_ZERO);
+	thread_t thread;
+
+	if (start == NULL) {
+		return ENOMEM;
+	}
+	start->function = function;
+	start->argument = argument;
+	if (kernel_thread_start(lx_thread_runs, start, &thread) != KERN_SUCCESS) {
+		kfree_type(struct lx_thread, start);
+		return EAGAIN;
+	}
+	thread_set_thread_name(thread, name);
+	thread_deallocate(thread);
+	return 0;
+}
+
+void
+lx_os_lock(void)
+{
+	lck_mtx_lock(&lx_lock);
+}
+
+void
+lx_os_unlock(void)
+{
+	lck_mtx_unlock(&lx_lock);
+}
+
+int
+lx_os_sleep(const void *address, unsigned long long nanoseconds)
+{
+	uint64_t deadline;
+
+	if (nanoseconds == 0) {
+		return lck_mtx_sleep(&lx_lock, LCK_SLEEP_DEFAULT, (event_t)address, THREAD_UNINT) == THREAD_TIMED_OUT;
+	}
+	nanoseconds_to_absolutetime(nanoseconds, &deadline);
+	deadline += mach_absolute_time();
+	return lck_mtx_sleep_deadline(&lx_lock, LCK_SLEEP_DEFAULT, (event_t)address, THREAD_UNINT, deadline) == THREAD_TIMED_OUT;
+}
+
+void
+lx_os_wakeup(const void *address)
+{
+	thread_wakeup((event_t)address);
+}
+
+/* ---- the rest of the machine ------------------------------------------------------------------------- */
+
+void
+lx_os_random(void *buffer, unsigned long size)
+{
+	read_random(buffer, (u_int)size);
+}
+
+unsigned
+lx_os_option(const char *name)
+{
+	return hakios_wifi_option(name);
+}
+
+int
+lx_os_firmware(const char *name, const void **data, unsigned long *size)
+{
+	uint64_t length = 0;
+	const uint8_t *file = hakios_wifi_driver_file(name, &length);
+
+	if (file == NULL) {
+		return ENOENT;
+	}
+	*data = file;
+	*size = (unsigned long)length;
+	return 0;
+}
+
+int
+lx_os_rproc_boot(void)
+{
+	return hakios_wifi_dsp_is_up() ? 0 : ENXIO;
+}
+
+int lx_os_radio_powered(void) { return hakios_wifi_icnss_ready(); }
+
+int
+lx_os_radio_address(unsigned char *address)
+{
+	return hakios_wifi_radio_address(address);
+}
+
+int
+lx_os_network(unsigned char *name, unsigned *name_length, unsigned char *passphrase, unsigned *passphrase_length)
+{
+	return hakios_wifi_network(name, name_length, passphrase, passphrase_length);
+}
+
+/* ---- frames: the radio as the link behind en0 (sys/hakios.net.h) ------------------------------------ */
+
+/*
+ * A frame from the network stack comes on whatever thread sends it, and the driver's side keeps
+ * a record of every thread that enters it: so frames are put in a queue here, and one thread of
+ * ours takes them to the driver. A queue that is full drops what comes (TCP sends it again).
+ */
+#define LX_QUEUE        256
+
+struct lx_frame {
+	uint16_t length;
+	uint8_t bytes[HAKIOS_NET_FRAME_MAX];
+};
+
+static bool lx_link_attached;
+static LCK_MTX_DECLARE(lx_queue_lock, &lx_lock_group);
+static struct lx_frame *lx_queue;
+static uint32_t lx_queue_in, lx_queue_out;      /* frames put in and taken out, counted from the start */
+static uint64_t lx_queue_dropped;
+
+static void
+lx_queue_runs(__unused void *parameter, __unused wait_result_t result)
+{
+	for (;;) {
+		struct lx_frame *frame;
+
+		lck_mtx_lock(&lx_queue_lock);
+		while (lx_queue_in == lx_queue_out) {
+			lck_mtx_sleep(&lx_queue_lock, LCK_SLEEP_DEFAULT, (event_t)&lx_queue_in, THREAD_UNINT);
+		}
+		frame = &lx_queue[lx_queue_out % LX_QUEUE];     /* (stays ours until lx_queue_out moves) */
+		lck_mtx_unlock(&lx_queue_lock);
+		lx_transmit(frame->bytes, frame->length);
+		lck_mtx_lock(&lx_queue_lock);
+		lx_queue_out++;
+		lck_mtx_unlock(&lx_queue_lock);
+	}
+}
+
+static bool
+lx_link_transmit(mbuf_t packet, size_t length)
+{
+	struct lx_frame *frame;
+
+	lck_mtx_lock(&lx_queue_lock);
+	if (length > HAKIOS_NET_FRAME_MAX || lx_queue_in - lx_queue_out == LX_QUEUE) {
+		lx_queue_dropped++;
+		lck_mtx_unlock(&lx_queue_lock);
+		return false;
+	}
+	frame = &lx_queue[lx_queue_in % LX_QUEUE];
+	if (mbuf_copydata(packet, 0, length, frame->bytes) != 0) {
+		lck_mtx_unlock(&lx_queue_lock);
+		return false;
+	}
+	frame->length = (uint16_t)length;
+	lx_queue_in++;
+	lck_mtx_unlock(&lx_queue_lock);
+	thread_wakeup((event_t)&lx_queue_in);
+	return true;
+}
+
+static struct hakios_net_link lx_link = {
+	.name = "the phone's radio (ath11k)",
+	.wireless = true,
+	.transmit = lx_link_transmit,
+};
+
+void
+lx_os_net_attach(const unsigned char *address)
+{
+	thread_t thread;
+
+	if (lx_link_attached) {
+		return;
+	}
+	lx_queue = kalloc_data(LX_QUEUE * sizeof(*lx_queue), Z_WAITOK | Z_ZERO);
+	if (lx_queue == NULL || kernel_thread_start(lx_queue_runs, NULL, &thread) != KERN_SUCCESS) {
+		say("lx: no memory or no thread for the frames to send: the radio's frames go nowhere\n");
+		return;
+	}
+	thread_set_thread_name(thread, "wifi-send");
+	thread_deallocate(thread);
+	memcpy(lx_link.address, address, sizeof(lx_link.address));
+	lx_link_attached = hakios_net_attach(&lx_link);
+	say("lx: %s\n", lx_link_attached ? "the radio is the link behind en0" : "EN0 HAS A LINK ALREADY: the radio's frames go "
+	    "nowhere");
+}
+
+/*
+ * With wifi=1 the interface is made when the kernel starts, before the radio is up: iOS's Wi-Fi
+ * side looks for it and for its registry entry as soon as it runs, once, and a radio that
+ * turns up twelve seconds later is one it has already failed to open.
+ */
+void
+hakios_lx_net_early(void)
+{
+	uint8_t address[6];
+
+	if (hakios_wifi_radio_address(address)) {
+		lx_os_net_attach(address);
+	}
+}
+
+void
+lx_os_net_link(int up)
+{
+	if (lx_link_attached) {
+		hakios_net_link_state(up != 0);
+	}
+}
+
+void
+lx_os_net_input(const unsigned char *frame, unsigned long length)
+{
+	if (lx_link_attached && length <= HAKIOS_NET_FRAME_MAX) {
+		hakios_net_input(frame, length);
+	}
+}
+
+/* ---- the radio's interrupts ------------------------------------------------------------------------------- */
+
+/*
+ * davinci: the radio's 12 Copy Engine completions arrive as wired GIC SPIs (intid 446..457 =
+ * Linux DT GIC_SPI 414 + 32, edge-triggered). Apple's stock XNU has no interrupt-controller driver
+ * for device SPIs, so the sweet kernel grew a tiny SPI layer (pexpert/arm/pe_fiq.c: sweet_gic_spi_*)
+ * that configures one in the GIC distributor and runs a handler for each that fires. On arrival the
+ * vector is masked and the dispatch thread told; the thread runs ath10k's handler (which drains the
+ * CE ring) and host.c re-enables the vector. This replaced a 1 ms poll of the CE registers that
+ * wedged the whole bus whenever the radio slept (power-save) with its WLAN clocks gated -- a poll
+ * read then hit a dead domain. With real interrupts the radio is touched only when it is awake.
+ */
+extern kern_return_t sweet_gic_spi_attach(uint32_t intid, bool edge, void (*handler)(void *context, uint32_t intid), void *context);
+extern void          sweet_gic_spi_mask(uint32_t intid);
+extern void          sweet_gic_spi_unmask(uint32_t intid);
+extern void          sweet_gic_spi_detach(uint32_t intid);
+extern uint64_t      sweet_gic_spi_count(uint32_t intid);
+
+#define LX_VECTORS       32
+#define LX_CE_SPI_BASE   446u            /* GIC intid of CE vector 0 on davinci (WCN3990) */
+
+static struct {
+	void (*function)(void *);
+	void *argument;
+	bool attached;
+} lx_vector[LX_VECTORS];
+static uint32_t lx_irq_first = LX_CE_SPI_BASE;  /* the GIC's number of vector 0 */
+static uint32_t lx_irq_pending;                 /* vectors that have fired, not yet dealt with */
+static uint32_t lx_irq_running;                 /* the vectors whose function the thread is in */
+static thread_t lx_irq_thread;
+static LCK_MTX_DECLARE(lx_irq_lock, &lx_lock_group);
+
+/* interrupt context: mask the vector (it stays masked until its handler has run) and tell the thread. */
+static void
+lx_irq_arrived(__unused void *context, uint32_t intid)
+{
+	sweet_gic_spi_mask(intid);
+	os_atomic_or(&lx_irq_pending, 1u << (intid - lx_irq_first), relaxed);
+	thread_wakeup((event_t)&lx_irq_pending);
+}
+
+static void
+lx_irq_runs(__unused void *parameter, __unused wait_result_t result)
+{
+	for (;;) {
+		uint32_t pending;
+
+		for (;;) {
+			assert_wait((event_t)&lx_irq_pending, THREAD_UNINT);
+			if ((pending = os_atomic_xchg(&lx_irq_pending, 0, acquire)) != 0) {
+				clear_wait(current_thread(), THREAD_AWAKENED);
+				break;
+			}
+			thread_block(THREAD_CONTINUE_NULL);
+		}
+		for (unsigned v = 0; v < LX_VECTORS; v++) {
+			if (!(pending & 1u << v)) {
+				continue;
+			}
+			lck_mtx_lock(&lx_irq_lock);
+			if (!lx_vector[v].attached) {
+				lck_mtx_unlock(&lx_irq_lock);
+				continue;
+			}
+			lx_irq_running |= 1u << v;
+			lck_mtx_unlock(&lx_irq_lock);
+			lx_vector[v].function(lx_vector[v].argument);
+			lck_mtx_lock(&lx_irq_lock);
+			lx_irq_running &= ~(1u << v);
+			lck_mtx_unlock(&lx_irq_lock);
+			thread_wakeup((event_t)&lx_irq_running);
+		}
+	}
+}
+
+int
+lx_os_irq_msi(__unused unsigned long long *address, __unused unsigned *data)
+{
+	return 0;                               /* davinci CE interrupts are wired SPIs, not MSI */
+}
+
+int
+lx_os_irq_attach(unsigned vector, void (*function)(void *), void *argument)
+{
+	kern_return_t kr;
+
+	if (vector >= LX_VECTORS || function == NULL) {
+		return EINVAL;
+	}
+	if (lx_irq_thread == THREAD_NULL) {
+		hakios_wifi_tell("lx: wifi irq: the radio's CE vectors are real GIC SPIs from %u (edge, group 1, routed to this cpu)\n",
+		    lx_irq_first);
+		if (kernel_thread_start(lx_irq_runs, NULL, &lx_irq_thread) != KERN_SUCCESS) {
+			lx_irq_thread = THREAD_NULL;
+			return ENOMEM;
+		}
+		thread_set_thread_name(lx_irq_thread, "wifi-irq");
+	}
+	lck_mtx_lock(&lx_irq_lock);
+	lx_vector[vector].function = function;
+	lx_vector[vector].argument = argument;
+	lx_vector[vector].attached = true;
+	lck_mtx_unlock(&lx_irq_lock);
+	if ((kr = sweet_gic_spi_attach(lx_irq_first + vector, true, lx_irq_arrived, NULL)) != KERN_SUCCESS) {
+		lck_mtx_lock(&lx_irq_lock);
+		lx_vector[vector].attached = false;
+		lck_mtx_unlock(&lx_irq_lock);
+		return kr == KERN_NAME_EXISTS ? EBUSY : EINVAL;
+	}
+	sweet_gic_spi_mask(lx_irq_first + vector);      /* masked until the driver enables it */
+	return 0;
+}
+
+void
+lx_os_irq_enable(unsigned vector)
+{
+	if (vector < LX_VECTORS && lx_vector[vector].attached) {
+		sweet_gic_spi_unmask(lx_irq_first + vector);
+	}
+}
+
+void
+lx_os_irq_disable(unsigned vector)
+{
+	if (vector >= LX_VECTORS || !lx_vector[vector].attached) {
+		return;
+	}
+	sweet_gic_spi_mask(lx_irq_first + vector);
+	if (current_thread() == lx_irq_thread) {
+		return;                         /* from the vector's own function: nothing to wait for */
+	}
+	lck_mtx_lock(&lx_irq_lock);
+	while (lx_irq_running & 1u << vector) {
+		lck_mtx_sleep(&lx_irq_lock, LCK_SLEEP_DEFAULT, (event_t)&lx_irq_running, THREAD_UNINT);
+	}
+	lck_mtx_unlock(&lx_irq_lock);
+}
+
+void
+lx_os_irq_detach_all(void)
+{
+	for (unsigned v = 0; v < LX_VECTORS; v++) {
+		if (lx_vector[v].attached) {
+			sweet_gic_spi_detach(lx_irq_first + v);
+		}
+	}
+	lck_mtx_lock(&lx_irq_lock);
+	for (unsigned v = 0; v < LX_VECTORS; v++) {
+		lx_vector[v].attached = false;
+	}
+	while (lx_irq_running != 0 && current_thread() != lx_irq_thread) {
+		lck_mtx_sleep(&lx_irq_lock, LCK_SLEEP_DEFAULT, (event_t)&lx_irq_running, THREAD_UNINT);
+	}
+	lck_mtx_unlock(&lx_irq_lock);
+	os_atomic_store(&lx_irq_pending, 0, relaxed);
+}
+
+unsigned long long
+lx_os_irq_count(unsigned vector)
+{
+	return vector < LX_VECTORS ? sweet_gic_spi_count(lx_irq_first + vector) : 0;
+}
+
+/* ---- the station (sys/hakios.sta.h) --------------------------------------------------------------------- */
+
+void
+lx_os_station(const struct hakios_sta_ops *ops)
+{
+	hakios_sta_attach(ops);
+}
+
+void
+lx_os_station_lost(int error)
+{
+	hakios_sta_lost(error);
+}
+
+/* ---- the driver ---------------------------------------------------------------------------------------- */
+
+/* The object has its own; this is the one of a kernel built without it. */
+__attribute__((weak)) int
+lx_start(void)
+{
+	say("lx: THE DRIVER IS NOT BUILT IN: its object was not there when this kernel was built (tools/mk-ath11k.sh, then "
+	    "build the kernel again)\n");
+	return ENXIO;
+}
+
+__attribute__((weak)) void
+lx_stop(void)
+{
+}
+
+__attribute__((weak)) int
+lx_prepare(void)
+{
+	return 0;
+}
+
+__attribute__((weak)) int
+lx_transmit(__unused const unsigned char *frame, __unused unsigned long length)
+{
+	return ENXIO;
+}
+
+int
+hakios_lx_start(void)
+{
+	return lx_start();
+}
+
+void
+hakios_lx_stop(void)
+{
+	lx_stop();
+}
+
+int
+hakios_lx_prepare(void)
+{
+	return lx_prepare();
+}
diff --git a/bsd/dev/hakios.net.c b/bsd/dev/hakios.net.c
new file mode 100644
index 0000000..5714d38
--- /dev/null
+++ b/bsd/dev/hakios.net.c
@@ -0,0 +1,428 @@
+/*
+ * en0: a network interface that is Ethernet as far as the rest of the kernel and iOS can tell.
+ *
+ * iOS expects its interfaces from IONetworkingFamily, which this kernel does not have; the BSD
+ * half of the kernel does not need it. The interface is made with the kernel's own interface
+ * KPI, the way bsd/net/if_fake.c makes its "feth": family Ethernet, the stock Ethernet framing
+ * and demultiplexing, one function that is given a frame to send and one call to hand a frame
+ * that has arrived to the stack. What iOS's user space makes of an interface that has no
+ * IOKit object behind it is another matter: see userland/src/net_test.m.
+ *
+ * What carries the frames is a link driver's business; sys/hakios.net.h is all that the two
+ * know of each other. The first link is QEMU's virtio network device (hakios.virtio_net.c).
+ * There can be two interfaces: en0 for the Wi-Fi (or virtio), en1 for the modem's packets
+ * through the IPA (hakios.cell.c); each has its link, its state and its thread.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <net/bpf.h>
+#include <net/ethernet.h>
+#include <net/if.h>
+#include <net/if_ether.h>
+#include <net/if_media.h>
+#include <net/if_types.h>
+#include <net/kpi_interface.h>
+#include <netinet/in.h>
+#include <pexpert/pexpert.h>
+#include <sys/kern_event.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/proc.h>
+#include <sys/hakios.net.h>
+#include <sys/sockio.h>
+#include <sys/systm.h>
+
+extern void HakiosWLANStart(const char *interface, const uint8_t *address);  /* iokit/Kernel/hakios.wlan.cpp */
+
+static LCK_GRP_DECLARE(net_lck_grp, "hakios-net");
+
+/* One interface: enN on its link. */
+struct net_if {
+	unsigned        unit;
+	const struct hakios_net_link *link;
+	bool            up;             /* the link says frames can pass */
+	ifnet_t         ifp;
+	lck_mtx_t       tx_lock;        /* one frame at a time to the link */
+	/* What has gone through: said once a minute while anything moves. */
+	struct {
+		uint64_t sent, received, sent_bytes, received_bytes, dropped_out, dropped_in;
+	} count;
+};
+static struct net_if net_ifs[HAKIOS_NET_UNITS];
+
+static inline struct net_if *
+net_if_of(ifnet_t ifp)
+{
+	return ifnet_softc(ifp);
+}
+
+/* The interface on unit `unit`, once attached; NULL before. */
+static struct net_if *
+net_if_unit(unsigned unit)
+{
+	return unit < HAKIOS_NET_UNITS && net_ifs[unit].ifp != NULL ? &net_ifs[unit] : NULL;
+}
+
+/*
+ * Boot-arg net_trace=N: a line in the log for each of the first N frames, either way.
+ * Boot-arg net_names=1: a line for every name asked of a DNS server and for every TCP connection
+ * begun from here -- which is how to see what a system that has just been given a network does
+ * with it (up to NAMES_MAX lines).
+ */
+#define NAMES_MAX       3000
+static uint32_t net_trace, net_names;
+
+static void
+trace_frame(const char *way, const uint8_t *frame, size_t length, size_t whole)
+{
+	static uint32_t said, names;
+	const uint8_t *end = frame + length, *ip = frame + ETHER_HDR_LEN, *l4;
+	uint16_t type;
+	bool ports;
+
+	if (length < ETHER_HDR_LEN + 28 || (said >= net_trace && (!net_names || names >= NAMES_MAX))) {
+		return;
+	}
+	type = (uint16_t)(frame[12] << 8 | frame[13]);
+	l4 = ip + 4 * (ip[0] & 0xf);
+	ports = type == ETHERTYPE_IP && (ip[9] == IPPROTO_TCP || ip[9] == IPPROTO_UDP) && l4 + 4 <= end;
+	if (net_names && names < NAMES_MAX && ports && way[0] == 'o') {
+		if (ip[9] == IPPROTO_UDP && (l4[2] << 8 | l4[3]) == 53 && l4 + 8 + 12 < end) {
+			char name[128];
+			const uint8_t *label = l4 + 8 + 12;
+			size_t n = 0;
+
+			/* the question: lengths and labels, up to a zero */
+			while (label < end && *label != 0 && *label < 64 && label + 1 + *label < end && n + *label + 2 < sizeof(name)) {
+				memcpy(name + n, label + 1, *label);
+				n += *label;
+				name[n++] = '.';
+				label += 1 + *label;
+			}
+			name[n ? n - 1 : 0] = 0;
+			names++;
+			printf("net: asks for the name %s (type %u)\n", name, label + 2 < end ? label[1] << 8 | label[2] : 0);
+		} else if (ip[9] == IPPROTO_TCP && l4 + 14 <= end && (l4[13] & 0x12) == 0x02) {
+			names++;
+			printf("net: connects to %u.%u.%u.%u port %u\n", ip[16], ip[17], ip[18], ip[19], l4[2] << 8 | l4[3]);
+		}
+	}
+	if (said >= net_trace) {
+		return;
+	}
+	said++;
+	if (type == ETHERTYPE_IP) {
+		printf("net: %s %zu bytes: IPv4 %s %u.%u.%u.%u:%u -> %u.%u.%u.%u:%u%s\n", way, whole, ip[9] == IPPROTO_TCP ? "TCP" :
+		    ip[9] == IPPROTO_UDP ? "UDP" : ip[9] == IPPROTO_ICMP ? "ICMP" : "protocol?", ip[12], ip[13], ip[14], ip[15],
+		    ports ? l4[0] << 8 | l4[1] : 0, ip[16], ip[17], ip[18], ip[19], ports ? l4[2] << 8 | l4[3] : 0,
+		    ip[9] == IPPROTO_TCP && ports && l4 + 14 <= end ? (l4[13] & 2 ? " SYN" : l4[13] & 1 ? " FIN" : l4[13] & 4 ? " RST" : "") : "");
+	} else {
+		printf("net: %s %zu bytes: %s (type %#x) to %02x:%02x:%02x:%02x:%02x:%02x\n", way, whole, type == ETHERTYPE_ARP ? "ARP" :
+		    type == ETHERTYPE_IPV6 ? "IPv6" : "?", type, frame[0], frame[1], frame[2], frame[3], frame[4], frame[5]);
+	}
+}
+
+/* ... of a frame on its way out: the start of it is enough */
+static void
+trace_packet(mbuf_t packet, size_t length)
+{
+	uint8_t start[192];
+	size_t have = length < sizeof(start) ? length : sizeof(start);
+
+	if ((net_trace || net_names) && mbuf_copydata(packet, 0, have, start) == 0) {
+		trace_frame("out", start, have, length);
+	}
+}
+
+/* ---- the interface -------------------------------------------------------------------------------- */
+
+/* The stack has a frame to send (a chain of mbufs that starts with the Ethernet header). */
+static errno_t
+net_output(ifnet_t ifp, mbuf_t packet)
+{
+	struct net_if *n = net_if_of(ifp);
+	size_t length = mbuf_pkthdr_len(packet);
+	bool sent = false;
+
+	if (length <= HAKIOS_NET_FRAME_MAX && n->up) {
+		bpf_tap_out(ifp, DLT_EN10MB, packet, NULL, 0);
+		trace_packet(packet, length);
+		lck_mtx_lock(&n->tx_lock);
+		sent = n->link->transmit(packet, length);
+		lck_mtx_unlock(&n->tx_lock);
+	}
+	if (sent) {
+		n->count.sent++;
+		n->count.sent_bytes += length;
+		ifnet_stat_increment_out(ifp, 1, (uint32_t)length, 0);
+	} else {
+		n->count.dropped_out++;
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+	}
+	mbuf_freem(packet);
+	return 0;
+}
+
+/* A frame has arrived on unit `unit`. */
+void
+hakios_net_input_unit(unsigned unit, const uint8_t *frame, size_t length)
+{
+	struct net_if *n = net_if_unit(unit);
+	struct ifnet_stat_increment_param stats = { .packets_in = 1, .bytes_in = (uint32_t)length };
+	unsigned int chunks = 1;
+	mbuf_t packet = NULL;
+	char *header;
+
+	if (n == NULL) {
+		return;
+	}
+	trace_frame("in ", frame, length, length);
+	if (length < ETHER_HDR_LEN || length > HAKIOS_NET_FRAME_MAX || mbuf_allocpacket(MBUF_DONTWAIT, length, &chunks, &packet) != 0) {
+		n->count.dropped_in++;
+		return;
+	}
+	if (mbuf_copyback(packet, 0, length, frame, MBUF_DONTWAIT) != 0) {
+		mbuf_freem(packet);
+		n->count.dropped_in++;
+		return;
+	}
+	/* as every Ethernet driver hands a frame up: the header noted and stepped over */
+	header = mbuf_data(packet);
+	mbuf_pkthdr_setrcvif(packet, n->ifp);
+	mbuf_pkthdr_setheader(packet, header);
+	mbuf_pkthdr_adjustlen(packet, -ETHER_HDR_LEN);
+	mbuf_setdata(packet, header + ETHER_HDR_LEN, length - ETHER_HDR_LEN);
+	bpf_tap_in(n->ifp, DLT_EN10MB, packet, header, ETHER_HDR_LEN);
+	n->count.received++;
+	n->count.received_bytes += length;
+	ifnet_input(n->ifp, packet, &stats);
+}
+
+void
+hakios_net_input(const uint8_t *frame, size_t length)
+{
+	hakios_net_input_unit(0, frame, length);
+}
+
+static unsigned net_ioctls_said;
+
+static errno_t
+net_ioctl(ifnet_t ifp, u_long command, void *data)
+{
+	struct net_if *n = net_if_of(ifp);
+	/* (a radio says it is one here too: IO80211.framework lists the interfaces whose media is 802.11) */
+	const int media[] = { (n->link->wireless ? IFM_IEEE80211 : IFM_ETHER) | IFM_AUTO };
+	struct ifreq *request = data;
+	struct ifmediareq *media_request = data;
+	user_addr_t list;
+	errno_t error = 0;
+
+	if (n->link->wireless && net_ioctls_said < 80) {
+		char who[32] = "?";
+
+		/* (while iOS's Wi-Fi side is being got to talk to this: who asks the interface what) */
+		proc_selfname(who, sizeof(who));
+		if (strcmp(who, "configd") != 0) {
+			net_ioctls_said++;
+			printf("net: en0 is asked %#lx by %s\n", command, who);
+		}
+	}
+	switch (command) {
+	case SIOCSIFADDR:
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		break;
+	case SIOCSIFFLAGS:
+		/* running whenever it is up: the link is there or it is not, nothing is switched on */
+		ifnet_set_flags(ifp, (ifnet_flags(ifp) & IFF_UP) ? IFF_RUNNING : 0, IFF_RUNNING);
+		break;
+	case SIOCGIFMEDIA32:
+	case SIOCGIFMEDIA64:
+		/* what configd asks to learn whether the cable is in */
+		list = command == SIOCGIFMEDIA64 ? ((struct ifmediareq64 *)media_request)->ifmu_ulist :
+		    CAST_USER_ADDR_T(((struct ifmediareq32 *)media_request)->ifmu_ulist);
+		media_request->ifm_active = media_request->ifm_current = media[0];
+		media_request->ifm_mask = 0;
+		media_request->ifm_status = IFM_AVALID | (n->up ? IFM_ACTIVE : 0);
+		if (list != USER_ADDR_NULL && media_request->ifm_count > 0) {
+			error = copyout(media, list, sizeof(media));
+		}
+		media_request->ifm_count = 1;
+		break;
+	case SIOCGIFDEVMTU:
+		request->ifr_devmtu.ifdm_current = ifnet_mtu(ifp);
+		request->ifr_devmtu.ifdm_max = ETHERMTU;
+		request->ifr_devmtu.ifdm_min = IF_MINMTU;
+		break;
+	case SIOCSIFMTU:
+		error = request->ifr_mtu > ETHERMTU || request->ifr_mtu < IF_MINMTU ? EINVAL : ifnet_set_mtu(ifp, request->ifr_mtu);
+		break;
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		break;                          /* the link hands us everything anyway */
+	default:
+		/* what iOS's Wi-Fi side asks of a radio's interface: bsd/dev/hakios.apple80211.c */
+		error = n->link->wireless ? hakios_apple80211_ioctl(command, data) : EOPNOTSUPP;
+		break;
+	}
+	return error;
+}
+
+/* Tell whoever listens for kernel events (configd does) that the link is up, or down. */
+static void
+net_link_event(ifnet_t ifp, uint32_t code)
+{
+	_Alignas(struct kern_event_msg) char message[sizeof(struct kern_event_msg) + sizeof(struct net_event_data)] = { 0 };
+	struct kern_event_msg *header = (struct kern_event_msg *)message;
+	struct net_event_data *about = (struct net_event_data *)(header + 1);
+
+	header->total_size = sizeof(message);
+	header->vendor_code = KEV_VENDOR_APPLE;
+	header->kev_class = KEV_NETWORK_CLASS;
+	header->kev_subclass = KEV_DL_SUBCLASS;
+	header->event_code = code;
+	about->if_family = ifnet_family(ifp);
+	about->if_unit = ifnet_unit(ifp);
+	strlcpy(about->if_name, ifnet_name(ifp), IFNAMSIZ);
+	ifnet_event(ifp, header);
+}
+
+void
+hakios_net_link_state_unit(unsigned unit, bool up)
+{
+	struct net_if *n = net_if_unit(unit);
+
+	if (n == NULL || up == n->up) {
+		return;
+	}
+	n->up = up;
+	printf("net: en%u's link (%s) is %s\n", n->unit, n->link->name, up ? "up" : "down");
+	net_link_event(n->ifp, up ? KEV_DL_LINK_ON : KEV_DL_LINK_OFF);
+}
+
+void
+hakios_net_link_state(bool up)
+{
+	hakios_net_link_state_unit(0, up);
+}
+
+/* The interface's own thread: for a link that wants to be asked, and for the minute's line in the log. */
+static void
+net_thread(void *parameter, __unused wait_result_t result)
+{
+	struct net_if *n = parameter;
+	uint64_t said = 0, total;
+	unsigned quiet = 0;
+
+	for (unsigned tick = 1;; tick++) {
+		quiet = n->link->poll != NULL && n->link->poll() ? 0 : quiet + 1;
+		/* about once a minute, if anything has moved since */
+		total = n->count.sent + n->count.received + n->count.dropped_out + n->count.dropped_in;
+		if (tick % 8192 == 0 && total != said) {
+			said = total;
+			printf("net: en%u so far %llu frames sent (%llu bytes), %llu received (%llu bytes); dropped: %llu out, %llu in\n",
+			    n->unit, n->count.sent, n->count.sent_bytes, n->count.received, n->count.received_bytes,
+			    n->count.dropped_out, n->count.dropped_in);
+		}
+		delay_for_interval(quiet < 100 ? 2 : 10, NSEC_PER_MSEC);
+	}
+}
+
+bool
+hakios_net_attach(const struct hakios_net_link *link)
+{
+	unsigned unit = link->unit;
+	struct net_if *n = unit < HAKIOS_NET_UNITS ? &net_ifs[unit] : NULL;
+	char uniqueid[16];
+	struct ifnet_init_eparams init = {
+		.ver = IFNET_INIT_CURRENT_VERSION,
+		.len = sizeof(init),
+		/*
+		 * The simple model: every frame straight to net_output(). And no Skywalk "nexus" made for
+		 * the interface by itself: sockets are all that is asked of it so far.
+		 */
+		.flags = IFNET_INIT_LEGACY | IFNET_INIT_NX_NOAUTO,
+		.uniqueid = uniqueid,
+		.uniqueid_len = 11,
+		.name = "en",
+		.unit = unit,
+		.softc = n,
+		.family = IFNET_FAMILY_ETHERNET,
+		.subfamily = link->wireless ? IFNET_SUBFAMILY_WIFI : IFNET_SUBFAMILY_ANY,
+		.type = IFT_ETHER,
+		.output = net_output,
+		.demux = ether_demux,
+		.add_proto = ether_add_proto,
+		.del_proto = ether_del_proto,
+		.check_multi = ether_check_multi,
+		.framer_extended = ether_frameout_extended,
+		.ioctl = net_ioctl,
+		.broadcast_addr = etherbroadcastaddr,
+		.broadcast_len = ETHER_ADDR_LEN,
+	};
+	const uint8_t *address = link->address;
+	ifnet_t ifp = NULL;
+	thread_t thread;
+	errno_t error;
+
+	if (n == NULL) {
+		printf("net: there is no unit %u for %s\n", unit, link->name);
+		return false;
+	}
+	if (n->link != NULL) {
+		printf("net: en%u is on %s already; %s is not attached\n", unit, n->link->name, link->name);
+		return false;
+	}
+	snprintf(uniqueid, sizeof(uniqueid), "hakios-en%u", unit);
+	n->unit = unit;
+	n->link = link;
+	n->up = link->up;
+	lck_mtx_init(&n->tx_lock, &net_lck_grp, LCK_ATTR_NULL);
+	error = ifnet_allocate_extended(&init, &ifp);
+	if (error != 0) {
+		printf("net: the interface en%u cannot be made: error %d\n", unit, error);
+		n->link = NULL;
+		return false;
+	}
+	ifnet_set_capabilities_enabled(ifp, 0, -1);
+	ifnet_set_addrlen(ifp, ETHER_ADDR_LEN);
+	ifnet_set_baudrate(ifp, 100 * 1000 * 1000);
+	ifnet_set_mtu(ifp, ETHERMTU);
+	ifnet_set_flags(ifp, IFF_BROADCAST | IFF_MULTICAST | IFF_SIMPLEX, 0xffff);
+	ifnet_set_hdrlen(ifp, ETHER_HDR_LEN);
+	ifnet_set_offload(ifp, 0);
+	error = ifnet_attach(ifp, NULL);
+	if (error != 0) {
+		printf("net: the interface en%u cannot be attached: error %d\n", unit, error);
+		ifnet_release(ifp);
+		n->link = NULL;
+		return false;
+	}
+	ifnet_set_lladdr(ifp, address, ETHER_ADDR_LEN);
+	bpfattach(ifp, DLT_EN10MB, ETHER_HDR_LEN);
+	n->ifp = ifp;
+	if (n->up) {
+		net_link_event(ifp, KEV_DL_LINK_ON);
+	}
+	if (link->wireless) {
+		/* (a radio's address is the phone's own: not for the log; and iOS's Wi-Fi side finds the interface by a service) */
+		printf("net: en%u attached on %s (a radio), link %s\n", unit, link->name, n->up ? "up" : "down");
+		HakiosWLANStart(uniqueid + 7, address);
+	} else {
+		printf("net: en%u attached on %s, address %02x:%02x:%02x:%02x:%02x:%02x, link %s\n", unit, link->name, address[0],
+		    address[1], address[2], address[3], address[4], address[5], n->up ? "up" : "down");
+	}
+	if (kernel_thread_start(net_thread, n, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	return true;
+}
+
+void
+hakios_net_init(void)
+{
+	PE_parse_boot_argn("net_trace", &net_trace, sizeof(net_trace));
+	PE_parse_boot_argn("net_names", &net_names, sizeof(net_names));
+	hakios_virtio_net_init();
+}
diff --git a/bsd/dev/hakios.qmi.c b/bsd/dev/hakios.qmi.c
new file mode 100644
index 0000000..7dd70dc
--- /dev/null
+++ b/bsd/dev/hakios.qmi.c
@@ -0,0 +1,963 @@
+/*
+ * QMI: the helpers of sys/hakios.qmi.h -- messages coded by tables, a handle on the IPC router,
+ * requests as transactions, indications to handlers.
+ *
+ * The interface is that of Linux's QMI helpers, because the driver that uses it (ath11k's qmi.c)
+ * was written for them and is compiled as it is. The code is not Linux's: it is written from the
+ * interface's meaning and from the public descriptions of the wire format (a 7-byte header, then
+ * type-length-value triples; see below at "the coding").
+ *
+ * Where it deliberately does not behave as Linux's does, each of them for a message that is not
+ * well formed (a message Linux decodes right is decoded the same here):
+ *   - a TLV is taken to be as long as it says: what its element does not use is skipped, and an
+ *     element that needs more than its TLV has is an error. (Linux reads on past the TLV.)
+ *   - a TLV of a type the table does not have is skipped, whatever its type. (Linux refuses the
+ *     message if the type is below 0x10.)
+ *   - a string that would fill its C buffer to the last byte is an error: the buffer is elem_len
+ *     bytes and ends with a zero. (Linux writes the zero one byte past it.)
+ *
+ * The same file is compiled into the kernel and, for its tests, on the machine that builds it
+ * (tools/qmi-test): the few things it needs from an operating system are in the first section.
+ */
+#include <sys/hakios.qmi.h>
+#include <sys/hakios.qrtr.h>
+
+/* ---- what is needed of the operating system ---------------------------------------------------- */
+
+#ifdef KERNEL
+
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <string.h>
+#include <sys/errno.h>
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/time.h>
+
+static LCK_GRP_DECLARE(qmi_lck_grp, "hakios-qmi");
+
+struct os_lock {
+	lck_mtx_t mutex;
+};
+
+static void *
+os_alloc(size_t size)
+{
+	return kalloc_data(size, Z_WAITOK | Z_ZERO);
+}
+
+static void
+os_free(void *memory, size_t size)
+{
+	kfree_data(memory, size);
+}
+
+static void
+os_lock_init(struct os_lock *l)
+{
+	lck_mtx_init(&l->mutex, &qmi_lck_grp, LCK_ATTR_NULL);
+}
+
+static void
+os_lock_destroy(struct os_lock *l)
+{
+	lck_mtx_destroy(&l->mutex, &qmi_lck_grp);
+}
+
+static void
+os_lock(struct os_lock *l)
+{
+	lck_mtx_lock(&l->mutex);
+}
+
+static void
+os_unlock(struct os_lock *l)
+{
+	lck_mtx_unlock(&l->mutex);
+}
+
+static uint64_t
+os_now_ms(void)
+{
+	uint64_t now, ns;
+
+	clock_get_uptime(&now);
+	absolutetime_to_nanoseconds(now, &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+/* With the lock held: sleep until os_wake(what) or for that long. */
+static void
+os_wait(struct os_lock *l, void *what, uint64_t ms)
+{
+	struct timespec ts = { .tv_sec = (time_t)(ms / 1000), .tv_nsec = (long)(ms % 1000) * NSEC_PER_MSEC };
+
+	msleep(what, &l->mutex, PZERO, "hakios-qmi", &ts);
+}
+
+static void
+os_wake(__unused struct os_lock *l, void *what)
+{
+	wakeup(what);
+}
+
+#define os_log(...)     printf(__VA_ARGS__)
+
+#else /* a program on the machine that builds this: the tests */
+
+#include <errno.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+struct os_lock {
+	pthread_mutex_t mutex;
+	pthread_cond_t woken;
+};
+
+static void *
+os_alloc(size_t size)
+{
+	return calloc(1, size ? size : 1);
+}
+
+static void
+os_free(void *memory, size_t size)
+{
+	(void)size;
+	free(memory);
+}
+
+static void
+os_lock_init(struct os_lock *l)
+{
+	pthread_mutex_init(&l->mutex, NULL);
+	pthread_cond_init(&l->woken, NULL);
+}
+
+static void
+os_lock_destroy(struct os_lock *l)
+{
+	pthread_mutex_destroy(&l->mutex);
+	pthread_cond_destroy(&l->woken);
+}
+
+static void
+os_lock(struct os_lock *l)
+{
+	pthread_mutex_lock(&l->mutex);
+}
+
+static void
+os_unlock(struct os_lock *l)
+{
+	pthread_mutex_unlock(&l->mutex);
+}
+
+static uint64_t
+os_now_ms(void)
+{
+	struct timespec ts;
+
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint64_t)ts.tv_sec * 1000 + (uint64_t)ts.tv_nsec / 1000000;
+}
+
+static void
+os_wait(struct os_lock *l, void *what, uint64_t ms)
+{
+	struct timespec until;
+
+	(void)what;                     /* one condition for all: whoever is woken looks again */
+	clock_gettime(CLOCK_REALTIME, &until);
+	until.tv_sec += (time_t)(ms / 1000);
+	until.tv_nsec += (long)(ms % 1000) * 1000000;
+	if (until.tv_nsec >= 1000000000) {
+		until.tv_sec++;
+		until.tv_nsec -= 1000000000;
+	}
+	pthread_cond_timedwait(&l->woken, &l->mutex, &until);
+}
+
+static void
+os_wake(struct os_lock *l, void *what)
+{
+	(void)what;
+	pthread_cond_broadcast(&l->woken);
+}
+
+#define os_log(...)     fprintf(stderr, __VA_ARGS__)
+
+#endif
+
+/* ---- the coding -------------------------------------------------------------------------------- */
+
+/*
+ * A message: the header, then TLVs -- type (1 byte), length (2), value -- in any order. Numbers
+ * are little-endian. A table describes the C structure a message is coded from or into, top
+ * level element by element; elements of one TLV follow each other and share its type:
+ *
+ *   [QMI_OPT_FLAG]   a byte in C that says whether the TLV is in the message at all
+ *   [QMI_DATA_LEN]   the count of the array that follows. In C it is always a 32-bit number,
+ *                    whatever the element's elem_size says (the tables are made by a tool that
+ *                    writes "uint32_t x_len" for every count, and Linux reads and writes four
+ *                    bytes there); elem_size is its size in the message: 1 byte if it is 1, else 2
+ *   the value        numbers of 1, 2, 4 or 8 bytes; a string (at the top level just its
+ *                    characters: the TLV's length is the string's); a structure, which is its
+ *                    own elements one after the other with nothing in between; or an array of
+ *                    any of these
+ *
+ * Inside a structure there are no TLVs and nothing is optional: a count if the element is a
+ * variable array, a length before a string (1 byte if the string's C buffer is at most 255
+ * bytes, else 2), then the values.
+ */
+#define TLV_HEADER      3
+
+struct writer {
+	uint8_t *at, *end;
+};
+
+struct reader {
+	const uint8_t *at, *end;
+};
+
+static bool
+put(struct writer *w, const void *bytes, size_t count)
+{
+	if ((size_t)(w->end - w->at) < count) {
+		return false;
+	}
+	memcpy(w->at, bytes, count);
+	w->at += count;
+	return true;
+}
+
+static bool
+put_number(struct writer *w, uint64_t value, unsigned size)
+{
+	uint8_t bytes[8];
+
+	for (unsigned i = 0; i < size; i++) {
+		bytes[i] = (uint8_t)(value >> (8 * i));
+	}
+	return put(w, bytes, size);
+}
+
+static bool
+get_number(struct reader *r, uint64_t *value, unsigned size)
+{
+	if ((size_t)(r->end - r->at) < size) {
+		return false;
+	}
+	*value = 0;
+	for (unsigned i = 0; i < size; i++) {
+		*value |= (uint64_t)r->at[i] << (8 * i);
+	}
+	r->at += size;
+	return true;
+}
+
+/* A number of the C structure, of 1, 2, 4 or 8 bytes, as the machine keeps it. */
+static uint64_t
+load(const void *from, unsigned size)
+{
+	uint8_t v8;
+	uint16_t v16;
+	uint32_t v32;
+	uint64_t v64;
+
+	switch (size) {
+	case 1: memcpy(&v8, from, 1); return v8;
+	case 2: memcpy(&v16, from, 2); return v16;
+	case 4: memcpy(&v32, from, 4); return v32;
+	default: memcpy(&v64, from, 8); return v64;
+	}
+}
+
+static void
+store(void *to, uint64_t value, unsigned size)
+{
+	uint8_t v8 = (uint8_t)value;
+	uint16_t v16 = (uint16_t)value;
+	uint32_t v32 = (uint32_t)value;
+
+	switch (size) {
+	case 1: memcpy(to, &v8, 1); break;
+	case 2: memcpy(to, &v16, 2); break;
+	case 4: memcpy(to, &v32, 4); break;
+	default: memcpy(to, &value, 8); break;
+	}
+}
+
+static bool
+is_number(const struct qmi_elem_info *e)
+{
+	return e->data_type >= QMI_UNSIGNED_1_BYTE && e->data_type <= QMI_SIGNED_4_BYTE_ENUM &&
+	       (e->elem_size == 1 || e->elem_size == 2 || e->elem_size == 4 || e->elem_size == 8);
+}
+
+static unsigned
+count_size(const struct qmi_elem_info *count)
+{
+	return count->elem_size == 1 ? 1 : 2;
+}
+
+static int encode_structure(struct writer *w, const struct qmi_elem_info *ei, const uint8_t *structure);
+
+/* `count` entries of one element. */
+static int
+encode_value(struct writer *w, const struct qmi_elem_info *e, const uint8_t *from, uint32_t count, bool top)
+{
+	if (is_number(e)) {
+		for (uint32_t i = 0; i < count; i++) {
+			if (!put_number(w, load(from + (size_t)i * e->elem_size, e->elem_size), e->elem_size)) {
+				return -EMSGSIZE;
+			}
+		}
+		return 0;
+	}
+	if (e->data_type == QMI_STRUCT && e->ei_array != NULL) {
+		for (uint32_t i = 0; i < count; i++) {
+			int error = encode_structure(w, e->ei_array, from + (size_t)i * e->elem_size);
+
+			if (error) {
+				return error;
+			}
+		}
+		return 0;
+	}
+	if (e->data_type == QMI_STRING && count == 1) {
+		size_t length = strnlen((const char *)from, e->elem_len);
+
+		if (length >= e->elem_len) {
+			return -EINVAL;                 /* no zero in the buffer */
+		}
+		if (!top && !put_number(w, length, e->elem_len <= 255 ? 1 : 2)) {
+			return -EMSGSIZE;
+		}
+		return put(w, from, length) ? 0 : -EMSGSIZE;
+	}
+	return -EINVAL;
+}
+
+/*
+ * The count and the entries of the element at *e (a QMI_DATA_LEN first, if the element is a variable
+ * array); leaves *e at the last element used.
+ */
+static int
+encode_counted(struct writer *w, const struct qmi_elem_info **e, const uint8_t *structure, bool top)
+{
+	uint32_t count = 1;
+
+	if ((*e)->data_type == QMI_DATA_LEN) {
+		const struct qmi_elem_info *length = (*e)++;
+
+		count = (uint32_t)load(structure + length->offset, sizeof(uint32_t));
+		if ((*e)->array_type != VAR_LEN_ARRAY || count > (*e)->elem_len || (count_size(length) == 1 && count > 255)) {
+			return -EINVAL;
+		}
+		if (!put_number(w, count, count_size(length))) {
+			return -EMSGSIZE;
+		}
+	} else if ((*e)->array_type == STATIC_ARRAY) {
+		count = (*e)->elem_len;
+	} else if ((*e)->array_type != NO_ARRAY) {
+		return -EINVAL;                         /* a variable array nothing counts */
+	}
+	return encode_value(w, *e, structure + (*e)->offset, count, top);
+}
+
+static int
+encode_structure(struct writer *w, const struct qmi_elem_info *ei, const uint8_t *structure)
+{
+	for (const struct qmi_elem_info *e = ei; e->data_type != QMI_EOTI; e++) {
+		int error = e->data_type == QMI_OPT_FLAG ? -EINVAL : encode_counted(w, &e, structure, false);
+
+		if (error) {
+			return error;
+		}
+	}
+	return 0;
+}
+
+int
+hakios_qmi_encode(uint8_t type, uint16_t message, uint16_t transaction, const struct qmi_elem_info *ei, const void *structure,
+    void *buffer, size_t size)
+{
+	struct writer w = { .at = buffer, .end = (uint8_t *)buffer + size };
+	uint8_t *start = buffer, *tlv;
+	const struct qmi_elem_info *e;
+
+	if (size < QMI_HEADER_SIZE) {
+		return -EMSGSIZE;
+	}
+	w.at += QMI_HEADER_SIZE;
+	for (e = structure != NULL ? ei : NULL; e != NULL && e->data_type != QMI_EOTI; e++) {
+		uint8_t tlv_type = e->tlv_type;
+		int error;
+
+		if (e->data_type == QMI_OPT_FLAG) {
+			if (!load((const uint8_t *)structure + e->offset, 1)) {
+				/* not there: on to the next element of another TLV */
+				while (e[1].data_type != QMI_EOTI && e[1].tlv_type == tlv_type) {
+					e++;
+				}
+				continue;
+			}
+			e++;
+			if (e->data_type == QMI_EOTI || e->tlv_type != tlv_type) {
+				return -EINVAL;
+			}
+		}
+		tlv = w.at;
+		if ((size_t)(w.end - w.at) < TLV_HEADER) {
+			return -EMSGSIZE;
+		}
+		w.at += TLV_HEADER;
+		error = encode_counted(&w, &e, structure, true);
+		if (error) {
+			return error;
+		}
+		if (w.at - tlv - TLV_HEADER > 0xffff) {
+			return -EMSGSIZE;
+		}
+		tlv[0] = tlv_type;
+		tlv[1] = (uint8_t)(w.at - tlv - TLV_HEADER);
+		tlv[2] = (uint8_t)((w.at - tlv - TLV_HEADER) >> 8);
+	}
+	if (w.at - start - QMI_HEADER_SIZE > 0xffff) {
+		return -EMSGSIZE;
+	}
+	start[0] = type;
+	start[1] = (uint8_t)transaction;
+	start[2] = (uint8_t)(transaction >> 8);
+	start[3] = (uint8_t)message;
+	start[4] = (uint8_t)(message >> 8);
+	start[5] = (uint8_t)(w.at - start - QMI_HEADER_SIZE);
+	start[6] = (uint8_t)((w.at - start - QMI_HEADER_SIZE) >> 8);
+	return (int)(w.at - start);
+}
+
+static int decode_structure(struct reader *r, const struct qmi_elem_info *ei, uint8_t *structure);
+
+static int
+decode_value(struct reader *r, const struct qmi_elem_info *e, uint8_t *to, uint32_t count, bool top)
+{
+	uint64_t value;
+
+	if (is_number(e)) {
+		for (uint32_t i = 0; i < count; i++) {
+			if (!get_number(r, &value, e->elem_size)) {
+				return -EINVAL;
+			}
+			store(to + (size_t)i * e->elem_size, value, e->elem_size);
+		}
+		return 0;
+	}
+	if (e->data_type == QMI_STRUCT && e->ei_array != NULL) {
+		for (uint32_t i = 0; i < count; i++) {
+			int error = decode_structure(r, e->ei_array, to + (size_t)i * e->elem_size);
+
+			if (error) {
+				return error;
+			}
+		}
+		return 0;
+	}
+	if (e->data_type == QMI_STRING && count == 1) {
+		value = (uint64_t)(r->end - r->at);             /* at the top level: all of the TLV */
+		if (!top && !get_number(r, &value, e->elem_len <= 255 ? 1 : 2)) {
+			return -EINVAL;
+		}
+		if (value >= e->elem_len || value > (uint64_t)(r->end - r->at)) {
+			return -EINVAL;
+		}
+		memcpy(to, r->at, (size_t)value);
+		to[value] = 0;
+		r->at += value;
+		return 0;
+	}
+	return -EINVAL;
+}
+
+static int
+decode_counted(struct reader *r, const struct qmi_elem_info **e, uint8_t *structure, bool top)
+{
+	uint32_t count = 1;
+
+	if ((*e)->data_type == QMI_DATA_LEN) {
+		const struct qmi_elem_info *length = (*e)++;
+		uint64_t value;
+
+		if (!get_number(r, &value, count_size(length))) {
+			return -EINVAL;
+		}
+		if ((*e)->array_type != VAR_LEN_ARRAY || value > (*e)->elem_len) {
+			return -EINVAL;
+		}
+		store(structure + length->offset, value, sizeof(uint32_t));
+		count = (uint32_t)value;
+	} else if ((*e)->array_type == STATIC_ARRAY) {
+		count = (*e)->elem_len;
+	} else if ((*e)->array_type != NO_ARRAY) {
+		return -EINVAL;
+	}
+	return decode_value(r, *e, structure + (*e)->offset, count, top);
+}
+
+static int
+decode_structure(struct reader *r, const struct qmi_elem_info *ei, uint8_t *structure)
+{
+	for (const struct qmi_elem_info *e = ei; e->data_type != QMI_EOTI; e++) {
+		int error = e->data_type == QMI_OPT_FLAG ? -EINVAL : decode_counted(r, &e, structure, false);
+
+		if (error) {
+			return error;
+		}
+	}
+	return 0;
+}
+
+int
+hakios_qmi_decode(const void *buffer, size_t length, const struct qmi_elem_info *ei, void *structure)
+{
+	const uint8_t *start = buffer;
+	struct reader r;
+	size_t said;
+
+	if (buffer == NULL || length < QMI_HEADER_SIZE || ei == NULL || structure == NULL) {
+		return -EINVAL;
+	}
+	said = start[5] | (size_t)start[6] << 8;
+	if (said > length - QMI_HEADER_SIZE) {
+		return -EINVAL;
+	}
+	r.at = start + QMI_HEADER_SIZE;
+	r.end = r.at + said;
+	while (r.at < r.end) {
+		const struct qmi_elem_info *e;
+		struct reader value;
+		uint8_t tlv_type;
+		int error;
+
+		if (r.end - r.at < TLV_HEADER) {
+			return -EINVAL;
+		}
+		tlv_type = r.at[0];
+		value.at = r.at + TLV_HEADER;
+		value.end = value.at + (r.at[1] | (size_t)r.at[2] << 8);
+		if (value.end > r.end) {
+			return -EINVAL;
+		}
+		r.at = value.end;
+		for (e = ei; e->data_type != QMI_EOTI && e->tlv_type != tlv_type; e++) {
+		}
+		if (e->data_type == QMI_EOTI) {
+			continue;                       /* nothing we know: a newer firmware's, say */
+		}
+		if (e->data_type == QMI_OPT_FLAG) {
+			store((uint8_t *)structure + e->offset, 1, 1);
+			e++;
+			if (e->data_type == QMI_EOTI || e->tlv_type != tlv_type) {
+				return -EINVAL;
+			}
+		}
+		error = decode_counted(&value, &e, structure, true);
+		if (error) {
+			return error;
+		}
+	}
+	return (int)(QMI_HEADER_SIZE + said);
+}
+
+const struct qmi_elem_info qmi_response_type_v01_ei[] = {
+	{
+		.data_type = QMI_SIGNED_2_BYTE_ENUM, .elem_len = 1, .elem_size = sizeof(uint16_t), .array_type = NO_ARRAY,
+		.tlv_type = QMI_COMMON_TLV_TYPE, .offset = offsetof(struct qmi_response_type_v01, result),
+	},
+	{
+		.data_type = QMI_SIGNED_2_BYTE_ENUM, .elem_len = 1, .elem_size = sizeof(uint16_t), .array_type = NO_ARRAY,
+		.tlv_type = QMI_COMMON_TLV_TYPE, .offset = offsetof(struct qmi_response_type_v01, error),
+	},
+	{ .data_type = QMI_EOTI },
+};
+
+/* ---- handles ----------------------------------------------------------------------------------- */
+
+/* What stands behind a handle (its `sock` points here). */
+struct qmi_state {
+	struct qmi_handle *handle;
+	const struct hakios_qrtr_ops *transport;
+	struct hakios_qrtr_port *port;
+	struct os_lock lock;                    /* the lists below and the transactions in them */
+	struct qmi_ops ops;
+	const struct qmi_msg_handler *handlers;
+	size_t largest;
+	struct qmi_txn *transactions;
+	uint16_t last_id;
+	struct qmi_service *services;
+	bool connected;
+	uint32_t peer_node, peer_port;
+	/* said in the log once each, so that a firmware that talks a lot cannot fill it */
+	bool said_malformed, said_undecoded, said_unknown;
+};
+
+static const struct hakios_qrtr_ops *qmi_transport;
+
+void
+hakios_qmi_set_transport(const struct hakios_qrtr_ops *ops)
+{
+	qmi_transport = ops;
+}
+
+static struct qmi_state *
+state_of(struct qmi_handle *qmi)
+{
+	return qmi != NULL ? (struct qmi_state *)(void *)qmi->sock : NULL;
+}
+
+/* With the lock held. */
+static struct qmi_txn **
+find_transaction(struct qmi_state *s, const struct qmi_txn *txn, uint16_t id)
+{
+	struct qmi_txn **p;
+
+	for (p = &s->transactions; *p != NULL; p = &(*p)->next) {
+		if (txn != NULL ? *p == txn : (*p)->id == id) {
+			return p;
+		}
+	}
+	return NULL;
+}
+
+/* A message that is not the reply somebody waits for: to its handler, if it has one. */
+static void
+to_handler(struct qmi_state *s, uint8_t type, uint16_t id, uint16_t message, uint32_t node, uint32_t port, const void *data,
+    size_t length)
+{
+	const struct qmi_msg_handler *h;
+	struct sockaddr_qrtr from = { .sq_family = AF_QIPCRTR, .sq_node = node, .sq_port = port };
+	struct qmi_txn txn = { .qmi = s->handle, .id = id };
+	void *decoded;
+	int result;
+
+	for (h = s->handlers; h != NULL && h->fn != NULL; h++) {
+		if (h->type == type && h->msg_id == message) {
+			break;
+		}
+	}
+	if (h == NULL || h->fn == NULL) {
+		if (!s->said_unknown) {
+			s->said_unknown = true;
+			os_log("qmi: a message nobody handles: type %u, id %#x, %zu bytes (said once)\n", type, message, length);
+		}
+		return;
+	}
+	decoded = os_alloc(h->decoded_size);
+	if (decoded == NULL) {
+		return;
+	}
+	result = hakios_qmi_decode(data, length, h->ei, decoded);
+	if (result < 0) {
+		if (!s->said_undecoded) {
+			s->said_undecoded = true;
+			os_log("qmi: message %#x (type %u, %zu bytes) cannot be decoded: %d (said once)\n", message, type, length, result);
+		}
+	} else {
+		h->fn(s->handle, &from, &txn, decoded);
+	}
+	os_free(decoded, h->decoded_size);
+}
+
+/* The router has a datagram for us. */
+static void
+qmi_receive(void *context, uint32_t node, uint32_t port, const void *data, size_t length)
+{
+	struct qmi_state *s = context;
+	const uint8_t *header = data;
+	struct qmi_txn **found, *txn;
+	uint16_t id, message;
+	uint8_t type;
+
+	if (length < QMI_HEADER_SIZE || length > s->largest + QMI_HEADER_SIZE ||
+	    (size_t)(header[5] | header[6] << 8) > length - QMI_HEADER_SIZE) {
+		if (!s->said_malformed) {
+			s->said_malformed = true;
+			os_log("qmi: a datagram of %zu bytes from %u:%u is no message we take (said once)\n", length, node, port);
+		}
+		return;
+	}
+	type = header[0];
+	id = (uint16_t)(header[1] | header[2] << 8);
+	message = (uint16_t)(header[3] | header[4] << 8);
+	if (type == QMI_RESPONSE) {
+		os_lock(&s->lock);
+		found = find_transaction(s, NULL, id);
+		txn = found != NULL ? *found : NULL;
+		if (txn != NULL && !txn->done && txn->ei != NULL && txn->dest != NULL) {
+			txn->result = hakios_qmi_decode(data, length, txn->ei, txn->dest);
+			txn->done = true;
+			os_wake(&s->lock, txn);
+			os_unlock(&s->lock);
+			return;
+		}
+		os_unlock(&s->lock);
+		if (txn == NULL) {
+			return;                         /* a reply to nothing: late, after its transaction was given up */
+		}
+	}
+	to_handler(s, type, id, message, node, port, data, length);
+}
+
+/* The router says a server we asked about is there, or is gone. */
+static void
+qmi_server(void *context, bool arrived, uint32_t service, uint32_t version, uint32_t instance, uint32_t node, uint32_t port)
+{
+	struct qmi_state *s = context;
+	struct qmi_service *svc, **p;
+
+	os_lock(&s->lock);
+	for (p = &s->services; *p != NULL; p = &(*p)->next) {
+		if ((*p)->node == node && (*p)->port == port) {
+			break;
+		}
+	}
+	svc = *p;
+	if (!arrived && svc != NULL) {
+		*p = svc->next;
+	}
+	os_unlock(&s->lock);
+
+	if (arrived && svc == NULL) {
+		svc = os_alloc(sizeof(*svc));
+		if (svc == NULL) {
+			return;
+		}
+		svc->service = service;
+		svc->version = version;
+		svc->instance = instance;
+		svc->node = node;
+		svc->port = port;
+		if (s->ops.new_server != NULL && s->ops.new_server(s->handle, svc) < 0) {
+			os_free(svc, sizeof(*svc));
+			return;
+		}
+		os_lock(&s->lock);
+		svc->next = s->services;
+		s->services = svc;
+		os_unlock(&s->lock);
+	} else if (!arrived && svc != NULL) {
+		if (s->ops.del_server != NULL) {
+			s->ops.del_server(s->handle, svc);
+		}
+		os_free(svc, sizeof(*svc));
+	}
+}
+
+int
+hakios_qmi_handle_init_transport(struct qmi_handle *qmi, size_t largest, const struct qmi_ops *ops,
+    const struct qmi_msg_handler *handlers, const struct hakios_qrtr_ops *transport)
+{
+	struct qmi_state *s;
+
+	qmi->sock = NULL;
+	if (transport == NULL) {
+		return -ENXIO;
+	}
+	s = os_alloc(sizeof(*s));
+	if (s == NULL) {
+		return -ENOMEM;
+	}
+	s->handle = qmi;
+	s->transport = transport;
+	s->largest = largest;
+	s->handlers = handlers;
+	if (ops != NULL) {
+		s->ops = *ops;
+	}
+	os_lock_init(&s->lock);
+	qmi->sock = (struct socket *)(void *)s;         /* before the port: callbacks may come at once */
+	s->port = transport->open(qmi_receive, qmi_server, s);
+	if (s->port == NULL) {
+		qmi->sock = NULL;
+		os_lock_destroy(&s->lock);
+		os_free(s, sizeof(*s));
+		return -ENXIO;
+	}
+	return 0;
+}
+
+int
+qmi_handle_init(struct qmi_handle *qmi, size_t largest, const struct qmi_ops *ops, const struct qmi_msg_handler *handlers)
+{
+	return hakios_qmi_handle_init_transport(qmi, largest, ops, handlers, qmi_transport);
+}
+
+/* Nobody may be waiting in qmi_txn_wait() on this handle any more. */
+void
+qmi_handle_release(struct qmi_handle *qmi)
+{
+	struct qmi_state *s = state_of(qmi);
+	struct qmi_service *svc;
+
+	if (s == NULL) {
+		return;
+	}
+	s->transport->close(s->port);                   /* no callback after this */
+	while ((svc = s->services) != NULL) {
+		s->services = svc->next;
+		os_free(svc, sizeof(*svc));
+	}
+	qmi->sock = NULL;
+	os_lock_destroy(&s->lock);
+	os_free(s, sizeof(*s));
+}
+
+int
+qmi_add_lookup(struct qmi_handle *qmi, unsigned int service, unsigned int version, unsigned int instance)
+{
+	struct qmi_state *s = state_of(qmi);
+	int error;
+
+	if (s == NULL) {
+		return -EINVAL;
+	}
+	error = s->transport->lookup(s->port, service, version, instance);
+	return error > 0 ? -error : error;
+}
+
+int
+hakios_qmi_connect(struct socket *sock, uint32_t node, uint32_t port)
+{
+	struct qmi_state *s = (struct qmi_state *)(void *)sock;
+
+	if (s == NULL) {
+		return -EINVAL;
+	}
+	os_lock(&s->lock);
+	s->peer_node = node;
+	s->peer_port = port;
+	s->connected = true;
+	os_unlock(&s->lock);
+	return 0;
+}
+
+int
+qmi_txn_init(struct qmi_handle *qmi, struct qmi_txn *txn, const struct qmi_elem_info *ei, void *structure)
+{
+	struct qmi_state *s = state_of(qmi);
+	uint16_t id;
+
+	memset(txn, 0, sizeof(*txn));
+	if (s == NULL) {
+		return -EINVAL;
+	}
+	txn->qmi = qmi;
+	txn->ei = ei;
+	txn->dest = structure;
+	os_lock(&s->lock);
+	/* the next number nobody else has (0 to 65534, round and round) */
+	for (id = (uint16_t)(s->last_id + 1);; id++) {
+		if (id == 0xffff) {
+			id = 0;
+		}
+		if (find_transaction(s, NULL, id) == NULL) {
+			break;
+		}
+		if (id == s->last_id) {
+			os_unlock(&s->lock);
+			return -ENOMEM;                 /* 65535 of them at once */
+		}
+	}
+	s->last_id = id;
+	txn->id = id;
+	txn->next = s->transactions;
+	s->transactions = txn;
+	os_unlock(&s->lock);
+	return id;
+}
+
+int
+qmi_send_request(struct qmi_handle *qmi, struct sockaddr_qrtr *sq, struct qmi_txn *txn, int msg_id, size_t largest,
+    const struct qmi_elem_info *ei, const void *structure)
+{
+	struct qmi_state *s = state_of(qmi);
+	uint32_t node, port;
+	bool connected;
+	size_t size = largest + QMI_HEADER_SIZE;
+	void *buffer;
+	int length, error;
+
+	if (s == NULL || txn == NULL) {
+		return -EINVAL;
+	}
+	os_lock(&s->lock);
+	connected = s->connected;
+	node = s->peer_node;
+	port = s->peer_port;
+	os_unlock(&s->lock);
+	if (sq != NULL) {
+		node = sq->sq_node;
+		port = sq->sq_port;
+	} else if (!connected) {
+		return -ENOTCONN;
+	}
+	buffer = os_alloc(size);
+	if (buffer == NULL) {
+		return -ENOMEM;
+	}
+	length = hakios_qmi_encode(QMI_REQUEST, (uint16_t)msg_id, txn->id, ei, structure, buffer, size);
+	if (length < 0) {
+		os_free(buffer, size);
+		return length;
+	}
+	error = s->transport->send(s->port, node, port, buffer, (size_t)length);
+	os_free(buffer, size);
+	return error > 0 ? -error : error;
+}
+
+void
+qmi_txn_cancel(struct qmi_txn *txn)
+{
+	struct qmi_state *s = state_of(txn->qmi);
+	struct qmi_txn **found;
+
+	if (s == NULL) {
+		return;
+	}
+	os_lock(&s->lock);
+	found = find_transaction(s, txn, 0);
+	if (found != NULL) {
+		*found = txn->next;
+	}
+	os_unlock(&s->lock);
+}
+
+int
+hakios_qmi_txn_wait_ms(struct qmi_txn *txn, uint64_t milliseconds)
+{
+	struct qmi_state *s = state_of(txn->qmi);
+	uint64_t now = os_now_ms(), until = now + milliseconds;
+	struct qmi_txn **found;
+	int result;
+
+	if (s == NULL) {
+		return -EINVAL;
+	}
+	os_lock(&s->lock);
+	while (!txn->done && now < until) {
+		os_wait(&s->lock, txn, until - now);
+		now = os_now_ms();
+	}
+	found = find_transaction(s, txn, 0);
+	if (found != NULL) {
+		*found = txn->next;
+	}
+	result = txn->done ? txn->result : -ETIMEDOUT;
+	os_unlock(&s->lock);
+	return result;
+}
diff --git a/bsd/dev/hakios.sta.c b/bsd/dev/hakios.sta.c
new file mode 100644
index 0000000..ffe4a38
--- /dev/null
+++ b/bsd/dev/hakios.sta.c
@@ -0,0 +1,371 @@
+/*
+ * Darwin-on-hakios: what stands between the two sides of the station boundary
+ * (sys/hakios.sta.h).
+ *
+ * Whoever wants a network asks from wherever it happens to be: an ioctl of wifid's, the thread
+ * that brings the radio up. The station side wants to be called by one thread, one call at a
+ * time, and a scan or a join takes seconds. So what is asked for is noted here and done by a
+ * thread of this file's; the asker returns at once and hears the outcome as an event. One
+ * request of each kind can wait: a second scan asked for while the first has not begun
+ * replaces it, as does a second join.
+ *
+ * What the last scan heard is kept here, so that it can be read without entering the station
+ * side, and so is the list of channels.
+ *
+ * The network the kernel was given in a file is a standing request: joined at the start, and
+ * again whenever the radio is turned back on (Settings' switch), until somebody asks for
+ * another network -- as iOS itself rejoins the networks it knows. If that other network cannot
+ * be joined (a wrong passphrase), the standing one is joined again.
+ */
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <sys/errno.h>
+#include <sys/hakios.sta.h>
+#include <sys/sweet_wifi.h>
+#include <sys/systm.h>
+
+extern void thread_set_thread_name(thread_t thread, const char *name);
+
+#define HEARD_MOST      128
+#define CHANNELS_MOST   96
+
+static LCK_GRP_DECLARE(sta_lock_group, "hakios-sta");
+static LCK_MTX_DECLARE(sta_lock, &sta_lock_group);
+
+static const struct hakios_sta_ops *sta_ops;   /* the station side, while there is one */
+static bool sta_thread_made;
+static bool sta_calls;                          /* the thread is in a call of the station side's */
+static unsigned sta_reads;                      /* ... and so many others are in its state() */
+static bool sta_on;                             /* the radio's power, as last asked for */
+
+/* what has been asked for and not begun */
+static bool asked_power, asked_power_on, asked_scan, asked_join, asked_leave;
+static struct hakios_sta_scan asked_scan_what;
+static struct hakios_sta_join asked_join_what;
+static struct hakios_sta_join standing;        /* the network joined whenever the radio comes on (ssid_length 0: none) */
+static struct hakios_sta_join fallback;        /* ... as it was before a join that has not come through yet */
+
+static struct hakios_sta_bss *heard;           /* by the last scan that came to an end */
+static unsigned heard_count;
+static struct hakios_sta_channel channels[CHANNELS_MOST];
+static unsigned channel_count;
+
+static void
+heard_one(const struct hakios_sta_bss *bss, __unused void *context)
+{
+	/* (only the thread writes the list, and it reads the count without the lock) */
+	if (heard_count < HEARD_MOST) {
+		lck_mtx_lock(&sta_lock);
+		heard[heard_count++] = *bss;
+		lck_mtx_unlock(&sta_lock);
+	}
+}
+
+static void
+sta_runs(__unused void *parameter, __unused wait_result_t result)
+{
+	static struct hakios_sta_scan scan;
+	static struct hakios_sta_join join;
+
+	for (;;) {
+		const struct hakios_sta_ops *ops;
+		bool power = false, power_on = false, leave = false, do_join = false, do_scan = false;
+		int error = 0;
+
+		lck_mtx_lock(&sta_lock);
+		while (sta_ops == NULL || !(asked_power || asked_leave || asked_join || asked_scan)) {
+			lck_mtx_sleep(&sta_lock, LCK_SLEEP_DEFAULT, (event_t)&sta_ops, THREAD_UNINT);
+		}
+		ops = sta_ops;
+		/* one thing at a time, in the order that makes sense when several wait */
+		if (asked_power) {
+			power = true;
+			power_on = asked_power_on;
+			asked_power = false;
+		} else if (asked_leave) {
+			leave = true;
+			asked_leave = false;
+		} else if (asked_join) {
+			do_join = true;
+			join = asked_join_what;
+			bzero(&asked_join_what, sizeof(asked_join_what));
+			asked_join = false;
+		} else {
+			do_scan = true;
+			scan = asked_scan_what;
+			asked_scan = false;
+		}
+		sta_calls = true;
+		lck_mtx_unlock(&sta_lock);
+
+		if (power) {
+			struct hakios_sta_state *state = kalloc_data(sizeof(*state), Z_WAITOK | Z_ZERO);
+			bool was_joined = false;
+
+			if (state != NULL) {
+				ops->state(state);
+				was_joined = state->phase == HAKIOS_STA_JOINED;
+				kfree_data(state, sizeof(*state));
+			}
+			error = ops->power(power_on);
+			if (!power_on && was_joined) {
+				hakios_apple80211_event(HAKIOS_STA_LINK, 0);
+			}
+			hakios_apple80211_event(HAKIOS_STA_POWER, error == 0 ? power_on : !power_on);
+			lck_mtx_lock(&sta_lock);
+			if (error == 0 && power_on && standing.ssid_length != 0 && !asked_join) {
+				asked_join_what = standing;
+				asked_join = true;
+			}
+			lck_mtx_unlock(&sta_lock);
+		} else if (leave) {
+			ops->leave();
+			hakios_apple80211_event(HAKIOS_STA_LINK, 0);
+		} else if (do_join) {
+			error = ops->join(&join);
+			bzero(&join, sizeof(join));
+			hakios_apple80211_event(HAKIOS_STA_JOIN_DONE, error);
+			if (error == 0) {
+				hakios_apple80211_event(HAKIOS_STA_LINK, 1);
+			}
+			/* a join that did not come through (a wrong passphrase) leaves things as they were: the standing network again */
+			lck_mtx_lock(&sta_lock);
+			if (error != 0 && fallback.ssid_length != 0 && !asked_join && !asked_leave && !asked_power) {
+				standing = asked_join_what = fallback;
+				asked_join = true;
+			}
+			bzero(&fallback, sizeof(fallback));
+			lck_mtx_unlock(&sta_lock);
+		} else if (do_scan) {
+			error = ops->scan(&scan);
+			lck_mtx_lock(&sta_lock);
+			heard_count = 0;
+			lck_mtx_unlock(&sta_lock);
+			ops->heard(heard_one, NULL);
+			hakios_apple80211_event(HAKIOS_STA_SCAN_DONE, error);
+		}
+
+		lck_mtx_lock(&sta_lock);
+		sta_calls = false;
+		lck_mtx_unlock(&sta_lock);
+		thread_wakeup((event_t)&sta_calls);
+	}
+}
+
+/* ---- the station side ---------------------------------------------------------------------------------- */
+
+void
+hakios_sta_attach(const struct hakios_sta_ops *ops)
+{
+	thread_t thread;
+
+	if (ops == NULL) {
+		lck_mtx_lock(&sta_lock);
+		sta_ops = NULL;
+		asked_power = asked_scan = asked_join = asked_leave = false;
+		while (sta_calls || sta_reads != 0) {
+			lck_mtx_sleep(&sta_lock, LCK_SLEEP_DEFAULT, (event_t)&sta_calls, THREAD_UNINT);
+		}
+		heard_count = channel_count = 0;
+		lck_mtx_unlock(&sta_lock);
+		return;
+	}
+	if (heard == NULL) {
+		heard = kalloc_data(HEARD_MOST * sizeof(*heard), Z_WAITOK | Z_ZERO);
+	}
+	if (heard == NULL) {
+		hakios_wifi_tell("wifi: no memory for what a scan hears: nobody can ask the radio for a network\n");
+		return;
+	}
+	if (!sta_thread_made) {
+		if (kernel_thread_start(sta_runs, NULL, &thread) != KERN_SUCCESS) {
+			hakios_wifi_tell("wifi: no thread for the station: nobody can ask the radio for a network\n");
+			return;
+		}
+		thread_set_thread_name(thread, "wifi-station");
+		thread_deallocate(thread);
+		sta_thread_made = true;
+	}
+	channel_count = ops->channels(channels, CHANNELS_MOST);
+	lck_mtx_lock(&sta_lock);
+	sta_ops = ops;
+	sta_on = true;
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	hakios_apple80211_event(HAKIOS_STA_POWER, 1);
+}
+
+void
+hakios_sta_lost(int error)
+{
+	hakios_apple80211_event(HAKIOS_STA_LINK, error != 0 ? error : ECONNRESET);
+}
+
+/* ---- who wants a network ------------------------------------------------------------------------------- */
+
+bool
+hakios_sta_present(void)
+{
+	return sta_ops != NULL;
+}
+
+bool
+hakios_sta_powered(void)
+{
+	return sta_ops != NULL && sta_on;
+}
+
+bool
+hakios_sta_busy(void)
+{
+	bool busy;
+
+	lck_mtx_lock(&sta_lock);
+	busy = sta_ops != NULL && (sta_calls || asked_power || asked_leave || asked_join || asked_scan);
+	lck_mtx_unlock(&sta_lock);
+	return busy;
+}
+
+int
+hakios_sta_ask_power(bool on)
+{
+	lck_mtx_lock(&sta_lock);
+	if (sta_ops == NULL) {
+		lck_mtx_unlock(&sta_lock);
+		return ENXIO;
+	}
+	sta_on = on;
+	asked_power = true;
+	asked_power_on = on;
+	if (!on) {
+		asked_scan = asked_join = asked_leave = false;
+	}
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	return 0;
+}
+
+int
+hakios_sta_ask_scan(const struct hakios_sta_scan *what)
+{
+	lck_mtx_lock(&sta_lock);
+	if (sta_ops == NULL || !sta_on) {
+		lck_mtx_unlock(&sta_lock);
+		return sta_ops == NULL ? ENXIO : ENETDOWN;
+	}
+	asked_scan_what = *what;
+	asked_scan = true;
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	return 0;
+}
+
+int
+hakios_sta_ask_join_standing(const struct hakios_sta_join *what)
+{
+	int error = hakios_sta_ask_join(what);
+
+	lck_mtx_lock(&sta_lock);
+	if (error == 0) {
+		standing = *what;
+	}
+	lck_mtx_unlock(&sta_lock);
+	return error;
+}
+
+int
+hakios_sta_ask_join(const struct hakios_sta_join *what)
+{
+	lck_mtx_lock(&sta_lock);
+	if (sta_ops == NULL || !sta_on) {
+		lck_mtx_unlock(&sta_lock);
+		return sta_ops == NULL ? ENXIO : ENETDOWN;
+	}
+	if (standing.ssid_length != 0) {
+		fallback = standing;
+	}
+	bzero(&standing, sizeof(standing));     /* (whoever asks for a network now has the say) */
+	asked_join_what = *what;
+	asked_join = true;
+	asked_leave = false;
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	return 0;
+}
+
+int
+hakios_sta_ask_leave(void)
+{
+	lck_mtx_lock(&sta_lock);
+	if (sta_ops == NULL) {
+		lck_mtx_unlock(&sta_lock);
+		return ENXIO;
+	}
+	asked_leave = true;
+	asked_join = false;
+	bzero(&asked_join_what, sizeof(asked_join_what));
+	bzero(&fallback, sizeof(fallback));
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	return 0;
+}
+
+bool
+hakios_sta_heard(unsigned index, struct hakios_sta_bss *bss)
+{
+	bool there;
+
+	lck_mtx_lock(&sta_lock);
+	if ((there = index < heard_count)) {
+		*bss = heard[index];
+	}
+	lck_mtx_unlock(&sta_lock);
+	return there;
+}
+
+void
+hakios_sta_state(struct hakios_sta_state *state)
+{
+	const struct hakios_sta_ops *ops;
+
+	bzero(state, sizeof(*state));
+	lck_mtx_lock(&sta_lock);
+	if ((ops = sta_ops) != NULL) {
+		sta_reads++;
+	}
+	lck_mtx_unlock(&sta_lock);
+	if (ops != NULL) {
+		ops->state(state);
+		lck_mtx_lock(&sta_lock);
+		sta_reads--;
+		lck_mtx_unlock(&sta_lock);
+		thread_wakeup((event_t)&sta_calls);
+	}
+}
+
+unsigned
+hakios_sta_channels(struct hakios_sta_channel *out, unsigned most)
+{
+	unsigned count;
+
+	lck_mtx_lock(&sta_lock);
+	count = channel_count < most ? channel_count : most;
+	memcpy(out, channels, count * sizeof(*out));
+	lck_mtx_unlock(&sta_lock);
+	return count;
+}
+
+bool
+hakios_sta_address(uint8_t *address)
+{
+	const struct hakios_sta_ops *ops = sta_ops;
+
+	if (ops != NULL) {
+		memcpy(address, ops->address, 6);
+	}
+	return ops != NULL;
+}
diff --git a/bsd/dev/sweet_camera.c b/bsd/dev/sweet_camera.c
new file mode 100644
index 0000000..bcf3ab3
--- /dev/null
+++ b/bsd/dev/sweet_camera.c
@@ -0,0 +1,3699 @@
+/*
+ * SWEET camera: the Mi 9T's (davinci, SM7150 "sdmmagpie", Titan 175) cameras for iOS.
+ * DRAFT -- not built, not run. Port of HackiOS's bsd/dev/redwood_camera.c (OOSEX GANG, APSL 2.0,
+ * hackios-xnu-kernel/xnu/files/bsd/dev/redwood_camera.c); see davinci-ios/camera/CAMERA-PORT-PLAN.md.
+ *
+ * Same architecture as HackiOS: no Qualcomm CAMSS driver stack, no CCI controller, no ISP. One
+ * kernel thread powers the sensor (bit-banged I2C on the CCI pins), programs CSIPHY -> CSID-lite 0 ->
+ * IFE-lite 0 RDI 0 -> write master 0 to write raw RAW10 frames through an apps-SMMU context of ours
+ * into kernel memory, and /dev/sweet-camera hands the frames to mediaserverd, where a userland
+ * FigCaptureDevice (HackiOS camera_device.c + camera_isp.c, ported) debayers on the CPU.
+ *
+ * Everything below is davinci's, from (a) MIUI's device tree (davinci_0.dts + dtbo overlay: cam-sensor@0..3,
+ * csiphy@ace0000.., csid-lite0@acc8000, vfe-lite0@acc4000, cci@ac4a000/@ac4b000, apps-smmu@15000000,
+ * titan_top_gdsc@ad0c1c4), (b) LineageOS android_kernel_xiaomi_sm6150 (camcc-sdmmagpie.c,
+ * gcc-sdmmagpie.c, pinctrl-sdmmagpie.c, clk-alpha-pll.c Fabia, cam_csiphy_1_2_hwreg.h,
+ * cam_ife_csid_lite17x.h, cam_vfe_lite17x.h, davinci-sdmmagpie-camera-sensor.dtsi), (c) the sensors'
+ * CamX module files from MIUI's /vendor/lib64/camera (com.qti.sensormodule.davinci_*.bin), turned into
+ * RWCTAB02 tables by davinci-ios/camera/tools/davinci_camsensor.py and read at run time from
+ * /usr/local/camera/camera-<sensor>.tab.
+ *
+ *   sensor        Android cell  chip (ID @reg)       CCI bus (SDA/SCL)   reset  MCLK (pin)     CSIPHY  VDIG enable
+ *   wide          cam-sensor@0  IMX586 0x0586 @0x16  CCI0 m0 (17/18)     26     MCLK2 (15)     0, 4L   PM6150L GPIO3
+ *                               (or IMX582 0x0582)
+ *   tele          cam-sensor@1  OV8856 0x885a @300b  CCI0 m1 (19/20)     24     MCLK3 (16)     3, 2L   PM6150L GPIO8
+ *   front (popup) cam-sensor@2  S5K3T2 0x3142 @0     CCI0 m0 (17/18)     23     MCLK0 (13)     1, 4L   TLMM 57
+ *   ultra-wide    cam-sensor@3  S5K3L6 0x30c6 @0     CCI1 m0 (27/28)     25     MCLK1 (14)     2, 4L   TLMM 29
+ *
+ *   7-bit slave addresses: IMX586/582 0x1a, OV8856 0x36, S5K3T2 0x56, S5K3L6 0x10 (tables carry them).
+ *   Supplies (all four, DT): VIO = PM6150 L16 (ldoa16, 1.8 V), VANA = PM6150L BOB (bobc1), VDIG =
+ *   PM6150L S8 (smpc8, 1.352 V) + the VDIG enable above (external LDOs), CUSTOM = PM6150L L9 (ldoc9,
+ *   2.952 V). MCLK 19.2 MHz from the crystal for all. CSIPHY's own supplies (L3C 1.2 V, refgen
+ *   @0xff1000) are the DSI PHY's too and on while the panel is.
+ *
+ * Boot-args (nothing is touched without sweetcam):
+ *   sweetcam=1   look only: clocks, GDSC, pins, PMIC regulator status, SMMU, RPMh (reads; the one write
+ *                is GCC's camera AHB branch, so camcc can be read at all)
+ *   sweetcam=2   + power up the sensor, read its chip ID, power down
+ *   sweetcam=3   CSID-lite's test pattern -> IFE-lite -> SMMU -> memory (no sensor)
+ *   sweetcam=4   the sensor's own frames into memory, N frames, then everything down
+ *   sweetcam=5   /dev/sweet-camera for iOS (sessions on demand)
+ *   sweetcam_sensor=ultra|front|wide|tele (default ultra), sweetcam_mode=N, sweetcam_settle=N,
+ *   sweetcam_pattern=1|2 (sensor / CSID colour bars), sweetcam_frames=N, sweetcam_after=SECS (20),
+ *   sweetcam_rails=0 (do not vote RPMh rails: assume the bootloader left them on),
+ *   sweetcam_fake=1 (with =5: synthetic frames, no hardware touched -- tests the iOS side alone),
+ *   sweetcam_swapi2c=1 (if SDA/SCL turn out the other way round),
+ *   sweetpopup=1 (raise the front camera's pop-up for its sessions, lower it after: the DRV8846 motor),
+ *   sweetpopup=2 (the motor alone: up, 2 s, down, then nothing else; with sweetcam >= 2).
+ *
+ * Safety rules kept from HackiOS: only DT voltages; only the registers named here are written; every
+ * write that should read back is read back; any fault -> everything switched off in reverse order and
+ * nothing more for the rest of the boot; whatever was found on is left on. sweet_camera_quiesce() puts
+ * everything down at halt/restart (call it from sweet_halt_restart()).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/conf.h>
+#include <sys/uio.h>
+#include <sys/vnode.h>
+#include <sys/proc.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <vm/vm_kern.h>
+#include <vm/pmap.h>
+#include <libkern/libkern.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <miscfs/devfs/devfs.h>
+#include <sys/sweet_camera.h>
+#include <sys/sysctl.h>
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, uint32_t);
+extern kern_return_t thread_terminate(thread_t);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern errno_t vnode_size(vnode_t, off_t *, vfs_context_t);
+extern vnode_t rootvnode;
+/* sweet_rpmh.c: per-resource allow-list (patch 0160 adds the camera rails) */
+extern int sweet_rpmh_vreg_vote(const char *res, unsigned mv, bool on);
+void sweet_camera_init(void);
+void sweet_camera_quiesce(void);
+
+/* As sweet_gpu.c: kernel_map, not io_submap (8 MB, permanent). */
+#ifndef VM_WIMG_IO
+#define VM_WIMG_IO              0x7u
+#endif
+#define cam_map(pa, size)       ml_io_map_unmappable((vm_offset_t)(pa), (vm_size_t)(size), VM_WIMG_IO)
+
+static uint32_t level;
+static bool broken, leaving, fake, use_rails = true, swap_i2c, pmic_reads;
+
+static void say(const char *format, ...) __printflike(1, 2);
+
+/*
+ * The whole report, also kept here: the kernel's 128 KB message buffer holds only a few seconds of a boot
+ * (backboardd's frame lines), so the start of a camera report is gone before USB comes up.
+ * sysctl kern.sweet_camlog reads it; once full, later lines go to the message buffer only.
+ */
+static char camlog[32768];
+static unsigned camlog_len;
+
+static int
+camlog_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	return SYSCTL_OUT(req, camlog, camlog_len);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_camlog, CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0,
+    camlog_sysctl, "A", "the camera driver's report");
+
+static void
+say(const char *format, ...)
+{
+	char line[300];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	if (!leaving && ml_get_interrupts_enabled()) {
+		size_t n = strlen(line);
+		if (camlog_len + n <= sizeof(camlog)) {
+			memcpy(camlog + camlog_len, line, n);
+			camlog_len += (unsigned)n;
+		}
+		printf("SWEET CAM: %s", line);
+	}
+}
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	uint32_t v = *(volatile uint32_t *)address;
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)address = value;
+}
+
+static void
+spin_us(uint32_t us)
+{
+	uint64_t until;
+
+	nanoseconds_to_absolutetime((uint64_t)us * NSEC_PER_USEC, &until);
+	until += mach_absolute_time();
+	while (mach_absolute_time() < until) {
+	}
+}
+
+static void
+wait_ms(uint32_t ms)
+{
+	if (leaving) {
+		spin_us(ms * 1000);
+	} else {
+		delay_for_interval(ms, NSEC_PER_MSEC);
+	}
+}
+
+static void
+give_up(const char *why)
+{
+	if (!broken) {
+		broken = true;
+		say("%s: nothing more is written in this boot\n", why);
+	}
+}
+
+static uint64_t
+cam_pa(vm_offset_t va)
+{
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)va);
+
+	return pn == 0 ? 0 : ((uint64_t)ptoa_64(pn) | (va & PAGE_MASK));
+}
+
+/* ---- pins: TLMM in three tiles (pinctrl-sdmmagpie.c: WEST 0x100000, NORTH 0x500000, SOUTH 0x900000) ---- */
+
+#define TLMM_PHYS               0x03400000UL
+#define TILE_WEST               0x00100000UL
+#define TILE_NORTH              0x00500000UL
+#define TILE_SOUTH              0x00900000UL
+#define CFG_PULL_UP             3u
+#define CFG_OUTPUT              (1u << 9)
+#define CFG_FUNCTION(f)         ((uint32_t)(f) << 2)
+#define CFG_DRIVE_MA(ma)        ((uint32_t)((ma) / 2 - 1) << 6)
+#define FUNC_CAM_MCLK           1               /* gpio13..16 function 1 */
+#define MAX_PIN                 128     /* sdmmagpie: gpio0..118 (the pop-up motor uses 88-91) */
+
+static vm_offset_t pin_va[MAX_PIN];
+
+/* The tile of each pin this file may touch; 0: not ours to touch. */
+static vm_offset_t
+pin_tile(unsigned pin)
+{
+	if (pin >= 13 && pin <= 28) {
+		return TILE_SOUTH;              /* MCLK0..3, CCI0/1, resets, CCI2 */
+	}
+	if (pin == 29) {
+		return TILE_NORTH;              /* ultra VDIG enable */
+	}
+	if (pin == 57) {
+		return TILE_WEST;               /* front VDIG enable */
+	}
+	if (pin == 43 || pin == 66 || pin == 88 || pin == 90 || pin == 91) {
+		return TILE_NORTH;              /* pop-up motor: fault, mode1, sleep, power enable, mode0 */
+	}
+	if (pin == 55) {
+		return TILE_WEST;               /* pop-up motor: direction */
+	}
+	return 0;
+}
+
+static vm_offset_t
+pin(unsigned n)
+{
+	vm_offset_t tile = n < MAX_PIN ? pin_tile(n) : 0;
+
+	if (tile == 0) {
+		give_up("a pin this driver does not own");
+		return 0;
+	}
+	if (pin_va[n] == 0) {
+		pin_va[n] = cam_map(TLMM_PHYS + tile + 0x1000UL * n, 0x1000);
+	}
+	return pin_va[n];
+}
+
+#define GPIO_CFG(n)             (pin(n))
+#define GPIO_IO(n)              (pin(n) + 4)
+
+static void
+show_pin(unsigned n, const char *what)
+{
+	uint32_t cfg = rd(GPIO_CFG(n)), io = rd(GPIO_IO(n));
+
+	say("gpio%u (%s): function %u, pull %u, %u mA, %s, reads %u\n", n, what, (cfg >> 2) & 15, cfg & 3,
+	    (((cfg >> 6) & 7) + 1) * 2, (cfg & CFG_OUTPUT) ? (io & 2 ? "drives high" : "drives low") : "input", io & 1);
+}
+
+/* ---- the sensors ---------------------------------------------------------------------------------- */
+
+enum { VDIG_NONE, VDIG_TLMM, VDIG_PMIC };
+enum {
+	REGS_SMIA,              /* Samsung: 0x0340 frame length, 0x0202 coarse, 0x0204 gain (16-bit), hold 0x0104 */
+	REGS_SONY,              /* Sony: same addresses, 8-bit data each, gain code 1024 - 1024/gain */
+	REGS_OV8856,            /* OmniVision: VTS 0x380e/f, exposure 0x3500..2 (lines << 4), gain 0x3508/9, hold 0x3208 */
+};
+struct sensor_hw {
+	const char *    name;
+	const char *    chip;
+	const char *    tab;            /* /usr/local/camera/<tab> (davinci_camsensor.py) */
+	const char *    tab_alt;        /* another chip on the same footprint (IMX582), picked by chip ID */
+	unsigned        sda, scl, reset;
+	uint32_t        mclk_cmd, mclk_cbcr;
+	unsigned        mclk_pin;
+	uint8_t         vdig_kind;
+	uint16_t        vdig_gpio;      /* TLMM pin, or PM6150L GPIO number */
+	unsigned        csiphy;
+	uint32_t        phy_cbcr, timer_cmd, timer_cbcr;
+	uint8_t         regs;
+	uint8_t         bayer;          /* 0 RGGB, 1 GRBG, 2 GBRG, 3 BGGR (CamX CFA from the module, converted) */
+	uint16_t        gain_unity, gain_max;
+	bool            popup;          /* behind the pop-up: dark until the motor raises it (not done here) */
+	uint8_t         af_address;     /* the lens motor's (DW9763) 7-bit I2C address on the sensor's bus; 0: fixed focus */
+};
+static const struct sensor_hw sensors[] = {
+	[SWEET_CAMERA_WIDE] = {
+		.name = "wide", .chip = "IMX586", .tab = "camera-imx586.tab", .tab_alt = "camera-imx582.tab",
+		.sda = 17, .scl = 18, .reset = 26, .mclk_cmd = 0x5044, .mclk_cbcr = 0x505c, .mclk_pin = 15,
+		.vdig_kind = VDIG_PMIC, .vdig_gpio = 3, .csiphy = 0, .phy_cbcr = 0x6020, .timer_cmd = 0x6004, .timer_cbcr = 0x601c,
+		.regs = REGS_SONY, .bayer = 0, .gain_unity = 256, .gain_max = 16 * 256, .af_address = 0x0c,
+	},
+	[SWEET_CAMERA_TELE] = {
+		.name = "tele", .chip = "OV8856", .tab = "camera-ov8856.tab",
+		.sda = 19, .scl = 20, .reset = 24, .mclk_cmd = 0x5064, .mclk_cbcr = 0x507c, .mclk_pin = 16,
+		.vdig_kind = VDIG_PMIC, .vdig_gpio = 8, .csiphy = 3, .phy_cbcr = 0x608c, .timer_cmd = 0x6070, .timer_cbcr = 0x6088,
+		.regs = REGS_OV8856, .bayer = 3, .gain_unity = 0x80, .gain_max = 0x7c0, .af_address = 0x0e,
+	},
+	[SWEET_CAMERA_FRONT] = {
+		.name = "front", .chip = "S5K3T2", .tab = "camera-s5k3t2.tab",
+		.sda = 17, .scl = 18, .reset = 23, .mclk_cmd = 0x5004, .mclk_cbcr = 0x501c, .mclk_pin = 13,
+		.vdig_kind = VDIG_TLMM, .vdig_gpio = 57, .csiphy = 1, .phy_cbcr = 0x6044, .timer_cmd = 0x6028, .timer_cbcr = 0x6040,
+		.regs = REGS_SMIA, .bayer = 1, .gain_unity = 0x20, .gain_max = 0x200, .popup = true,
+	},
+	[SWEET_CAMERA_ULTRA] = {
