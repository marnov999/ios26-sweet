+	if (F64_EXP(a) == 0x7ff || F64_EXP(b) == 0x7ff) {
+		if ((!F64_EXP(a) && !F64_FRAC(a)) || (!F64_EXP(b) && !F64_FRAC(b))) return F64_DEFNAN;
+		if (F64_EXP(c) == 0x7ff && sc != sp) return F64_DEFNAN;
+		return F64_PACK(sp, 0x7ff, 0);
+	}
+	if (F64_EXP(c) == 0x7ff) return c;
+	prod_zero = (!F64_EXP(a) && !F64_FRAC(a)) || (!F64_EXP(b) && !F64_FRAC(b));
+	if (prod_zero) {
+		if (!F64_EXP(c) && !F64_FRAC(c)) return F64_PACK(sp & sc, 0, 0);
+		return c;
+	}
+	unpack_norm64(a, &ea, &ma);
+	unpack_norm64(b, &eb, &mb);
+	p = (u128)ma * mb;            /* [2^104, 2^106), value p * 2^(ep-1023-104) */
+	ep = ea + eb - 0x3ff;
+	if (!F64_EXP(c) && !F64_FRAC(c)) {
+		/* round the exact product */
+		uint64_t sig = (uint64_t)shr_jam128(p, 42);
+		int e = ep;
+		if (sig & 0x8000000000000000ull) { sig = shr_jam64(sig, 1); e++; }
+		return round_pack64(sp, e - 1, sig);
+	}
+	unpack_norm64(c, &ec, &mc);
+	/* express both with leading one near bit 124 of a 128-bit value:
+	 * product: p << 18 -> leading bit at 122/123 with exponent ep (bit 122)
+	 * addend:  mc << 70 -> leading bit at 122 with exponent ec */
+	p <<= 18;
+	cc = (u128)mc << 70;
+	d = ep - ec;
+	if (d >= 0) {
+		cc = shr_jam128(cc, d);
+	} else {
+		p = shr_jam128(p, -d);
+		ep = ec;
+	}
+	if (sp == sc) {
+		m = p + cc;
+		s = sp;
+	} else {
+		if (p >= cc) { m = p - cc; s = sp; }
+		else { m = cc - p; s = sc; }
+		if (!m) return F64_PACK(0, 0, 0);
+	}
+	/* normalise: leading one to bit 126, then take top 64 bits with jam */
+	{
+		int lz = 0;
+		u128 t = m;
+		uint64_t sig;
+		int e;
+		while (!(t >> 127)) { t <<= 1; lz++; }
+		/* t leading one at bit 127; value bit index (127 - lz) of m.
+		 * m bit 122 corresponds to exponent ep. */
+		e = ep + (127 - lz) - 122;
+		sig = (uint64_t)(t >> 65) | ((t << 63) != 0);   /* leading at bit 62 */
+		return round_pack64(s, e - 1, sig);
+	}
+}
+
+f64 f64_rinta(f64 a)
+{
+	int e = F64_EXP(a), s = F64_SIGN(a);
+	uint64_t m, half, mask;
+	if (e == 0x7ff) return f64_isnan(a) ? (a | F64_QBIT) : a;
+	if (e < 0x3fe) return F64_PACK(s, 0, 0);                 /* |a| < 0.5 */
+	if (e == 0x3fe) return F64_PACK(s, 0x3ff, 0);            /* 0.5 <= |a| < 1 */
+	if (e >= 0x433) return a;                                /* integral */
+	m = a & 0x7fffffffffffffffull;
+	mask = (1ull << (0x433 - e)) - 1;
+	half = 1ull << (0x432 - e);
+	m += half;
+	m &= ~mask;
+	return m | ((uint64_t)s << 63);
+}
+
+int64_t f64_to_i64_rna(f64 a)
+{
+	int e = F64_EXP(a), s = F64_SIGN(a);
+	uint64_t m;
+	if (f64_isnan(a)) return 0;
+	if (e >= 0x43e) {
+		if (s && a == 0xc3e0000000000000ull) return INT64_MIN;
+		return s ? INT64_MIN : INT64_MAX;
+	}
+	a = f64_rinta(a);
+	e = F64_EXP(a);
+	if (!e) return 0;
+	m = F64_FRAC(a) | 0x0010000000000000ull;
+	if (e >= 0x433) m <<= (e - 0x433);
+	else m >>= (0x433 - e);
+	return s ? -(int64_t)m : (int64_t)m;
+}
+
+f64 f64_from_i32(int32_t v)
+{
+	int s = v < 0, sh;
+	uint64_t m = s ? (uint64_t)(-(int64_t)v) : (uint64_t)v;
+	if (!v) return 0;
+	sh = clz64(m) - 11;          /* leading one to bit 52 */
+	m <<= sh;
+	return F64_PACK(s, 0x3ff + 52 - sh - 1, 0) + m;   /* hidden bit adds 1 to exp */
+}
+
+f64 f32_to_f64(f32 a)
+{
+	int s = F32_SIGN(a), e = F32_EXP(a);
+	uint64_t m = F32_FRAC(a);
+	if (e == 0xff) {
+		if (m) return F64_PACK(s, 0x7ff, m << 29) | F64_QBIT;
+		return F64_PACK(s, 0x7ff, 0);
+	}
+	if (!e) {
+		int sh;
+		if (!m) return F64_PACK(s, 0, 0);
+		sh = clz64(m) - 40;      /* leading one to bit 23 */
+		m <<= sh;
+		e = 1 - sh;
+		m &= 0x7fffff;
+	}
+	return F64_PACK(s, e - 127 + 1023, m << 29);
+}
+
+f32 f64_to_f32(f64 a)
+{
+	int s = F64_SIGN(a), e = F64_EXP(a);
+	uint64_t m = F64_FRAC(a);
+	uint32_t sig, rb;
+	int ex;
+	if (e == 0x7ff) {
+		if (m) return ((uint32_t)s << 31) | 0x7fc00000u | (uint32_t)(m >> 29);
+		return ((uint32_t)s << 31) | 0x7f800000u;
+	}
+	if (!e && !m) return (uint32_t)s << 31;
+	/* 64-bit sig with leading one at bit 62 */
+	if (e) { m = (m | 0x0010000000000000ull) << 10; }
+	else { int sh = clz64(m) - 1; m <<= sh; e = 1 - (sh - 10); }
+	/* value = m/2^62 * 2^(e-1023); f32 biased exponent = e - 1023 + 127 */
+	ex = e - 1023 + 127;
+	/* round to 24 bits: keep sig in bits 62..39, round bits 38..0 */
+	if (ex <= 0) {
+		/* subnormal: shift right by 1 - ex */
+		m = shr_jam64(m, 1 - ex);
+		ex = 0;
+	} else if (ex >= 0xff) {
+		return ((uint32_t)s << 31) | 0x7f800000u;
+	}
+	{
+		uint64_t keep = m >> 39;               /* 24 bits incl. hidden */
+		uint64_t rem = m & ((1ull << 39) - 1);
+		uint64_t halfv = 1ull << 38;
+		sig = (uint32_t)keep;
+		if (rem > halfv || (rem == halfv && (sig & 1))) sig++;
+		rb = 0;
+		(void)rb;
+		if (ex == 0) {
+			/* sig < 2^23 unless rounding carried into the normal range */
+			return ((uint32_t)s << 31) + sig;
+		}
+		if (sig >= 0x1000000u) { sig >>= 1; ex++; if (ex >= 0xff) return ((uint32_t)s << 31) | 0x7f800000u; }
+		return ((uint32_t)s << 31) + ((uint32_t)(ex - 1) << 23) + sig;
+	}
+}
+
+/* binary32 arithmetic via binary64 (53 >= 2*24+2, so double rounding is exact) */
+f32 f32_add(f32 a, f32 b) { return f64_to_f32(f64_add(f32_to_f64(a), f32_to_f64(b))); }
+f32 f32_sub(f32 a, f32 b) { return f64_to_f32(f64_sub(f32_to_f64(a), f32_to_f64(b))); }
+f32 f32_mul(f32 a, f32 b) { return f64_to_f32(f64_mul(f32_to_f64(a), f32_to_f64(b))); }
+f32 f32_div(f32 a, f32 b) { return f64_to_f32(f64_div(f32_to_f64(a), f32_to_f64(b))); }
+f32 f32_from_i32(int32_t v) { return f64_to_f32(f64_from_i32(v)); }
+
+static int f32_isnan(f32 a) { return F32_EXP(a) == 0xff && F32_FRAC(a); }
+
+static f32 f32_nan2(f32 a, f32 b)
+{
+	if (f32_isnan(a) && !(a & 0x400000)) return a | 0x400000;
+	if (f32_isnan(b) && !(b & 0x400000)) return b | 0x400000;
+	if (f32_isnan(a)) return a;
+	return b | 0x400000;
+}
+
+/* total order helper on non-NaN values: returns <0, 0, >0 ; -0 == +0 */
+static int f32_order(f32 a, f32 b)
+{
+	int32_t ia, ib;
+	if (!((a | b) & 0x7fffffffu)) return 0;
+	ia = (a & 0x80000000u) ? -(int32_t)(a & 0x7fffffffu) : (int32_t)a;
+	ib = (b & 0x80000000u) ? -(int32_t)(b & 0x7fffffffu) : (int32_t)b;
+	return ia < ib ? -1 : ia > ib ? 1 : 0;
+}
+
+f32 f32_min(f32 a, f32 b)
+{
+	int o;
+	if (f32_isnan(a) || f32_isnan(b)) return f32_nan2(a, b);
+	if (!((a | b) & 0x7fffffffu)) return a | b;          /* min(-0,+0) = -0 */
+	o = f32_order(a, b);
+	return o <= 0 ? a : b;
+}
+
+f32 f32_max(f32 a, f32 b)
+{
+	int o;
+	if (f32_isnan(a) || f32_isnan(b)) return f32_nan2(a, b);
+	if (!((a | b) & 0x7fffffffu)) return a & b;          /* max(-0,+0) = +0 */
+	o = f32_order(a, b);
+	return o >= 0 ? a : b;
+}
+
+int32_t f32_to_i32_rz(f32 a)
+{
+	int s = F32_SIGN(a), e = F32_EXP(a);
+	uint32_t m;
+	if (f32_isnan(a)) return 0;
+	if (e < 127) return 0;
+	if (e >= 127 + 31) {
+		return s ? INT32_MIN : INT32_MAX;
+	}
+	m = F32_FRAC(a) | 0x800000u;
+	if (e >= 150) m <<= (e - 150);
+	else m >>= (150 - e);
+	return s ? -(int32_t)m : (int32_t)m;
+}
+
+unsigned f32_cmp(f32 a, f32 b)
+{
+	int o;
+	if (f32_isnan(a) || f32_isnan(b)) return SF_C | SF_V;
+	o = f32_order(a, b);
+	if (o < 0) return SF_N;
+	if (o == 0) return SF_Z | SF_C;
+	return SF_C;
+}
+
+unsigned f64_cmp(f64 a, f64 b)
+{
+	int64_t ia, ib;
+	if (f64_isnan(a) || f64_isnan(b)) return SF_C | SF_V;
+	if (!((a | b) & 0x7fffffffffffffffull)) return SF_Z | SF_C;
+	ia = (a >> 63) ? -(int64_t)(a & 0x7fffffffffffffffull) : (int64_t)a;
+	ib = (b >> 63) ? -(int64_t)(b & 0x7fffffffffffffffull) : (int64_t)b;
+	if (ia < ib) return SF_N;
+	if (ia == ib) return SF_Z | SF_C;
+	return SF_C;
+}
+
+/* ------------------------------------------------------------------ */
+/* bionic exp (arm64 libm.so, Android 11, address 0x31ec4), bit exact.  */
+
+static const uint64_t exp_tab[256] = {
+#include "sweet_qg_exp_tab.inc"
+};
+#define EXP_INVLN2N   0x40671547652b82feull
+#define EXP_NEGLN2HI  0xbf762e42fefa0000ull
+#define EXP_NEGLN2LO  0xbd0cf79abc9e3b3aull
+#define EXP_C2        0x3fdffffffffffdbdull
+#define EXP_C3        0x3fc555555555543cull
+#define EXP_C4        0x3fa55555cf172b91ull
+#define EXP_C5        0x3f81111167a4d017ull
+
+f64 sf_exp(f64 x)
+{
+	unsigned abstop = (unsigned)(x >> 52) & 0x7ff;
+	int special = 0;
+	f64 z, kd, r, r2, tail, tmp, scale, p1, t1, p2;
+	int64_t ki;
+	uint64_t idx, sbits;
+
+	if (abstop - 0x3c9u >= 0x3fu) {
+		if ((int)abstop - 0x3c9 < 0)
+			return f64_add(x, F64_1);                    /* tiny: 1 + x */
+		if (abstop >= 0x409) {
+			if (x == 0xfff0000000000000ull) return 0;    /* -inf */
+			if (abstop >= 0x7ff) return f64_add(x, F64_1);
+			if (x >> 63)                                 /* __math_uflow(0) */
+				return f64_mul(0x1000000000000000ull, 0x1000000000000000ull);
+			return f64_mul(0x7000000000000000ull, 0x7000000000000000ull);
+		}
+		special = 1;
+	}
+	z = f64_mul(EXP_INVLN2N, x);
+	kd = f64_rinta(z);
+	ki = f64_to_i64_rna(z);
+	r = f64_fma(EXP_NEGLN2HI, kd, x);
+	r = f64_fma(kd, EXP_NEGLN2LO, r);
+	idx = ((uint64_t)ki << 1) & 0xfe;
+	tail = exp_tab[idx];
+	sbits = exp_tab[idx + 1] + ((uint64_t)ki << 45);
+	p1 = f64_fma(EXP_C3, r, EXP_C2);
+	r2 = f64_mul(r, r);
+	t1 = f64_add(tail, r);
+	t1 = f64_fma(r2, p1, t1);
+	p2 = f64_mul(r2, r2);
+	tmp = f64_fma(r, EXP_C5, EXP_C4);
+	tmp = f64_fma(p2, tmp, t1);
+	if (!special) {
+		scale = sbits;
+		return f64_fma(tmp, scale, scale);
+	}
+	/* specialcase */
+	if (!((uint32_t)ki & 0x80000000u)) {
+		f64 y;
+		sbits -= 1009ull << 52;
+		scale = sbits;
+		y = f64_fma(tmp, scale, scale);
+		return f64_mul(y, 0x7f00000000000000ull);
+	} else {
+		f64 y, hi, lo, one = F64_1, t;
+		sbits += 1022ull << 52;
+		scale = sbits;
+		lo = f64_mul(tmp, scale);
+		y = f64_add(lo, scale);
+		if (sf_mi(f64_cmp(y, one))) {
+			t = f64_sub(scale, y);
+			lo = f64_add(lo, t);
+			hi = f64_add(y, one);
+			t = f64_sub(one, hi);
+			t = f64_add(y, t);
+			lo = f64_add(lo, t);
+			y = f64_add(hi, lo);
+			y = f64_add(y, 0xbff0000000000000ull);
+			if (sf_eq(f64_cmp(y, 0))) y = 0;
+		}
+		return f64_mul(y, 0x0010000000000000ull);
+	}
+}
+#endif
