+		.sda = 27, .scl = 28, .reset = 25, .mclk_cmd = 0x5024, .mclk_cbcr = 0x503c, .mclk_pin = 14,
+		.vdig_kind = VDIG_TLMM, .vdig_gpio = 29, .csiphy = 2, .phy_cbcr = 0x6068, .timer_cmd = 0x604c, .timer_cbcr = 0x6064,
+		.regs = REGS_SMIA, .bayer = 1, .gain_unity = 0x20, .gain_max = 0x200,
