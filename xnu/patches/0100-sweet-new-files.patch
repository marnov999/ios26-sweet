+/*
+ * SWEET PM6150L L11C bring-up; see report.md for DT and source evidence.
+ * Sole XNU apps-DRV owner, called from thread context with deep idle disabled.
+ * No sleep/wake programming, SPMI writes, GIC handler, or timeout recovery.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <sys/sysctl.h>
+#include <libkern/libkern.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
+int sweet_rpmh_vreg_vote(const char *res, unsigned mv, bool on);
+
+/* Live downstream DT has two positional reg entries, no reg-names. */
+#define RH_RSC_PA       0x18220000u
+#define RH_TCS_PA       0x18220d00u
+#define RH_TCS_SIZE     0x3000u
+#define RH_DICT_PA      0x0c3f000cu
+#define RH_DRV          2u
+#define RH_ACTIVE_N     2u       /* DT order: ACTIVE 2, SLEEP 3, WAKE 3 */
+#define RH_NORMAL_N     8u       /* hidden CONTROL TCS is not in this bank */
+#define RH_TCS_STRIDE   0x2a0u
+#define RH_CMD_STRIDE   0x14u
+#define RH_IRQ_EN       0x00u
+#define RH_IRQ_STATUS   0x04u
+#define RH_IRQ_CLEAR    0x08u
+#define RH_WAIT         0x10u
+#define RH_CONTROL      0x14u
+#define RH_STATUS       0x18u
+#define RH_ENABLE       0x1cu
+#define RH_MSGID        0x30u
+#define RH_ADDR         0x34u
+#define RH_DATA         0x38u
+#define RH_CMD_STATUS   0x3cu
+#define RH_AMC_EN       (1u << 16)
+#define RH_TRIGGER      (1u << 24)
+#define RH_ISSUED       (1u << 8)
+#define RH_COMPLETE     (1u << 16)
+#define RH_WRITE_ACK    (8u | (1u << 8) | (1u << 16))
+#define RH_DB_MAGIC     0x0c0330dbu
+#define RH_DB_HEADER    144u
+#define RH_DB_ENTRY     24u
+#define RH_DB_MAX       0x100000u /* policy bound, not a DT size */
+#define RH_VRM          4u
+#define RH_TIMEOUT_US   100000u
+
+static vm_offset_t rh_rsc, rh_tcs, rh_dict, rh_db;
+static uint32_t rh_db_size;
+static unsigned rh_ncpt;
+static unsigned rh_lock;
+static bool rh_poisoned;
+
+/*
+ * Every line below, also kept here (the newest 8 KB): the kernel's message buffer holds only seconds of
+ * a boot, so the reason a vote was refused is gone before USB comes up. sysctl kern.sweet_rpmhlog.
+ */
+static char rh_log_buf[8192];
+static unsigned rh_log_len;
+
+static int
+rh_log_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	return SYSCTL_OUT(req, rh_log_buf, rh_log_len);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_rpmhlog, CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0,
+    rh_log_sysctl, "A", "the RPMh vote helper's messages");
+
+static void rh_log(const char *format, ...) __printflike(1, 2);
+
+static void
+rh_log(const char *format, ...)
+{
+	char line[200];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	printf("SWEET RPMH: %s", line);
+	size_t n = strlen(line);
+	if (rh_log_len + n > sizeof(rh_log_buf)) {
+		unsigned drop = sizeof(rh_log_buf) / 2;
+		memmove(rh_log_buf, rh_log_buf + drop, rh_log_len - drop);
+		rh_log_len -= drop;
+	}
+	memcpy(rh_log_buf + rh_log_len, line, n);
+	rh_log_len += (unsigned)n;
+}
+
+static uint32_t
+rh_read(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+rh_write(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = value;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+rh_sync(uint32_t off, uint32_t value)
+{
+	rh_write(rh_tcs, off, value);
+	for (unsigned i = 0; i < 1000; ++i) {
+		if (rh_read(rh_tcs, off) == value) {
+			return true;
+		}
+		delay(1);
+	}
+	rh_log("readback timeout off=%#x want=%#x got=%#x\n",
+	    off, value, rh_read(rh_tcs, off));
+	return false;
+}
+
+/* DB is little endian; avoid packed structs and unaligned Device loads. */
+static uint16_t
+rh_db16(uint32_t off)
+{
+	uint32_t v = rh_read(rh_db, off & ~3u);
+	return (uint16_t)(v >> (8u * (off & 3u)));
+}
+
+static bool
+rh_range(uint32_t off, uint32_t size)
+{
+	return off <= rh_db_size && size <= rh_db_size - off;
+}
+
+static int
+rh_map(void)
+{
+	if (!rh_rsc) {
+		rh_rsc = ml_io_map(RH_RSC_PA, 0x100);
+	}
+	if (!rh_tcs) {
+		rh_tcs = ml_io_map(RH_TCS_PA, RH_TCS_SIZE);
+	}
+	if (!rh_dict) {
+		rh_dict = ml_io_map(RH_DICT_PA, 8);
+	}
+	if (!rh_rsc || !rh_tcs || !rh_dict) {
+		rh_log("RSC/locator mapping failed\n");
+		return ENOMEM;
+	}
+	uint32_t id = rh_read(rh_rsc, 0);
+	uint32_t solver = rh_read(rh_rsc, 4);
+	uint32_t config = rh_read(rh_rsc, 0x0c);
+	unsigned major = (id >> 16) & 0xffu;
+	unsigned count = (config >> (6u * RH_DRV)) & 0x3fu;
+	rh_ncpt = (config >> 27) & 0x1fu;
+	rh_log("rsc=%#x tcs=%#x DRV=%u id=%#x solver=%#x config=%#x TCS=%u ncpt=%u\n",
+	    RH_RSC_PA, RH_TCS_PA, RH_DRV, id, solver, config, count, rh_ncpt);
+	/* This client implements the pre-v3 layout only; do not guess v3 offsets. */
+	if ((major != 1 && major != 2) || config == 0xffffffffu ||
+	    solver == 0xffffffffu || count < RH_NORMAL_N ||
+	    count > RH_TCS_SIZE / RH_TCS_STRIDE || rh_ncpt < 3 || rh_ncpt > 16) {
+		rh_log("unsupported RSC geometry/revision\n");
+		return ENODEV;
+	}
+	if (!rh_db) {
+		uint32_t pa = rh_read(rh_dict, 0);
+		uint32_t size = rh_read(rh_dict, 4);
+		rh_log("cmd-db locator=%#x pa=%#x size=%#x\n", RH_DICT_PA, pa, size);
+		/* Firmware supplies the reserved RAM address; never scan physical RAM. */
+		if (pa < 0x80000000u || (pa & 3u) || (size & 3u) ||
+		    size < RH_DB_HEADER || size > RH_DB_MAX ||
+		    (uint64_t)pa + size > 0x100000000ULL) {
+			rh_log("invalid cmd-db locator\n");
+			return EINVAL;
+		}
+		rh_db = ml_io_map(pa, size);
+		if (!rh_db) {
+			return ENOMEM;
+		}
+		rh_db_size = size;
+	}
+	uint32_t db_version = rh_read(rh_db, 0);
+	uint32_t magic = rh_read(rh_db, 4);
+	uint32_t flags = rh_read(rh_db, 140);
+	rh_log("cmd-db version=%#x magic=%#x checksum=%#x flags=%#x\n",
+	    db_version, magic, rh_read(rh_db, 136), flags);
+	/* Linux only checks magic; version 1 is an intentionally stricter policy. */
+	if (magic != RH_DB_MAGIC || db_version != 1 || (flags & 1u)) {
+		rh_log("unsupported/standalone cmd-db\n");
+		return EINVAL;
+	}
+	return 0;
+}
+
+static int
+rh_lookup(const char *res, uint32_t *address)
+{
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	unsigned matches = 0;
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if (slave < 3 || slave > 5 || (entries & 3u) ||
+		    !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			rh_log("malformed cmd-db slave header %u\n", i);
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = rh_read(rh_db, e + 16);
+			if (slave != RH_VRM || (addr >> 16) != RH_VRM || (addr & 15u) ||
+			    !rh_range(aux + rh_db16(e + 22), rh_db16(e + 20))) {
+				rh_log("invalid VRM entry for %s\n", res);
+				return EINVAL;
+			}
+			/* This cmd-db lists some resources twice (bobc1, both at 0x40400): one address is not ambiguous. */
+			if (matches && addr != *address) {
+				rh_log("%s at %#x and %#x; refusing\n", res, *address, addr);
+				return ENODEV;
+			}
+			*address = addr;
+			++matches;
+			rh_log("%s addr=%#x slave=%u aux-version=%#x priority=%#x:%#x\n",
+			    res, addr, slave, rh_db16(h + 8),
+			    rh_read(rh_db, e + 8), rh_read(rh_db, e + 12));
+		}
+	}
+	if (matches == 0) {
+		rh_log("%s not in cmd-db; refusing\n", res);
+		return ENODEV;
+	}
+	return 0;
+}
+
+static bool
+rh_free(unsigned t)
+{
+	uint32_t b = t * RH_TCS_STRIDE;
+	/* Idle alone is insufficient: a sleep/wake payload can be armed and idle. */
+	return rh_read(rh_tcs, b + RH_STATUS) != 0 &&
+	    rh_read(rh_tcs, b + RH_STATUS) != 0xffffffffu &&
+	    rh_read(rh_tcs, b + RH_CONTROL) == 0 &&
+	    rh_read(rh_tcs, b + RH_ENABLE) == 0 &&
+	    rh_read(rh_tcs, b + RH_WAIT) == 0 &&
+	    !(rh_read(rh_tcs, RH_IRQ_STATUS) & (1u << t));
+}
+
+static int
+rh_send(uint32_t address, unsigned mv, uint32_t mode, bool on)
+{
+	int chosen = -1;
+	for (unsigned t = 0; t < RH_ACTIVE_N; ++t) {
+		uint32_t b = t * RH_TCS_STRIDE;
+		uint32_t enabled = rh_read(rh_tcs, b + RH_ENABLE);
+		rh_log("ACTIVE TCS%u idle=%#x control=%#x enable=%#x wait=%#x\n",
+		    t, rh_read(rh_tcs, b + RH_STATUS), rh_read(rh_tcs, b + RH_CONTROL),
+		    enabled, rh_read(rh_tcs, b + RH_WAIT));
+		if (enabled & ~((1u << rh_ncpt) - 1u)) {
+			return EIO;
+		}
+		for (unsigned c = 0; c < rh_ncpt; ++c) {
+			if ((enabled & (1u << c)) &&
+			    (rh_read(rh_tcs, b + RH_ADDR + c * RH_CMD_STRIDE) & ~15u) == address) {
+				rh_log("conflicting inherited L11C request in TCS%u\n", t);
+				return EBUSY;
+			}
+		}
+		if (chosen < 0 && rh_free(t)) {
+			chosen = (int)t;
+		}
+	}
+	if (chosen < 0) {
+		rh_log("no empty idle ACTIVE TCS; leaving inherited state intact\n");
+		return EBUSY;
+	}
+	unsigned t = (unsigned)chosen;
+	uint32_t b = t * RH_TCS_STRIDE, bit = 1u << t;
+	uint32_t irq_en = rh_read(rh_tcs, RH_IRQ_EN);
+	if (irq_en == 0xffffffffu || !rh_free(t)) {
+		return EBUSY;
+	}
+	/* Only this TCS's source is masked. Other sources/CPU IRQs remain intact. */
+	if (!rh_sync(RH_IRQ_EN, irq_en & ~bit)) {
+		rh_poisoned = true;
+		return EIO;
+	}
+	if (!rh_free(t)) {
+		/* No payload was touched. Do not acknowledge somebody else's IRQ. */
+		if (!rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+			rh_poisoned = true;
+		}
+		return EBUSY;
+	}
+	/* From here an uncertain write/timeout quarantines our slot for this boot. */
+	rh_poisoned = true;
+	/* The allow-list's mode (PMIC5 raw: LDO HPM 7, SMPS/BOB AUTO 6); enable comes last. */
+	const uint32_t offsets[3] = {0, 8, 4};
+	const uint32_t values[3] = {mv, mode, on ? 1u : 0u};
+	rh_log("TCS%u ACTIVE %u mV mode=%u enable=%d irq-enable=%#x\n", t, mv, mode, on, irq_en);
+	for (unsigned c = 0; c < 3; ++c) {
+		uint32_t cmd = b + c * RH_CMD_STRIDE;
+		if (!rh_sync(cmd + RH_MSGID, RH_WRITE_ACK) ||
+		    !rh_sync(cmd + RH_ADDR, address + offsets[c]) ||
+		    !rh_sync(cmd + RH_DATA, values[c])) {
+			return EIO;
+		}
+	}
+	if (!rh_sync(b + RH_WAIT, 7) || !rh_sync(b + RH_ENABLE, 7) ||
+	    !rh_sync(b + RH_CONTROL, 0) || !rh_sync(b + RH_CONTROL, RH_AMC_EN)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, b + RH_CONTROL, RH_AMC_EN | RH_TRIGGER);
+	uint32_t irq = 0, idle = 0, status[3] = {0, 0, 0};
+	bool done = false, progress = false;
+	for (unsigned us = 0; us < RH_TIMEOUT_US; ++us) {
+		irq = rh_read(rh_tcs, RH_IRQ_STATUS);
+		idle = rh_read(rh_tcs, b + RH_STATUS);
+		bool complete = true;
+		for (unsigned c = 0; c < 3; ++c) {
+			status[c] = rh_read(rh_tcs, b + RH_CMD_STATUS + c * RH_CMD_STRIDE);
+			complete &= status[c] != 0xffffffffu &&
+			    (status[c] & (RH_ISSUED | RH_COMPLETE)) == (RH_ISSUED | RH_COMPLETE);
+		}
+		/* A fresh IRQ or observed execution transition excludes stale CMD_STATUS. */
+		progress |= idle == 0 || !complete;
+		if (idle && idle != 0xffffffffu && irq != 0xffffffffu &&
+		    ((irq & bit) || progress) && complete) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	rh_log("TCS%u done=%d irq=%#x idle=%#x control=%#x cmd-status=%#x/%#x/%#x\n",
+	    t, done, irq, idle, rh_read(rh_tcs, b + RH_CONTROL), status[0], status[1], status[2]);
+	if (!done) {
+		rh_log("timeout; TCS quarantined, IRQ remains masked; no reset/retry\n");
+		return ETIMEDOUT;
+	}
+	/* Proven completion: clear trigger before mode, then free only our commands. */
+	if (!rh_sync(b + RH_CONTROL, RH_AMC_EN) || !rh_sync(b + RH_CONTROL, 0) ||
+	    !rh_sync(b + RH_ENABLE, 0) || !rh_sync(b + RH_WAIT, 0)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, RH_IRQ_CLEAR, bit); /* W1C: never clear other TCS bits */
+	if ((rh_read(rh_tcs, RH_IRQ_STATUS) & bit) ||
+	    !rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+		return EIO;
+	}
+	rh_poisoned = false;
+	rh_log("%#x ACTIVE vote (enable %d) complete (rail voltage requires hardware verification)\n",
+	    address, on);
+	return 0;
+}
+
+/*
+ * Our (apps) vote for one of the few rails listed: its voltage, mode, and on or off. RPMh
+ * aggregates the votes of every processor, so an off vote turns a rail off only if nobody else wants
+ * it. ldoc11: the touch controller's 3.2 V; ldoa18: the panel's vdda-3p3 (3.0 V; MIUI's dsi panel
+ * supply entry 1, cut in dsi_panel_power_off). 0160, the cameras (davinci-sdmmagpie-camera-sensor.dtsi,
+ * clamped to the regulators' ranges in the live DT; bsd/dev/sweet_camera.c, sweetcam >= 2 only):
+ * ldoa16 VIO 1.8 V, ldoc9 CUSTOM 2.952-3.008 V (PMIC5 LDOs: HPM), smpc8 VDIG input 1.352 V and
+ * bobc1 VANA 3.296 V (PMIC5 SMPS / BOB: AUTO, not forced PWM).
+ */
+static const struct {
+	const char *res;
+	unsigned mv_min, mv_max;
+	uint32_t mode;
+} rh_allowed[] = {
+	{ "ldoc11", 2950, 3400, 7 }, { "ldoa18", 2950, 3050, 7 },
+	{ "ldoa16", 1800, 1800, 7 }, { "ldoc9", 2952, 3008, 7 },
+	{ "smpc8", 1352, 1352, 6 }, { "bobc1", 3296, 3296, 6 },
+};
+
+int
+sweet_rpmh_vreg_vote(const char *res, unsigned mv, bool on)
+{
+	/* Board-specific helper: do not apply a rail's policy to arbitrary resources. */
+	unsigned k = 0;
+	while (res && k < sizeof(rh_allowed) / sizeof(rh_allowed[0]) &&
+	    (strcmp(res, rh_allowed[k].res) || mv < rh_allowed[k].mv_min || mv > rh_allowed[k].mv_max)) {
+		++k;
+	}
+	if (!res || k == sizeof(rh_allowed) / sizeof(rh_allowed[0])) {
+		rh_log("%s at %u mV is not in the allow-list\n", res ? res : "(null)", mv);
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (rh_poisoned) {
+		rh_log("previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, &address);
+	}
+	if (!error) {
+		error = rh_send(address, mv, rh_allowed[k].mode, on);
+	}
+out:
+	if (error) {
+		rh_log("enable failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+int
+sweet_rpmh_vreg_enable(const char *res, unsigned mv)
+{
+	return sweet_rpmh_vreg_vote(res, mv, true);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
new file mode 100644
index 0000000..b40eccd
--- /dev/null
+++ b/bsd/dev/sweet_sample.c
@@ -0,0 +1,88 @@
+/*
+ * SWEET process sampler: where is a daemon stuck?
+ *
+ * The phone has no debugger and daemons log nowhere readable. Every
+ * interval a kernel thread prints, for each process named in boot-arg
+ * sweetsample (comma separated, default "SpringBoard,backboardd"; "-" = off)
+ * and for each of its threads, the user pc/lr/sp and a frame-pointer
+ * backtrace as "SMP name[pid] tN pc ... lr ... bt ..." (header line with the
+ * shared region slide and the main binary's mach header, to symbolicate
+ * with tools/sweet-crash.py). A thread blocked in a syscall shows the
+ * syscall stub in pc and its caller in lr/bt.
+ *
+ * First sample 90 s after start, then every 120 s, 40 samples at most.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/proc_internal.h>
+#include <kern/task.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+
+extern task_t proc_task(proc_t);
+extern int hz;
+extern void sweet_sample_start(void);
+
+static char sweet_sample_names[128];
+
+static bool
+sweet_sample_wanted(const char *name)
+{
+	size_t n = strlen(name);
+	for (const char *t = sweet_sample_names; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && n > 0 && strncmp(t, name, n) == 0) {
+			return true;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+
+extern void sweet_sample_task(const char *name, int pid, task_t task);  /* osfmk/kern/exception.c */
+
+static int
+sweet_sample_proc(proc_t p, __unused void *arg)
+{
+	char name[32];
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (sweet_sample_wanted(name)) {
+		task_t task = proc_task(p);
+		if (task != TASK_NULL) {
+			sweet_sample_task(name, proc_pid(p), task);
+		}
+	}
+	return PROC_RETURNED;
+}
+
+static void
+sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	if (!PE_parse_boot_argn("sweetsample", sweet_sample_names, sizeof(sweet_sample_names))) {
+		strlcpy(sweet_sample_names, "SpringBoard,backboardd", sizeof(sweet_sample_names));
+	}
+	if (sweet_sample_names[0] == '-') {
+		return;
+	}
+	(void)tsleep(&chan, PZERO, "sweetsmp", 90 * hz);
+	for (int i = 0; i < 40; i++) {
+		printf("SMP --- sample %d\n", i);
+		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
+		(void)tsleep(&chan, PZERO, "sweetsmp", 120 * hz);
+	}
+}
+
+void
+sweet_sample_start(void)
+{
+	thread_t thread;
+	if (kernel_thread_start(sweet_sample_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/sweet_spmi.c b/bsd/dev/sweet_spmi.c
new file mode 100644
index 0000000..ceae89a
--- /dev/null
+++ b/bsd/dev/sweet_spmi.c
@@ -0,0 +1,199 @@
+/*
+ * Battery-only adaptation of input/sweet_keys.c, observer EXT_READL.
+ * PMIC READ ONLY. The only MMIO store issues a 1..8-byte read command.
+ * No interrupt clear, peripheral enable, charger config, or PMIC writes.
+ * Init is serialized by the single built-in SweetBattery personality.
+ * Battery APIDs are disjoint from the existing keys' 008/4c1 APIDs.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <machine/machine_routines.h>
+#include <IOKit/IOLocks.h>
+#include "sweet_spmi.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define SP_CORE_PA 0x0c440000u
+#define SP_OBS_PA  0x0e600000u
+#define SP_CFG_PA  0x0c40a000u
+#define SP_NO_APID 0xffffu
+
+static vm_offset_t sp_core, sp_obs, sp_cfg;
+static IOLock *sp_lock;
+static unsigned sp_count;
+static bool sp_attempted, sp_ready;
+/* A timed-out command may complete late: never reuse that lane this boot. */
+static bool sp_poisoned[512];
+
+static uint32_t
+sp_rd(vm_offset_t base, unsigned off)
+{
+	uint32_t value = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+static uint16_t
+sp_find_apid(unsigned ppid)
+{
+	uint16_t found = SP_NO_APID;
+	for (unsigned i = 0; i < sp_count; ++i) {
+		uint32_t map = sp_rd(sp_core, 0x900u + 4u * i);
+		if (!map || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		unsigned owner = sp_rd(sp_cfg, 0x700u + 4u * i) & 7u;
+		if (found == SP_NO_APID || owner == 0) {
+			found = (uint16_t)i;
+		}
+	}
+	return found;
+}
+
+int
+sweet_spmi_init(void)
+{
+	if (sp_attempted) {
+		return sp_ready ? 0 : -1;
+	}
+	sp_attempted = true;
+	sp_lock = IOLockAlloc();
+	if (!sp_lock) {
+		return -1;
+	}
+	sp_core = ml_io_map(SP_CORE_PA, 0x2000);
+	sp_cfg = ml_io_map(SP_CFG_PA, 0x1000);
+	sp_obs = ml_io_map(SP_OBS_PA, 0x10000); /* EE 0, 512 * 0x80 */
+	if (!sp_core || !sp_cfg || !sp_obs) {
+		printf("SWEET BATTERY: SPMI mapping failed\n");
+		return -1;
+	}
+	uint32_t arb_version = sp_rd(sp_core, 0);
+	sp_count = sp_rd(sp_core, 4) & 0x7ffu;
+	if (arb_version < 0x50000000u || arb_version >= 0x70000000u ||
+	    !sp_count || sp_count > 512) {
+		printf("SWEET BATTERY: unsupported SPMI arb=%#x APIDs=%u\n",
+		    arb_version, sp_count);
+		return -1;
+	}
+	sp_ready = true;
+	printf("SWEET BATTERY: SPMI arb=%#x APIDs=%u, observer reads only\n",
+	    arb_version, sp_count);
+	return 0;
+}
+
+/*
+ * EXT_READL of n = 1..8 consecutive bytes of one peripheral in ONE SPMI
+ * transaction (BC = n - 1; data in RDATA0 +0x18 / RDATA1 +0x1c). n = 1 is the
+ * proven single-byte command. Multi-byte reads give atomic 16..32-bit QG/RTC/
+ * SDAM values without the QG hold bit (no writes).
+ */
+int
+sweet_spmi_read_n(unsigned sid, unsigned addr, uint8_t *out, unsigned n)
+{
+	/* Restrict access to the battery blocks; keys retain their own lanes. */
+	unsigned peripheral = addr >> 8;
+	if (!sp_ready || !out || sid != 0 || addr > 0xffffu || n < 1 || n > 8 ||
+	    (addr & 0xffu) + n > 0x100u ||
+	    (peripheral != 0x10 && peripheral != 0x11 && peripheral != 0x12 &&
+	    peripheral != 0x13 && peripheral != 0x48 && peripheral != 0x60 &&   /* 0x60: RTC_RW (reads) */
+	    peripheral != 0xb6)) {                                               /* 0xB6: QG SDAM (reads) */
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid((sid << 8) | peripheral);
+	if (apid == SP_NO_APID || sp_poisoned[apid]) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	unsigned off = 0x80u * apid;
+	uint32_t cmd = (1u << 27) | ((addr & 0xffu) << 4) | (n - 1u);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(sp_obs + off) = cmd; /* EXT_READL, BC=n-1 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(sp_obs, off + 0x08u);
+		if (status & 1u) {
+			if (status & 0x0eu) {
+				IOLockUnlock(sp_lock);
+				return -1;
+			}
+			uint32_t d0 = sp_rd(sp_obs, off + 0x18u);
+			uint32_t d1 = n > 4 ? sp_rd(sp_obs, off + 0x1cu) : 0;
+			for (unsigned b = 0; b < n; ++b) {
+				out[b] = (uint8_t)((b < 4 ? d0 >> (8u * b) : d1 >> (8u * (b - 4u))) & 0xffu);
+			}
+			IOLockUnlock(sp_lock);
+			return 0;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	printf("SWEET BATTERY: SPMI timeout sid=%u addr=%#x n=%u APID=%u disabled\n",
+	    sid, addr, n, apid);
+	IOLockUnlock(sp_lock);
+	return -1;
+}
+
+int
+sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
+{
+	return sweet_spmi_read_n(sid, addr, out, 1);
+}
+/*
+ * The one write this file allows: the QG SDAM's SOC parameters, 0xB646..0xB657 (VALID, SOC, TEMP, RBAT,
+ * OCV, IBAT, TIME -- what qpnp-qg's qg_store_soc_params / update_msoc write), so MIUI's next power-on SOC
+ * (and ours) continues from the number iOS showed. EXT_WRITEL of n = 1..8 bytes by our own (EE 0)
+ * channel at chnls + 0x10000 * APID, as the PON writes in sweet_gpu.c; only on an APID owned by EE 0.
+ */
+#define SP_CHNLS_PA 0x0c600000u
+int
+sweet_spmi_write_sdam(unsigned addr, const uint8_t *buf, unsigned n)
+{
+	static vm_offset_t ch;
+	static uint16_t ch_apid = SP_NO_APID;
+	if (!sp_ready || !buf || n < 1 || n > 8 || addr < 0xB646u || addr + n > 0xB658u) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid(0xB6u);
+	if (apid == SP_NO_APID || sp_poisoned[apid] || (sp_rd(sp_cfg, 0x700u + 4u * apid) & 7u) != 0) {
+		IOLockUnlock(sp_lock);
+		return -2;
+	}
+	if (ch == 0 || ch_apid != apid) {
+		ch = ml_io_map(SP_CHNLS_PA + 0x10000u * apid, 0x1000u);
+		ch_apid = apid;
+		if (ch == 0) {
+			IOLockUnlock(sp_lock);
+			return -1;
+		}
+	}
+	uint32_t w0 = 0, w1 = 0;
+	for (unsigned i = 0; i < n; i++) {
+		if (i < 4) {
+			w0 |= (uint32_t)buf[i] << (8 * i);
+		} else {
+			w1 |= (uint32_t)buf[i] << (8 * (i - 4));
+		}
+	}
+	*(volatile uint32_t *)(ch + 0x10u) = w0;                                     /* WDATA0 */
+	*(volatile uint32_t *)(ch + 0x14u) = w1;                                     /* WDATA1 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x00u) = (0u << 27) | ((addr & 0xffu) << 4) | (n - 1u);   /* EXT_WRITEL */
+	__asm__ volatile("dsb osh" ::: "memory");
+	int rc = -3;
+	for (unsigned i = 0; i < 1000u; ++i) {
+		uint32_t status = *(volatile uint32_t *)(ch + 0x08u);
+		if (status & 1u) {
+			rc = (status & 0x0eu) ? -4 : 0;
+			break;
+		}
+		delay(1);
+	}
+	IOLockUnlock(sp_lock);
+	return rc;
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_spmi.h b/bsd/dev/sweet_spmi.h
new file mode 100644
