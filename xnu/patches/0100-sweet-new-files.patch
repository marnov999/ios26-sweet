+int
+sweet_panel_brightness(uint32_t level)
+{
+	static uint32_t most = 0;       /* boot-arg sweetbl_max=N: no brighter than N (0..2047), whatever iOS asks */
+	if (most == 0) {
+		most = 0x7FFu;
+		(void)PE_parse_boot_argn("sweetbl_max", &most, sizeof(most));
+		if (most == 0 || most > 0x7FFu) {
+			most = 0x7FFu;
+		}
+	}
+	if (level > most) {
+		level = most;
+	}
+	/*
+	 * backboardd turns the backlight off as brightness 0 and back on as brightness 1, each with a
+	 * FadePeriod, and leaves it to the backlight to fade back to where it was (as Apple's does);
+	 * taken literally, the panel woke at 1 of 2047 -- dark, it looked as if it had not woken
+	 * (2026-10-26). So 1 means: the last level above it.
+	 */
+	static uint32_t last_lit = 0x218u;
+	if (level == 1u && last_lit > 1u) {
+		level = last_lit;
+	} else if (level > 1u) {
+		last_lit = level;
+	}
+	g_panel_level = level;
+	return (g_panel_off || g_wake_pending) ? 0 : panel_dcs_brightness(level);
+}
+
+static uint32_t
+g_panel_level_shown(void)
+{
+	return g_panel_level;
+}
