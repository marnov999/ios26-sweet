+#define NX_TABLET_POINTER_UNKNOWN               0
+#define NX_TABLET_POINTER_PEN                   1
+#define NX_TABLET_POINTER_CURSOR                2
+#define NX_TABLET_POINTER_ERASER                3
+
+/* TabletPointData type: defines the tablet data for points included
+ * in mouse events created by a tablet driver.
+ */
+
+typedef struct _NXTabletPointData {
+	SInt32  x;  /* absolute x coordinate in tablet space at full tablet resolution */
+    SInt32  y;  /* absolute y coordinate in tablet space at full tablet resolution */
+	SInt32  z;  /* absolute z coordinate in tablet space at full tablet resolution */
+    UInt16  buttons;   /* one bit per button - bit 0 is first button - 1 = closed  */
+    UInt16  pressure;  /* scaled pressure value; MAX=(2^16)-1, MIN=0 */
+    struct {           /* tilt range is -((2^15)-1) to (2^15)-1 (-32767 to 32767)  */
+        SInt16 x;      /* scaled tilt x value */
+        SInt16 y;      /* scaled tilt y value */
+	} tilt;
+	UInt16  rotation;  /* Fixed-point representation of device rotation in a 10.6 format */
+	SInt16  tangentialPressure; /* tangential pressure on the device; same range as tilt */
+	UInt16  deviceID;  /* system-assigned unique device ID */
+	SInt16  vendor1;   /* vendor-defined signed 16-bit integer */
+	SInt16  vendor2;   /* vendor-defined signed 16-bit integer */
+	SInt16  vendor3;   /* vendor-defined signed 16-bit integer */
+} NXTabletPointData, *NXTabletPointDataPtr;
+
+/* TabletProximityData type: defines the tablet data for proximity
+ * events included in mouse events created by a tablet driver.
+ */
+
+typedef struct _NXTabletProximityData {
+    UInt16  vendorID;             /* vendor-defined ID - typically the USB vendor ID */
+	UInt16  tabletID;             /* vendor-defined tablet ID - typically the USB product ID */
+	UInt16  pointerID;            /* vendor-defined ID of the specific pointing device */
+	UInt16  deviceID;             /* system-assigned unique device ID */
+	UInt16  systemTabletID;       /* system-assigned unique tablet ID */
+	UInt16  vendorPointerType;    /* vendor-defined pointer type */
+	UInt32  pointerSerialNumber;  /* vendor-defined serial number */
+	UInt64  uniqueID __attribute__ ((packed));             /* vendor-defined unique ID */
+	UInt32  capabilityMask;       /* capabilities mask of the device */
+	UInt8   pointerType;          /* type of pointing device */
+	UInt8   enterProximity;       /* non-zero = entering; zero = leaving */
+	SInt16  reserved1;
+} NXTabletProximityData, *NXTabletProximityDataPtr;
+
+/* EventData type: defines the data field of an event */
+
+typedef	union {
+    struct {    /* For mouse-down and mouse-up events */
+        UInt8   subx;       /* sub-pixel position for x */
+        UInt8   suby;       /* sub-pixel position for y */
+        SInt16  eventNum;   /* unique identifier for this button */
+        SInt32  click;      /* click state of this event */
+        UInt8   pressure;   /* pressure value: 0=none, 255=full */
+        UInt8   buttonNumber;/* button generating other button event (0-31) */
+        UInt8   subType;
+        UInt8   reserved2;
+        SInt32  reserved3;
+        union {
+            NXTabletPointData      point;     /* tablet point data */
+            NXTabletProximityData  proximity; /* tablet proximity data */
+        } tablet;
+    } mouse;
+    struct {
+        SInt32  dx;
+        SInt32  dy;
+        UInt8   subx;
+        UInt8   suby;
+        UInt8   subType;
+        UInt8   reserved1;
+        SInt32  reserved2;
+        union {
+            NXTabletPointData      point;     /* tablet point data */
+            NXTabletProximityData  proximity; /* tablet proximity data */
+        } tablet;
+    } mouseMove;
+    struct {    /* For key-down and key-up events */
+        UInt16  origCharSet;    /* unmodified character set code */
+        SInt16  repeat;         /* for key-down: nonzero if really a repeat */
+        UInt16  charSet;        /* character set code */
+        UInt16  charCode;       /* character code in that set */
+        UInt16  keyCode;        /* device-dependent key number */
+        UInt16  origCharCode;   /* unmodified character code */
+        SInt32  reserved1;
+        UInt32  keyboardType;
+        SInt32  reserved2;
+        SInt32  reserved3;
+        SInt32  reserved4;
+        SInt32  reserved5[4];
+    } key;
+    struct {    /* For mouse-entered and mouse-exited events */
+        SInt16  reserved;
+        SInt16  eventNum;       /* unique identifier from mouse down event */
+        SInt32  trackingNum;    /* unique identifier from settrackingrect */
+        SInt32  userData;       /* uninterpreted integer from settrackingrect */
+        SInt32  reserved1;
+        SInt32  reserved2;
+        SInt32  reserved3;
+        SInt32  reserved4;
+        SInt32  reserved5;
+        SInt32  reserved6[4];
+    } tracking;
+    struct {
+        SInt16  deltaAxis1;
+        SInt16  deltaAxis2;
+        SInt16  deltaAxis3;
+        SInt16  reserved1;
+        SInt32  fixedDeltaAxis1;
+        SInt32  fixedDeltaAxis2;
+        SInt32  fixedDeltaAxis3;
+        SInt32  pointDeltaAxis1;
+        SInt32  pointDeltaAxis2;
+        SInt32  pointDeltaAxis3;
+        SInt32  reserved8[4];
+    } scrollWheel, zoom;
+    struct {    /* For window-changed, sys-defined, and app-defined events */
+        SInt16  reserved;
+        SInt16  subType;    /* event subtype for compound events */
+        union {
+            float   F[11];  /* for use in compound events */
+            SInt32  L[11];  /* for use in compound events */
+            SInt16  S[22];  /* for use in compound events */
+            char    C[44];  /* for use in compound events */
+        } misc;
+    } compound;
+    struct {
+        SInt32  x;  /* absolute x coordinate in tablet space at full tablet resolution */
+        SInt32  y;  /* absolute y coordinate in tablet space at full tablet resolution */
+        SInt32  z;  /* absolute z coordinate in tablet space at full tablet resolution */
+        UInt16  buttons;   /* one bit per button - bit 0 is first button - 1 = closed  */
+        UInt16  pressure;  /* scaled pressure value; MAX=(2^16)-1, MIN=0 */
+        struct {           /* tilt range is -((2^15)-1) to (2^15)-1 (-32767 to 32767)  */
+            SInt16 x;      /* scaled tilt x value */
+            SInt16 y;      /* scaled tilt y value */
+        } tilt;
+        UInt16  rotation;  /* Fixed-point representation of device rotation in a 10.6 format */
+        SInt16  tangentialPressure; /* tangential pressure on the device; same range as tilt */
+        UInt16  deviceID;  /* system-assigned unique device ID */
+        SInt16  vendor1;   /* vendor-defined signed 16-bit integer */
+        SInt16  vendor2;   /* vendor-defined signed 16-bit integer */
+        SInt16  vendor3;   /* vendor-defined signed 16-bit integer */
+        SInt32  reserved[4];
+    } tablet;
+    struct {
+        UInt16  vendorID;  /* vendor-defined ID - typically the USB vendor ID */
+        UInt16  tabletID;  /* vendor-defined tablet ID - typically the USB product ID */
+        UInt16  pointerID; /* vendor-defined ID of the specific pointing device */
+        UInt16  deviceID;             /* system-assigned unique device ID */
+        UInt16  systemTabletID;       /* system-assigned unique tablet ID */
+        UInt16  vendorPointerType;    /* vendor-defined pointer type */
+        UInt32  pointerSerialNumber;  /* vendor-defined serial number */
+        UInt64  uniqueID __attribute__ ((packed));             /* vendor-defined unique ID */
+        UInt32  capabilityMask;       /* capabilities mask of the device */
+        UInt8   pointerType;          /* type of pointing device */
+        UInt8   enterProximity;       /* non-zero = entering; zero = leaving */
+        SInt16  reserved1;
+        SInt32  reserved2[4];
+    } proximity;
+} NXEventData;
+
+/* The current version number of the NXEventData structure. */
+
+#define kNXEventDataVersion		2
+
+/* Finally! The event record! */
+#ifndef __ppc__
+typedef struct _NXEvent {
+	SInt32              type;		/* An event type from above */
+    struct {
+        SInt32	x, y;					/* Base coordinates in window, */
+    } 					location;	/* from bottom left */
+    UInt64              time __attribute__ ((packed));		/* time since launch */
+    SInt32              flags;		/* key state flags */
+    UInt32              window;		/* window number of assigned window */
+    UInt64              service_id __attribute__ ((packed)); /* service id */
+    SInt32              ext_pid;    /* external pid */
+    NXEventData			data;		/* type-dependent data */
+} NXEvent, *NXEventPtr;
+
+#else
+
+typedef struct _NXEvent {
+	SInt32              type;		/* An event type from above */
+    struct {
+        SInt32	x, y;					/* Base coordinates in window, */
+    } 					location;	/* from bottom left */
+    UInt64              time __attribute__ ((packed));		/* time since launch */
+    SInt32              flags;		/* key state flags */
+    UInt32              window;		/* window number of assigned window */
+    NXEventData			data;		/* type-dependent data */
+    UInt64              service_id __attribute__ ((packed)); /* service id */
+    SInt32              ext_pid;    /* external pid */
+} NXEvent, *NXEventPtr;
+
+#endif
+
+/* The current version number of the NXEvent structure. */
+
+#define kNXEventVersion		2
+
+/* How to pick window(s) for event (for PostEvent) */
+#define NX_NOWINDOW		-1
+#define NX_BYTYPE		0
+#define NX_BROADCAST		1
+#define NX_TOPWINDOW		2
+#define NX_FIRSTWINDOW		3
+#define NX_MOUSEWINDOW		4
+#define NX_NEXTWINDOW		5
+#define NX_LASTLEFT		6
+#define NX_LASTRIGHT		7
+#define NX_LASTKEY		8
+#define NX_EXPLICIT		9
+#define NX_TRANSMIT		10
+#define NX_BYPSCONTEXT		11
+
+#endif /* EVENT_H */	/* End of defs common with dpsclient/event.h */
+
+/* Mask of events that cause the screen to wake up */
+#define NX_WAKEMASK     (   NX_KEYDOWNMASK | NX_FLAGSCHANGEDMASK | \
+                            NX_LMOUSEDOWNMASK | NX_LMOUSEUPMASK | \
+                            NX_RMOUSEDOWNMASK | NX_RMOUSEUPMASK | \
+                            NX_OMOUSEDOWNMASK | NX_OMOUSEUPMASK   \
+                        )
+
+/* Mask of events that cause screen to undim */
+#define NX_UNDIMMASK    (   NX_WAKEMASK | NX_KEYUPMASK | NX_SCROLLWHEELMOVEDMASK | \
+                            NX_LMOUSEDRAGGEDMASK | NX_RMOUSEDRAGGEDMASK | NX_OMOUSEDRAGGEDMASK | \
+                            NX_MOUSEMOVEDMASK | NX_MOUSEENTEREDMASK | NX_MOUSEEXITEDMASK | \
+                            NX_TABLETPOINTERMASK | NX_TABLETPROXIMITYMASK \
+                        )
+
+
+#define  NX_EVENT_EXTENSION_LOCATION_INVALID            0x1
+#define  NX_EVENT_EXTENSION_LOCATION_TYPE_FLOAT         0x2
+#define  NX_EVENT_EXTENSION_LOCATION_DEVICE_SCALED      0x4
+#define  NX_EVENT_EXTENSION_MOUSE_DELTA_TYPE_FLOAT      0x8
+#define  NX_EVENT_EXTENSION_AUDIT_TOKEN                 0x10
+
+typedef struct _NXEventExtension {
+    UInt32              flags;
+    audit_token_t       audit;
+} NXEventExtension;
+
+typedef struct _NXEventExt {
+    NXEvent             payload;
+    NXEventExtension    extension;
+} NXEventExt;
+
+#endif /* !_DEV_EVENT_H */
+
diff --git a/iokit/Kernel/arm/hid/SweetHID.cpp b/iokit/Kernel/arm/hid/SweetHID.cpp
new file mode 100644
index 0000000..e22ff28
--- /dev/null
+++ b/iokit/Kernel/arm/hid/SweetHID.cpp
@@ -0,0 +1,583 @@
+/*
+ * SWEET: HID event services for the iOS userland (backboardd's HID event
+ * system).
+ *
+ * backboardd watches for IOService objects with HIDServiceSupport = true,
+ * opens them with IOServiceOpen type 'esuc' (IOHIDEventServiceUserClient,
+ * compiled here from IOHIDFamily-1915.140.3, the version the iOS 16.7
+ * userland ships) and reads serialized IOHIDEvents from the user client's
+ * shared queue. This file has the minimal IOHIDEventService base class and
+ * two services:
+ *
+ *   SweetHIDButtons  consumer-control keys (power, volume, home)
+ *   SweetHIDTouch    the built-in touch screen (digitizer collections)
+ *
+ * Hardware drivers feed them through the C entry points sweet_hid_key()
+ * and sweet_hid_touch(). Boot-arg sweethidtest=N (seconds) presses Home
+ * every N seconds, to test the event path without input hardware.
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOTimerEventSource.h>
+#include <libkern/c++/OSArray.h>
+#include <pexpert/pexpert.h>
+
+#include "IOHIDEventService.h"
+#include "IOHIDEventServiceUserClient.h"
+#include "IOHIDEvent.h"
+#include "IOHIDKeys.h"
+#include "IOHIDPrivateKeys.h"
+#include "IOHIDUsageTables.h"
+
+extern "C" uint64_t mach_absolute_time(void);
+
+/* One open client: the user client and its event callback. */
+class IOHIDEventServiceClient : public OSObject {
+	OSDeclareDefaultStructors(IOHIDEventServiceClient);
+public:
+	bool                       initClient() { return OSObject::init(); }
+	IOService                 *client;
+	void                      *context;
+	IOHIDEventService::Action  action;
+};
+OSDefineMetaClassAndStructors(IOHIDEventServiceClient, OSObject);
+
+#define super IOService
+OSDefineMetaClassAndStructors(IOHIDEventService, IOService);
+
+bool
+IOHIDEventService::start(IOService *provider)
+{
+	if (!super::start(provider)) {
+		return false;
+	}
+	_clientLock = IOLockAlloc();
+	_clients = OSArray::withCapacity(2);
+	_hidWorkLoop = getWorkLoop();
+	if (!_clientLock || !_clients || !_hidWorkLoop) {
+		return false;
+	}
+	_hidWorkLoop->retain();
+	_hidGate = IOCommandGate::commandGate(this);
+	if (!_hidGate || _hidWorkLoop->addEventSource(_hidGate) != kIOReturnSuccess) {
+		return false;
+	}
+
+	OSString *transport = getTransport();
+	OSString *product = getProduct();
+	setProperty(kIOHIDTransportKey, transport);
+	setProperty(kIOHIDProductKey, product);
+	setProperty(kIOHIDManufacturerKey, "Sweet");
+	setProperty(kIOHIDVendorIDKey, getVendorID(), 32);
+	setProperty(kIOHIDProductIDKey, getProductID(), 32);
+	setProperty(kIOHIDLocationIDKey, (unsigned long long)getProductID(), 32);
+	setProperty(kIOHIDReportIntervalKey, getReportInterval(), 32);
+	setProperty(kIOHIDPrimaryUsagePageKey, getPrimaryUsagePage(), 32);
+	setProperty(kIOHIDPrimaryUsageKey, getPrimaryUsage(), 32);
+	setProperty(kIOHIDBuiltInKey, kOSBooleanTrue);
+	OSSafeReleaseNULL(transport);
+	OSSafeReleaseNULL(product);
+
+	OSDictionary *pair = OSDictionary::withCapacity(2);
+	OSArray *pairs = OSArray::withCapacity(1);
+	OSNumber *page = OSNumber::withNumber(getPrimaryUsagePage(), 32);
+	OSNumber *usage = OSNumber::withNumber(getPrimaryUsage(), 32);
+	if (pair && pairs && page && usage) {
+		pair->setObject(kIOHIDDeviceUsagePageKey, page);
+		pair->setObject(kIOHIDDeviceUsageKey, usage);
+		pairs->setObject(pair);
+		setProperty(kIOHIDDeviceUsagePairsKey, pairs);
+	}
+	OSSafeReleaseNULL(pair);
+	OSSafeReleaseNULL(pairs);
+	OSSafeReleaseNULL(page);
+	OSSafeReleaseNULL(usage);
+
+	/* What IOHIDFamily's "IOHIDEventServiceUserClient" personality merges in. */
+	setProperty("HIDServiceSupport", kOSBooleanTrue);
+	setProperty("IOUserClientClass", "IOHIDEventServiceUserClient");
+	return true;
+}
+
+void
+IOHIDEventService::free(void)
+{
+	if (_hidGate && _hidWorkLoop) {
+		_hidWorkLoop->removeEventSource(_hidGate);
+	}
+	OSSafeReleaseNULL(_hidGate);
+	OSSafeReleaseNULL(_hidWorkLoop);
+	OSSafeReleaseNULL(_clients);
+	if (_clientLock) {
+		IOLockFree(_clientLock);
+		_clientLock = NULL;
+	}
+	super::free();
+}
+
+bool
+IOHIDEventService::open(IOService *client, IOOptionBits options, void *context, Action action)
+{
+	IOHIDEventServiceClient *data = OSTypeAlloc(IOHIDEventServiceClient);
+	bool ok = false;
+
+	if (data && data->initClient()) {
+		data->client = client;
+		data->context = context;
+		data->action = action;
+		ok = super::open(client, options, data);
+	}
+	OSSafeReleaseNULL(data);
+	IOLog("SWEET HID: %s open by %s -> %d\n", getName(), client ? client->getName() : "?", ok);
+	return ok;
+}
+
+void
+IOHIDEventService::close(IOService *forClient, IOOptionBits options)
+{
+	super::close(forClient, options);
+}
+
+bool
+IOHIDEventService::handleOpen(IOService *client, IOOptionBits options __unused, void *argument)
+{
+	IOHIDEventServiceClient *data = OSDynamicCast(IOHIDEventServiceClient, (OSObject *)argument);
+	bool ok = false;
+
+	if (!data) {
+		return false;
+	}
+	IOLockLock(_clientLock);
+	if (!handleIsOpenLocked(client)) {
+		/* Copy on write: dispatchEvent iterates a snapshot without the lock. */
+		OSArray *next = OSArray::withArray(_clients, _clients->getCount() + 1);
+		if (next && next->setObject(data)) {
+			_clients->release();
+			_clients = next;
+			ok = true;
+		} else {
+			OSSafeReleaseNULL(next);
+		}
+	}
+	IOLockUnlock(_clientLock);
+	return ok;
+}
+
+void
+IOHIDEventService::handleClose(IOService *client, IOOptionBits options __unused)
+{
+	IOLockLock(_clientLock);
+	OSArray *next = OSArray::withCapacity(_clients->getCount());
+	if (next) {
+		for (unsigned int i = 0; i < _clients->getCount(); i++) {
+			IOHIDEventServiceClient *data = (IOHIDEventServiceClient *)_clients->getObject(i);
+			if (data->client != client) {
+				next->setObject(data);
+			}
+		}
+		_clients->release();
+		_clients = next;
+	}
+	IOLockUnlock(_clientLock);
+}
+
+bool
+IOHIDEventService::handleIsOpenLocked(const IOService *client) const
+{
+	for (unsigned int i = 0; i < _clients->getCount(); i++) {
+		IOHIDEventServiceClient *data = (IOHIDEventServiceClient *)_clients->getObject(i);
+		if (client == NULL || data->client == client) {
+			return true;
+		}
+	}
+	return false;
+}
+
+bool
+IOHIDEventService::handleIsOpen(const IOService *client) const
+{
+	IOLockLock(_clientLock);
+	bool open = handleIsOpenLocked(client);
+	IOLockUnlock(_clientLock);
+	return open;
+}
+
+void
+IOHIDEventService::dispatchEvent(IOHIDEvent *event, IOOptionBits options)
+{
+	OSArray *clients;
+
+	event->setSenderID(getRegistryEntryID());
+	IOLockLock(_clientLock);
+	clients = _clients;
+	clients->retain();
+	IOLockUnlock(_clientLock);
+
+	for (unsigned int i = 0; i < clients->getCount(); i++) {
+		IOHIDEventServiceClient *data = (IOHIDEventServiceClient *)clients->getObject(i);
+		if (data->action) {
+			(*data->action)(data->client, this, data->context, event, options);
+		}
+	}
+	clients->release();
+}
+
+IOHIDEvent *
+IOHIDEventService::copyEvent(IOHIDEventType type __unused, IOHIDEvent *matching __unused, IOOptionBits options __unused)
+{
+	return NULL;
+}
+
+IOHIDEvent *
+IOHIDEventService::copyMatchingEvent(OSDictionary *matching __unused)
+{
+	return NULL;
+}
+
+IOReturn
+IOHIDEventService::setElementValue(UInt32 usagePage __unused, UInt32 usage __unused, UInt32 value __unused)
+{
+	return kIOReturnUnsupported;
+}
+
+IOReturn
+IOHIDEventService::setProperties(OSObject *properties)
+{
+	/* The event system pushes its settings here; nothing to configure. */
+	return OSDynamicCast(OSDictionary, properties) ? kIOReturnSuccess : kIOReturnBadArgument;
+}
+
+UInt32
+IOHIDEventService::getPrimaryUsagePage()
+{
+	return 0;
+}
+
+UInt32
+IOHIDEventService::getPrimaryUsage()
+{
+	return 0;
+}
+
+OSString *
+IOHIDEventService::getTransport()
+{
+	return OSString::withCString("SPU");
+}
+
+OSString *
+IOHIDEventService::getProduct()
+{
+	return OSString::withCString(getName());
+}
+
+UInt32
+IOHIDEventService::getVendorID()
+{
+	return 0x05ac;
+}
+
+UInt32
+IOHIDEventService::getProductID()
+{
+	return 0;
+}
+
+UInt32
+IOHIDEventService::getReportInterval()
+{
+	return 10000;	/* us */
+}
+
+IOReturn
+IOHIDEventService::newUserClient(task_t owningTask, void *securityID, UInt32 type,
+    OSDictionary *properties, IOUserClient **handler)
+{
+	IOUserClient *client;
+
+	if (type != kIOHIDEventServiceUserClientType) {
+		IOLog("SWEET HID: %s user client type 0x%x unsupported\n", getName(), (unsigned)type);
+		return super::newUserClient(owningTask, securityID, type, properties, handler);
+	}
+	client = OSTypeAlloc(IOHIDEventServiceUserClient);
+	if (!client) {
+		return kIOReturnNoMemory;
+	}
+	if (!client->initWithTask(owningTask, securityID, type)) {
+		client->release();
+		IOLog("SWEET HID: %s user client init refused\n", getName());
+		return kIOReturnBadArgument;
+	}
+	if (!client->attach(this)) {
+		client->release();
+		return kIOReturnUnsupported;
+	}
+	if (!client->start(this)) {
+		client->detach(this);
+		client->release();
+		return kIOReturnUnsupported;
+	}
+	*handler = client;
+	return kIOReturnSuccess;
+}
+
+/*
+ * Buttons. iOS takes the side/volume/home buttons as consumer-control
+ * keyboard events (AppleM68Buttons publishes the same usage pair).
+ */
+class SweetHIDButtons : public IOHIDEventService {
+	OSDeclareDefaultStructors(SweetHIDButtons);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void key(UInt32 usage, bool down);
+protected:
+	virtual UInt32 getPrimaryUsagePage() APPLE_KEXT_OVERRIDE { return kHIDPage_Consumer; }
+	virtual UInt32 getPrimaryUsage() APPLE_KEXT_OVERRIDE { return kHIDUsage_Csmr_ConsumerControl; }
+	virtual UInt32 getProductID() APPLE_KEXT_OVERRIDE { return 1; }
+private:
+	static void testFired(OSObject *owner, IOTimerEventSource *sender);
+	IOTimerEventSource *fTest;
+	UInt32 fTestSecs;
+	UInt32 fTestCount;
+};
+OSDefineMetaClassAndStructors(SweetHIDButtons, IOHIDEventService);
+
+/*
+ * Touch screen: digitizer collection events with finger children,
+ * coordinates normalized to 0..1 like IOHIDEventDriver produces for
+ * absolute digitizers.
+ */
+#define SWEET_TOUCH_FINGERS 10
+/*
+ * Contacts that start this close to a panel edge (pixels, ~3 mm) carry
+ * kIOHIDDigitizerEventFromEdgeTip for their whole life, as Apple's touch
+ * firmware reports them. UIKit derives UITouch's edge type from that bit
+ * (_UIEventHIDTouchEdgeTypeForHIDEvent); without it there is no home or
+ * app-switcher gesture.
+ */
+#define SWEET_TOUCH_EDGE_PX 48
+/* what sweet_touch.c reports: the panel's 1080 columns, its 2340 rows stretched to 2400 */
+#define SWEET_TOUCH_W 1080
+#define SWEET_TOUCH_H 2400
+class SweetHIDTouch : public IOHIDEventService {
+	OSDeclareDefaultStructors(SweetHIDTouch);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void touch(int finger, bool down, int x, int y);
+protected:
+	virtual UInt32 getPrimaryUsagePage() APPLE_KEXT_OVERRIDE { return kHIDPage_Digitizer; }
+	virtual UInt32 getPrimaryUsage() APPLE_KEXT_OVERRIDE { return kHIDUsage_Dig_TouchScreen; }
+	virtual UInt32 getProductID() APPLE_KEXT_OVERRIDE { return 2; }
+private:
+	IOLock *fLock;
+	int fLogicalW, fLogicalH, fOffX, fOffY;
+	bool fScaled;   /* the whole panel is the whole presented display (SweetFramebuffer.cpp fScale) */
+	bool fDown[SWEET_TOUCH_FINGERS];
+	bool fEdge[SWEET_TOUCH_FINGERS];
+	IOFixed fX[SWEET_TOUCH_FINGERS];
+	IOFixed fY[SWEET_TOUCH_FINGERS];
+};
+OSDefineMetaClassAndStructors(SweetHIDTouch, IOHIDEventService);
+
+static SweetHIDButtons *gSweetButtons;
+static SweetHIDTouch *gSweetTouch;
+
+bool
+SweetHIDButtons::start(IOService *provider)
+{
+	if (!IOHIDEventService::start(provider)) {
+		return false;
+	}
+	if (PE_parse_boot_argn("sweethidtest", &fTestSecs, sizeof(fTestSecs)) && fTestSecs) {
+		fTest = IOTimerEventSource::timerEventSource(this, &SweetHIDButtons::testFired);
+		if (fTest && _hidWorkLoop->addEventSource(fTest) == kIOReturnSuccess) {
+			fTest->setTimeoutMS(fTestSecs * 1000);
+		}
+	}
+	gSweetButtons = this;
+	registerService();
+	IOLog("SWEET HID: buttons registered (test every %u s)\n", fTestSecs);
+	return true;
+}
+
+void
+SweetHIDButtons::key(UInt32 usage, bool down)
+{
+	IOHIDEvent *event = IOHIDEvent::keyboardEvent(mach_absolute_time(), kHIDPage_Consumer, usage, down);
+
+	if (event) {
+		IOLog("SWEET HID: key 0x%x %s (%u clients)\n", (unsigned)usage, down ? "down" : "up",
+		    _clients ? _clients->getCount() : 0);
+		dispatchEvent(event);
+		event->release();
+	}
+}
+
+void
+SweetHIDButtons::testFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	SweetHIDButtons *self = (SweetHIDButtons *)owner;
+
+	/*
+	 * Home (Menu) press, then the release 100 ms later; Setup's "Hello"
+	 * screen waits for it. Even counts press, odd counts release.
+	 */
+	bool press = (self->fTestCount & 1) == 0;
+	self->key(kHIDUsage_Csmr_Menu, press);
+	if (++self->fTestCount < 60) {
+		sender->setTimeoutMS(press ? 100 : self->fTestSecs * 1000);
+	}
+}
+
+bool
+SweetHIDTouch::start(IOService *provider)
+{
+	fLock = IOLockAlloc();
+	if (!fLock || !IOHIDEventService::start(provider)) {
+		return false;
+	}
+	int native = 0, scale = 1;
+	PE_parse_boot_argn("sweetfb_native", &native, sizeof(native));
+	PE_parse_boot_argn("sweetfb_scale", &scale, sizeof(scale));
+	fLogicalW = native ? 1080 : 1125;
+	fLogicalH = native ? 2400 : 2436;
+	fOffX = (fLogicalW - 1080) / 2;
+	fOffY = (fLogicalH - 2400) / 2;
+	/*
+	 * As SweetFramebuffer.cpp shows the display: scaled onto the whole panel (boot-args as there,
+	 * sweetfb_scale default 1), the panel's edges are the display's; cropped (sweetfb_scale=0), the
+	 * panel is the centered part of it.
+	 */
+	fScaled = !native && scale != 0;
+	/* The digitizer covers the main display (backboardd maps it 1:1). */
+	setProperty("DisplayIntegrated", kOSBooleanTrue);
+	setProperty("SurfaceWidth", (unsigned long long)(68 << 16), 32);	/* mm, 16.16 */
+	setProperty("SurfaceHeight", (unsigned long long)(151 << 16), 32);
+	gSweetTouch = this;
+	registerService();
+	IOLog("SWEET HID: touch registered (%s %dx%d)\n", fScaled ? "the whole panel onto" : "the panel centered on",
+	    fLogicalW, fLogicalH);
+	return true;
+}
+
+void
+SweetHIDTouch::touch(int finger, bool down, int x, int y)
+{
+	uint64_t now = mach_absolute_time();
+	IOHIDEvent *collection;
+	bool any = false;
+
+	if (finger < 0 || finger >= SWEET_TOUCH_FINGERS) {
+		return;
+	}
+	x = x < 0 ? 0 : (x > 1079 ? 1079 : x);
+	y = y < 0 ? 0 : (y > 2399 ? 2399 : y);
+
+	IOLockLock(fLock);
+	bool was = fDown[finger];
+	/*
+	 * Panel pixels -> the presented 1125x2436 display (SweetFramebuffer.cpp), 0..1 across it. Scaled,
+	 * a pixel's centre: panel x 0 and 1079 are 0.0005 and 0.9995 of the display, its pixels 0 and 1124
+	 * as the framebuffer shows them there.
+	 */
+	IOFixed nx, ny;
+	if (fScaled) {
+		nx = (IOFixed)((((int64_t)x * 2 + 1) << 16) / (2 * SWEET_TOUCH_W));
+		ny = (IOFixed)((((int64_t)y * 2 + 1) << 16) / (2 * SWEET_TOUCH_H));
+	} else {
+		nx = (IOFixed)(((int64_t)(x + fOffX) << 16) / fLogicalW);
+		ny = (IOFixed)(((int64_t)(y + fOffY) << 16) / fLogicalH);
+	}
+	bool moved = down && (nx != fX[finger] || ny != fY[finger]);
+	if (was == down && !moved) {
+		IOLockUnlock(fLock);
+		return;
+	}
+	if (!was && down) {
+		fEdge[finger] = x < SWEET_TOUCH_EDGE_PX || x > 1079 - SWEET_TOUCH_EDGE_PX ||
+		    y < SWEET_TOUCH_EDGE_PX || y > 2399 - SWEET_TOUCH_EDGE_PX;
+	}
+
+	collection = IOHIDEvent::digitizerEvent(now, 0, kIOHIDDigitizerTransducerTypeHand, false, 0, 0, 0);
+	if (!collection) {
+		IOLockUnlock(fLock);
+		return;
+	}
+	collection->setIntegerValue(kIOHIDEventFieldDigitizerCollection, TRUE);
+
+	UInt32 cmask = 0;
+	for (int i = 0; i < SWEET_TOUCH_FINGERS; i++) {
+		bool d = (i == finger) ? down : fDown[i];
+		if (i != finger && !d) {
+			continue;
+		}
+		IOFixed fx = (i == finger && down) ? nx : fX[i];
+		IOFixed fy = (i == finger && down) ? ny : fY[i];
+		IOHIDEvent *child = IOHIDEvent::digitizerEvent(now, (UInt32)i + 2, kIOHIDDigitizerTransducerTypeFinger,
+		    d, d ? 1 : 0, fx, fy);
+		if (!child) {
+			continue;
+		}
+		UInt32 mask = fEdge[i] ? kIOHIDDigitizerEventFromEdgeTip : 0;
+		if (i == finger) {
+			if (was != down) {
+				mask |= kIOHIDDigitizerEventTouch | kIOHIDDigitizerEventRange;
+			}
+			if (moved) {
+				mask |= kIOHIDDigitizerEventPosition;
+			}
+			if (!was && down) {
+				mask |= kIOHIDDigitizerEventIdentity;
+			}
+		}
+		child->setIntegerValue(kIOHIDEventFieldDigitizerIndex, i);
+		child->setIntegerValue(kIOHIDEventFieldDigitizerIdentity, i + 2);
+		child->setIntegerValue(kIOHIDEventFieldDigitizerTouch, d);
+		child->setIntegerValue(kIOHIDEventFieldDigitizerEventMask, mask);
+		collection->appendChild(child);
+		child->release();
+		cmask |= mask;
+		any |= d;
+	}
+	fDown[finger] = down;
+	if (down) {
+		fX[finger] = nx;
+		fY[finger] = ny;
+	}
+	collection->setFixedValue(kIOHIDEventFieldDigitizerX, nx);
+	collection->setFixedValue(kIOHIDEventFieldDigitizerY, ny);
+	collection->setIntegerValue(kIOHIDEventFieldDigitizerRange, any);
+	collection->setIntegerValue(kIOHIDEventFieldDigitizerTouch, any);
+	collection->setIntegerValue(kIOHIDEventFieldDigitizerEventMask, cmask);
+	collection->setIntegerValue(kIOHIDEventFieldDigitizerButtonMask, any ? 1 : 0);
+	IOLockUnlock(fLock);
+
+	if (was != down) {
+		IOLog("SWEET HID: touch %d %s at %d,%d%s\n", finger, down ? "down" : "up", x, y,
+		    fEdge[finger] ? " edge" : "");
+	}
+	dispatchEvent(collection);
+	collection->release();
+}
+
+/* key: 0 power (side button), 1 volume up, 2 volume down, 3 home */
+extern "C" void
+sweet_hid_key(int key, int down)
+{
+	static const UInt32 usages[] = {
+		kHIDUsage_Csmr_Power, kHIDUsage_Csmr_VolumeIncrement,
+		kHIDUsage_Csmr_VolumeDecrement, kHIDUsage_Csmr_Menu,
+	};
+
+	if (gSweetButtons && key >= 0 && key < (int)(sizeof(usages) / sizeof(usages[0]))) {
+		gSweetButtons->key(usages[key], down != 0);
+	}
+}
+
+extern "C" void
+sweet_hid_touch(int finger, int down, int x, int y)
+{
+	if (gSweetTouch) {
+		gSweetTouch->touch(finger, down != 0, x, y);
+	}
+}
diff --git a/iokit/Kernel/arm/hid/ev_keymap.h b/iokit/Kernel/arm/hid/ev_keymap.h
new file mode 100644
index 0000000..e6db930
--- /dev/null
+++ b/iokit/Kernel/arm/hid/ev_keymap.h
@@ -0,0 +1,171 @@
+/*
+ * @APPLE_LICENSE_HEADER_START@
+ *
+ * Copyright (c) 1999-2003 Apple Computer, Inc.  All Rights Reserved.
+ *
+ * This file contains Original Code and/or Modifications of Original Code
+ * as defined in and that are subject to the Apple Public Source License
+ * Version 2.0 (the 'License'). You may not use this file except in
+ * compliance with the License. Please obtain a copy of the License at
+ * http://www.opensource.apple.com/apsl/ and read it before using this
+ * file.
+ *
+ * The Original Code and all software distributed under the License are
+ * distributed on an 'AS IS' basis, WITHOUT WARRANTY OF ANY KIND, EITHER
+ * EXPRESS OR IMPLIED, AND APPLE HEREBY DISCLAIMS ALL SUCH WARRANTIES,
+ * INCLUDING WITHOUT LIMITATION, ANY WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE, QUIET ENJOYMENT OR NON-INFRINGEMENT.
+ * Please see the License for the specific language governing rights and
+ * limitations under the License.
+ *
+ * @APPLE_LICENSE_HEADER_END@
+ */
+/* 	Copyright (c) 1992 NeXT Computer, Inc.  All rights reserved.
+ *
+ *	ev_keymap.h
+ *	Defines the structure used for parsing keymappings.  These structures
+ *	and definitions are used by event sources in the kernel and by
+ *	applications and utilities which manipulate keymaps.
+ *
+ * HISTORY
+ * 02-Jun-1992    Mike Paquette at NeXT
+ *      Created.
+ */
+
+#ifndef _DEV_EV_KEYMAP_H
+#define _DEV_EV_KEYMAP_H
+
+#define	NX_NUMKEYCODES	256	/* Highest key code is 0xff. ADB used to use 0x80 for keydown state, but who the heck uses adb anymore. */
+#define NX_NUMSEQUENCES	128	/* Maximum possible number of sequences */
+#define	NX_NUMMODIFIERS	16	/* Maximum number of modifier bits */
+#define	NX_BYTE_CODES	0	/* If first short 0, all are bytes (else shorts) */
+
+#define	NX_WHICHMODMASK	0x0f 	/* bits out of keyBits for bucky bits */
+#define	NX_MODMASK	0x10	/* Bit out of keyBits indicates modifier bit */
+#define	NX_CHARGENMASK	0x20	/* bit out of keyBits for char gen */
+#define	NX_SPECIALKEYMASK 0x40	/* bit out of keyBits for specialty key */
+#define	NX_KEYSTATEMASK	0x80	/* OBSOLETE - DO NOT USE IN NEW DESIGNS */
+
+/*
+ * Special keys currently known to and understood by the system.
+ * If new specialty keys are invented, extend this list as appropriate.
+ * The presence of these keys in a particular implementation is not
+ * guaranteed.
+ */
+#define NX_NOSPECIALKEY			0xFFFF
+#define NX_KEYTYPE_SOUND_UP		0
+#define NX_KEYTYPE_SOUND_DOWN		1
+#define NX_KEYTYPE_BRIGHTNESS_UP	2
+#define NX_KEYTYPE_BRIGHTNESS_DOWN	3
+#define NX_KEYTYPE_CAPS_LOCK		4
+#define NX_KEYTYPE_HELP			5
+#define NX_POWER_KEY			6
+#define	NX_KEYTYPE_MUTE			7
+#define NX_UP_ARROW_KEY			8
+#define NX_DOWN_ARROW_KEY		9
+#define NX_KEYTYPE_NUM_LOCK		10
+
+#define NX_KEYTYPE_CONTRAST_UP		11
+#define NX_KEYTYPE_CONTRAST_DOWN	12
+#define NX_KEYTYPE_LAUNCH_PANEL		13
+#define NX_KEYTYPE_EJECT		14
+#define NX_KEYTYPE_VIDMIRROR		15
+
+#define NX_KEYTYPE_PLAY			16
+#define NX_KEYTYPE_NEXT			17
+#define NX_KEYTYPE_PREVIOUS		18
+#define NX_KEYTYPE_FAST			19
+#define NX_KEYTYPE_REWIND		20
+
+#define NX_KEYTYPE_ILLUMINATION_UP	21
+#define NX_KEYTYPE_ILLUMINATION_DOWN	22
+#define NX_KEYTYPE_ILLUMINATION_TOGGLE	23
+
+#define	NX_NUMSPECIALKEYS		24 /* Maximum number of special keys */
+#define NX_NUM_SCANNED_SPECIALKEYS	24 /* First 24 special keys are */
+					  /* actively scanned in kernel */
+
+#define NX_KEYTYPE_MENU		25
+
+/* Mask of special keys that are posted as events */
+
+#define NX_SPECIALKEY_POST_MASK		\
+                                ((1 << NX_KEYTYPE_SOUND_UP) | (1 << NX_KEYTYPE_SOUND_DOWN) | \
+                                (1 << NX_POWER_KEY) | (1 << NX_KEYTYPE_MUTE) | \
+                                (1 << NX_KEYTYPE_BRIGHTNESS_UP) | (1 << NX_KEYTYPE_BRIGHTNESS_DOWN) | \
+                                (1 << NX_KEYTYPE_CONTRAST_UP) | (1 << NX_KEYTYPE_CONTRAST_UP) | \
+                                (1 << NX_KEYTYPE_LAUNCH_PANEL) | (1 << NX_KEYTYPE_EJECT) | \
+                                (1 << NX_KEYTYPE_VIDMIRROR) | (1 << NX_KEYTYPE_PLAY) | \
+                                (1 << NX_KEYTYPE_NEXT) | (1 << NX_KEYTYPE_PREVIOUS) | \
+                                (1 << NX_KEYTYPE_FAST) | (1 << NX_KEYTYPE_REWIND) | \
+                                (1 << NX_KEYTYPE_ILLUMINATION_UP) | \
+                                (1 << NX_KEYTYPE_ILLUMINATION_DOWN) | \
+                                (1 << NX_KEYTYPE_ILLUMINATION_TOGGLE) | 0)
+
+/* Modifier key indices into modDefs[] */
+#define NX_MODIFIERKEY_ALPHALOCK	0
+#define NX_MODIFIERKEY_SHIFT		1
+#define NX_MODIFIERKEY_CONTROL		2
+#define NX_MODIFIERKEY_ALTERNATE	3
+#define NX_MODIFIERKEY_COMMAND		4
+#define NX_MODIFIERKEY_NUMERICPAD	5
+#define NX_MODIFIERKEY_HELP		6
+#define NX_MODIFIERKEY_SECONDARYFN     	7
+#define NX_MODIFIERKEY_NUMLOCK		8
+
+/* support for right hand modifier */
+#define NX_MODIFIERKEY_RSHIFT		9
+#define NX_MODIFIERKEY_RCONTROL		10
+#define NX_MODIFIERKEY_RALTERNATE	11
+#define NX_MODIFIERKEY_RCOMMAND		12
+
+#define NX_MODIFIERKEY_ALPHALOCK_STATELESS  13
+#define NX_MODIFIERKEY_LAST_KEY     13
+
+
+typedef struct _NXParsedKeyMapping_ {
+ 	/* If nonzero, all numbers are shorts; if zero, all numbers are bytes*/
+	short	shorts;
+
+	/*
+	 *  For each keycode, low order bit says if the key
+	 *  generates characters.
+	 *  High order bit says if the key is assigned to a modifier bit.
+	 *  The second to low order bit gives the current state of the key.
+	 */
+	char	keyBits[NX_NUMKEYCODES];
+
+	/* Bit number of highest numbered modifier bit */
+	int			maxMod;
+
+	/* Pointers to where the list of keys for each modifiers bit begins,
+	 * or NULL.
+	 */
+	unsigned char *modDefs[NX_NUMMODIFIERS];
+
+	/* Key code of highest key deinfed to generate characters */
+	int			numDefs;
+
+	/* Pointer into the keyMapping where this key's definitions begin */
+	unsigned char *keyDefs[NX_NUMKEYCODES];
+
+	/* number of sequence definitions */
+	int			numSeqs;
+
+	/* pointers to sequences */
+	unsigned char *seqDefs[NX_NUMSEQUENCES];
+
+	/* Special key definitions */
+	int			numSpecialKeys;
+
+	/* Special key values, or 0xFFFF if none */
+	unsigned short specialKeys[NX_NUMSPECIALKEYS];
+
+	/* Pointer to the original keymapping string */
+	const unsigned char *mapping;
+
+	/* Length of the original string */
+	int	mappingLen;
+} NXParsedKeyMapping;
+
+#endif /* !_DEV_EV_KEYMAP_H */
diff --git a/iokit/Kernel/hakios.wlan.cpp b/iokit/Kernel/hakios.wlan.cpp
new file mode 100644
index 0000000..5df3e5d
--- /dev/null
+++ b/iokit/Kernel/hakios.wlan.cpp
@@ -0,0 +1,171 @@
+/*
+ * HakiosWLAN: the registry entries by which Darwin finds the Wi-Fi interface.
+ *
+ * en0 is made with the BSD interface KPI (drivers/net/hakios.net.c) and has no IOKit object behind
+ * it of its own; Darwin looks for two, as IO80211Family would have made them:
+ *
+ *   - wifid's device is whatever service has the property IO80211InterfaceRole =
+ *     "Infrastructure", and IO80211.framework binds to an interface through a service whose
+ *     IOInterfaceName is the interface's name. The service has no user client, on purpose:
+ *     the framework's attempt to open one fails, it says "Falling back to IOCTL path", and
+ *     from then on every request is an ioctl on a socket, which drivers/wifi/hakios.apple80211.c
+ *     answers.
+ *   - SystemConfiguration (SCNetworkInterfaceCopyAll) lists the network interfaces it finds as
+ *     objects of the class IONetworkInterface, and calls one a Wi-Fi interface when its parent
+ *     is of the class IO80211Controller; type, unit, name and built-in-ness are properties of
+ *     the interface, the hardware address one of the controller. configd makes a network
+ *     service (DHCP and the rest) for an interface it has listed, and only an interface with a
+ *     service can be the one the system routes through -- which wifid waits for after a join
+ *     ("failed to become routable interface") before Settings ticks the network.
+ *
+ *   - MobileGestalt, which lsd asks for the Wi-Fi address of every bundle it registers, looks the
+ *     address up as the property local-mac-address of the device tree's "wlan" node, as a phone
+ *     has it; without that it waits, up to 5 s every time, for a service of the class
+ *     IONetworkController under that node. With neither, each such question cost 5 s, and a
+ *     LaunchServices database rebuilt in full (a first boot on an empty data volume) takes hours,
+ *     SpringBoard waiting. (Found by the ios-sapphire port, patches 0157 and 0158, which carries
+ *     this file on: github.com/Angelpro09xd/ios-sapphire, APSL 2.0.)
+ *
+ * So: a controller of the class IO80211Controller -- an IOEthernetController and so an
+ * IONetworkController, as in IO80211Family -- under the "wlan" node (the platform when there is
+ * none), the radio's address on that node as local-mac-address, and below the controller one
+ * object that is both, an IONetworkInterface with wifid's properties. The classes are ours, named
+ * as IO80211Family and IONetworkingFamily name theirs; none has anything but properties.
+ */
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+
+extern "C" void HakiosWLANStart(const char * interface, const uint8_t * address);
+
+class IONetworkController : public IOService
+{
+	OSDeclareDefaultStructors(IONetworkController);
+};
+
+OSDefineMetaClassAndStructors(IONetworkController, IOService);
+
+class IOEthernetController : public IONetworkController
+{
+	OSDeclareDefaultStructors(IOEthernetController);
+};
+
+OSDefineMetaClassAndStructors(IOEthernetController, IONetworkController);
+
+class IO80211Controller : public IOEthernetController
+{
+	OSDeclareDefaultStructors(IO80211Controller);
+};
+
+OSDefineMetaClassAndStructors(IO80211Controller, IOEthernetController);
+
+class IONetworkInterface : public IOService
+{
+	OSDeclareDefaultStructors(IONetworkInterface);
+};
+
+OSDefineMetaClassAndStructors(IONetworkInterface, IOService);
+
+class HakiosWLAN : public IONetworkInterface
+{
+	OSDeclareDefaultStructors(HakiosWLAN);
+
+public:
+	virtual IOReturn newUserClient(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties,
+	    IOUserClient ** handler) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(HakiosWLAN, IONetworkInterface);
+
+/* There is none (see the top); that somebody asked shows that the service was found. */
+IOReturn
+HakiosWLAN::newUserClient(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties, IOUserClient ** handler)
+{
+	static unsigned said;
+
+	if (said++ < 8) {
+		IOLog("HakiosWLAN: a user client of type %u is asked for: there is none\n", (unsigned) type);
+	}
+	return kIOReturnUnsupported;
+}
+
+/* attach, start, register: the service, or NULL */
+static IOService *
+publish(IOService * service, IOService * provider, const char * name)
+{
+	if (service == NULL || !service->attach(provider)) {
+		OSSafeReleaseNULL(service);
+		return NULL;
+	}
+	service->setName(name);
+	if (!service->start(provider)) {
+		service->detach(provider);
+		service->release();
+		return NULL;
+	}
+	service->registerService();
+	return service;
+}
+
+/* Once, when the interface of a radio exists. */
+void
+HakiosWLANStart(const char * interface, const uint8_t * address)
+{
+	IOService * platform = IOService::getPlatform();
+	OSDictionary * match = IOService::nameMatching("wlan");
+	IOService * node = match != NULL ? IOService::copyMatchingService(match) : NULL;   /* the device tree's */
+	IO80211Controller * controller = OSTypeAlloc(IO80211Controller);
+	HakiosWLAN * wlan = OSTypeAlloc(HakiosWLAN);
+	OSData * mac;
+	OSNumber * number;
+
+	if (platform == NULL || controller == NULL || wlan == NULL || !controller->init() || !wlan->init()) {
+		OSSafeReleaseNULL(controller);
+		OSSafeReleaseNULL(wlan);
+		OSSafeReleaseNULL(node);
+		OSSafeReleaseNULL(match);
+		IOLog("HakiosWLAN: cannot create the services\n");
+		return;
+	}
+	if ((mac = OSData::withBytes(address, 6)) != NULL) {
+		controller->setProperty("IOMACAddress", mac);
+		if (node != NULL) {
+			node->setProperty("local-mac-address", mac);     /* where MobileGestalt reads it first */
+		}
+		mac->release();
+	}
+	controller->setProperty("IOBuiltin", true);
+	OSSafeReleaseNULL(match);
+	controller = (IO80211Controller *) publish(controller, node != NULL ? node : platform, "HakiosWLANController");
+	OSSafeReleaseNULL(node);
+	if (controller == NULL) {
+		wlan->release();
+		IOLog("HakiosWLAN: the controller did not start\n");
+		return;
+	}
+
+	wlan->setProperty("IOInterfaceName", interface);
+	wlan->setProperty("BSD Name", interface);
+	wlan->setProperty("IOInterfaceNamePrefix", "en");
+	if ((number = OSNumber::withNumber(6ULL, 32)) != NULL) {        /* IFT_ETHER */
+		wlan->setProperty("IOInterfaceType", number);
+		number->release();
+	}
+	if ((number = OSNumber::withNumber((unsigned long long) (interface[2] - '0'), 32)) != NULL) {
+		wlan->setProperty("IOInterfaceUnit", number);
+		number->release();
+	}
+	wlan->setProperty("IOBuiltin", true);
+	wlan->setProperty("IOPrimaryInterface", true);
+	wlan->setProperty("IO80211InterfaceRole", "Infrastructure");
+	if (publish(wlan, controller, "HakiosWLAN") == NULL) {
+		IOLog("HakiosWLAN: the service did not start\n");
+	} else {
+		wlan->release();
+	}
+	controller->release();
+}
diff --git a/libkern/crypto/sweet_aes.c b/libkern/crypto/sweet_aes.c
new file mode 100644
index 0000000..21be4eb
--- /dev/null
+++ b/libkern/crypto/sweet_aes.c
@@ -0,0 +1,111 @@
+/*
+ * SWEET legacy AES CBC/ECB provider backed by BearSSL's portable bitslice AES.
+ * Upstream sources and MIT license are staged by 0020-stage-bearssl.sh.
+ * No heap, SIMD or CPU crypto extension is needed. Contexts can be copied:
+ * their only pointer is the immutable BearSSL class descriptor.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <libkern/libkern.h>
+#include <libkern/crypto/aes.h>
+#include <corecrypto/ccmode.h>
+#include <corecrypto/cc_error.h>
+#include "sweet_bearssl/inc/bearssl_block.h"
+
+_Static_assert(sizeof(br_aes_ct_cbcenc_keys) <= sizeof(aes_encrypt_ctx),
+    "BearSSL encryption context does not fit the XNU AES ABI");
+_Static_assert(sizeof(br_aes_ct_cbcdec_keys) <= sizeof(aes_decrypt_ctx),
+    "BearSSL decryption context does not fit the XNU AES ABI");
+
+static int
+sweet_aes_encrypt_init(const struct ccmode_cbc *mode, cccbc_ctx *ctx,
+    size_t key_len, const void *key)
+{
+    (void)mode;
+    if (ctx == NULL) {
+        return CCERR_PARAMETER;
+    }
+    cc_clear(sizeof(br_aes_ct_cbcenc_keys), ctx);
+    if (key == NULL || (key_len != 16 && key_len != 24 && key_len != 32)) {
+        return CCERR_PARAMETER;
+    }
+    br_aes_ct_cbcenc_init((br_aes_ct_cbcenc_keys *)(void *)ctx, key, key_len);
+    return CCERR_OK;
+}
+
+static int
+sweet_aes_decrypt_init(const struct ccmode_cbc *mode, cccbc_ctx *ctx,
+    size_t key_len, const void *key)
+{
+    (void)mode;
+    if (ctx == NULL) {
+        return CCERR_PARAMETER;
+    }
+    cc_clear(sizeof(br_aes_ct_cbcdec_keys), ctx);
+    if (key == NULL || (key_len != 16 && key_len != 24 && key_len != 32)) {
+        return CCERR_PARAMETER;
+    }
+    br_aes_ct_cbcdec_init((br_aes_ct_cbcdec_keys *)(void *)ctx, key, key_len);
+    return CCERR_OK;
+}
+
+static int
+sweet_aes_check(const void *ctx, const void *iv, size_t nblocks,
+    const void *in, void *out, unsigned rounds)
+{
+    if (ctx == NULL || iv == NULL ||
+        (rounds != 10 && rounds != 12 && rounds != 14)) {
+        return CCERR_PARAMETER;
+    }
+    if (nblocks > SIZE_MAX / 16) {
+        return CCERR_OVERFLOW;
+    }
+    if (nblocks != 0 && (in == NULL || out == NULL)) {
+        return CCERR_PARAMETER;
+    }
+    return CCERR_OK;
+}
+
+static int
+sweet_aes_encrypt_cbc(const cccbc_ctx *ctx, cccbc_iv *iv, size_t nblocks,
+    const void *in, void *out)
+{
+    const br_aes_ct_cbcenc_keys *key = (const void *)ctx;
+    int error = sweet_aes_check(ctx, iv, nblocks, in, out,
+        key == NULL ? 0 : key->num_rounds);
+    if (error != CCERR_OK || nblocks == 0) {
+        return error;
+    }
+    /* BearSSL is in-place; copy first so both corecrypto API forms work. */
+    memmove(out, in, nblocks * 16);
+    br_aes_ct_cbcenc_run(key, iv, out, nblocks * 16);
+    return CCERR_OK;
+}
+
+static int
+sweet_aes_decrypt_cbc(const cccbc_ctx *ctx, cccbc_iv *iv, size_t nblocks,
+    const void *in, void *out)
+{
+    const br_aes_ct_cbcdec_keys *key = (const void *)ctx;
+    int error = sweet_aes_check(ctx, iv, nblocks, in, out,
+        key == NULL ? 0 : key->num_rounds);
+    if (error != CCERR_OK || nblocks == 0) {
+        return error;
+    }
+    memmove(out, in, nblocks * 16);
+    br_aes_ct_cbcdec_run(key, iv, out, nblocks * 16);
+    return CCERR_OK;
+}
+
+const struct ccmode_cbc sweet_aes_cbc_encrypt = {
+    .size = sizeof(br_aes_ct_cbcenc_keys),
+    .block_size = 16,
+    .init = sweet_aes_encrypt_init,
+    .cbc = sweet_aes_encrypt_cbc,
+};
+const struct ccmode_cbc sweet_aes_cbc_decrypt = {
+    .size = sizeof(br_aes_ct_cbcdec_keys),
+    .block_size = 16,
+    .init = sweet_aes_decrypt_init,
+    .cbc = sweet_aes_decrypt_cbc,
+};
+#endif /* ARM64_BOARD_CONFIG_SWEET */
