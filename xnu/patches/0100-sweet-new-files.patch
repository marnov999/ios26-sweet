+/* ------------------------------------------------------------------ */
+/* uapi (include/uapi/linux/qg.h, this tree has QG_MAX = 18)          */
+enum {
+	QG_SOC, QG_OCV_UV, QG_RBAT_MOHM, QG_PON_OCV_UV, QG_GOOD_OCV_UV, QG_ESR,
+	QG_CHARGE_COUNTER, QG_FIFO_TIME_DELTA, QG_BATT_SOC, QG_CC_SOC,
+	QG_ESR_CHARGE_DELTA, QG_ESR_DISCHARGE_DELTA, QG_ESR_CHARGE_SF,
+	QG_ESR_DISCHARGE_SF, QG_FULL_SOC, QG_CLEAR_LEARNT_DATA, QG_SYS_SOC,
+	QG_RESERVED_10, QG_MAX
+};
+#define QG_MAX_FIFO_LENGTH 16
+struct qg_fifo_data { uint32_t v, i, count, interval; };
+struct qg_param     { uint32_t data; uint8_t valid; uint8_t pad_[3]; };
+struct qg_kernel_data {
+	uint32_t seq_no, fifo_time, fifo_length;
+	struct qg_fifo_data fifo[QG_MAX_FIFO_LENGTH];
+	struct qg_param param[QG_MAX];
+};
+struct qg_user_data { struct qg_param param[QG_MAX]; };
+
+/* bms power-supply properties the daemon reads every cycle (read_props()) */
+struct qg_props {
+	int32_t capacity;              /* POWER_SUPPLY_PROP_CAPACITY (shown %)      */
+	int32_t voltage_ocv;           /* SDAM OCV, uV (read, unused by algorithm)  */
+	int32_t temp;                  /* deci-degC                                 */
+	int32_t voltage_min;           /* vbatt_cutoff_mv*1000 = 3400000            */
+	int32_t batt_full_current;     /* iterm_ma*1000 = 350000 (positive)         */
+	int32_t current_now;           /* uA, + = discharge (LAST_BURST_AVG_I)      */
+	int32_t voltage_max;           /* float voltage = 4400000                   */
+	int32_t voltage_now;           /* uV (LAST_ADC_V)                           */
+	int32_t batt_profile_version;  /* 100                                       */
+	int32_t fg_type;               /* 0 (QG)                                    */
+	int32_t resistance_capacitive; /* rbat_conn_mohm = 0                        */
+	int32_t charge_full;           /* learned capacity, uAh                     */
+	int32_t charge_full_design;    /* nom capacity, uAh = 4000000               */
+	int32_t debug_battery;         /* 0                                         */
+};
+
+/* ------------------------------------------------------------------ */
+/* 1. battery profile (kernel /dev/qg_battery semantics)               */
+int qg_prof_soc(int ocv_uv, int temp, int charging);   /* BPIOCXSOC, cpct  */
+int qg_prof_ocv(int soc, int temp, int charging);      /* BPIOCXOCV, uV    */
+int qg_prof_fcc(int temp, int charging);               /* BPIOCXFCC, mAh   */
+int qg_prof_slope(int soc, int temp, int charging);    /* BPIOCXSLOPE      */
+int qg_prof_var(int table /* 4..15 = Z1..Y6 */, int soc, int temp); /* BPIOCXVAR */
+/* Linux lookup_soc_ocv(): % (0..100), rounded */
+int qg_lookup_soc_ocv_pct(int ocv_uv, int temp, int charging);
+
+/* ------------------------------------------------------------------ */
+/* 2. the QG daemon                                                    */
+
+/* the 55 int/float pairs of the daemon state ("*_DUMP" names in the binary),
+ * in binary order, at info+0x2cc */
+enum {
+	QD_TIMESTAMP, QD_SEQNO, QD_FIFO_LENGTH, QD_FIFO_DELTA, QD_FIFO_V, QD_FIFO_I,
+	QD_FIFO_INT, QD_FIFO_CNT, QD_B_TEMP, QD_FCC, QD_INIT_OCV, QD_GOOD_OCV,
+	QD_CUTOFF_OCV, QD_CUTOFF_IBAT, QD_FULL_OCV, QD_INIT_SOC, QD_CUTOFF_SOC,
+	QD_FULL_SOC, QD_VOLTAGE_SOC, QD_CC_SOC, QD_R_SOC, QD_B_SOC, QD_S_SOC,
+	QD_M_SOC, QD_SLOPE, QD_V_OCV, QD_V_IBAT, QD_CC_FIFO, QD_CC_UAH, QD_B_OCV,
+	QD_T_RBAT, QD_RLONG, QD_RSHORT, QD_ESR, QD_M_ESR, QD_CSHORT, QD_CLONG,
+	QD_I_RSHORT, QD_I_RLONG, QD_V_RSHORT, QD_V_RLONG, QD_V_ESR, QD_VBAT_ERR,
+	QD_SOC_CORR, QD_CUTOFF_VPREDICT, QD_FULLSOC_VPREDICT, QD_CUTOFF_RBAT,
+	QD_FULLSOC_RBAT, QD_ESR_CHG_DELTA, QD_ESR_CHG_SF, QD_ESR_DISCHG_DELTA,
+	QD_ESR_DISCHG_SF, QD_V_CAP, QD_QG_MODE, QD_SOC_GAIN, QD_NSLOT
+};
+struct qd_slot { int32_t i; f32 f; };
+
+/* per-table decode of the Z/Y profile tables (daemon .data @0x13bcc8) */
+struct qd_ptab { int32_t sub, div, add, mult; };
+
+struct qg_daemon {
+	struct qd_slot s[QD_NSLOT];       /* info+0x2cc .. 0x483 */
+	uint8_t  is_charging;             /* +0x484 */
+	uint8_t  have_soc;                /* +0x485 */
+	int32_t  fifo_delta;              /* +0x488 per-entry ms correction */
+	int32_t  last_soc;                /* +0x48c */
+	int32_t  fg_type;                 /* +0x490 */
+	int32_t  esr_chg_delta;           /* +0x494 */
+	int32_t  esr_dischg_delta;        /* +0x498 */
+	int32_t  esr_chg_sf;              /* +0x49c */
+	int32_t  esr_dischg_sf;           /* +0x4a0 */
+	/* configuration (persist.vendor.qg.* - all unset on davinci) */
+	int32_t  clk_skew_pct, vwt, ccwt, coff_ibat_ma, coff_cold_ibat_ma;
+	int32_t  coff_soc, fullsoc, fullsoc_margin, rconn, cold_temp;
+	int32_t  full_soc_cold_temp, esr_delta_limit, esr_sf_max, esr_sf_min;
+	int32_t  esr_use_discharge, chg_med2low_ua, chg_hi2med_ua;
+	int32_t  dischg_med2low_ua, dischg_hi2med_ua;
+	f32      gain_dischg_high, gain_dischg_med, gain_dischg_low;
+	f32      gain_chg_high, gain_chg_med, gain_chg_low;
+	f32      coff_gain, cld_coff_gain, fullsoc_gain;
+	int32_t  learned_uah, design_uah;  /* +0x520 / +0x524 */
+	struct qg_props p;                 /* +0x74 snapshot of this cycle */
+	struct qd_ptab tab[16];            /* profile decode/scale state   */
+};
+
+/* qg_main() initialisation; returns 0 */
+int qg_daemon_init(struct qg_daemon *d, const struct qg_props *p);
+/* qg_read_cb(): consume one kdata, returns 1 and fills *ud when the daemon
+ * writes udata back to the kernel, 0 when it does not */
+int qg_daemon_process(struct qg_daemon *d, const struct qg_kernel_data *kd,
+		      const struct qg_props *p, struct qg_user_data *ud);
+
+/* ------------------------------------------------------------------ */
+/* 3. kernel side (qpnp-qg.c / qg-soc.c, Xiaomi lineage-24.0)          */
+
+/* QG SDAM (base 0xB600) fields used by the SOC code, qg-sdam.c layout */
+struct qg_sdam {
+	uint32_t valid;          /* 0xB646  u8  */
+	uint32_t soc;            /* 0xB647  u8  */
+	uint32_t temp;           /* 0xB648  u16 (s16 deci-C) */
+	uint32_t rbat_mohm;      /* 0xB64A  u16 */
+	uint32_t ocv_uv;         /* 0xB64C  u32 */
+	uint32_t ibat_ua;        /* 0xB650  u32 */
+	uint32_t time_sec;       /* 0xB654  u32 (PMIC RTC) */
+	uint32_t esr_chg_delta;  /* 0xB66A  u32 (signed) */
+	uint32_t esr_dischg_delta; /* 0xB66E u32 (signed) */
+	uint32_t esr_chg_sf;     /* 0xB672  u16 */
+	uint32_t esr_dischg_sf;  /* 0xB674  u16 */
+};
+#define QG_SDAM_BASE        0xB600
+#define QG_SDAM_VALID_REG   0xB646
+#define QG_SDAM_SOC_REG     0xB647
+#define QG_SDAM_TEMP_REG    0xB648
+#define QG_SDAM_RBAT_REG    0xB64A
+#define QG_SDAM_OCV_REG     0xB64C
+#define QG_SDAM_IBAT_REG    0xB650
+#define QG_SDAM_TIME_REG    0xB654
+#define QG_SDAM_MAGIC_REG   0xB680
+#define QG_SDAM_MAGIC       0x12345678u
+/* raw SDAM bytes 0xB646..0xB675 (48 bytes) <-> struct; pack only touches the
+ * fields Linux's qg_store_soc_params()/qg_store_esr_params() write */
+#define QG_SDAM_RAW_LEN 48
+void qg_sdam_unpack(const uint8_t raw[QG_SDAM_RAW_LEN], struct qg_sdam *s);
+void qg_sdam_pack(const struct qg_sdam *s, uint8_t raw[QG_SDAM_RAW_LEN]);
+
+/* constants of this phone (base dts + dtbo 14, driver defaults otherwise) */
+#define QG_VBATT_CUTOFF_UV     3400000
+#define QG_FLOAT_UV            4400000
+#define QG_ITERM_UA            350000
+#define QG_IGNORE_SHUTDOWN_S   360     /* DEFAULT_SHUTDOWN_SOC_SECS */
+#define QG_SHUTDOWN_SOC_THR    3       /* qcom,shutdown-soc-threshold */
+#define QG_SHUTDOWN_TEMP_DIFF  50      /* DEFAULT_SHUTDOWN_TEMP_DIFF, deci-C */
+#define QG_DELTA_SOC           1
+#define QG_COLD_TEMP_THRESH    0       /* DEFAULT_COLD_TEMP_THRESHOLD, deci-C */
+#define QG_MIN_SLEEP_TIME_S    1800    /* DEFAULT_SLEEP_TIME_SECS */
+#define QG_RECHARGE_SOC        99      /* smb5 qcom,auto-recharge-soc */
+#define QG_EINVAL              (-22)
+
+enum { QG_PS_UNKNOWN = 0, QG_PS_CHARGING = 1, QG_PS_DISCHARGING = 2,
+       QG_PS_NOT_CHARGING = 3, QG_PS_FULL = 4 };   /* POWER_SUPPLY_STATUS_* */
+#define QG_HEALTH_GOOD 1                            /* POWER_SUPPLY_HEALTH_GOOD */
+
+struct qg_kernel {
+	/* SOC state (struct qpnp_qg) */
+	int msoc, catch_up_soc, last_adj_ssoc, maint_soc, recharge_soc;
+	int sys_soc, batt_soc, cc_soc, full_soc, esr_last;
+	int charge_full, charge_done, charge_status, health;
+	int usb_present, force_soc, soc_reporting_ready;
+	int rtc_valid;             /* PMIC RTC readable (get_rtc_time() rc == 0); default 1 */
+	uint32_t last_maint_soc_update_time;   /* RTC s */
+	/* msoc scaling alarm (alarm_timer) */
+	int scale_armed;
+	int64_t scale_due_ms;                  /* monotonic ms */
+	int next_wakeup_ms;
+	/* fifo geometry for get_next_update_time(): get_fifo_done_time(false/true) */
+	int fifo_full_ms, fifo_rt_ms;
+	/* Xiaomi smooth tracking (chip->param) */
+	int shown;                 /* param.batt_soc, -EINVAL until first run */
+	int raw_soc, batt_ma, batt_temp, update_now;
+	int64_t last_change_s;     /* param.last_soc_change_time.tv_sec (boottime) */
+	int batt_ma_prev, batt_ma_avg, samples_index, samples_num;
+	int batt_ma_avg_samples[8];
+	/* force shutdown + shutdown-delay (qg_psy_get_property statics) */
+	int force_shutdown, fs_count;
+	int shutdown_delay, shutdown_delay_cancel, last_shutdown_delay;
+	/* SDAM mirror: what Linux would have written (write it back to keep
+	 * MIUI and iOS consistent) */
+	struct qg_sdam sdam;
+	int sdam_dirty;            /* bit0 SOC/TEMP/RBAT/OCV/IBAT/TIME/VALID, bit1 SOC only, bit2 ESR */
+	int soc_monotonic_reg;     /* value for QG_SOC_MONOTONIC (0x48BF) */
+	/* kdata params the kernel hands the daemon at its next read */
+	uint32_t pon_ocv_uv;       /* QG_PON_OCV_UV (daemon ignores it) */
+	/* capacity learning (fg-alg.c, qcom,cl-feedback-on) */
+	int last_fifo_i_ua;        /* chip->last_fifo_i_ua: i of the last FIFO/ACC entry */
+	struct {
+		int active, init_cc_soc_sw, init_batt_soc, init_batt_soc_cp;
+		int64_t nom_cap_uah, init_cap_uah, final_cap_uah, learned_cap_uah, delta_cap_uah;
+	} cl;
+	int16_t sdam_learned_mah;  /* SDAM 0xB668 (s16 mAh), sdam_dirty bit3 when written */
+};
+
+struct qg_pon_in {
+	uint32_t s7_ocv_uv;        /* QG_S7_PON_OCV (0x4870) converted */
+	int batt_temp;             /* deci-C */
+	uint32_t rtc_sec;          /* PMIC RTC now */
+	int rtc_ok, sdam_ok;
+	struct qg_sdam sdam;       /* read at PON */
+};
+struct qg_pon_out {
+	int pon_soc, full_soc, cutoff_soc, calc_soc, used_shutdown;
+	uint32_t ocv_uv;
+};
+
+/* probe defaults (msoc etc. are set by qg_kernel_pon).  sdam_learned_mah =
+ * SDAM 0xB668 as read at boot; runs cap_learning_post_profile_init() with the
+ * nominal capacity (fcc1 @ 25 degC). */
+void qg_kernel_init(struct qg_kernel *k);
+void qg_kernel_profile_init(struct qg_kernel *k, int16_t sdam_learned_mah);
+/* POWER_SUPPLY_PROP_CHARGE_FULL (learned capacity, uAh) -> daemon props.charge_full */
+int qg_kernel_charge_full_uah(const struct qg_kernel *k);
+/* qg_determine_pon_soc() (Xiaomi variant).  wa_flags = 6 on PM6150, so the
+ * PON_OCV_WA branch is not taken.  Sets msoc/catch_up/sys/cc, the SDAM mirror
+ * (sdam_dirty |= 1), QG_SOC_MONOTONIC and pon_ocv_uv; soc_reporting_ready = 1. */
+void qg_kernel_pon(struct qg_kernel *k, const struct qg_pon_in *in, struct qg_pon_out *out);
+
+/* process_udata_work().  vbat_avg_uv = QG_S2_NORMAL_AVG_V (0x4880, hold-at-1 %),
+ * batt_cur_ua = LAST_BURST_AVG_I (update_msoc), batt_temp/rtc for the SDAM
+ * write, now_ms = monotonic clock for the msoc alarm. */
+void qg_kernel_udata(struct qg_kernel *k, const struct qg_user_data *ud,
+		     int vbat_avg_uv, int batt_cur_ua, int batt_temp,
+		     uint32_t rtc_sec, int64_t now_ms);
+/* scale_soc_work(): call when scale_armed && now_ms >= scale_due_ms */
+void qg_kernel_scale_timer(struct qg_kernel *k, int batt_cur_ua, int batt_temp,
+			   uint32_t rtc_sec, int64_t now_ms);
+/* qg_status_change_work() (charger STATUS / CHARGE_DONE / input change) */
+void qg_kernel_status(struct qg_kernel *k, int charge_status, int charge_done,
+		      int health, int usb_present, int batt_cur_ua, int batt_temp,
+		      uint32_t rtc_sec, int64_t now_ms);
+/* qg_vbat_empty_handler(): QG VBAT_EMPTY interrupt (INT_RT_STS 0x4810 bit2
+ * rising, threshold 3.1 V) -> SOC forced to 0, SDAM SOC=0/OCV=SDAM OCV/VALID */
+void qg_kernel_vbat_empty(struct qg_kernel *k, uint32_t sdam_ocv_uv, int batt_temp,
+			  uint32_t rtc_sec, int64_t now_ms);
+/* qg_get_battery_capacity() (linearize-soc, hold-soc-while-full) */
+int qg_kernel_capacity(const struct qg_kernel *k);
+/* soc_monitor_work(), every 10 s: Xiaomi smooth tracking -> k->shown */
+void qg_kernel_soc_monitor(struct qg_kernel *k, int batt_ua, int batt_temp, int64_t boot_s);
+/* force_shutdown_work(): returns the delay to the next call (ms) */
+int qg_kernel_force_shutdown(struct qg_kernel *k, int vbat_uv);
+/* POWER_SUPPLY_PROP_CAPACITY (what healthd/MIUI show), incl. shutdown-delay */
+int qg_kernel_reported_capacity(struct qg_kernel *k, int vbat_uv);
+
+/* charger side (davinci smb5-lib.c, ref/.../smb5/): POWER_SUPPLY_PROP_HEALTH,
+ * STATUS and CHARGE_DONE of the "battery" psy from SMB5 registers.  Votes that
+ * are invisible to a register reader (JEITA/USER/CHG_TERMINATION ICL votes,
+ * BQ pump) are taken as not set; DC input is absent on davinci.
+ *   r1006 BATTERY_CHARGER_STATUS_1, r100d BATTERY_CHARGER_STATUS_7,
+ *   r1043 CHARGING_PAUSE_CMD, r110b POWER_PATH_STATUS, r1310 USBIN_INT_RT_STS,
+ *   capacity = bms POWER_SUPPLY_PROP_CAPACITY (qg_kernel_reported_capacity) */
+/* returns POWER_SUPPLY_HEALTH_*: GOOD 1, OVERHEAT 2, COLD 6, WARM 10, COOL 11 */
+int qg_smb5_health(uint8_t r100d);
+int qg_smb5_usb_present(uint8_t r1310);
+int qg_smb5_charge_done(uint8_t r1006);
+int qg_smb5_batt_status(uint8_t r1006, uint8_t r100d, uint8_t r1043, uint8_t r110b, int capacity);
+
+/* kdata assembly (qg_process_fifo / qg_process_accumulator / fifo-done):
+ * v_raw/i_raw = QG_V_FIFO/QG_I_FIFO words; returns -1 when an entry reads 0x8000
+ * (Linux rejects the whole FIFO then).  Appends at kd->fifo_length. */
+int qg_kdata_add_fifo(struct qg_kernel_data *kd, const uint16_t *v_raw, const uint16_t *i_raw,
+		      int len, uint32_t interval_ms, uint32_t count, int subtype4);
+int qg_kdata_add_accum(struct qg_kernel_data *kd, uint32_t v_acc_raw /*u24*/, uint32_t i_acc_raw /*s24*/,
+		       uint8_t acc_cnt, uint32_t interval_ms, int subtype4);
+/* FIFO_TIME_DELTA as qg_fifo_update_done_handler() validates it */
+void qg_kdata_fifo_time_delta(struct qg_kernel_data *kd, int hw_delta_ms, int sw_delta_ms);
+
+/* ------------------------------------------------------------------ */
+/* register helpers (qg-util.c)                                        */
+static inline uint32_t qg_vraw_to_uv(uint32_t raw) { return (uint32_t)((194637ull * raw) / 1000); }
+/* PM6150 QG subtype 4 (10 A ADC): uA, + = discharge */
+static inline int32_t qg_iraw_to_ua_sub4(int32_t sraw) { return (int32_t)(((int64_t)sraw * 305176) / 1000); }
+static inline int32_t qg_iraw_to_ua_sub3(int32_t sraw) { return (int32_t)(((int64_t)sraw * 152588) / 1000); }
+/* S2_NORMAL_MEAS_CTL3 -> sample interval ms with QG_CLK_ADJUST_WA (PM6150) */
+static inline uint32_t qg_sample_interval_ms(uint8_t ctl3) { uint32_t v = ctl3 * 10u; return (v * 32000u + 32764u / 2) / 32764u; }
+/* S2_NORMAL_MEAS_CTL2 -> samples per FIFO entry and FIFO length */
+static inline uint32_t qg_sample_count(uint8_t ctl2) { return 1u << ((ctl2 & 0x7) + 1); }
+static inline uint32_t qg_fifo_length(uint8_t ctl2) { return ((ctl2 >> 3) & 0x7) + 1; }
+
+#ifdef __cplusplus
+}
+#endif
+#endif
