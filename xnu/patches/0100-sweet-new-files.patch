+        num = OSNumber::withNumber(nanoTime, 64);
+        if (num) {
+            debugDict->setObject("LastEventTime", num);
+            OSSafeReleaseNULL(num);
+        }
+    }
+    if (_lastEventType) {
+        num = OSNumber::withNumber(_lastEventType, 32);
+        if (num) {
+            debugDict->setObject("LastEventType", num);
+            OSSafeReleaseNULL(num);
