+	slot->handler = handler;
+	slot->context = context;
+	slot->count = 0;
+	os_atomic_store(&slot->intid, intid, release);
+
+	sweet_gic_spi_mask(intid);
+	gicd_write32(SGIC_ICPENDR(intid / 32), 1u << (intid % 32));
+	gicd_write32(SGIC_ICACTIVER(intid / 32), 1u << (intid % 32));
+	gicd_write32(SGIC_IGROUPR(intid / 32), gicd_read32(SGIC_IGROUPR(intid / 32)) | 1u << (intid % 32));
+	gicd_write32(SGIC_IGRPMODR(intid / 32), gicd_read32(SGIC_IGRPMODR(intid / 32)) & ~(1u << (intid % 32)));
