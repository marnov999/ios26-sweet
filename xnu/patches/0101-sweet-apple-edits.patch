+		;
+	}
+	sweet_gic_spi_unmask(intid);
+	return KERN_SUCCESS;
+}
+
+void
+sweet_gic_spi_detach(uint32_t intid)
+{
+	sweet_gic_spi_mask(intid);
+	if (gicd_base != 0 && intid >= SGIC_SPI_MIN && intid < SGIC_SPI_MAX) {
+		gicd_write32(SGIC_ICPENDR(intid / 32), 1u << (intid % 32));
+	}
+	for (unsigned i = 0; i < SGIC_SPI_SLOTS; i++) {
+		if (sgic_spi[i].intid == intid) {
+			sgic_spi[i].handler = NULL;
+			os_atomic_store(&sgic_spi[i].intid, 0, release);
+		}
+	}
+}
+
+uint64_t
+sweet_gic_spi_count(uint32_t intid)
+{
+	for (unsigned i = 0; i < SGIC_SPI_SLOTS; i++) {
+		if (sgic_spi[i].intid == intid) {
+			return sgic_spi[i].count;
+		}
+	}
+	return 0;
