+	if (gicd_base == 0 || intid < SGIC_SPI_MIN || intid >= SGIC_SPI_MAX || handler == NULL) {
+		return KERN_INVALID_ARGUMENT;
+	}
+	for (unsigned i = 0; i < SGIC_SPI_SLOTS; i++) {
+		if (sgic_spi[i].intid == intid) {
+			return KERN_NAME_EXISTS;
+		}
+		if (slot == NULL && sgic_spi[i].intid == 0) {
+			slot = &sgic_spi[i];
+		}
+	}
+	if (slot == NULL) {
+		return KERN_RESOURCE_SHORTAGE;
+	}
+
+	/* Install the dispatcher on this processor the first time, and remember it so every SPI is
+	 * routed here (interrupts off pins us to this processor while we read its MPIDR + install). */
+	if (!sgic_handler_installed) {
+		boolean_t istate = ml_set_interrupts_enabled(FALSE);
+		sgic_target_mpidr = __builtin_arm_rsr64("MPIDR_EL1");
+		ml_install_interrupt_handler(NULL, 0, NULL, (IOInterruptHandler)sweet_spi_platform_handler, NULL);
+		sgic_handler_installed = true;
+		(void)ml_set_interrupts_enabled(istate);
+	}
